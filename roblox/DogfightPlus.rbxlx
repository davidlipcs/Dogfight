<Item class="Folder" referent="RBX57"><Properties><string name="Name">sim</string></Properties><Item class="ModuleScript" referent="RBX49"><Properties><string name="Name">AI</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Mouse-aim instructor, player pilot and enemy AI: the port of web/js/ai.js.
local M = require(script.Parent.SimMath)
local Specs = require(script.Parent.Specs)
local Weapons = require(script.Parent.Weapons)
local Sim = require(script.Parent.Sim)
local G, DEG, V = M.G, M.DEG, M.V
local add, sub, mul, dot, cross, len, norm, clamp, smoothstep, angleBetween, bankAngle, wrap = M.add, M.sub, M.mul, M.dot, M.cross, M.len, M.norm, M.clamp, M.smoothstep, M.angleBetween, M.bankAngle, M.wrap
local ARH = Specs.ARH
local STT, gunLead, launchZone = Weapons.STT, Weapons.gunLead, Weapons.launchZone
local AI_DT = Sim.AI_DT
local acos, atan2, abs, cos, sin = math.acos, M.atan2, math.abs, math.cos, math.sin

local A = {}

-- Mouse-aim "instructor" (War Thunder style): swings the flight path - or with `nose` the nose itself - towards `direction`.
function A.steerTowards(fm, direction, c, maxGFrac, precision, nose)
	maxGFrac, precision, nose = maxGFrac or 1, precision or 1, nose or false
	local s, q, right, up, fwd = fm.spec, fm.quat, fm.right, fm.up, fm.forward
	local path = (nose or fm.speed <= 30) and fwd or norm(fm.vel, fwd)
	local lift = norm(cross(right, path), up)
	local side = cross(path, lift)
	local d = norm(direction)
	local off = acos(clamp(dot(d, path), -1, 1))
	local speed = math.max(fm.speed, 60)
	local perp = sub(d, mul(path, dot(d, path)))
	if len(perp) > 1e-6 then perp = norm(perp) end
	local behind = smoothstep(120 * DEG, 170 * DEG, off)
	if behind > 0 or len(perp) < 0.5 then
		local flat = cross(path, V(0, 0, 1))
		if len(flat) < 1e-3 then flat = right:clone() end
		flat = norm(flat)
		local sign = dot(perp, flat)
		if abs(sign) < 0.15 then sign = bankAngle(q) >= 0 and 1 or -1 end
		flat = mul(flat, sign >= 0 and 1 or -1)
		perp = norm(add(mul(perp, 1 - behind), mul(flat, math.max(behind, 0.01))), flat)
	end
	-- turn rate demand (PD: a path already swinging towards the target eases off)
	local closingRate = dot(fm.accel, perp) / speed
	local rate = clamp(off * 0.9 * precision - 0.5 * closingRate * (1 - behind), 0, 1.0)
	local acc = add(mul(perp, rate * speed), V(0, 0, G))
	acc:addScaled(path, -dot(acc, path))
	local aG = len(acc) / G
	local rollPull = atan2(dot(acc, side), dot(acc, lift))
	local rollPush = wrap(rollPull + math.pi)
	-- pull (lift towards the target) or push (lift away, negative G)?
	local pushOk = behind == 0 and (off < 40 * DEG or (aG <= -s.gMin * 0.85 and off < 60 * DEG))
	local costPull, costPush = abs(rollPull), abs(rollPush) + 25 * DEG
	local push = (fm.steerPush and true or false) and pushOk
	if pushOk then
		local flip
		if push then flip = costPull + 20 * DEG < costPush else flip = costPush + 20 * DEG < costPull end
		if flip then push = not push end
	end
	fm.steerPush = push
	local rollErr = push and rollPush or rollPull
	-- small corrections: keep the bank small (the rudder below does the rest)
	if off < 45 * DEG and behind == 0 then
		local cur = bankAngle(q)
		local lim = (20 + 160 * smoothstep((nose and 2 or 4) * DEG, (nose and 22 or 40) * DEG, off)) * DEG
		local base = (push and abs(cur) > math.pi / 2) and math.pi or 0        -- inverted flight: limit around 180
		local want = wrap(cur + rollErr - base)
		rollErr = wrap(clamp(want, -lim, lim) + base - cur)
	end
	-- load factor along the lift direction we are rolling to, applied as the roll gets there
	local target = add(mul(lift, cos(rollErr)), mul(side, sin(rollErr)))
	local nz = dot(acc, target) / G
	nz = 1 + (nz - 1) * math.max(0, cos(clamp(rollErr, -math.pi / 2, math.pi / 2)))
	nz = clamp(nz, s.gMin * 0.85, s.gMax * maxGFrac)
	c.roll = clamp(rollErr * 1.8 - fm.omega.y * 0.3, -1, 1)
	c.pitch = clamp(nz >= 1 and (nz - 1) / (s.gMax - 1) or (nz - 1) / (1 - s.gMin), -1, 1)
	local fine = 1 - smoothstep((nose and 6 or 3) * DEG, (nose and 20 or 12) * DEG, off)
	c.yaw = clamp(atan2(dot(d, side), dot(d, path)) * 4 * precision, -1, 1) * fine
	if fm.onGround then
		local he = wrap(atan2(d.x, d.y) - atan2(fwd.x, fwd.y))
		c.roll = 0
		c.yaw = clamp(he * 3, -1, 1)
		c.pitch = clamp(math.asin(clamp(d.z, -1, 1)) * 4, 0, 1)
	end
	return off
end
local steerTowards = A.steerTowards

local PLAYER_G = 0.85

local PlayerPilot = {}
PlayerPilot.__index = function(t, k)
	if k == "manual" then return t.pitch ~= nil or t.roll ~= nil end
	return PlayerPilot[k]
end
function A.newPlayerPilot(ac)
	local p = setmetatable({}, PlayerPilot)
	p.ac, p.aim, p.pitch, p.roll, p.yaw = ac, ac.forward:clone(), nil, nil, nil
	ac.pilot = p
	return p
end
function PlayerPilot:think() end
function PlayerPilot:fly()
	local c, fm = self.ac.controls, self.ac.fm
	if self.manual then
		-- keyboard flying: the instructor lets go, the jet does exactly what the keys say; an axis without a key holds its attitude
		c.pitch = self.pitch ~= nil and self.pitch or 0
		c.roll = self.roll ~= nil and self.roll or clamp(-fm.omega.y * 0.5, -1, 1)
		c.yaw = self.yaw ~= nil and self.yaw or 0
		-- extreme mode: a full pull lets the jet go past the AoA limit (Cobra)
		c.postStall = fm.extreme and c.pitch >= 0.95
		return
	end
	c.postStall = false
	steerTowards(fm, self.aim, c, fm.extreme and 1 or PLAYER_G, fm.extreme and 1.5 or 1.3, true)
	if self.yaw ~= nil then c.yaw = self.yaw end
end

-- The AI flies the same jets as the player (with a weaker airframe); its pilot is a little weaker too.
local SKILLS = {
	easy = { g = 0.6, precision = 0.65, missileCd = 36, cm = 0.3, aware = 0.2, gunCone = 0.7, arh = false, zone = 0.5, maxIr = 3500, maxArh = 0, evade = 0.08 },
	normal = { g = 0.8, precision = 0.85, missileCd = 24, cm = 0.6, aware = 0.45, gunCone = 1.0, arh = true, zone = 0.7, maxIr = 4500, maxArh = 8000, evade = 0.15 },
	hard = { g = 0.92, precision = 0.95, missileCd = 15, cm = 0.9, aware = 0.75, gunCone = 1.4, arh = true, zone = 0.8, maxIr = 5500, maxArh = 10000, evade = 0.24 },
	ace = { g = 1.0, precision = 1.0, missileCd = 11, cm = 1.0, aware = 0.95, gunCone = 1.8, arh = true, zone = 0.88, maxIr = 6500, maxArh = 13000, evade = 0.35 },
	wing = { g = 0.95, precision = 0.95, missileCd = 14, cm = 0.9, aware = 0.8, gunCone = 1.4, arh = true, zone = 0.8, maxIr = 5500, maxArh = 11000, evade = 0.2 },
}
A.SKILLS = SKILLS
local MIN_AGL = 450

local AIPilot = {}
AIPilot.__index = AIPilot
local function initAI(self, ac, skill, area)
	self.ac, self.skill, self.rnd, self.area = ac, SKILLS[skill or "normal"], ac.rnd, area
	self.state, self.target, self.threat, self.aware, self.defendTimer = "patrol", nil, nil, {}, 0
	self.missileTimer = self.rnd.uniform(6, 14)
	self.patrolAlt = ac.pos.z
	self.waypoint = self:patrolPoint()
	ac.pilot = self
end
function A.newAIPilot(ac, skill, area)
	local p = setmetatable({}, AIPilot)
	initAI(p, ac, skill, area)
	return p
end
function AIPilot:patrolPoint()
	local a, r = self.area, self.rnd
	if not a then return V(r.uniform(-20000, 20000), r.uniform(-20000, 20000), self.patrolAlt) end
	local ang = r.uniform(0, 2 * math.pi)
	local d = a.r * 0.8 * math.sqrt(r())
	return V(a.x + sin(ang) * d, a.y + cos(ang) * d, self.patrolAlt)
end
-- may this enemy be attacked?  inside the combat zone (+ margin) and not in the base's safe area
function AIPilot:fair(t)
	local a = self.area
	if not a then return true end
	if a.safe and math.sqrt((t.pos.x - a.safe.x) ^ 2 + (t.pos.y - a.safe.y) ^ 2) < a.safe.r then return false end
	return math.sqrt((t.pos.x - a.x) ^ 2 + (t.pos.y - a.y) ^ 2) < a.engage
end
function AIPilot:think(world)
	local ac = self.ac
	self.missileTimer = self.missileTimer - AI_DT
	ac.trigger = false
	local target = nil
	for _, e in ipairs(world:enemiesOf(ac)) do
		if self:fair(e) then
			if not target or len(sub(e.pos, ac.pos)) < len(sub(target.pos, ac.pos)) then target = e end
		end
	end
	self.target = target
	local threat = self:findThreat(world)
	if threat then
		self.threat, self.state, self.defendTimer = threat, "defend", 2.5
	elseif self.defendTimer > 0 then
		self.defendTimer = self.defendTimer - AI_DT
		if self.threat and not self.threat.alive then self.defendTimer = math.min(self.defendTimer, 0.5) end
	else
		self.threat = nil
		self.state = self.target and "engage" or "patrol"
	end
	local t = self.target
	if not t then return end
	local d, r = len(sub(t.pos, ac.pos)), ac.radar
	if not r.on then r:togglePower() end
	if r.locked ~= t and r.pending ~= t and d < r.spec.lockRange then r:tryLock(t) end
	if self.state == "engage" then self:weapons(world, t, d) end
end
function AIPilot:findThreat(world)
	local ac = self.ac
	local best, bd = nil, 1e9
	for _, m in ipairs(world.missiles) do
		if m.alive and m.shooter and m.shooter.team ~= ac.team and (m.guidedTarget == ac or m.intended == ac) then
			local d = len(sub(m.pos, ac.pos))
			local known = self.aware[m.id]
			if not known then
				local warned = false
				if m.spec.guidance == ARH then
					for _, t in ipairs(ac.rwr.threats) do
						if t.level == "launch" and (t.source == m or t.source == m.shooter) then warned = true; break end
					end
				end
				local spotted = d < 4500 and self.rnd() < self.skill.aware * 0.5
				if warned or spotted then self.aware[m.id] = true; known = true end
			end
			if known and d < bd then best, bd = m, d end
		end
	end
	return best
end
function AIPilot:gunSolution(t)
	local dir = gunLead(self.ac.pos, self.ac.vel, t.pos, t.vel, self.ac.spec.gun, 2)
	return dir
end
function AIPilot:weapons(world, t, d)
	local ac = self.ac
	if self.holdFire then return end                  -- peacetime: weapons hold (air policing)
	if d < 1100 and angleBetween(ac.forward, self:gunSolution(t)) < self.skill.gunCone * DEG then ac.trigger = true end
	if self.missileTimer > 0 then return end
	local fired = nil
	local closingT = -dot(t.vel, norm(sub(t.pos, ac.pos)))
	local function zone(key)
		local z = launchZone(ac:missileSpec(key), ac.speed, ac.pos.z, closingT)
		return z * self.skill.zone
	end
	if ac:missileCount("AIM-9M") > 0 and d > 900 and d < math.min(self.skill.maxIr, zone("AIM-9M")) then
		if ac.selected ~= "AIM-9M" then ac:select("AIM-9M")
		elseif ac.irSeeker.candidate == t or ac.irSeeker.target == t then
			if not ac.irSeeker.locked then ac.irSeeker:lock() end
			if ac.irSeeker.target == t then fired = ac:fireMissile(world) end
		end
	elseif ac:missileCount("AIM-120A") > 0 and self.skill.arh and ac.radar.mode == STT and ac.radar.locked == t then
		if d > 2500 and d < math.min(self.skill.maxArh, zone("AIM-120A")) then
			if ac.selected ~= "AIM-120A" then ac:select("AIM-120A") end
			fired = ac:fireMissile(world)
		end
	end
	if fired then self.missileTimer = self.skill.missileCd * self.rnd.uniform(0.8, 1.3) end
end
function AIPilot:fly(dt, world)
	local ac, terr = self.ac, world.terrain
	local desired, throttle, maxG = nil, 1, self.skill.g
	if self.state == "defend" and self.threat and self.threat.alive then desired, throttle, maxG = self:defend(world)
	elseif self.state == "engage" and self.target then desired, throttle = self:pursue(self.target)
	else desired, throttle = self:patrol() end
	local agl = ac.pos.z - terr:height(ac.pos.x, ac.pos.y)
	local ahead = add(ac.pos, mul(ac.vel, 4))
	local aglAhead = ahead.z - terr:height(ahead.x, ahead.y)
	if aglAhead < MIN_AGL or agl < MIN_AGL * 0.7 then
		desired = norm(add(norm(V(ac.vel.x, ac.vel.y, 0)), V(0, 0, 0.9)))
		maxG = 1
	elseif agl < 1800 and desired.z < -0.15 then
		desired = norm(V(desired.x, desired.y, -0.15))
	end
	if abs(ac.pos.x) > 42000 or abs(ac.pos.y) > 42000 then desired = norm(add(norm(V(-ac.pos.x, -ac.pos.y, 0)), mul(desired, 0.3))) end
	local a = self.area
	if a and math.sqrt((ac.pos.x - a.x) ^ 2 + (ac.pos.y - a.y) ^ 2) > a.engage + 4000 then
		desired = norm(add(norm(V(a.x - ac.pos.x, a.y - ac.pos.y, 0)), mul(desired, 0.3)))
	end
	steerTowards(ac.fm, desired, ac.controls, maxG, self.skill.precision)
	ac.controls.throttle = throttle
end
function AIPilot:pursue(t)
	local ac = self.ac
	local rel = sub(t.pos, ac.pos)
	local d = len(rel)
	local desired
	if d < 2500 then desired = self:gunSolution(t) else desired = norm(add(rel, mul(t.vel, math.min(d / 600, 6) * 0.5))) end
	local throttle = 1
	if d > 5000 or ac.speed < 190 then throttle = 1.1
	elseif d < 900 and -dot(sub(t.vel, ac.vel), norm(rel)) > 80 then throttle = 0.6 end
	return desired, throttle
end
function AIPilot:defend(world)
	local ac, m = self.ac, self.threat
	local los = sub(m.pos, ac.pos)
	local d = len(los)
	local flat = norm(V(los.x, los.y, 0))
	local perp = V(-flat.y, flat.x, 0)
	if dot(perp, ac.vel) < 0 then perp = mul(perp, -1) end
	local agl = ac.pos.z - world.terrain:height(ac.pos.x, ac.pos.y)
	local useCm = self.rnd() < self.skill.cm * 0.25
	if m.spec.guidance == ARH then
		if d < 14000 and useCm then ac:dispense(world) end
		return norm(add(perp, V(0, 0, agl > 2500 and -0.25 or 0))), 1, self.skill.g
	end
	if d < 3500 then
		if useCm or d < 1500 then ac:dispense(world) end
		return norm(add(sub(perp, mul(flat, 0.3)), V(0, 0, -0.1))), 0.65, 1
	end
	return norm(add(mul(flat, -1), V(0, 0, -0.05))), 1.1, self.skill.g
end
function AIPilot:patrol()
	local ac = self.ac
	local to = sub(self.waypoint, ac.pos)
	if len(V(to.x, to.y, 0)) < 3000 then self.waypoint = self:patrolPoint() end
	local climb = clamp((self.patrolAlt - ac.pos.z) / 3000, -0.3, 0.3)
	return norm(add(norm(V(to.x, to.y, 0)), V(0, 0, climb))), 0.95
end

-- The player's wingman: flies in formation (behind and to the right) until an enemy comes within reach of the lead,
-- then fights it like any AI pilot, and comes back to the formation when the sky is clear.
local WING_REACH = 26000
local Wingman = setmetatable({}, { __index = AIPilot })
Wingman.__index = Wingman
function A.newWingmanPilot(ac, lead)
	local p = setmetatable({}, Wingman)
	initAI(p, ac, "wing", nil)
	p.lead, p.order = lead, "free"
	return p
end
function Wingman:fair(t)
	local l = self.lead
	if not l or not l.alive then return true end
	if self.order == "rejoin" then return false end
	if self.order == "engage" then return true end
	return len(sub(t.pos, l.pos)) < (self.order == "cover" and 6000 or WING_REACH)
end
function Wingman:think(world)
	AIPilot.think(self, world)
	local l = self.lead
	if self.order == "engage" and l and l.radar and l.radar.locked and l.radar.locked.alive and self.state ~= "defend" then self.target = l.radar.locked end
end
function Wingman:patrol()
	local l, ac = self.lead, self.ac
	if not l or not l.alive or l.onGround then return AIPilot.patrol(self) end
	local fwd = norm(V(l.forward.x, l.forward.y, 0), V(0, 1, 0))
	local right = V(fwd.y, -fwd.x, 0)
	local slot = add(add(l.pos, mul(fwd, -140)), mul(right, 110))
	slot.z = slot.z + 15
	local to = sub(add(slot, mul(l.vel, 1.2)), ac.pos)
	local d = len(to)
	local desired = d > 60 and norm(add(to, mul(l.vel, 1.5))) or norm(l.vel)
	local along = dot(sub(slot, ac.pos), norm(l.vel))
	local throttle = clamp(math.min(1, l.controls.throttle) + along * 0.004 + (l.speed - ac.speed) * 0.02, 0.25, 1.1)
	if d > 3000 then throttle = 1.1 end
	return desired, throttle
end

return A
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX50"><Properties><string name="Name">Flight</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Point-mass aerodynamics + fly-by-wire (G command with AoA limiter) + landing gear: the port of web/js/flight.js.
-- Everything that differs between the aircraft comes from the spec (Specs).
local M = require(script.Parent.SimMath)
local G, DEG, V = M.G, M.DEG, M.V
local add, sub, mul, dot, cross, len, norm, clamp, interp = M.add, M.sub, M.mul, M.dot, M.cross, M.len, M.norm, M.clamp, M.interp
local qaxis, qmul, fwdOf, upOf, rightOf, qheading = M.qaxis, M.qmul, M.fwdOf, M.upOf, M.rightOf, M.qheading
local sin, cos, sqrt, asin, atan2 = math.sin, math.cos, math.sqrt, math.asin, M.atan2

local R_AIR, GAMMA = 287.05, 1.4
local RHO0 = 1.225
local RHO_TROPOPAUSE = 0.36392

local F = {}
F.RHO0 = RHO0

-- the standard atmosphere: returns density, speed of sound
function F.isa(alt)
	local h = clamp(alt, 0, 32000)
	local temp, p
	if h < 11000 then
		temp = 288.15 - 0.0065 * h
		p = 101325 * (temp / 288.15) ^ 5.25588
	elseif h < 20000 then
		temp = 216.65
		p = 22632.1 * math.exp(-G * (h - 11000) / (R_AIR * temp))
	else
		temp = 216.65 + 0.001 * (h - 20000)
		p = 5474.89 * (temp / 216.65) ^ (-G / (R_AIR * 0.001))
	end
	return p / (R_AIR * temp), sqrt(GAMMA * R_AIR * temp)
end
local isa = F.isa

local CLA_MACH = { { 0, 1 }, { 0.8, 1.08 }, { 0.95, 1.12 }, { 1.1, 0.95 }, { 1.5, 0.8 }, { 2.2, 0.62 } }
local K_ALPHA, K_BETA, TAU_PITCH, TAU_ROLL, TAU_YAW = 6, 3, 0.06, 0.09, 0.12
F.MAX_AB = 1.1
local MAX_AB = F.MAX_AB
local G_ONSET = 10
local SPOOL_UP_CORE, SPOOL_DOWN_CORE, SPOOL_UP_AB, SPOOL_DOWN_AB = 0.30, 0.40, 0.07, 0.25
F.GEAR_HEIGHT = 2.05
local GEAR_HEIGHT = F.GEAR_HEIGHT
local GEAR_TIME, GEAR_CD, FLAP_CL, FLAP_CD = 4, 0.022, 0.22, 0.012
local MU_PAVED, MU_GRASS, MU_BRAKE, MAX_SINK, MAX_BANK = 0.02, 0.07, 0.45, 4.2, 12
local NWS_RATE = 0.45

-- ------------------------------------------------------------------ the controls
function F.newControls(throttle)
	return {
		pitch = 0, roll = 0, yaw = 0, throttle = throttle or 0.85, airbrake = false, brakes = false,
		postStall = false,               -- extreme mode + full aft stick: the AoA limiter lets go (Cobra)
	}
end

-- ------------------------------------------------------------------ the flight model
local FM = {}
local getters = {
	tvc = function(t) if t.extreme and t.spec.tvc then return t.spec.tvc end return nil end,
	mass = function(t) return t.spec.emptyMass + t.fuel + t.storeMass end,
	speed = function(t) return len(t.vel) end,
	forward = function(t) return fwdOf(t.quat) end,
	up = function(t) return upOf(t.quat) end,
	right = function(t) return rightOf(t.quat) end,
	afterburner = function(t) return t.engine > 1.001 and t.fuel > 0 end,
}
FM.__index = function(t, k)
	local m = FM[k]
	if m ~= nil then return m end
	local g = getters[k]
	if g then return g(t) end
	return nil
end

function F.new(spec, pos, vel, quat, fuel)
	local self = setmetatable({}, FM)
	self.spec = spec
	self.pos = pos:clone()
	self.vel = vel:clone()
	self.quat = quat:clone()
	self.omega = V()                       -- x pitch, y roll, z yaw-left (local)
	self.fuel = fuel or spec.internalFuel
	self.storeMass, self.storeCd = 0, 0
	self.engine, self.nzCmd = 0.85, 1
	self.alpha, self.beta, self.mach, self.ias, self.rho, self.qbar = 0, 0, 0, len(vel), RHO0, 0
	self.gLoad, self.thrust, self.accel = 1, 0, V()
	self.gearDown, self.gearPos, self.onGround, self.groundPitch = false, 0, false, 0
	self.contactEvent, self.crashReason, self.sinkRate, self.flaps = nil, "", 0, 0
	self.gearHeight = spec.gearHeight or GEAR_HEIGHT
	self.drag, self.fuelFlow = 0, 0
	self.extreme, self.vectorAngle = false, 0        -- F-16 extreme mode: thrust vectoring on
	return self
end

function FM:placeOnGround(x, y, groundZ, headingDeg)
	self.pos = V(x, y, groundZ + self.gearHeight)
	self.vel = V()
	self.quat = qheading(headingDeg, 0)
	self.omega = V()
	self.gearDown, self.gearPos, self.onGround, self.groundPitch, self.engine, self.nzCmd = true, 1, true, 0, 0, 1
	self.groundZ, self.arrest, self.catapultAcc = groundZ, 0, 0
end

function FM:setGear(down)
	if not down and self.onGround then return false end
	self.gearDown = down
	return true
end

function FM:liftCoefficient(alpha, mach)
	local s = self.spec
	local cla = s.clAlpha * interp(CLA_MACH, mach)
	local a = math.abs(alpha)
	local stall = s.alphaStall * DEG
	local tvc = self.tvc
	local clMax = tvc and tvc.clMax or s.clMax
	local cl
	if a <= stall then
		cl = math.min(cla * a, clMax)
	else
		local peak = math.min(cla * stall, clMax)
		local t = clamp((a - stall) / (15 * DEG), 0, 1)
		cl = peak * (1 - t) + 0.95 * sin(2 * math.min(a, math.pi - a)) * t
	end
	return M.sign(alpha ~= 0 and alpha or 1) * cl
end

function FM:thrustAt(setting, rho, mach)
	local s = self.spec
	if self.fuel <= 0 then return 0 end
	local lapse
	if rho >= RHO_TROPOPAUSE then lapse = (rho / RHO0) ^ 0.75
	else lapse = (RHO_TROPOPAUSE / RHO0) ^ 0.75 * (rho / RHO_TROPOPAUSE) ^ 1.25 end
	local dry = s.thrustDry * (0.04 + 0.96 * math.min(setting, 1) ^ 1.6) * lapse * (1 + 0.02 * mach)
	if setting <= 1 then return dry end
	local ab = clamp((setting - 1) / (MAX_AB - 1), 0, 1)
	return dry + (s.thrustAb * lapse * (1 + 0.3 * mach) - dry) * ab
end

function FM:spool(target, dt)
	local e = self.engine
	if target > e then
		if e < 1 then e = math.min(e + SPOOL_UP_CORE * (0.45 + 0.55 * e) * dt, math.min(target, 1))
		elseif self.fuel > 0 then e = math.min(e + SPOOL_UP_AB * dt, target) end
	elseif target < e then
		e = math.max(e - (e > 1 and SPOOL_DOWN_AB or SPOOL_DOWN_CORE) * dt, target)
	end
	self.engine = e
end

function FM:step(dt, c, terrain)
	local s = self.spec
	local fwd, up, right = self.forward, self.up, self.right
	local rho, aSound = isa(self.pos.z)
	local speed = self.speed
	local vhat = speed > 1 and mul(self.vel, 1 / speed) or fwd:clone()
	local alpha = speed > 1 and atan2(-dot(self.vel, up), dot(self.vel, fwd)) or 0
	local beta = asin(clamp(dot(self.vel, right) / math.max(speed, 1), -1, 1))
	local mach = speed / aSound
	local qbar = 0.5 * rho * speed * speed
	local mass = self.mass

	self:spool(clamp(c.throttle, 0, s.noAB and 1 or MAX_AB), dt)       -- turboprop / plain turbofan trainers: no afterburner
	local tv = self.tvc
	local thrust = self:thrustAt(self.engine, rho, mach) * (tv and tv.thrustScale or 1)
	self.thrust = thrust
	local sfc = self.engine <= 1 and s.fuelFlowDry / s.thrustDry or s.fuelFlowAb / s.thrustAb
	self.fuelFlow = thrust * sfc
	self.fuel = math.max(0, self.fuel - self.fuelFlow * dt)

	local cl = self:liftCoefficient(alpha, mach)
	local flaps = self.gearPos * clamp((125 - speed * sqrt(rho / RHO0)) / 25, 0, 1)
	self.flaps = flaps
	if flaps > 0 and alpha > -0.05 then cl = cl + FLAP_CL * flaps end
	local liftDir = norm(cross(right, vhat), up)
	local sideDir = cross(vhat, liftDir)
	local cd = s.cd0 + (s.pylonCd or 0) + interp(s.waveDrag, mach) + s.kInduced * (tv and tv.kScale or 1) * cl * cl + self.storeCd + 0.8 * sin(alpha) ^ 2
	if c.airbrake then cd = cd + s.airbrakeCd end
	cd = cd + GEAR_CD * self.gearPos + FLAP_CD * flaps
	local area = s.wingArea
	self.drag = qbar * area * cd
	-- thrust vectoring: the nozzle turns with the pitch stick, part of the thrust pushes the tail down (nose up)
	local vec = (tv and not self.onGround) and clamp(c.pitch, -1, 1) * tv.vector * DEG or 0
	self.vectorAngle = self.vectorAngle + (vec - self.vectorAngle) * math.min(1, dt * 8)
	local force = add(add(add(mul(liftDir, qbar * area * cl), mul(sideDir, -qbar * area * 1.1 * beta)),
		mul(vhat, -qbar * area * cd)), add(mul(fwd, thrust * cos(self.vectorAngle)), mul(up, thrust * sin(self.vectorAngle))))
	local acc = add(mul(force, 1 / mass), V(0, 0, -G))

	-- landing gear
	local target = self.gearDown and 1 or 0
	self.gearPos = self.gearPos + clamp(target - self.gearPos, -dt / GEAR_TIME, dt / GEAR_TIME)
	self.contactEvent = nil
	if terrain then
		local groundZ = terrain:height(self.pos.x, self.pos.y)
		local tele = { force = force, mass = mass, alpha = alpha, mach = mach, rho = rho, qbar = qbar, speed = speed }
		if self.onGround then self:groundStep(dt, c, acc, terrain, tele) return end
		if self.pos.z - groundZ <= self.gearHeight then
			if self:touchdown(groundZ, terrain) then self:groundStep(dt, c, acc, terrain, tele) end
			return
		end
	end

	-- FLCS pitch: G command with AoA limiter and onset limit
	local stick = clamp(c.pitch, -1, 1)
	local nz = stick >= 0 and 1 + stick * (s.gMax - 1) or 1 + stick * (1 - s.gMin)
	self.nzCmd = self.nzCmd + clamp(nz - self.nzCmd, -G_ONSET * dt, G_ONSET * dt)
	nz = self.nzCmd
	local claEff = s.clAlpha * interp(CLA_MACH, mach)
	-- AoA limit: normal, or in extreme mode 30 degrees (the mouse instructor) / 80 with full aft stick (Cobra)
	local alphaLim = (tv and (c.postStall and tv.alphaPostStall or tv.alphaNormal) or s.alphaLimit) * DEG
	local alphaReq
	if qbar > 1 then alphaReq = nz * mass * G / (qbar * area * claEff) else alphaReq = alphaLim * (nz > 0 and 1 or -1) end
	alphaReq = clamp(alphaReq, -10 * DEG, alphaLim)
	-- Cobra: below ~600 km/h a full pull with vectored thrust throws the nose straight up to the limit
	if tv and c.postStall and speed < 170 then alphaReq = alphaLim end
	local vSafe = math.max(speed, 30)
	local pathPitch = dot(acc, liftDir) / vSafe
	local pathLat = dot(acc, sideDir) / vSafe
	-- the vectored nozzle keeps pitch and roll authority even when the air is too slow for the tail
	local authority = clamp(qbar / 9000 + (tv and tv.lowSpeedAuthority or 0), 0.12, 1)
	local qMax = tv and tv.pitchRate or 0.9
	local qCmd = clamp(pathPitch + K_ALPHA * (alphaReq - alpha) * authority, -qMax, qMax)
	local rollEff = clamp(qbar / 9000 + (tv and tv.lowSpeedAuthority * 0.5 or 0), 0.15, 1) * (1 - 0.5 * clamp(alpha / alphaLim, 0, 1))
	local pCmd = clamp(c.roll, -1, 1) * (tv and tv.rollRate or s.rollRate) * DEG * rollEff
	local betaCmd = -clamp(c.yaw, -1, 1) * s.yawBeta * DEG
	local rCmd = pathLat + K_BETA * (beta - betaCmd) * authority
	self.omega.x = self.omega.x + (qCmd - self.omega.x) * math.min(1, dt / TAU_PITCH)
	self.omega.y = self.omega.y + (pCmd - self.omega.y) * math.min(1, dt / TAU_ROLL)
	self.omega.z = self.omega.z + (-rCmd - self.omega.z) * math.min(1, dt / TAU_YAW)

	self.vel:addScaled(acc, dt)
	self.pos:addScaled(self.vel, dt)
	local rot = mul(self.omega, dt)
	local ang = len(rot)
	if ang > 1e-9 then
		self.quat = qmul(self.quat, qaxis(rot, ang))
		self.quat:normalize()
	end

	self.alpha, self.beta, self.mach, self.rho, self.qbar = alpha, beta, mach, rho, qbar
	self.ias = speed * sqrt(rho / RHO0)
	self.accel = acc
	self.gLoad = dot(mul(force, 1 / mass), up) / G
end

function FM:touchdown(groundZ, terrain)
	local fwd, s = self.forward, self.spec
	local pitch = asin(clamp(fwd.z, -1, 1)) / DEG
	local r = self.right
	local bank = atan2(-r.z, self.up.z) / DEG
	self.sinkRate = math.max(0, -self.vel.z)
	local reason = ""
	local tail = s.tailStrike or 13
	if self.gearPos < 0.98 then
		reason = self.gearPos < 0.1 and "futómű nélkül értél földet" or "a futómű nem volt kint"
	elseif self.sinkRate > MAX_SINK then reason = string.format("túl kemény földetérés (%.1f m/s)", self.sinkRate)
	elseif math.abs(bank) > MAX_BANK then reason = "szárnyvéggel értél földet"
	elseif pitch < -3 then reason = "orral értél földet"
	elseif pitch > tail + 7 then reason = "farokkal értél földet"
	elseif terrain:slope(self.pos.x, self.pos.y) > 6 * DEG then reason = "egyenetlen terep"
	elseif terrain.isWater and terrain.isWater(self.pos.x, self.pos.y) then reason = "a tengerbe csapódtál" end
	if reason ~= "" then
		self.contactEvent, self.crashReason = "crash", reason
		self.pos.z = groundZ + 1
		return false
	end
	self.onGround = true
	self.contactEvent = pitch > tail + 2 and "tailstrike" or "touchdown"
	self.groundPitch = math.max(0, pitch) * DEG
	self.omega = V()
	self.nzCmd = 1
	self.pos.z = groundZ + self.gearHeight
	self.vel.z = 0
	self.groundZ = groundZ
	return true
end

function FM:groundStep(dt, c, acc, terrain, t)
	local fwd = self.forward
	local heading = atan2(fwd.x, fwd.y)
	local hDir = V(sin(heading), cos(heading), 0)
	local hRight = V(hDir.y, -hDir.x, 0)
	local normal = 0
	if acc.z < 0 then normal = -acc.z; acc.z = 0 end
	local paved = true
	if terrain.airfield then paved = terrain.airfield:onPaved(self.pos.x, self.pos.y) end
	local mu = (paved and MU_PAVED or MU_GRASS) + ((c.brakes or self.parkBrake) and MU_BRAKE or 0)
	local u, w = dot(self.vel, hDir), dot(self.vel, hRight)
	if math.abs(u) > 1e-3 then
		local decel = math.min(mu * normal, math.abs(u) / dt)
		acc:addScaled(hDir, -M.sign(u) * decel)
	elseif normal > 0 then
		local along, hold = dot(acc, hDir), mu * normal
		acc:addScaled(hDir, -(math.abs(along) <= hold and along or M.sign(along) * hold))
	end
	-- carrier: the catapult shuttle pulls forward, the arresting wire holds back (set by the game)
	if self.catapultAcc and self.catapultAcc ~= 0 then acc:addScaled(hDir, self.catapultAcc) end
	if self.arrest and self.arrest ~= 0 then
		if u > 1.2 then acc:addScaled(hDir, -math.min(self.arrest, u / dt)) else self.arrest = 0 end
	end
	local grip = 0.8 * normal
	acc:addScaled(hRight, -clamp(w / math.max(dt, 0.02), -grip, grip))

	local gs = math.max(math.abs(u), 0.1)
	local nws = self.groundPitch < 2 * DEG and NWS_RATE * math.min(1, 8 / gs) or 0
	local yawRate = clamp(c.yaw, -1, 1) * (nws + 0.03 * math.min(gs / 60, 1)) * (gs > 0.3 and 1 or 0)
	local ias = t.speed * sqrt(t.rho / RHO0)
	local rotateIas = self.spec.rotateIas or 60
	local auth = clamp((ias - rotateIas) / 12, 0, 1)
	local tailStrike = self.spec.tailStrike or 13
	local stick = clamp(c.pitch, -1, 1)
	local pitchRate = stick > 0 and stick * 7 * DEG * auth or 0
	if pitchRate <= 0 then pitchRate = -3.5 * DEG end
	if self.catapultAcc and self.catapultAcc ~= 0 and ias > rotateIas - 4 then pitchRate = math.max(pitchRate, 9 * DEG) end   -- catapult: hands-off rotation
	self.groundPitch = clamp(self.groundPitch + pitchRate * dt, 0, tailStrike * DEG)

	self.vel:addScaled(acc, dt)
	self.pos:addScaled(self.vel, dt)
	heading = heading + yawRate * dt
	self.quat = qheading(heading / DEG, self.groundPitch / DEG)
	self.omega = V(self.groundPitch > 0 and pitchRate or 0, 0, 0)
	local ng = terrain:height(self.pos.x, self.pos.y)
	if self.groundZ ~= nil and self.groundZ - ng > 3 then
		-- rolled off an edge (the carrier's deck): from here it flies - or falls
		self.onGround, self.groundZ, self.catapultAcc = false, nil, 0
		self.alpha, self.mach, self.rho, self.qbar, self.ias, self.accel = t.alpha, t.mach, t.rho, t.qbar, ias, acc
		return
	end
	self.groundZ = ng
	if normal == 0 and self.vel.z > 0 then
		if self.pos.z > ng + self.gearHeight + 0.3 then self.onGround = false; self.groundZ = nil end
	else
		self.pos.z = ng + self.gearHeight
		self.vel.z = 0
	end
	self.alpha, self.beta, self.mach, self.rho, self.qbar = t.alpha, 0, t.mach, t.rho, t.qbar
	self.ias, self.accel = ias, acc
	self.gLoad = dot(mul(t.force, 1 / t.mass), self.up) / G + normal / G
end

return F
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX51"><Properties><string name="Name">Sim</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Aircraft + World: the port of web/js/sim.js.  The simulation steps at 100 Hz (PHYS_DT), the sensors at 30 Hz, the AI at 10 Hz.
local M = require(script.Parent.SimMath)
local Flight = require(script.Parent.Flight)
local Specs = require(script.Parent.Specs)
local Weapons = require(script.Parent.Weapons)
local V, add, sub, mul, len, copy, norm, qheading, xform, DEG = M.V, M.add, M.sub, M.mul, M.len, M.copy, M.norm, M.qheading, M.xform, M.DEG
local IR, ARH, MISSILES = Specs.IR, Specs.ARH, Specs.MISSILES
local STT = Weapons.STT

local S = {}
local STORE_DRAG_AREA = 0.031                       -- m^2 of drag area per missile with its launcher
local ASSIST_IR_FOV, ASSIST_IR_CONE = 10, 30        -- player lock assist: seeker search cone / F-key cone (deg)
S.PHYS_DT, S.SENSOR_DT, S.AI_DT = 1 / 100, 1 / 30, 1 / 10
local PHYS_DT, SENSOR_DT, AI_DT = S.PHYS_DT, S.SENSOR_DT, S.AI_DT

-- ------------------------------------------------------------------ the aircraft
local Aircraft = {}
local getters = {
	pos = function(t) return t.fm.pos end,
	vel = function(t) return t.fm.vel end,
	quat = function(t) return t.fm.quat end,
	forward = function(t) return t.fm.forward end,
	speed = function(t) return t.fm.speed end,
	mach = function(t) return t.fm.mach end,
	engineSetting = function(t) return t.alive and t.fm.engine or 0 end,
	damaged = function(t) return t.hp < t.spec.hp * 0.5 end,
	onGround = function(t) return t.fm.onGround end,
	selectedSpec = function(t) return t.selected and t:missileSpec(t.selected) or nil end,
	extreme = function(t) return t.fm.extreme end,
	bayOpenAny = function(t)
		if not t.spec.bays then return 0 end
		return math.max(t:bayOpen("main"), t:bayOpen("side_L"), t:bayOpen("side_R"))
	end,
}
Aircraft.__index = function(t, k)
	local m = Aircraft[k]
	if m ~= nil then return m end
	local g = getters[k]
	if g then return g(t) end
	return nil
end

-- opts: isPlayer, livery, rnd, loadout (a name or { station = weapon }), missiles, lockAssist, blastMult, ...
function S.newAircraft(spec, name, team, pos, headingDeg, speed, opts)
	opts = opts or {}
	local self = setmetatable({}, Aircraft)
	self.spec, self.name, self.team = spec, name, team
	self.isPlayer = opts.isPlayer == true
	self.livery = opts.livery or "viper"
	self.rnd = opts.rnd or M.rng(math.floor(os.clock() * 1e6) % 1000000000)
	local q = qheading(headingDeg, 0)
	self.fm = Flight.new(spec, pos, mul(xform(q, V(0, 1, 0)), speed), q)
	self.fm.engine = 0.9
	self.controls = Flight.newControls(0.9)
	self.trigger = false
	self.gun = Weapons.newGun(spec.gun, self.rnd)
	self.loadout = opts.loadout or "default"
	self.stations, self.selected = {}, nil
	self.radar = Weapons.newRadar(spec.radar, self, self.rnd)
	self.missiles = opts.missiles or MISSILES          -- the player's and the enemies' missiles differ
	self.irSeeker = Weapons.newIRSeeker(self.missiles["AIM-9M"] or MISSILES["AIM-9M"], self.rnd)
	self.rwr = Weapons.newRWR(self)
	self.flares, self.chaff, self.cmHold, self.cmTimer = spec.cm.flares, spec.cm.chaff, false, 0
	self.hp, self.alive, self.burning, self.crashed, self.deathTime = spec.hp, true, false, false, nil
	self.kills, self.lastAttacker, self.lastHitTime, self.pilot = 0, nil, -1e9, nil
	self.lockAssist, self.irAutoHold = opts.lockAssist == true, 0
	self.outfit = opts.outfit
	self.skin, self.blastMult, self.tracerColor = opts.skin, opts.blastMult or 1, opts.tracerColor
	self.fm.extreme = spec.tvcAlways == true             -- the F-22's thrust vectoring is always on
	self:rearm()
	return self
end

function Aircraft:rearm()
	-- a loadout is a name from spec.loadouts or a { station = weapon } table (the menu's loadout editor)
	local layout = self.loadout
	if type(layout) ~= "table" then layout = self.spec.loadouts[layout] or self.spec.loadouts.default end
	local nums = {}
	for n in pairs(layout) do
		local ok = self.spec.stations[n] and (not self.spec.pylons[n])
		if self.spec.stations[n] and self.spec.pylons[n] then
			for _, k in ipairs(self.spec.pylons[n]) do if k == layout[n] then ok = true end end
		end
		if ok then nums[#nums + 1] = n end
	end
	table.sort(nums)
	self.stations = {}
	for _, n in ipairs(nums) do
		local m = self.spec.stations[n]
		self.stations[#self.stations + 1] = { number = n, key = layout[n], spec = self:missileSpec(layout[n]), mount = V(m[1], m[2], m[3]), loaded = true, launch = nil }
	end
	self.gun:reload()
	self.flares, self.chaff = self.spec.cm.flares, self.spec.cm.chaff
	if not self.selected or self:missileCount(self.selected) == 0 then self.selected = self.stations[1] and self.stations[1].key or nil end
	self:updateStores()
end

function Aircraft:updateStores()
	local mass, n = 0, 0
	for _, s in ipairs(self.stations) do
		if s.loaded then mass = mass + s.spec.mass; n = n + 1 end
	end
	self.fm.storeMass = mass
	self.fm.storeCd = self.spec.bays and 0 or STORE_DRAG_AREA * n / self.spec.wingArea       -- F-22: all inside
end
function Aircraft:missileCount(key)
	local n = 0
	for _, s in ipairs(self.stations) do if s.loaded and not s.launch and s.key == key then n = n + 1 end end
	return n
end
function Aircraft:weaponKeys()
	local out, seen = {}, {}
	for _, s in ipairs(self.stations) do
		if not seen[s.key] then seen[s.key] = true; out[#out + 1] = s.key end
	end
	return out
end
function Aircraft:missileSpec(key) return self.missiles[key] or MISSILES[key] end
function Aircraft:select(key)
	local has = false
	for _, k in ipairs(self:weaponKeys()) do if k == key then has = true end end
	if not has then return false end
	self.selected = key
	self.irSeeker:reset()
	return true
end
function Aircraft:toggleGear() return self.fm:setGear(not self.fm.gearDown) end
-- F-16 extreme mode (thrust vectoring); false when the jet has none
function Aircraft:toggleExtreme()
	if not self.spec.tvc or self.spec.tvcAlways then return false end
	self.fm.extreme = not self.fm.extreme
	return true
end

function Aircraft:physicsStep(dt, world)
	if self.crashed or self.ghost then return end
	if self.alive then
		self.fm:step(dt, self.controls, world.terrain)
		local ev = self.fm.contactEvent
		if ev == "crash" then self:crash(world, self.fm.crashReason); return end
		if ev == "tailstrike" then
			world:emit("message", { to = self, text = "FAROKÜTÉS!", level = "bad" })
			self:takeDamage(30, nil, "tailstrike", world)
		elseif ev == "touchdown" and self.fm.sinkRate > 3 then
			world:emit("message", { to = self, text = "KEMÉNY LANDOLÁS", level = "warn" })
		end
		self.gun:update(dt, self, self.trigger, world)
		if self.spec.bays then self:updateLaunches(dt, world) end
		self.cmTimer = self.cmTimer - dt
		if self.cmHold then self:dispense(world) end
	else
		local wreck = Flight.newControls(0)
		wreck.pitch, wreck.roll = -0.3, 0.9
		self.fm:step(dt, wreck, nil)
		self.gun.firing = false
		if self.pos.z <= world.terrain:height(self.pos.x, self.pos.y) + 1.5 then self:crash(world) end
	end
end

function Aircraft:sensorStep(dt, world)
	if not self.alive or (self.ghost and not self.slave) then return end          -- (the rear seat's copy of the pilot's jet looks round too)
	local r = self.radar
	r:update(dt, world)
	local msgs = { locked = { "RADAR LOCK", "good" }, lost = { "LOCK LOST", "warn" }, decoyed = { "LOCK LOST - CHAFF", "warn" } }
	local msg = r.lastEvent and msgs[r.lastEvent]
	if msg then world:emit("message", { to = self, text = msg[1], level = msg[2] }) end
	local sp = self.selectedSpec
	if sp and sp.guidance == IR then
		if self.irSeeker.spec ~= sp then self.irSeeker = Weapons.newIRSeeker(sp, self.rnd) end
		self.irSeeker.acqFov = self.lockAssist and ASSIST_IR_FOV or nil
		local slave = (r.mode == STT and r.trackPos) and norm(sub(r.trackPos, self.pos)) or nil
		local res = self.irSeeker:update(dt, self.pos, self.forward, world:heatSources(), world.terrain, slave, self)
		if res == "lost" then world:emit("message", { to = self, text = "SEEKER LOST", level = "warn" })
		elseif res == "decoyed" then world:emit("message", { to = self, text = "SEEKER ON FLARE", level = "warn" }) end
		if slave and not self.irSeeker.locked and self.irSeeker.candidate == r.locked then self.irSeeker:lock() end
		-- lock assist: the seeker locks by itself onto an enemy in its (wide) search cone
		self.irAutoHold = self.irAutoHold - dt
		local c = self.irSeeker.candidate
		if self.lockAssist and self.irAutoHold <= 0 and not self.irSeeker.locked and c and not c.isFlare and c.team ~= self.team then
			self.irSeeker:lock()
			world:emit("message", { to = self, text = "SEEKER LOCK - Space: indítás", level = "good" })
		end
	end
	self.rwr:update(world)
end

function Aircraft:toggleIrLock(world)
	local sp = self.selectedSpec
	if not sp or sp.guidance ~= IR then return false end
	if self.irSeeker.locked then
		self.irSeeker:unlock()
		self.irAutoHold = 3
		return false
	end
	if self.lockAssist and world and not self.irSeeker.candidate then
		-- nothing in the seeker: look for the hottest enemy within a wide cone around the nose
		local s = self.irSeeker:bestInCone(self.pos, self.forward, world:heatSources(), ASSIST_IR_CONE * DEG, world.terrain, self)
		if s and not s.isFlare and s.team ~= self.team then self.irSeeker.candidate = s end
	end
	return self.irSeeker:lock()
end

function Aircraft:fireMissile(world)
	if not self.alive or not self.selected then return nil end
	local byNum = {}
	for _, s in ipairs(self.stations) do byNum[s.number] = s end
	local st = nil
	for _, n in ipairs(self.spec.firingOrder) do
		local s = byNum[n]
		if s and s.loaded and not s.launch and s.key == self.selected then st = s; break end
	end
	if not st then
		world:emit("message", { to = self, text = "NINCS TÖBB " .. self.selected, level = "warn" })
		return nil
	end
	local sp = st.spec
	local target, axis = nil, nil
	if sp.guidance == IR then
		target = self.irSeeker.target
		axis = self.irSeeker.axis and self.irSeeker.axis:clone() or nil
	else
		target = self.radar.mode == STT and self.radar.locked or nil
	end
	if self.spec.bays then
		-- internal bay: the door opens and the launcher swings the missile out first (updateLaunches)
		st.launch = { t = 0, target = target, axis = axis, released = false, timing = self.spec.launch[st.key] }
		if sp.guidance == IR then self.irSeeker:reset() end
		self:afterLaunch()
		return { spec = sp, pending = true }
	end
	local m = self:release(st, target, axis, world, math.abs(st.mount.x) > 4.5 and 0 or 4)
	if sp.guidance == IR then self.irSeeker:reset() end
	self:afterLaunch()
	return m
end
-- the rear seat shoots: a missile of the given kind at the given target, whatever the radar of the jet says (nil: not launched)
function Aircraft:fireFrom(world, key, target)
	if not self.alive or self.ejected then return nil end
	local byNum = {}
	for _, s in ipairs(self.stations) do byNum[s.number] = s end
	local st = nil
	for _, n in ipairs(self.spec.firingOrder) do
		local s = byNum[n]
		if s and s.loaded and not s.launch and s.key == key then st = s; break end
	end
	if not st then return nil end
	if target and (not target.alive or target.team == self.team) then target = nil end
	local sp = st.spec
	local axis = nil
	if sp.guidance == IR and target then axis = norm(sub(target.pos, self.pos)) end
	if self.spec.bays then
		st.launch = { t = 0, target = target, axis = axis, released = false, timing = self.spec.launch[st.key] }
		self:afterLaunch()
		return { spec = sp, pending = true }
	end
	local m = self:release(st, target, axis, world, math.abs(st.mount.x) > 4.5 and 0 or 4)
	self:afterLaunch()
	return m
end
function Aircraft:release(st, target, axis, world, eject)
	local q = self.quat
	local pos = add(self.pos, xform(q, st.mount))
	local vel = sub(self.vel, mul(self.fm.up, eject))
	local m = Weapons.newMissile(st.spec, self, pos, vel, self.forward, self.rnd, target, axis)
	st.loaded = false
	self:updateStores()
	world:addMissile(m)
	return m
end
function Aircraft:afterLaunch()
	if self:missileCount(self.selected) == 0 then
		for _, k in ipairs(self:weaponKeys()) do
			if self:missileCount(k) > 0 then self:select(k); break end
		end
	end
end
-- F-22 launch sequences: door open -> launcher out -> release -> launcher back -> door closed
function Aircraft:updateLaunches(dt, world)
	for _, st in ipairs(self.stations) do
		local L = st.launch
		if L then
			L.t = L.t + dt
			local T = L.timing
			if not L.released and L.t >= T.release then
				L.released = true
				local target = L.target
				if st.spec.guidance == IR and self.irSeeker.locked then target = self.irSeeker.target end
				if st.spec.guidance == ARH then target = (self.radar.mode == STT) and self.radar.locked or L.target end
				self:release(st, (target and target.alive ~= false) and target or nil, L.axis, world, T.eject)
			end
			if L.t >= T.close[2] then st.launch = nil end
		end
	end
end
-- 0..1: how far the launcher of station st is out; how open the doors of a bay group are
function Aircraft:rackOut(st)
	local L = st.launch
	if not L then return 0 end
	local T = L.timing
	local function ramp(a, b) return math.min(1, math.max(0, (L.t - a) / (b - a))) end
	if L.t < T.back[1] then return ramp(T.out[1], T.out[2]) end
	return 1 - ramp(T.back[1], T.back[2])
end
function Aircraft:bayOpen(group)
	local open = 0
	for _, st in ipairs(self.stations) do
		local L = st.launch
		if L and self.spec.bays[st.number] == group then
			local T = L.timing
			local o
			if L.t < T.close[1] then o = math.min(1, L.t / T.open)
			else o = 1 - math.min(1, (L.t - T.close[1]) / (T.close[2] - T.close[1])) end
			open = math.max(open, o)
		end
	end
	return open
end

function Aircraft:dispense(world)
	if self.cmTimer > 0 or (self.flares <= 0 and self.chaff <= 0) then return end
	self.cmTimer = self.spec.cm.interval
	local down = mul(self.fm.up, -1)
	if self.flares > 0 then
		self.flares = self.flares - 1
		local side = mul(self.fm.right, self.rnd.uniform(-12, 12))
		world:addFlare(Weapons.newFlare(add(self.pos, mul(down, 1.5)), add(add(mul(self.vel, 0.96), mul(down, 22)), side), self.spec.cm))
	end
	if self.chaff > 0 then
		self.chaff = self.chaff - 1
		world:addChaff(Weapons.newChaff(add(self.pos, mul(down, 1.5)), self.vel, self.spec.cm))
	end
end

function Aircraft:takeDamage(amount, source, weapon, world)
	if not self.alive then return end
	if self.invulnerable then world:emit("shielded", { target = self, source = source, weapon = weapon }); return end     -- tutorial
	self.hp = self.hp - amount
	self.lastAttacker, self.lastHitTime = source, world.time
	if self.hp < self.spec.hp * 0.3 then self.burning = true end
	if self.hp <= 0 then self:kill(world, source, weapon) end
end
function Aircraft:kill(world, killer, weapon)
	if not self.alive then return end
	self.alive, self.burning, self.hp, self.trigger, self.cmHold = false, true, 0, false, false
	self.deathTime = world.time
	if self.radar.on then self.radar:togglePower() end
	if killer and killer ~= self then killer.kills = killer.kills + 1 end
	world:emit("kill", { victim = self, killer = killer, weapon = weapon })
end
function Aircraft:crash(world, reason)
	if self.crashed then return end
	if self.alive then
		local recent = (world.time - self.lastHitTime < 30) and self.lastAttacker or nil
		if reason and reason ~= "" then world:emit("message", { to = self, text = "BALESET: " .. reason, level = "bad" }) end
		self:kill(world, recent, "crash")
	end
	self.crashed = true
	self.fm.vel = V()
	world:emit("explosion", { pos = copy(self.pos), size = 2.5, ground = true })
end

-- ------------------------------------------------------------------ the world
local World = {}
World.__index = World
function S.newWorld(terrain, seed)
	local w = setmetatable({}, World)
	w.terrain, w.rnd = terrain, M.rng(seed or 1)
	w.aircraft, w.missiles, w.bullets, w.flares, w.chaff, w.events = {}, {}, {}, {}, {}, {}
	w.time, w.acc, w.sensorAcc, w.aiAcc = 0, 0, 0, 0
	return w
end
function World:emit(kind, data) self.events[#self.events + 1] = { kind, data } end
function World:drainEvents()
	local e = self.events
	self.events = {}
	return e
end
function World:addAircraft(a) self.aircraft[#self.aircraft + 1] = a; return a end
function World:addMissile(m)
	self.missiles[#self.missiles + 1] = m
	self:emit("launch", { missile = m, shooter = m.shooter })
end
function World:addFlare(f) self.flares[#self.flares + 1] = f; self:emit("flare", { flare = f }) end
function World:addChaff(c) self.chaff[#self.chaff + 1] = c; self:emit("chaff", { chaff = c }) end
function World:heatSources()
	local out = {}
	for _, a in ipairs(self.aircraft) do
		if a.alive or (a.burning and not a.crashed) then out[#out + 1] = a end
	end
	for _, f in ipairs(self.flares) do out[#out + 1] = f end
	return out
end
function World:enemiesOf(a)
	local out = {}
	for _, o in ipairs(self.aircraft) do
		if o.team ~= a.team and o.alive then out[#out + 1] = o end
	end
	return out
end
local function filterAlive(list)
	local out = {}
	for _, x in ipairs(list) do if x.alive then out[#out + 1] = x end end
	return out
end
function World:update(frameDt)
	frameDt = math.min(frameDt, 0.1)
	self.acc = self.acc + frameDt
	local steps = 0
	while self.acc >= PHYS_DT do
		self:physics(PHYS_DT)
		self.acc = self.acc - PHYS_DT
		steps = steps + 1
		if steps >= 12 then self.acc = 0; break end
	end
	Weapons.updateBullets(self, frameDt)
	self.missiles = filterAlive(self.missiles)
	self.flares = filterAlive(self.flares)
	self.chaff = filterAlive(self.chaff)
	local keep = {}
	for _, a in ipairs(self.aircraft) do
		if a.isPlayer or not a.crashed or self.time - a.deathTime < 8 then keep[#keep + 1] = a end
	end
	self.aircraft = keep
end
function World:physics(dt)
	self.time = self.time + dt
	for _, a in ipairs(self.aircraft) do if a.pilot and a.alive then a.pilot:fly(dt, self) end end
	for _, a in ipairs(self.aircraft) do a:physicsStep(dt, self) end
	for _, m in ipairs(self.missiles) do m:update(dt, self) end
	for _, f in ipairs(self.flares) do f:update(dt) end
	for _, c in ipairs(self.chaff) do c:update(dt) end
	self.sensorAcc = self.sensorAcc + dt
	if self.sensorAcc >= SENSOR_DT then
		for _, a in ipairs(self.aircraft) do a:sensorStep(self.sensorAcc, self) end
		self.sensorAcc = 0
	end
	self.aiAcc = self.aiAcc + dt
	if self.aiAcc >= AI_DT then
		for _, a in ipairs(self.aircraft) do if a.pilot and a.alive then a.pilot:think(self) end end
		self.aiAcc = 0
	end
end
function World:detonate(m, pos, ground, selfDestruct)
	if not m.alive then return end
	m.alive = false
	local sp = m.spec
	local k = (m.shooter and m.shooter.blastMult) or 1          -- hangar mod: bigger blast
	local rLethal, rDamage = sp.lethalRadius * k, sp.damageRadius * k
	for _, ac in ipairs(self.aircraft) do
		if ac.alive then
			local d = len(sub(ac.pos, pos))
			if d < rDamage then
				local dmg = d <= rLethal and sp.damage or sp.damage * (1 - (d - rLethal) / (rDamage - rLethal))
				self:emit("hit", { target = ac, pos = copy(ac.pos), shooter = m.shooter, missile = m })
				ac:takeDamage(dmg, m.shooter, sp.name, self)
			end
		end
	end
	self:emit("explosion", { pos = copy(pos), size = (selfDestruct and 0.8 or (sp.damage >= 150 and 1.6 or 1.2)) * (k > 1 and 1.5 or 1), ground = ground or false })
	self:emit("missile_end", { missile = m })
end

return S
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX52"><Properties><string name="Name">SimMath</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The math of the flight simulation: the port of web/js/util.js (vectors, quaternions, a seeded random).  World: +X east,
-- +Y north, +Z up, SI units, exactly like the browser game.  Written in the common subset of Lua 5.4 and Luau (no compound
-- assignment, no types), so the very same file can be tested against the JavaScript original outside of Roblox.
local M = {}

M.G = 9.80665
M.DEG = math.pi / 180
local DEG = M.DEG
local atan2 = math.atan2 or function(y, x) return math.atan(y, x) end
M.atan2 = atan2
local sqrt, abs, sin, cos, acos = math.sqrt, math.abs, math.sin, math.cos, math.acos

-- ------------------------------------------------------------------ vectors
local Vec = {}
Vec.__index = Vec
local function V(x, y, z) return setmetatable({ x = x or 0, y = y or 0, z = z or 0 }, Vec) end
M.V = V
Vec.__add = function(a, b) return V(a.x + b.x, a.y + b.y, a.z + b.z) end
Vec.__sub = function(a, b) return V(a.x - b.x, a.y - b.y, a.z - b.z) end
Vec.__mul = function(a, b)
	if type(a) == "number" then return V(b.x * a, b.y * a, b.z * a) end
	return V(a.x * b, a.y * b, a.z * b)
end
Vec.__unm = function(a) return V(-a.x, -a.y, -a.z) end
function Vec:clone() return V(self.x, self.y, self.z) end
-- in place (like THREE.Vector3)
function Vec:addScaled(v, s) self.x = self.x + v.x * s; self.y = self.y + v.y * s; self.z = self.z + v.z * s; return self end
function Vec:scale(s) self.x = self.x * s; self.y = self.y * s; self.z = self.z * s; return self end
function Vec:set(x, y, z) self.x = x; self.y = y; self.z = z; return self end

function M.add(a, b) return V(a.x + b.x, a.y + b.y, a.z + b.z) end
function M.sub(a, b) return V(a.x - b.x, a.y - b.y, a.z - b.z) end
function M.mul(a, s) return V(a.x * s, a.y * s, a.z * s) end
function M.dot(a, b) return a.x * b.x + a.y * b.y + a.z * b.z end
function M.cross(a, b) return V(a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x) end
function M.len(a) return sqrt(a.x * a.x + a.y * a.y + a.z * a.z) end
function M.copy(a) return V(a.x, a.y, a.z) end
function M.norm(a, fallback)
	local l = M.len(a)
	if l > 1e-9 then return V(a.x / l, a.y / l, a.z / l) end
	if fallback then return M.copy(fallback) end
	return V(0, 1, 0)
end
local function clamp(x, lo, hi) if x < lo then return lo elseif x > hi then return hi else return x end end
M.clamp = clamp
function M.lerp(a, b, t) return a + (b - a) * t end
function M.smoothstep(e0, e1, x)
	local t = clamp((x - e0) / (e1 - e0), 0, 1)
	return t * t * (3 - 2 * t)
end
function M.sign(x) if x > 0 then return 1 elseif x < 0 then return -1 else return 0 end end
function M.angleBetween(a, b)
	local la, lb = M.len(a), M.len(b)
	if la < 1e-9 or lb < 1e-9 then return 0 end
	return acos(clamp(M.dot(a, b) / (la * lb), -1, 1))
end
-- table: a list of { x, y } pairs, 1-based
function M.interp(t, x)
	if x <= t[1][1] then return t[1][2] end
	for i = 1, #t - 1 do
		local x0, y0, x1, y1 = t[i][1], t[i][2], t[i + 1][1], t[i + 1][2]
		if x <= x1 then return y0 + (y1 - y0) * (x - x0) / (x1 - x0) end
	end
	return t[#t][2]
end

-- ------------------------------------------------------------------ quaternions (THREE.Quaternion: x, y, z, w)
local Quat = {}
Quat.__index = Quat
local function Q(x, y, z, w) return setmetatable({ x = x or 0, y = y or 0, z = z or 0, w = w or 1 }, Quat) end
M.Q = Q
function Quat:clone() return Q(self.x, self.y, self.z, self.w) end
function Quat:normalize()
	local l = sqrt(self.x * self.x + self.y * self.y + self.z * self.z + self.w * self.w)
	if l == 0 then self.x, self.y, self.z, self.w = 0, 0, 0, 1
	else l = 1 / l; self.x = self.x * l; self.y = self.y * l; self.z = self.z * l; self.w = self.w * l end
	return self
end
-- a * b (b is applied first)
local function qmul(a, b)
	return Q(a.x * b.w + a.w * b.x + a.y * b.z - a.z * b.y,
		a.y * b.w + a.w * b.y + a.z * b.x - a.x * b.z,
		a.z * b.w + a.w * b.z + a.x * b.y - a.y * b.x,
		a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z)
end
M.qmul = qmul
function M.qaxis(axis, angle)
	local a = M.norm(axis)
	local h = angle / 2
	local s = sin(h)
	return Q(a.x * s, a.y * s, a.z * s, cos(h))
end
local function xform(q, v)
	local x, y, z = v.x, v.y, v.z
	local qx, qy, qz, qw = q.x, q.y, q.z, q.w
	local ix = qw * x + qy * z - qz * y
	local iy = qw * y + qz * x - qx * z
	local iz = qw * z + qx * y - qy * x
	local iw = -qx * x - qy * y - qz * z
	return V(ix * qw + iw * -qx + iy * -qz - iz * -qy,
		iy * qw + iw * -qy + iz * -qx - ix * -qz,
		iz * qw + iw * -qz + ix * -qy - iy * -qx)
end
M.xform = xform
function M.toLocal(q, v) return xform(Q(-q.x, -q.y, -q.z, q.w), v) end
function M.fwdOf(q) return xform(q, V(0, 1, 0)) end
function M.upOf(q) return xform(q, V(0, 0, 1)) end
function M.rightOf(q) return xform(q, V(1, 0, 0)) end

-- orientation whose +Y axis points along forward and +Z as close to up as possible
function M.qlook(forward, up)
	up = up or V(0, 0, 1)
	local y = M.norm(forward)
	local u = up
	if abs(M.dot(y, u)) > 0.999 then
		if abs(y.z) > 0.5 then u = V(0, 1, 0) else u = V(0, 0, 1) end
	end
	local x = M.norm(M.cross(y, u))
	local z = M.cross(x, y)
	-- THREE.Matrix4.makeBasis(x, y, z) -> setFromRotationMatrix
	local m11, m12, m13 = x.x, y.x, z.x
	local m21, m22, m23 = x.y, y.y, z.y
	local m31, m32, m33 = x.z, y.z, z.z
	local trace = m11 + m22 + m33
	local q = Q()
	if trace > 0 then
		local s = 0.5 / sqrt(trace + 1)
		q.w = 0.25 / s; q.x = (m32 - m23) * s; q.y = (m13 - m31) * s; q.z = (m21 - m12) * s
	elseif m11 > m22 and m11 > m33 then
		local s = 2 * sqrt(1 + m11 - m22 - m33)
		q.w = (m32 - m23) / s; q.x = 0.25 * s; q.y = (m12 + m21) / s; q.z = (m13 + m31) / s
	elseif m22 > m33 then
		local s = 2 * sqrt(1 + m22 - m11 - m33)
		q.w = (m13 - m31) / s; q.x = (m12 + m21) / s; q.y = 0.25 * s; q.z = (m23 + m32) / s
	else
		local s = 2 * sqrt(1 + m33 - m11 - m22)
		q.w = (m21 - m12) / s; q.x = (m13 + m31) / s; q.y = (m23 + m32) / s; q.z = 0.25 * s
	end
	return q
end

-- compass heading (deg, clockwise from north) + pitch (deg) -> quaternion
function M.qheading(headingDeg, pitchDeg)
	pitchDeg = pitchDeg or 0
	return qmul(M.qaxis(V(0, 0, 1), -headingDeg * DEG), M.qaxis(V(1, 0, 0), pitchDeg * DEG))
end

function M.rotateTowards(cur, target, maxAngle)
	local ang = M.angleBetween(cur, target)
	if ang <= maxAngle or ang < 1e-6 then return M.copy(target) end
	local axis = M.cross(cur, target)
	if M.len(axis) < 1e-9 then
		if abs(cur.z) < 0.9 then axis = M.cross(cur, V(0, 0, 1)) else axis = M.cross(cur, V(1, 0, 0)) end
	end
	return M.norm(xform(M.qaxis(axis, maxAngle), cur))
end

-- closest approach of a relative position / velocity within dt: returns distance, time
function M.closestApproach(pRel, vRel, dt)
	local vv = M.dot(vRel, vRel)
	local t = 0
	if vv > 1e-9 then t = clamp(-M.dot(pRel, vRel) / vv, 0, dt) end
	return M.len(pRel + vRel * t), t
end

function M.headingDeg(v) return ((atan2(v.x, v.y) / DEG) % 360 + 360) % 360 end
function M.bankAngle(q)
	local r, u = M.rightOf(q), M.upOf(q)
	return atan2(-r.z, u.z)
end
function M.wrap(a)
	return ((((a + math.pi) % (2 * math.pi)) + 2 * math.pi) % (2 * math.pi)) - math.pi
end

-- ------------------------------------------------------------------ seeded random (mulberry32), 32-bit arithmetic by hand
local TWO32 = 4294967296
local function imul(a, b)                         -- the low 32 bits of a * b (unsigned 32 bit a, b)
	local ah, al = math.floor(a / 65536), a % 65536
	local bh, bl = math.floor(b / 65536), b % 65536
	return (al * bl + ((ah * bl + al * bh) % 65536) * 65536) % TWO32
end
local function bitop(a, b, f)
	local r, bit = 0, 1
	for _ = 1, 32 do
		if f(a % 2, b % 2) then r = r + bit end
		a = math.floor(a / 2); b = math.floor(b / 2); bit = bit * 2
	end
	return r
end
local function bxor(a, b) return bitop(a, b, function(x, y) return x ~= y end) end
local function bor(a, b) return bitop(a, b, function(x, y) return x == 1 or y == 1 end) end
local function rshift(a, n) return math.floor(a / 2 ^ n) end
-- rng(seed) returns r with r() in [0, 1), r.uniform(lo, hi), r.gauss(mu, sigma) - the same sequence as the JavaScript one
function M.rng(seed)
	local a = (seed or 1) % TWO32
	local function step()
		a = (a + 0x6d2b79f5) % TWO32
		local t = a
		t = imul(bxor(t, rshift(t, 15)), bor(t, 1))
		t = bxor(t, (t + imul(bxor(t, rshift(t, 7)), bor(t, 61))) % TWO32)
		return bxor(t, rshift(t, 14)) / TWO32
	end
	local obj = setmetatable({}, { __call = function() return step() end })
	function obj.uniform(lo, hi) return lo + (hi - lo) * step() end
	function obj.gauss(mu, sigma)
		mu = mu or 0
		sigma = sigma or 1
		local u = math.max(step(), 1e-12)
		local v = step()
		return mu + sigma * sqrt(-2 * math.log(u)) * cos(2 * math.pi * v)
	end
	return obj
end

return M
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX53"><Properties><string name="Name">SimTerrain</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The height field and the home air base of the game: the port of web/js/terrain.js.  heights: a 1-based array of
-- (res+1)^2 numbers in metres, row after row (rows from the south, columns from the west), exactly the game's grid.
local M = require(script.Parent.SimMath)
local clamp, sqrt, atan = M.clamp, math.sqrt, math.atan

local T = {}
T.RUNWAY_LENGTH, T.RUNWAY_WIDTH, T.TAXIWAY_OFFSET, T.TAXIWAY_WIDTH = 3000, 45, 190, 23
T.APRON = { 260, 520, -350, 350 }

-- ------------------------------------------------------------------ the air base
local Airfield = {}
Airfield.__index = function(t, k)
	if k == "southThreshold" then return t.y - T.RUNWAY_LENGTH / 2 end
	return Airfield[k]
end
function T.newAirfield(x, y, elevation) return setmetatable({ x = x, y = y, elevation = elevation }, Airfield) end
function Airfield:onRunway(x, y, margin)
	margin = margin or 0
	return math.abs(x - self.x) <= T.RUNWAY_WIDTH / 2 + margin and math.abs(y - self.y) <= T.RUNWAY_LENGTH / 2 + margin
end
function Airfield:onPaved(x, y)
	local dx, dy = x - self.x, y - self.y
	if self:onRunway(x, y, 3) then return true end
	if math.abs(dx - T.TAXIWAY_OFFSET) <= T.TAXIWAY_WIDTH / 2 and math.abs(dy) <= T.RUNWAY_LENGTH / 2 then return true end
	for _, cy in ipairs({ -T.RUNWAY_LENGTH / 2 + 60, 0, T.RUNWAY_LENGTH / 2 - 60 }) do
		if dx >= 0 and dx <= T.TAXIWAY_OFFSET and math.abs(dy - cy) <= T.TAXIWAY_WIDTH / 2 then return true end
	end
	local x0, x1, y0, y1 = T.APRON[1], T.APRON[2], T.APRON[3], T.APRON[4]
	return dx >= x0 - 70 and dx <= x1 and dy >= y0 and dy <= y1
end
function Airfield:startPosition() return { self.x, self.southThreshold + 120, 0 } end

-- ------------------------------------------------------------------ the terrain
local Terrain = {}
Terrain.__index = Terrain

-- data: { size, res, heights (1-based, metres, (res+1)^2 values), airfield = { x, y, elevation } }
function T.new(data)
	local self = setmetatable({}, Terrain)
	self:load(data)
	return self
end

function Terrain:load(data)
	self.size = data.size
	self.res = data.res
	self.n = data.res + 1
	self.cell = self.size / self.res
	self.half = self.size / 2
	self.grid = data.heights
	local mx = -1e9
	for i = 1, #self.grid do if self.grid[i] > mx then mx = self.grid[i] end end
	self.maxHeight = mx
	local a = data.airfield
	self.airfield = T.newAirfield(a.x, a.y, a.elevation)
end

-- i, j are 0-based like the original
function Terrain:at(i, j) return self.grid[j * self.n + i + 1] end

function Terrain:rawHeight(x, y)
	local gx, gy = (x + self.half) / self.cell, (y + self.half) / self.cell
	if gx < 0 or gy < 0 or gx >= self.res or gy >= self.res then return -220 end
	local i, j = math.floor(gx), math.floor(gy)
	local fx, fy = gx - i, gy - j
	local n, g = self.n, self.grid
	local k = j * n + i + 1
	local h0 = g[k] + (g[k + 1] - g[k]) * fx
	local h1 = g[k + n] + (g[k + n + 1] - g[k + n]) * fx
	return h0 + (h1 - h0) * fy
end

function Terrain:height(x, y) return math.max(self:rawHeight(x, y), 0) end

function Terrain:slope(x, y, d)
	d = d or 6
	local gx = (self:height(x + d, y) - self:height(x - d, y)) / (2 * d)
	local gy = (self:height(x, y + d) - self:height(x, y - d)) / (2 * d)
	return atan(sqrt(gx * gx + gy * gy))
end

function Terrain:lineOfSight(a, b, samples)
	samples = samples or 12
	if a.z > self.maxHeight and b.z > self.maxHeight then return true end
	for k = 1, samples - 1 do
		local t = k / samples
		local z = a.z + (b.z - a.z) * t
		if z < self.maxHeight and z < self:height(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t) then return false end
	end
	return true
end

function Terrain:clampInside(x, y, margin)
	margin = margin or 8000
	local lim = self.half - margin
	return clamp(x, -lim, lim), clamp(y, -lim, lim)
end

return T
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX54"><Properties><string name="Name">SpecData</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- GENERATED by tools/gen_specs_lua.mjs from web/js/specs.js - do not edit by hand.
-- The aircraft, missile, radar, gun and countermeasure data of the game (arrays are 1-based, station numbers are keys).
return {
	IR = "IR",
	ARH = "ARH",
	MISSILES = {
		["AIM-9M"] = {
			name = "AIM-9M",
			guidance = "IR",
			mass = 86,
			propellant = 22,
			diameter = 0.127,
			length = 2.87,
			motor = {
				{ 5, 9200 }
			},
			cd = {
				{ 0.5, 0.36 },
				{ 0.9, 0.42 },
				{ 1.1, 0.72 },
				{ 1.6, 0.6 },
				{ 2.5, 0.48 },
				{ 4, 0.4 }
			},
			cnMax = 18,
			maxG = 30,
			inducedDrag = 0.16,
			navGain = 4,
			guidanceDelay = 0.2,
			guidanceTime = 60,
			armTime = 0.6,
			fuseRadius = 6,
			lethalRadius = 4,
			damageRadius = 14,
			damage = 140,
			seekerFov = 2.5,
			gimbal = 40,
			trackRate = 30,
			seekerRange = 9000,
			ccm = 0.65,
			minRange = 400,
			datalink = false,
			loft = false,
			smoke = 0.35,
			railTime = 0.25,
			refArea = 0.012667686977437444,
			burnTime = 5
		},
