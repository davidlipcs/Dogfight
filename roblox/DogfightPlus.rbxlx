<Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">IslandMath</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The island's heights at any point (shared by the terrain builder, the world and the spawn code): the game's metres
-- become studs (Config.Island), the game's north (+y) is Roblox's -Z.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Island = require(Shared.Island)

local IslandMath = {}

local S, VS = Config.Island.StudsPerMeter, Config.Island.HeightScale
local heights = nil          -- [j][i] metres (j = rows from the south, i = columns from the west)
local mats = nil             -- the material digits (a string, row after row)

local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local lookup = {}
for i = 1, #alphabet do lookup[string.byte(alphabet, i)] = i - 1 end

-- base64 -> a list of bytes
local function decode(s: string)
	local out, n = {}, 0
	local acc, bits = 0, 0
	for i = 1, #s do
		local v = lookup[string.byte(s, i)]
		if v then
			acc = acc * 64 + v
			bits += 6
			if bits >= 8 then
				bits -= 8
				local div = 2 ^ bits
				local byte = math.floor(acc / div)
				acc -= byte * div
				n += 1
				out[n] = byte
			end
		end
	end
	return out
end

function IslandMath.load()
	if heights then return end
	local N = Island.N
	heights = {}
	local j = 0
	for _, name in { "IslandH1", "IslandH2", "IslandH3" } do
		local bytes = decode(require(ReplicatedStorage.Shared[name]))
		local k = 1
		for _ = 1, Island.HeightRows do
			j += 1
			local row = table.create(N)
			for i = 1, N do
				row[i] = (bytes[k] + bytes[k + 1] * 256) * Island.Unit - Island.Offset
				k += 2
			end
			heights[j] = row
		end
	end
	mats = require(ReplicatedStorage.Shared.IslandM)
end

-- metres of height at a point given as cell coordinates (fractional, 0 .. N-1)
local function cellHeight(fi: number, fj: number): number
	local N = Island.N
	fi = math.clamp(fi, 0, N - 1)
	fj = math.clamp(fj, 0, N - 1)
	local i0, j0 = math.floor(fi), math.floor(fj)
	local i1, j1 = math.min(i0 + 1, N - 1), math.min(j0 + 1, N - 1)
	local tx, ty = fi - i0, fj - j0
	local h = heights
	local a = h[j0 + 1][i0 + 1] * (1 - tx) + h[j0 + 1][i1 + 1] * tx
	local b = h[j1 + 1][i0 + 1] * (1 - tx) + h[j1 + 1][i1 + 1] * tx
	return a * (1 - ty) + b * ty
end

-- studs (X, Z) -> cell coordinates
function IslandMath.cellOf(X: number, Z: number)
	local cell = Island.SizeMeters / Island.N
	local mx, my = X / S, -Z / S
	return (mx + Island.SizeMeters / 2) / cell - 0.5, (my + Island.SizeMeters / 2) / cell - 0.5
end

-- the ground height in studs under (X, Z); the sea is 0
function IslandMath.height(X: number, Z: number): number
	IslandMath.load()
	local fi, fj = IslandMath.cellOf(X, Z)
	return math.max(cellHeight(fi, fj), 0) * VS
end

-- the ground material digit (1 grass, 2 leafy, 3 ground, 4 rock, 5 sand, 6 snow) of the cell under (X, Z)
function IslandMath.material(X: number, Z: number): number
	IslandMath.load()
	local fi, fj = IslandMath.cellOf(X, Z)
	local N = Island.N
	local i, j = math.clamp(math.floor(fi + 0.5), 0, N - 1), math.clamp(math.floor(fj + 0.5), 0, N - 1)
	return string.byte(mats, j * N + i + 1) - 48
end

-- the air base in studs: its centre on the ground, the runway runs north - south (along Z)
function IslandMath.airfield()
	local a = Island.Airfield
	local X, Z = a.x * S, -a.y * S
	return Vector3.new(X, a.elevation * VS, Z)
end

return IslandMath
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">JetBuilder</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Builds a fighter out of plain parts (no meshes, so nothing to upload): the same model flies in the game,
-- sits in the hangar preview and carries the bought paint scheme and the pilot's outfit.
-- The nose points to -Z (LookVector), like every Roblox model.
local Catalog = require(script.Parent.Catalog)
local Config = require(script.Parent.Config)
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local JetBuilder = {}

local function color(n: number): Color3
	return Color3.fromRGB(bit32.band(bit32.rshift(n, 16), 255), bit32.band(bit32.rshift(n, 8), 255), bit32.band(n, 255))
end
JetBuilder.color = color

local DEFAULT = { color = 0x8d949c, emissive = 0x000000, pcolor = 0x4b5258 }
local ENEMY = { color = 0x4a3a3a, emissive = 0x000000, pattern = "splinter", pcolor = 0x2a1f1f, rough = 0.8 }
JetBuilder.EnemySkin = ENEMY

-- a small seeded generator: a scheme always gets the same pattern
local function seeded(id: string)
	local h = 2166136261
	for i = 1, #id do
		h = bit32.bxor(h, string.byte(id, i))
		h = (h * 16777619) % 4294967296
	end
	local a = h
	return function()
		a = (a * 1664525 + 1013904223) % 4294967296
		return a / 4294967296
	end
end

local function newPart(parent: Instance, name: string, size: Vector3, cf: CFrame, col: Color3, material: Enum.Material?, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = col
	p.Material = material or Enum.Material.SmoothPlastic
	if shape then p.Shape = shape end
	p.Anchored = false
	p.CanCollide = false
	p.CanTouch = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CFrame = cf
	p.Parent = parent
	return p
end

local function weld(body: BasePart, p: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0 = body
	w.Part1 = p
	w.Parent = p
end

-- the pattern of a paint scheme: thin coloured parts laid over the wings and the fuselage
local function decorate(model: Model, body: Part, skin, mat: Enum.Material)
	local kind = skin.pattern
	if not kind then return end
	local r = seeded(skin.id or "x")
	local col = color(skin.pcolor or 0xffffff)
	local rainbow = { 0xff3b3b, 0xff9a2a, 0xffe83a, 0x3bd86a, 0x3ba8ff, 0x8a4aff }
	local count = 0
	local function add(name: string, size: Vector3, cf: CFrame, c: Color3?, shape: Enum.PartType?)
		if count >= 36 then return end
		count += 1
		local p = newPart(model, name, size, cf, c or col, mat, shape)
		weld(body, p)
	end
	-- a spot on the top of a wing: u along the span (-3.5..3.5), v along the chord (-1.7..1.7); the part follows the sweep
	local function wingTop(side: number, u: number, v: number): CFrame
		local sx = 0.906 * u - 0.423 * v
		local sz = 0.423 * u + 0.906 * v
		return CFrame.new(side * (5.2 + sx), 0.27, 2 + sz) * CFrame.Angles(0, side * math.rad(-25), 0)
	end
	local function onTube(z: number): CFrame
		return CFrame.new(0, 1.3, z)
	end
	if kind == "camo" or kind == "splinter" or kind == "digital" then
		for i = 1, 24 do
			local side = (i % 2 == 0) and 1 or -1
			local u, v = (r() * 2 - 1) * 3.2, (r() * 2 - 1) * 1.4
			if i % 4 == 0 then
				add("Camo", Vector3.new(0.5 + r() * 0.9, 0.1, 0.8 + r() * 1.6), onTube(-6 + r() * 11) * CFrame.Angles(0, (r() - 0.5) * 0.8, 0))
			elseif kind == "camo" then
				add("Camo", Vector3.new(1.0 + r() * 1.6, 0.1, 0.8 + r() * 1.0), wingTop(side, u, v) * CFrame.Angles(0, (r() - 0.5) * 1.2, 0))
			elseif kind == "splinter" then
				add("Camo", Vector3.new(0.5 + r() * 0.8, 0.1, 1.2 + r() * 1.8), wingTop(side, u, v) * CFrame.Angles(0, (r() - 0.5) * 2.4, 0))
			else
				add("Camo", Vector3.new(0.7, 0.1, 0.7), wingTop(side, math.floor(u / 0.7) * 0.7, math.floor(v / 0.7) * 0.7))
			end
		end
	elseif kind == "dots" or kind == "hex" then
		for i = 0, 4 do
			for j = 0, 1 do
				local u, v = -3 + i * 1.5, -0.9 + j * 1.8
				add("Dot", Vector3.new(0.8, 0.1, 0.8), wingTop(1, u, v), nil, nil)
				add("Dot", Vector3.new(0.8, 0.1, 0.8), wingTop(-1, u, v), nil, nil)
			end
		end
		for k = 0, 3 do add("Dot", Vector3.new(0.8, 0.1, 0.8), onTube(-5 + k * 3)) end
	elseif kind == "checker" then
		for i = 0, 3 do
			for j = 0, 2 do
				if (i + j) % 2 == 0 then
					add("Check", Vector3.new(1.3, 0.1, 1.3), wingTop(1, -2.4 + i * 1.6, -1.3 + j * 1.3))
					add("Check", Vector3.new(1.3, 0.1, 1.3), wingTop(-1, -2.4 + i * 1.6, -1.3 + j * 1.3))
				end
			end
		end
		for k = 0, 4 do if k % 2 == 0 then add("Check", Vector3.new(1.1, 0.1, 1.1), onTube(-6 + k * 2.6)) end end
	elseif kind == "flame" then
		for i = 1, 8 do
			add("Flame", Vector3.new(0.6 + r() * 0.5, 0.1, 2.4 + r() * 3.2), onTube(2 + i * 0.7 + r()) * CFrame.new(((i % 2 == 0) and 1 or -1) * (0.2 + r() * 0.6), 0, 0) * CFrame.Angles(0, (r() - 0.5) * 0.3, 0))
		end
		for i = 1, 6 do add("Flame", Vector3.new(0.9, 0.1, 1.2 + r() * 1.4), wingTop((i % 2 == 0) and 1 or -1, -3 + i * 1.0, 0.5 + r() * 0.6)) end
	else -- stripes, tiger, wave, rainbow: bands across the wings and rings round the fuselage
		for k = 0, 3 do
			local c = (kind == "rainbow") and color(rainbow[(k % #rainbow) + 1]) or col
			local u = -2.6 + k * 1.75
			add("Band", Vector3.new(0.8, 0.1, 3.7), wingTop(1, u, 0), c)
			add("Band", Vector3.new(0.8, 0.1, 3.7), wingTop(-1, u, 0), c)
		end
		for k = 0, 4 do
			local c = (kind == "rainbow") and color(rainbow[((k + 2) % #rainbow) + 1]) or col
			add("Ring", Vector3.new(0.7, 2.68, 2.68), CFrame.new(0, 0, -5 + k * 2.6) * CFrame.Angles(0, math.rad(90), 0), c, Enum.PartType.Cylinder)
		end
	end
end

-- a pilot in a seat (1 = front, 2 = rear of a two-seat jet): helmet with visor, oxygen mask and hose, shoulders,
-- harness, arms on the stick.  Everything sits inside the canopy and the fuselage tube: nobody sticks out of the jet.
-- The parts live in a Folder "Seat<n>" (removeSeat deletes it).
function JetBuilder.addPilot(model: Model, outfitId: string?, seat: number, twoSeat: boolean?)
	local body = model.PrimaryPart
	local old = model:FindFirstChild("Seat" .. seat)
	if old then old:Destroy() end
	local folder = Instance.new("Folder")
	folder.Name = "Seat" .. seat
	folder.Parent = model
	local outfit = outfitId and Catalog.PilotById[outfitId]
	local helmet = outfit and color(outfit.helmet) or Color3.fromRGB(205, 205, 200)
	local visor = outfit and color(outfit.visor) or Color3.fromRGB(34, 36, 42)
	local suit = outfit and color(outfit.suit) or Color3.fromRGB(86, 96, 70)
	local acc = outfit and color(outfit.accent) or Color3.fromRGB(220, 200, 60)
	local skinTone = Color3.fromRGB(199, 154, 118)
	local webbing = Color3.fromRGB(38, 41, 45)
	local rubber = Color3.fromRGB(40, 46, 42)
	-- the visor is real glass: how much light it lets through (visorT) decides how opaque it looks and, from the
	-- cockpit view, how dark the world is (Visor.luau); mirror = a reflective coating
	local T = outfit and outfit.visorT or 0.97
	local sunVisor = T <= 0.5
	local mirror = outfit and outfit.mirror == true
	local pressure = outfit and outfit.pressure == true
	local helmet2 = outfit and color(outfit.helmet2) or helmet
	local suit2 = outfit and color(outfit.suit2) or suit
	local glove = outfit and color(outfit.glove) or Color3.fromRGB(30, 31, 34)
	local px = 0
	local pz = not twoSeat and -2.75 or (seat == 1 and -3.85 or -0.95)       -- the seat
	local function piece(name: string, size: Vector3, cf: CFrame, col: Color3, mat: Enum.Material, shape: Enum.PartType?)
		local p = newPart(folder, name, size, body.CFrame * cf, col, mat, shape)      -- (the jet may already be flying somewhere)
		weld(body, p)
		return p
	end
	piece("Seat", Vector3.new(1.7, 0.3, 1.5), CFrame.new(px, 0.45, pz + 0.15), Color3.fromRGB(52, 56, 60), Enum.Material.SmoothPlastic)
	piece("SeatBack", Vector3.new(1.5, 1.9, 0.3), CFrame.new(px, 1.35, pz + 0.85), Color3.fromRGB(48, 52, 56), Enum.Material.SmoothPlastic)
	piece("PilotTorso", Vector3.new(1.0, 1.15, 0.78), CFrame.new(px, 0.95, pz) * CFrame.Angles(0, 0, math.rad(90)), suit, Enum.Material.Fabric, Enum.PartType.Cylinder)
	piece("PilotShoulders", Vector3.new(1.45, 0.62, 0.7), CFrame.new(px, 1.34, pz), suit, Enum.Material.Fabric, Enum.PartType.Ball)
	piece("PilotNeck", Vector3.new(0.4, 0.36, 0.36), CFrame.new(px, 1.6, pz - 0.05) * CFrame.Angles(0, 0, math.rad(90)), skinTone, Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
	local hs = pressure and 1.18 or 1
	piece("PilotHelmet", Vector3.new(0.86 * hs, 0.94 * hs, 0.98 * hs), CFrame.new(px, 1.93, pz - 0.08), helmet, Enum.Material.SmoothPlastic, Enum.PartType.Ball).Reflectance = 0.12
	if pressure then
		local ring = piece("PilotNeckRing", Vector3.new(0.14, 0.78, 0.78), CFrame.new(px, 1.6, pz - 0.05) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(170, 178, 186), Enum.Material.Metal, Enum.PartType.Cylinder)
		ring.Reflectance = 0.3
	end
	-- the helmet's livery: thin parts over the shell in the second colour
	local pat = outfit and outfit.pattern
	local top = 2.42 * (pressure and 1.04 or 1)
	if pat == "stripes" or pat == "tricolor" or pat == "trim" or pat == "wolf" then
		piece("LiveryStripe", Vector3.new(0.14, 0.05, 0.86 * hs), CFrame.new(px, top, pz - 0.08), pat == "tricolor" and Color3.fromRGB(205, 42, 62) or helmet2, Enum.Material.SmoothPlastic)
		if pat == "tricolor" then
			piece("LiveryStripe", Vector3.new(0.14, 0.05, 0.86), CFrame.new(px + 0.14, top - 0.02, pz - 0.08), Color3.fromRGB(46, 138, 74), Enum.Material.SmoothPlastic)
			piece("LiveryStripe", Vector3.new(0.14, 0.05, 0.86), CFrame.new(px - 0.14, top - 0.02, pz - 0.08), Color3.fromRGB(244, 244, 240), Enum.Material.SmoothPlastic)
		elseif pat == "wolf" then
			for _, s in { -1, 1 } do piece("LiveryStripe", Vector3.new(0.1, 0.05, 0.8), CFrame.new(px + s * 0.2, top - 0.05, pz - 0.08) * CFrame.Angles(0, 0, s * math.rad(-14)), helmet2, Enum.Material.SmoothPlastic) end
		end
	elseif pat == "chevron" then
		for k = 0, 2 do
			for _, s in { -1, 1 } do piece("LiveryV", Vector3.new(0.5, 0.05, 0.1), CFrame.new(px + s * 0.22, top - 0.07 - k * 0.0, pz - 0.38 + k * 0.22) * CFrame.Angles(0, s * math.rad(35), 0), helmet2, Enum.Material.SmoothPlastic) end
		end
	elseif pat == "camo" or pat == "circuit" then
		local rnd = Random.new(7)
		for _ = 1, 7 do
			piece("LiveryBlot", Vector3.new(0.18 + rnd:NextNumber() * 0.2, 0.05, 0.18 + rnd:NextNumber() * 0.2), CFrame.new(px + rnd:NextNumber(-0.3, 0.3), top - 0.06, pz - 0.08 + rnd:NextNumber(-0.35, 0.35)) * CFrame.Angles(0, rnd:NextNumber() * 3, 0), helmet2, pat == "circuit" and Enum.Material.Neon or Enum.Material.SmoothPlastic)
		end
	end
	if not sunVisor then
		piece("PilotFace", Vector3.new(0.58, 0.42, 0.4), CFrame.new(px, 1.88, pz - 0.5), skinTone, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	end
	local lens = piece("PilotVisor", Vector3.new(0.78 * hs, 0.5 * hs, 0.52 * hs), CFrame.new(px, 1.93, pz - 0.42 * hs), visor, Enum.Material.Glass, Enum.PartType.Ball)
	lens.Transparency = math.clamp(T - 0.05, 0, 0.9)               -- clear glass: see-through, dark glass: opaque
	lens.Reflectance = mirror and 0.65 or 0.2
	piece("PilotMask", Vector3.new(0.46, 0.34, 0.34), CFrame.new(px, 1.74, pz - 0.58), rubber, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	piece("PilotHose", Vector3.new(0.1, 0.1, 1.0), CFrame.new(px - 0.28, 1.38, pz - 0.5) * CFrame.Angles(math.rad(-48), math.rad(14), 0), rubber, Enum.Material.SmoothPlastic)
	for _, s in { -1, 1 } do
		piece("PilotEar", Vector3.new(0.14, 0.4, 0.4), CFrame.new(px + s * 0.43, 1.9, pz - 0.05), Color3.fromRGB(44, 48, 54), Enum.Material.Metal, Enum.PartType.Cylinder)
		piece("PilotYoke", Vector3.new(0.42, 0.1, 0.5), CFrame.new(px + s * 0.4, 1.3, pz) * CFrame.Angles(0, 0, s * math.rad(-25)), suit2, Enum.Material.Fabric)
		piece("PilotStrap", Vector3.new(0.22, 1.0, 0.05), CFrame.new(px + s * 0.34, 1.05, pz - 0.38) * CFrame.Angles(0, 0, s * math.rad(-10)), webbing, Enum.Material.Fabric)
		piece("PilotArm", Vector3.new(0.3, 0.3, 1.05), CFrame.new(px + s * 0.6, 0.85, pz - 0.5) * CFrame.Angles(math.rad(-25), s * math.rad(-6), 0), suit, Enum.Material.Fabric)
		piece("PilotGlove", Vector3.new(0.34, 0.34, 0.34), CFrame.new(px + s * 0.56, 0.7, pz - 1.0), glove, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	end
	piece("PilotBuckle", Vector3.new(0.26, 0.2, 0.06), CFrame.new(px, 1.0, pz - 0.4), Color3.fromRGB(176, 182, 190), Enum.Material.Metal)
	piece("PilotChestStrap", Vector3.new(0.9, 0.1, 0.05), CFrame.new(px, 1.0, pz - 0.39), webbing, Enum.Material.Fabric)
	piece("PilotPatch", Vector3.new(0.3, 0.14, 0.05), CFrame.new(px - 0.42, 1.18, pz - 0.38), acc, Enum.Material.SmoothPlastic)
	piece("PilotStripe", Vector3.new(0.12, 0.05, 0.85), CFrame.new(px, 2.4, pz - 0.08), acc, Enum.Material.SmoothPlastic)
end

function JetBuilder.removeSeat(model: Model, seat: number)
	local f = model:FindFirstChild("Seat" .. seat)
	if f then f:Destroy() end
end

-- An imported jet (the game's own .glb model, imported into Studio and put in ReplicatedStorage.JetModels): scaled to the
-- real length, turned nose-to--Z, centred, every part welded to the invisible root "Body".  The paint scheme's tint goes
-- on the painted parts; the patterns are only drawn on the jets built from parts.
local function fromImported(src: Instance, key: string, skin, enemy: boolean?): Model?
	local model: Model = src:Clone()
	model.Name = enemy and "Enemy" or "Jet"
	local parts = {}
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then table.insert(parts, d)
		elseif d:IsA("Weld") or d:IsA("WeldConstraint") or d:IsA("Motor6D") or d:IsA("Script") or d:IsA("LocalScript") then d:Destroy() end
	end
	if #parts == 0 then model:Destroy() return nil end
	local length = 15
	for _, j in Config.JetModels do if j.key == key then length = j.length end end

	model:PivotTo(CFrame.new())
	local _, size = model:GetBoundingBox()
	if size.X > size.Z then model:PivotTo(CFrame.Angles(0, math.rad(90), 0) * model:GetPivot()) end   -- the long axis along Z
	local _, size2 = model:GetBoundingBox()
	model:ScaleTo(length / math.max(size2.X, size2.Z))
	local bb = model:GetBoundingBox()
	model:PivotTo(CFrame.new(-bb.Position) * model:GetPivot())                                        -- centred

	-- the nose points to -Z: the rear of a jet (engines, tail) is heavier than its nose
	local flip = Config.JetModelFlip[key]
	if flip == nil then
		local front, rear = 0, 0
		for _, p in parts do
			local v = p.Size.X * p.Size.Y * p.Size.Z
			if p.Position.Z < -length * 0.3 then front += v elseif p.Position.Z > length * 0.3 then rear += v end
		end
		flip = front > rear
	end
	if flip then model:PivotTo(CFrame.Angles(0, math.rad(180), 0) * model:GetPivot()) end

	local body = Instance.new("Part")
	body.Name = "Body"
	body.Size = Vector3.new(1, 1, 1)
	body.Transparency = 1
	body.CanCollide = false
	body.CanTouch = false
	body.Massless = true
	body.Anchored = false
	body.CFrame = CFrame.new()
	body.Parent = model
	model.PrimaryPart = body

	local tint = enemy and Color3.fromRGB(95, 80, 80) or (skin and skin.color and color(skin.color)) or nil
	for _, p in parts do
		p.Anchored = false
		p.CanCollide = false
		p.CanTouch = false
		p.Massless = true
		weld(body, p)
		local isGlass = p.Transparency > 0.05 or string.find(string.lower(p.Name), "glass") ~= nil
		if tint and not isGlass and p:IsA("MeshPart") then
			p.Color = tint
			local sa = p:FindFirstChildOfClass("SurfaceAppearance")
			if sa then pcall(function() sa.Color = tint end) end
		end
	end
	-- the afterburner flame and a generous hit box
	local k = length / 15
	local flame = newPart(model, "Flame", Vector3.new(5 * k, 1.5 * k, 1.5 * k), CFrame.new(0, 0, length / 2 + 2 * k) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(255, 150, 40), Enum.Material.Neon, Enum.PartType.Cylinder)
	flame.Transparency = 0.6
	weld(body, flame)
	local hit = newPart(model, "Hitbox", Vector3.new(9 * k, 3.5 * k, length * 1.2), CFrame.new(), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic)
	hit.Transparency = 1
	hit.CanQuery = true
	weld(body, hit)
	return model
end

-- a Model with PrimaryPart "Body".  air: a Catalog.Air id (nil = the factory grey), pilot: a Catalog.Pilot id (nil = plain),
-- enemy: true builds the dark hostile scheme (smaller part count); twoSeat: a longer canopy with a rear seat (wsoId: the
-- outfit of whoever sits there; addPilot puts a pilot in a seat later, removeSeat takes him out)
function JetBuilder.build(airId: string?, pilotId: string?, enemy: boolean?, twoSeat: boolean?, wsoId: string?, modelKey: string?): Model
	local skin = enemy and ENEMY or (airId and Catalog.AirById[airId]) or DEFAULT
	-- the game's own model when it is imported (a two-seater uses the built one: there is no rear seat in the single-seat models)
	if modelKey and not twoSeat then
		local folder = ReplicatedStorage:FindFirstChild("JetModels")
		local src = folder and folder:FindFirstChild(modelKey)
		if src then
			local m = fromImported(src, modelKey, (airId and Catalog.AirById[airId]) or nil, enemy)
			if m then return m end
		end
	end
	local model = Instance.new("Model")
	model.Name = enemy and "Enemy" or "Jet"

	local paint = color(skin.color)
	local accent = color(skin.pcolor or 0x4b5258)
	local dark = Color3.fromRGB(34, 38, 44)
	local metal = skin.metal or 0
	local material = metal >= 0.6 and Enum.Material.Metal or Enum.Material.SmoothPlastic
	local reflect = skin.metal and math.clamp(skin.metal * 0.35, 0, 0.4) or 0
	local glow = skin.emissive and skin.emissive > 0x222222

	local body = newPart(model, "Body", Vector3.new(2.6, 2.6, 15), CFrame.new(0, 0, 0), paint, material, Enum.PartType.Block)
	body.Transparency = 1                                         -- the root of the model; the round Tube is what you see
	body.Reflectance = reflect
	model.PrimaryPart = body

	local function piece(name, size, cf, col, mat, shape)
		local p = newPart(model, name, size, cf, col, mat or material, shape)
		p.Reflectance = reflect
		weld(body, p)
		return p
	end
	-- fuselage: a round tube along Z, a nose cone, the engine
	piece("Tube", Vector3.new(15, 2.6, 2.6), CFrame.Angles(0, math.rad(90), 0), paint, material, Enum.PartType.Cylinder)
	piece("Nose1", Vector3.new(4, 2.0, 2.0), CFrame.new(0, 0, -9.2) * CFrame.Angles(0, math.rad(90), 0), paint, material, Enum.PartType.Cylinder)
	piece("Nose2", Vector3.new(3, 1.2, 1.2), CFrame.new(0, 0, -11.6) * CFrame.Angles(0, math.rad(90), 0), dark, Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
	-- wings, tailplanes, fins
	piece("WingL", Vector3.new(8, 0.35, 4.2), CFrame.new(-5.2, -0.1, 2) * CFrame.Angles(0, math.rad(25), 0), paint)
	piece("WingR", Vector3.new(8, 0.35, 4.2), CFrame.new(5.2, -0.1, 2) * CFrame.Angles(0, math.rad(-25), 0), paint)
	piece("TailL", Vector3.new(3.4, 0.3, 2), CFrame.new(-2.7, 0, 7.4) * CFrame.Angles(0, math.rad(20), 0), paint)
	piece("TailR", Vector3.new(3.4, 0.3, 2), CFrame.new(2.7, 0, 7.4) * CFrame.Angles(0, math.rad(-20), 0), paint)
	piece("FinL", Vector3.new(0.3, 3.4, 3), CFrame.new(-1.0, 2.5, 6.6) * CFrame.Angles(0, 0, math.rad(10)), paint)
	piece("FinR", Vector3.new(0.3, 3.4, 3), CFrame.new(1.0, 2.5, 6.6) * CFrame.Angles(0, 0, math.rad(-10)), paint)
	piece("Intake", Vector3.new(1.8, 1.3, 4), CFrame.new(0, -1.6, -2.5), dark, Enum.Material.SmoothPlastic)
	-- the glass
	local canopy
	if twoSeat then
		canopy = piece("Canopy", Vector3.new(7.4, 2.3, 2.1), CFrame.new(0, 1.45, -2.3) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(110, 170, 220), Enum.Material.Glass, Enum.PartType.Ball)
	else
		canopy = piece("Canopy", Vector3.new(4.4, 2.3, 2.1), CFrame.new(0, 1.45, -3.0) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(110, 170, 220), Enum.Material.Glass, Enum.PartType.Ball)
	end
	canopy.Transparency = 0.45
	canopy.Reflectance = 0.15
	-- the engine: a dark nozzle and the afterburner flame (the client turns it up with the throttle)
	piece("Nozzle", Vector3.new(1.6, 2.2, 2.2), CFrame.new(0, 0, 8.4) * CFrame.Angles(0, math.rad(90), 0), dark, Enum.Material.Metal, Enum.PartType.Cylinder)
	local flame = piece("Flame", Vector3.new(5, 1.5, 1.5), CFrame.new(0, 0, 11.4) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(255, 150, 40), Enum.Material.Neon, Enum.PartType.Cylinder)
	flame.Transparency = 0.6
	-- a glow trim (a neon paint scheme): thin strips along the wing edges
	if glow and not enemy then
		local g = color(skin.color)
		for _, s in { -1, 1 } do
			local p = piece("Glow", Vector3.new(0.3, 0.45, 7), CFrame.new(s * 5.2, -0.05, 4) * CFrame.Angles(0, s * math.rad(-25), 0), g, Enum.Material.Neon)
			p.Reflectance = 0
		end
	end
	-- missiles under the wings
	if not enemy then
		for _, s in { -1, 1 } do
			piece("Missile", Vector3.new(2.6, 0.5, 0.5), CFrame.new(s * 3.6, -0.7, 1.4) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(220, 222, 226), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
		end
		JetBuilder.addPilot(model, pilotId, 1, twoSeat)
		if twoSeat and wsoId ~= nil then JetBuilder.addPilot(model, wsoId, 2, true) end
	end
	-- the pattern of the paint scheme
	if not enemy then
		decorate(model, body, skin, material)
	end
	-- a generous invisible hit box (the guns and missiles test against it)
	local hit = newPart(model, "Hitbox", Vector3.new(9, 3.5, 18), CFrame.new(0, 0, 0), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic)
	hit.Transparency = 1
	hit.CanQuery = true
	weld(body, hit)
	return model
end

-- turns the afterburner flame up or down (0..1)
function JetBuilder.setFlame(model: Model, level: number)
	local f = model:FindFirstChild("Flame")
	if f then
		f.Transparency = 1 - math.clamp(level, 0, 1) * 0.85
	end
end

return JetBuilder
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The remote events and functions between the server and the players.  The server creates them (Remotes.init()),
-- the clients wait for them (Remotes.get()).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = {}

local EVENTS = {
	"Fire",           -- client -> server: the gun is firing
	"FireMissile",    -- client -> server: a missile at an enemy (the Model)
	"Flare",          -- client -> server: drop flares
	"Crashed",        -- client -> server: my jet hit the ground / the sea
	"Launch",         -- client -> server: take off (kind: "single" or "twoseat")
	"Mark",           -- client -> server: the rear seat marks an enemy (the Model) for the pilot
	"Seat",           -- server -> client: you sit in the rear seat of this jet (the Model), or nil: you left it
	"RoomState",      -- server -> client: the room you are in (members, teams, open rear seats)
	"Tracer",         -- server -> clients: a line of tracer fire (from, to, color)
	"Hud",            -- server -> client: { wave, enemies, missiles, flares, hp }
	"Toast",          -- server -> client: a short message (text, kind)
	"MissileAlert",   -- server -> client: true / false, a missile is coming at you
	"Died",           -- server -> client: the jet is gone (reason)
	"Profile",        -- server -> client: the coins, the owned and the equipped things
}
local FUNCTIONS = {
	"BuyAir", "BuyPilot", "EquipAir", "EquipPilot", "EquipJet",    -- shop: (id) -> ok, message
	"BuyProduct", "BuyPass",                            -- Robux: (index) -> ok
	"GetProfile",
	"BuySkinRobux",                                     -- (kind "air"/"pilot", id): the Robux purchase of a skin
	"ListRooms", "CreateRoom", "JoinRoom", "LeaveRoom", "QuickPlay", "SetTeam", "SetSlots",   -- the hangar groups
	"JoinSeat", "LeaveSeat",                            -- the rear seat of a two-seat jet
}

function Remotes.init()
	local folder = Instance.new("Folder")
	folder.Name = "Remotes"
	for _, n in EVENTS do
		local e = Instance.new("RemoteEvent")
		e.Name = n
		e.Parent = folder
	end
	for _, n in FUNCTIONS do
		local f = Instance.new("RemoteFunction")
		f.Name = n
		f.Parent = folder
	end
	folder.Parent = ReplicatedStorage
	return folder
end

function Remotes.get()
	local folder = ReplicatedStorage:WaitForChild("Remotes")
	local t = {}
	for _, n in EVENTS do t[n] = folder:WaitForChild(n) end
	for _, n in FUNCTIONS do t[n] = folder:WaitForChild(n) end
	return t
end

return Remotes
]]></ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX24"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX23"><Properties><string name="Name">Server</string></Properties><Item class="ModuleScript" referent="RBX14"><Properties><string name="Name">Combat</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Jets, guns, missiles, flares, damage and kills: everything that decides who hits whom lives on the server.
-- Every jet belongs to a room (attribute RoomId) and a team (Team); only members of the same room see and hit each
-- other, and in a team-fight room only the other team is hostile.  A two-seat jet (Seats = 2) carries a second
-- player in the rear seat (WsoId) who fires missiles, drops flares and marks targets for the pilot.
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local JetBuilder = require(Shared.JetBuilder)
local Data = require(script.Parent.Data)
local Rooms = require(script.Parent.Rooms)
local World = require(script.Parent.World)

local Combat = {}
local remotes = nil
local rng = Random.new()

local jets = {}      -- [Player] = Model: the jet a player flies
local rear = {}      -- [Player] = Model: the jet whose rear seat a player holds
local lastShot, lastMissile, lastFlare = {}, {}, {}
local missiles = {}  -- active missile tables
local killedEvent = Instance.new("BindableEvent")
Combat.EnemyKilled = killedEvent.Event      -- fires (enemyModel, attackerPlayer or nil)

local function folder(name: string): Folder
	local f = workspace:FindFirstChild(name)
	if not f then
		f = Instance.new("Folder")
		f.Name = name
		f.Parent = workspace
	end
	return f
end

-- the jet a player is in (and "pilot" or "wso")
function Combat.seatOf(player: Player)
	local j = jets[player]
	if j and j.Parent then return j, "pilot" end
	local r = rear[player]
	if r and r.Parent then return r, "wso" end
	return nil, nil
end
function Combat.jetOf(player: Player): Model?
	local j = jets[player]
	if j and j.Parent then return j end
	return nil
end

local function toast(player: Player?, text: string, kind: string?)
	if player and player.Parent and remotes then remotes.Toast:FireClient(player, text, kind or "info") end
end
Combat.toast = toast

-- everybody in a jet: the pilot and the rear seat
local function occupants(model: Model): { Player }
	local out = {}
	local pid, wid = model:GetAttribute("OwnerId"), model:GetAttribute("WsoId")
	if pid then
		local p = Players:GetPlayerByUserId(pid)
		if p then table.insert(out, p) end
	end
	if wid and wid ~= 0 then
		local p = Players:GetPlayerByUserId(wid)
		if p then table.insert(out, p) end
	end
	return out
end
Combat.occupants = occupants

local function velocityOf(model: Model): Vector3
	local v = model:GetAttribute("Vel")
	if typeof(v) == "Vector3" then return v end
	local body = model.PrimaryPart
	if body then return body.AssemblyLinearVelocity end
	return Vector3.zero
end

local function explode(pos: Vector3, size: number?)
	local e = Instance.new("Explosion")
	e.Position = pos
	e.BlastRadius = size or 10
	e.BlastPressure = 0
	e.DestroyJointRadiusPercent = 0
	e.Parent = workspace
	Debris:AddItem(e, 4)
end

-- tracer lines are shown only to the members of the room
local function tracer(roomId: number, from: Vector3, to: Vector3, color: Color3, except: Player?)
	local room = Rooms.byId(roomId)
	if not room then return end
	for p in room.members do
		if p ~= except then remotes.Tracer:FireClient(p, from, to, color) end
	end
end
Combat.tracer = tracer

-- is `target` an enemy of `attacker` (a jet)?  Same room; the AI is hostile to everybody, a jet only in a team fight
function Combat.hostile(attacker: Model, target: Model): boolean
	local room = attacker:GetAttribute("RoomId")
	if not room or target:GetAttribute("RoomId") ~= room then return false end
	if target.Parent == workspace.Enemies then return true end
	if target.Parent == workspace.Jets and target ~= attacker then
		local r = Rooms.byId(room)
		return r ~= nil and r.mode == "pvp" and target:GetAttribute("Team") ~= attacker:GetAttribute("Team")
	end
	return false
end

function Combat.init(r)
	remotes = r
	folder("Jets")
	folder("Enemies")
	folder("Missiles")
	folder("Effects")

	remotes.Fire.OnServerEvent:Connect(function(player) Combat.fireGun(player) end)
	remotes.FireMissile.OnServerEvent:Connect(function(player, target) Combat.playerMissile(player, target) end)
	remotes.Flare.OnServerEvent:Connect(function(player) Combat.flare(player) end)
	remotes.Mark.OnServerEvent:Connect(function(player, target) Combat.mark(player, target) end)
	remotes.Crashed.OnServerEvent:Connect(function(player)
		local j = Combat.jetOf(player)
		if j then Combat.destroy(j, nil, "Lezuhantál") end
	end)
	remotes.JoinSeat.OnServerInvoke = function(player, pilotUserId) return Combat.joinSeat(player, pilotUserId) end
	remotes.LeaveSeat.OnServerInvoke = function(player) Combat.leaveSeat(player) return true end

	-- a member leaves the room: the jet goes with them (the rear seat just empties)
	Rooms.hooks.left = function(player)
		Combat.removeJet(player)
	end
	-- nobody changes team in the air
	Rooms.hooks.canSwitch = function(player)
		return Combat.seatOf(player) == nil
	end
	Players.PlayerRemoving:Connect(function(player)
		Combat.removeJet(player)
		lastShot[player], lastMissile[player], lastFlare[player] = nil, nil, nil
	end)
end

-- ------------------------------------------------------------------ the jets
-- a new jet for a player (twoSeat: with a rear seat that a team mate can take), in the air over the island
function Combat.spawnPlayerJet(player: Player, twoSeat: boolean?)
	local room = Rooms.get(player)
	if not room then return nil end
	Combat.removeJet(player)
	local p = Data.get(player)
	local team = room.team[player] or "A"
	local pos, look = World.spawnPoint(team, room.mode == "pvp", rng)
	local model = JetBuilder.build(p and p.airOn, p and p.pilotOn, false, twoSeat == true, nil, p and p.jetOn)
	model.Name = "Jet_" .. player.Name
	model:SetAttribute("Health", Config.Jet.Health)
	model:SetAttribute("MaxHealth", Config.Jet.Health)
	model:SetAttribute("OwnerId", player.UserId)
	model:SetAttribute("RoomId", room.id)
	model:SetAttribute("Team", team)
	model:SetAttribute("Seats", twoSeat and 2 or 1)
	model:SetAttribute("WsoId", 0)
	model:SetAttribute("SeatOpen", twoSeat == true)
	model:SetAttribute("Missiles", Config.Jet.Missiles)
	model:SetAttribute("Flares", Config.Jet.Flares)
	model:SetAttribute("FlareUntil", 0)
	model:SetAttribute("MarkUid", 0)
	model:PivotTo(CFrame.lookAt(pos, pos + look))
	model.Parent = workspace.Jets
	local body = model.PrimaryPart
	-- a force that cancels gravity: the player's own flight code moves the jet
	local att = Instance.new("Attachment")
	att.Parent = body
	local vf = Instance.new("VectorForce")
	vf.Attachment0 = att
	vf.RelativeTo = Enum.ActuatorRelativeTo.World
	vf.ApplyAtCenterOfMass = true
	vf.Force = Vector3.new(0, body.AssemblyMass * workspace.Gravity, 0)
	vf.Parent = body
	body.AssemblyLinearVelocity = look * Config.Jet.StartSpeed
	pcall(function() body:SetNetworkOwner(player) end)
	jets[player] = model
	Rooms.push(room)
	return model
end

-- the rear seat of somebody's two-seat jet (same room, same team)
function Combat.joinSeat(player: Player, pilotUserId)
	if Combat.seatOf(player) then return false, "Már repülsz" end
	local room = Rooms.get(player)
	local pilot = typeof(pilotUserId) == "number" and Players:GetPlayerByUserId(pilotUserId)
	local jet = pilot and Combat.jetOf(pilot)
	if not room or not jet then return false, "Ez a gép már nincs a levegőben" end
	if jet:GetAttribute("RoomId") ~= room.id then return false, "Másik szoba" end
	if jet:GetAttribute("Seats") ~= 2 or jet:GetAttribute("WsoId") ~= 0 or not jet:GetAttribute("SeatOpen") then return false, "A hátsó ülés foglalt" end
	if jet:GetAttribute("Team") ~= (room.team[player] or "A") then return false, "Ez a másik csapat gépe" end
	local d = Data.get(player)
	jet:SetAttribute("WsoId", player.UserId)
	JetBuilder.addPilot(jet, d and d.pilotOn, 2, true)
	rear[player] = jet
	remotes.Seat:FireClient(player, jet)
	toast(pilot, player.DisplayName .. " beült a hátsó ülésre", "good")
	Rooms.push(room)
	return true, "Beültél"
end

function Combat.leaveSeat(player: Player)
	local jet = rear[player]
	rear[player] = nil
	if jet and jet.Parent then
		if jet:GetAttribute("WsoId") == player.UserId then
			jet:SetAttribute("WsoId", 0)
			JetBuilder.removeSeat(jet, 2)
			local pilot = Players:GetPlayerByUserId(jet:GetAttribute("OwnerId") or 0)
			toast(pilot, player.DisplayName .. " kiszállt a hátsó ülésből", "warn")
		end
	end
	if player.Parent then remotes.Seat:FireClient(player, nil) end
end

-- takes a player out of whatever jet they are in (a pilot's jet is removed, with the rear seat's passenger)
function Combat.removeJet(player: Player)
	local jet = jets[player]
	jets[player] = nil
	if jet and jet.Parent then
		for _, p in occupants(jet) do
			if p ~= player then
				rear[p] = nil
				remotes.Seat:FireClient(p, nil)
				remotes.Died:FireClient(p, "A pilóta kilépett")
			end
		end
		jet:Destroy()
	end
	if rear[player] then Combat.leaveSeat(player) end
end

-- the rear seat marks an enemy: the pilot's display shows it and the pilot's lock prefers it
function Combat.mark(player: Player, target)
	local jet, role = Combat.seatOf(player)
	if not jet or role ~= "wso" then return end
	if typeof(target) ~= "Instance" or not target:IsA("Model") or not target.Parent or not Combat.hostile(jet, target) then
		jet:SetAttribute("MarkUid", 0)
		return
	end
	local uid = target:GetAttribute("Uid")
	if not uid then
		Combat.uidCounter = (Combat.uidCounter or 0) + 1
		uid = Combat.uidCounter
		target:SetAttribute("Uid", uid)
	end
	jet:SetAttribute("MarkUid", uid)
end

-- ------------------------------------------------------------------ damage
function Combat.damage(model: Model, amount: number, attacker: Player?, how: string?)
	if not model or not model.Parent then return end
	local hp = model:GetAttribute("Health")
	if not hp or hp <= 0 then return end
	hp -= amount
	model:SetAttribute("Health", hp)
	if hp <= 0 then Combat.destroy(model, attacker, how) end
end

-- the coins and the score of a kill; the other seat of the shooter's jet shares in it
local function award(attacker: Player, amount: number, text: string)
	local jet = Combat.seatOf(attacker)
	Data.addKill(attacker)
	Data.addCoins(attacker, amount)
	toast(attacker, text .. " +" .. amount .. " érme", "good")
	if jet then
		for _, p in occupants(jet) do
			if p ~= attacker then
				Data.addCoins(p, math.floor(amount / 2))
				toast(p, text .. " +" .. math.floor(amount / 2) .. " érme", "good")
			end
		end
	end
end

function Combat.destroy(model: Model, attacker: Player?, how: string?)
	if not model.Parent then return end
	model:SetAttribute("Health", 0)
	local pos = model:GetPivot().Position
	explode(pos, 18)
	local ownerId = model:GetAttribute("OwnerId")
	if ownerId then
		-- a player's jet: everybody in it is out
		for _, victim in occupants(model) do
			jets[victim] = nil
			rear[victim] = nil
			remotes.MissileAlert:FireClient(victim, false)
			remotes.Seat:FireClient(victim, nil)
			remotes.Died:FireClient(victim, how or "Lelőttek")
		end
		if attacker then
			local room = Rooms.byId(model:GetAttribute("RoomId"))
			award(attacker, Config.Rooms.PvpKillCoins, "Lelőtted az ellenfelet!")
			if room then
				local team = room.team[attacker]
				if team then Rooms.score(room, team) end
				Rooms.push(room)
			end
		end
	else
		if attacker then award(attacker, Config.Coins.PerKill, "Lelőttél egy ellenséget!") end
		killedEvent:Fire(model, attacker)
	end
	model:Destroy()
end

-- ------------------------------------------------------------------ guns
-- the closest enemy on the line of fire (a sphere round each jet), or nil
local function lineTarget(origin: Vector3, look: Vector3, range: number, radius: number, jet: Model)
	local best, bestT = nil, range
	local function consider(m: Model)
		if not m:IsA("Model") or not Combat.hostile(jet, m) then return end
		local c = m:GetPivot().Position
		local v = c - origin
		local t = v:Dot(look)
		if t > 0 and t < bestT then
			local perp = (v - look * t).Magnitude
			if perp < radius + t * 0.004 then best, bestT = m, t end
		end
	end
	for _, m in workspace.Enemies:GetChildren() do consider(m) end
	for _, m in workspace.Jets:GetChildren() do consider(m) end
	return best, bestT
end

function Combat.fireGun(player: Player)
	local jet = Combat.jetOf(player)               -- only the pilot has the gun
	if not jet then return end
	local now = os.clock()
	if now - (lastShot[player] or 0) < 1 / (Config.Gun.Rate + 2) then return end
	lastShot[player] = now
	local body = jet.PrimaryPart
	local look = body.CFrame.LookVector
	local origin = body.Position + look * 12
	local G = Config.Gun
	local target, t = lineTarget(origin, look, G.Range, G.Radius, jet)
	local dest = origin + look * (target and t or G.Range)
	tracer(jet:GetAttribute("RoomId"), origin, dest, Color3.fromRGB(255, 240, 140), player)
	if target then Combat.damage(target, G.Damage, player, "gépágyú") end
end

-- ------------------------------------------------------------------ missiles
local function launchMissile(owner: Player?, origin: CFrame, target: Model, damage: number, roomId: number)
	local part = Instance.new("Part")
	part.Name = "Missile"
	part.Size = Vector3.new(0.8, 0.8, 5)
	part.Color = Color3.fromRGB(255, 190, 90)
	part.Material = Enum.Material.Neon
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CFrame = origin
	part:SetAttribute("RoomId", roomId)
	local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0.35, 2.4)
	a1.Position = Vector3.new(0, -0.35, 2.4)
	a0.Parent, a1.Parent = part, part
	local trail = Instance.new("Trail")
	trail.Attachment0, trail.Attachment1 = a0, a1
	trail.Lifetime = 0.9
	trail.Color = ColorSequence.new(Color3.fromRGB(255, 200, 120), Color3.fromRGB(120, 120, 120))
	trail.Transparency = NumberSequence.new(0.1, 1)
	trail.Parent = part
	part.Parent = workspace.Missiles
	local m = { part = part, dir = origin.LookVector, target = target, owner = owner, damage = damage, age = 0, judged = false, lost = false, victims = {} }
	table.insert(missiles, m)
	if target:GetAttribute("OwnerId") then
		for _, victim in occupants(target) do
			table.insert(m.victims, victim)
			remotes.MissileAlert:FireClient(victim, true)
		end
	end
	return m
end
Combat.launchMissile = launchMissile

local function endMissile(m)
	m.part:Destroy()
	m.dead = true
	for _, v in m.victims do
		if v.Parent then remotes.MissileAlert:FireClient(v, false) end
	end
end

-- a missile from the pilot (the target must be in front of the nose) or from the rear seat (a wide cone)
function Combat.playerMissile(player: Player, target)
	local jet, role = Combat.seatOf(player)
	if not jet or typeof(target) ~= "Instance" or not target:IsA("Model") or not target.Parent then return end
	if not Combat.hostile(jet, target) then return end
	local now = os.clock()
	if now - (lastMissile[jet] or 0) < 0.8 then return end
	local n = jet:GetAttribute("Missiles") or 0
	if n <= 0 then return end
	local body = jet.PrimaryPart
	local to = target:GetPivot().Position - body.Position
	local dist = to.Magnitude
	if dist > Config.Missile.Range or dist < 80 then return end
	local cone = role == "wso" and 80 or Config.Missile.Cone + 6
	if to.Unit:Dot(body.CFrame.LookVector) < math.cos(math.rad(cone)) then return end
	lastMissile[jet] = now
	jet:SetAttribute("Missiles", n - 1)
	local startCF = CFrame.lookAt(body.Position + to.Unit * 9, body.Position + to.Unit * 20)
	if role == "pilot" then startCF = body.CFrame * CFrame.new(0, -1, -8) end
	launchMissile(player, startCF, target, Config.Missile.Damage, jet:GetAttribute("RoomId"))
	task.delay(Config.Jet.MissileReload, function()
		if jet.Parent then jet:SetAttribute("Missiles", math.min(Config.Jet.Missiles, (jet:GetAttribute("Missiles") or 0) + 1)) end
	end)
end

function Combat.flare(player: Player)
	local jet = Combat.seatOf(player)
	if not jet then return end
	local now = os.clock()
	if now - (lastFlare[jet] or 0) < Config.Jet.FlareCooldown then return end
	local n = jet:GetAttribute("Flares") or 0
	if n <= 0 then return end
	lastFlare[jet] = now
	jet:SetAttribute("Flares", n - 1)
	jet:SetAttribute("FlareUntil", now + Config.Jet.FlareTime)
	local body = jet.PrimaryPart
	for i = 1, 3 do
		local f = Instance.new("Part")
		f.Name = "Flare"
		f.Shape = Enum.PartType.Ball
		f.Size = Vector3.new(1.4, 1.4, 1.4)
		f.Color = Color3.fromRGB(255, 220, 140)
		f.Material = Enum.Material.Neon
		f.CanCollide = false
		f.CanQuery = false
		f.CFrame = body.CFrame * CFrame.new(rng:NextNumber(-2, 2), -2, 9)
		f.Parent = workspace.Effects
		f.AssemblyLinearVelocity = body.AssemblyLinearVelocity * 0.6 + Vector3.new(rng:NextNumber(-25, 25), -20, rng:NextNumber(-25, 25))
		local light = Instance.new("PointLight")
		light.Color = f.Color
		light.Range = 14
		light.Parent = f
		Debris:AddItem(f, 3)
	end
end

-- the missiles fly: they steer at the target (limited turn), a flare burst can shake them off, the fuse goes
-- off close to the target
function Combat.step(dt: number)
	local M = Config.Missile
	local now = os.clock()
	for i = #missiles, 1, -1 do
		local m = missiles[i]
		if m.dead then
			table.remove(missiles, i)
		else
			m.age += dt
			local target = m.target
			local pos = m.part.Position
			if m.age > M.Life or pos.Y < -5 or not m.part.Parent then
				endMissile(m)
			else
				local alive = target and target.Parent and (target:GetAttribute("Health") or 0) > 0
				if alive and not m.lost then
					local tpos = target:GetPivot().Position
					local dist = (tpos - pos).Magnitude
					-- the last moment: flares (a player) or the pilot's skill (an enemy) can shake the missile off, once
					if not m.judged and dist < 450 then
						m.judged = true
						local isPlayer = target:GetAttribute("OwnerId") ~= nil
						local shaken
						if isPlayer then
							shaken = (target:GetAttribute("FlareUntil") or 0) > now and rng:NextNumber() < 0.6
						else
							shaken = rng:NextNumber() < Config.Enemy.FlareChance
						end
						if shaken then
							m.lost = true
							if m.owner then toast(m.owner, "Kicselezték a rakétádat!", "warn") end
							for _, v in m.victims do toast(v, "Kicselezted a rakétát!", "good") end
						end
					end
					if not m.lost then
						local lead = tpos + velocityOf(target) * math.clamp(dist / M.Speed, 0, 1.5)
						local want = (lead - pos)
						if want.Magnitude > 0.1 then
							want = want.Unit
							local ang = math.acos(math.clamp(m.dir:Dot(want), -1, 1))
							local maxTurn = M.TurnRate * dt
							if ang <= maxTurn then m.dir = want else m.dir = m.dir:Lerp(want, maxTurn / ang).Unit end
						end
						if dist < M.FuseRadius then
							explode(pos, 12)
							Combat.damage(target, m.damage, m.owner, "rakéta")
							endMissile(m)
						end
					end
				end
				if not m.dead then
					local np = pos + m.dir * M.Speed * dt
					m.part.CFrame = CFrame.lookAt(np, np + m.dir)
				end
			end
		end
	end
end

return Combat
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX15"><Properties><string name="Name">Data</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The save: coins, the bought skins and what is worn, kills.  A DataStore keeps it between visits; when the
-- DataStore is not available (Studio without API access) the game still runs, the save lives for the session.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local Data = {}

local store = nil
pcall(function() store = DataStoreService:GetDataStore(Config.DataStoreName) end)

local profiles = {}   -- [Player] = table
local loaded = {}     -- [Player] = true once the data is in
local remotes = nil

local function fresh()
	return {
		coins = Config.Coins.Start, kills = 0, best = 0, flown = 0,
		air = {}, pilot = {},            -- owned: [id] = true
		airOn = nil, pilotOn = nil,      -- worn (nil = the factory paint / the plain flight suit)
		jetOn = nil,                     -- the jet model (Config.JetModels key; nil = the one built from parts)
		receipts = {},
		version = 1,
	}
end

local function key(player: Player): string
	return "u_" .. tostring(player.UserId)
end

function Data.init(r)
	remotes = r
end

function Data.get(player: Player)
	return profiles[player]
end

function Data.isLoaded(player: Player): boolean
	return loaded[player] == true
end

-- what the client needs to draw the shop and the HUD
function Data.view(player: Player)
	local p = profiles[player]
	if not p then return nil end
	return { coins = p.coins, kills = p.kills, best = p.best, air = p.air, pilot = p.pilot, airOn = p.airOn, pilotOn = p.pilotOn, jetOn = p.jetOn, double = p.double == true }
end

function Data.push(player: Player)
	if remotes and profiles[player] then remotes.Profile:FireClient(player, Data.view(player)) end
end

function Data.load(player: Player)
	local p = fresh()
	if store then
		local ok, saved = pcall(function() return store:GetAsync(key(player)) end)
		if ok and typeof(saved) == "table" then
			for k, v in saved do p[k] = v end
		elseif not ok then
			warn("DataStore load failed: ", saved)
		end
	end
	p.air = p.air or {}
	p.pilot = p.pilot or {}
	p.receipts = p.receipts or {}
	profiles[player] = p
	loaded[player] = true
	Data.push(player)
	return p
end

function Data.save(player: Player)
	local p = profiles[player]
	if not p or not store then return end
	local copy = {}
	for k, v in p do if k ~= "double" then copy[k] = v end end
	for attempt = 1, 3 do
		local ok, err = pcall(function() store:SetAsync(key(player), copy) end)
		if ok then return end
		warn("DataStore save failed (" .. attempt .. "): ", err)
		task.wait(2 * attempt)
	end
end

function Data.addCoins(player: Player, n: number)
	local p = profiles[player]
	if not p or n == 0 then return end
	if n > 0 and p.double then n = n * 2 end
	p.coins = math.max(0, p.coins + n)
	Data.push(player)
end

function Data.spend(player: Player, price: number): boolean
	local p = profiles[player]
	if not p or p.coins < price then return false end
	p.coins -= price
	return true
end

function Data.addKill(player: Player)
	local p = profiles[player]
	if not p then return end
	p.kills += 1
end

function Data.start()
	Players.PlayerRemoving:Connect(function(player)
		Data.save(player)
		profiles[player] = nil
		loaded[player] = nil
	end)
	-- autosave every minute
	task.spawn(function()
		while true do
			task.wait(60)
			for _, player in Players:GetPlayers() do
				if loaded[player] then task.spawn(Data.save, player) end
			end
		end
	end)
	game:BindToClose(function()
		for _, player in Players:GetPlayers() do
			if loaded[player] then task.spawn(Data.save, player) end
		end
		task.wait(3)
	end)
end

return Data
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX16"><Properties><string name="Name">Enemies</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The enemy jets (flown by the server) and the waves.  Every co-op room has its own waves: the enemies chase the
-- nearest jet of that room, shoot when they are lined up and fire a missile now and then - the flares and a hard
-- turn are the answer.  (A team-fight room has no AI.)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local JetBuilder = require(Shared.JetBuilder)
local Data = require(script.Parent.Data)
local Combat = require(script.Parent.Combat)
local Rooms = require(script.Parent.Rooms)

local Enemies = {}
local remotes = nil
local rng = Random.new()

local state = {}         -- [roomId] = { list, wave, pending, waveTimer, spawnTimer, idle }

local function stateOf(room)
	local s = state[room.id]
	if not s then
		s = { list = {}, wave = 0, pending = 0, waveTimer = 3, spawnTimer = 0, idle = 0 }
		state[room.id] = s
	end
	return s
end

function Enemies.wave(room): number
	local s = state[room.id]
	return s and s.wave or 0
end
function Enemies.count(room): number
	local s = state[room.id]
	return s and (#s.list + s.pending) or 0
end

-- the room's jets in the air
local function flyers(room)
	local out = {}
	for _, p in Rooms.players(room) do
		local j = Combat.jetOf(p)
		if j then table.insert(out, { player = p, jet = j }) end
	end
	return out
end

local function clearRoom(id: number)
	local s = state[id]
	if not s then return end
	for _, e in s.list do e.model:Destroy() end
	state[id] = nil
end
Enemies.clearRoom = clearRoom

local function spawnOne(room, s)
	local E, W = Config.Enemy, Config.World
	local a = rng:NextNumber(0, math.pi * 2)
	local pos = Vector3.new(math.cos(a) * W.EnemyRing, rng:NextNumber(W.EnemyAltitude[1], W.EnemyAltitude[2]), math.sin(a) * W.EnemyRing)
	local look = (Vector3.new(0, 400, 0) - pos).Unit
	-- an imported enemy model when there is one
	local key = nil
	local have = ReplicatedStorage:FindFirstChild("JetModels")
	if have then
		local avail = {}
		for _, k in Config.EnemyModels do if have:FindFirstChild(k) then table.insert(avail, k) end end
		if #avail > 0 then key = avail[rng:NextInteger(1, #avail)] end
	end
	local model = JetBuilder.build(nil, nil, true, false, nil, key)
	model.Name = "Enemy"
	local hp = E.Health + math.min(s.wave, 10) * 4
	model:SetAttribute("Health", hp)
	model:SetAttribute("MaxHealth", hp)
	model:SetAttribute("RoomId", room.id)
	model.PrimaryPart.Anchored = true
	model:PivotTo(CFrame.lookAt(pos, pos + look))
	model.Parent = workspace.Enemies
	table.insert(s.list, {
		model = model, pos = pos, look = look, bank = 0, speed = E.Speed,
		gunT = 0, missT = rng:NextNumber(4, E.MissileCooldown), phase = rng:NextNumber(0, 6.28),
	})
end

local function startWave(room, s, n)
	s.wave += 1
	s.pending = Config.Enemy.WaveBase + s.wave + math.max(0, n - 1)        -- one more for every extra jet in the air
	s.spawnTimer = 0
	for _, p in Rooms.players(room) do Combat.toast(p, "HULLÁM " .. s.wave .. " – " .. s.pending .. " ellenség jön", "warn") end
end

function Enemies.init(r)
	remotes = r
	Rooms.hooks.closed = function(room) clearRoom(room.id) end
	Combat.EnemyKilled:Connect(function(model, attacker)
		local id = model:GetAttribute("RoomId")
		local room = id and Rooms.byId(id)
		local s = id and state[id]
		if not s then return end
		for i = #s.list, 1, -1 do
			if s.list[i].model == model then table.remove(s.list, i) end
		end
		if room and #s.list == 0 and s.pending == 0 then
			s.waveTimer = Config.Enemy.WaveDelay
			local bonus = Config.Coins.WaveBonus * math.min(s.wave, 10)
			for _, f in flyers(room) do
				Data.addCoins(f.player, bonus)
				Combat.toast(f.player, "HULLÁM " .. s.wave .. " KÉSZ! +" .. bonus .. " érme", "good")
			end
		end
	end)
end

local function nearestTarget(room, pos: Vector3)
	local best, bestD = nil, math.huge
	for _, f in flyers(room) do
		local d = (f.jet:GetPivot().Position - pos).Magnitude
		if d < bestD then best, bestD = f.jet, d end
	end
	return best, bestD
end

local function steer(e, dt: number, wish: Vector3, rate: number)
	local look = e.look
	local ang = math.acos(math.clamp(look:Dot(wish), -1, 1))
	local maxTurn = rate * dt
	local nl = look
	if ang <= maxTurn then nl = wish elseif ang > 1e-4 then nl = look:Lerp(wish, maxTurn / ang).Unit end
	-- bank into the turn (looks right, costs nothing)
	local side = look:Cross(nl).Y
	local want = math.clamp(side / math.max(dt, 1e-3) * 1.4, -1.2, 1.2)
	e.bank += (want - e.bank) * math.min(1, dt * 4)
	e.look = nl
	return ang
end

local function stepRoom(room, dt: number)
	local E, W = Config.Enemy, Config.World
	local s = stateOf(room)
	local fliers = flyers(room)
	if #fliers == 0 then
		-- nobody is flying: the wave stops, the leftovers go away after a while
		s.idle += dt
		if s.idle > 10 and (#s.list > 0 or s.pending > 0) then
			for _, e in s.list do e.model:Destroy() end
			s.list = {}
			s.pending = 0
			s.wave = math.max(0, s.wave - 1)
			s.waveTimer = 3
		end
		return
	end
	s.idle = 0

	-- waves
	if #s.list == 0 and s.pending == 0 then
		s.waveTimer -= dt
		if s.waveTimer <= 0 then startWave(room, s, #fliers) end
	end
	if s.pending > 0 then
		s.spawnTimer -= dt
		if s.spawnTimer <= 0 and #s.list < E.MaxActive then
			spawnOne(room, s)
			s.pending -= 1
			s.spawnTimer = 2.5
		end
	end

	for i = #s.list, 1, -1 do
		local e = s.list[i]
		if not e.model.Parent then
			table.remove(s.list, i)
		else
			local target, dist = nearestTarget(room, e.pos)
			local wish = e.look
			if target then
				local tpos = target:GetPivot().Position
				local tvel = target.PrimaryPart and target.PrimaryPart.AssemblyLinearVelocity or Vector3.zero
				local lead = tpos + tvel * math.clamp(dist / 900, 0, 1.2)
				wish = (lead - e.pos)
				if wish.Magnitude < 1 then wish = e.look else wish = wish.Unit end
				-- swing out a little when very close instead of a head-on pass
				if dist < 250 then wish = (wish + Vector3.new(math.sin(e.phase), 0.25, math.cos(e.phase)) * 0.8).Unit end
			else
				wish = (Vector3.new(0, 500, 0) - e.pos).Unit
			end
			-- the edges of the field and the ground
			if math.abs(e.pos.X) > W.Half - 300 or math.abs(e.pos.Z) > W.Half - 300 then
				wish = (Vector3.new(-e.pos.X, 450 - e.pos.Y, -e.pos.Z)).Unit
			end
			if e.pos.Y < 120 and wish.Y < 0.2 then wish = Vector3.new(wish.X, 0.35, wish.Z).Unit end
			if e.pos.Y > 1600 and wish.Y > -0.1 then wish = Vector3.new(wish.X, -0.3, wish.Z).Unit end
			steer(e, dt, wish, E.TurnRate)
			e.pos += e.look * e.speed * dt
			local up = Vector3.new(0, 1, 0)
			if math.abs(e.look.Y) > 0.98 then up = Vector3.new(0, 0, 1) end
			e.model:PivotTo(CFrame.lookAt(e.pos, e.pos + e.look, up) * CFrame.Angles(0, 0, e.bank))
			e.model:SetAttribute("Vel", e.look * e.speed)
			e.phase += dt * 0.7

			-- weapons
			if target then
				local aimOk = target:GetPivot().Position - e.pos
				local aim = math.acos(math.clamp(e.look:Dot(aimOk.Unit), -1, 1))
				e.gunT -= dt
				if dist < E.GunRange and aim < 0.1 and e.gunT <= 0 then
					e.gunT = 0.2
					local from = e.pos + e.look * 12
					local to = target:GetPivot().Position
					Combat.tracer(room.id, from, from + (to - from).Unit * math.min(dist, E.GunRange), Color3.fromRGB(255, 90, 70), nil)
					if rng:NextNumber() < 0.45 then Combat.damage(target, E.GunDamage, nil, "ellenséges ágyú") end
				end
				e.missT -= dt
				if e.missT <= 0 and dist < E.MissileRange and dist > 700 and aim < 0.45 then
					e.missT = E.MissileCooldown * rng:NextNumber(0.8, 1.3)
					Combat.launchMissile(nil, CFrame.lookAt(e.pos + e.look * 10, e.pos + e.look * 20), target, Config.Missile.Damage * 0.8, room.id)
				end
			end
		end
	end
end

function Enemies.step(dt: number)
	-- only co-op rooms with somebody in the air have waves
	for id, s in state do
		if not Rooms.byId(id) then clearRoom(id) end
	end
	for _, p in Players:GetPlayers() do
		local room = Rooms.get(p)
		if room and room.mode == "coop" and not room._stepped then
			room._stepped = true
			stepRoom(room, dt)
		end
	end
	for _, p in Players:GetPlayers() do
		local room = Rooms.get(p)
		if room then room._stepped = nil end
	end
end

return Enemies
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX17"><Properties><string name="Name">IslandBuilder</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Builds the game's real island as Roblox terrain, from the height grid and the ground colours of the browser game
-- (IslandMath).  It takes a few minutes, so do it ONCE in Studio (see roblox/README.md): the terrain is saved with the place.
--   require(game.ReplicatedStorage.Shared.IslandMath) is not needed by hand - in the Command Bar (View > Command Bar) run:
--   require(game.ServerScriptService.Server.IslandBuilder).build()
-- The terrain is a thin shell (three voxels) over the sea bed: nothing is dug, so it stays light.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Island = require(Shared.Island)
local IslandMath = require(Shared.IslandMath)

local IslandBuilder = {}

local MATERIAL = {
	[0] = Enum.Material.Sand,
	[1] = Enum.Material.Grass,
	[2] = Enum.Material.LeafyGrass,
	[3] = Enum.Material.Ground,
	[4] = Enum.Material.Rock,
	[5] = Enum.Material.Sand,
	[6] = Enum.Material.Snow,
}

function IslandBuilder.build(progress: ((number) -> ())?)
	IslandMath.load()
	local terrain = workspace.Terrain
	terrain:Clear()
	local V = Config.Island.Voxel
	local half = Config.World.Half
	local nv = math.floor(half * 2 / V)              -- voxels per side
	local VS = Config.Island.HeightScale
	local field = IslandMath.airfield()
	local SLAB = 16
	local t0 = os.clock()
	local slabsPerSide = math.ceil(nv / SLAB)
	local total, done = slabsPerSide * slabsPerSide, 0

	for sx = 0, slabsPerSide - 1 do
		for sz = 0, slabsPerSide - 1 do
			local vx0, vz0 = sx * SLAB, sz * SLAB
			local w, d = math.min(SLAB, nv - vx0), math.min(SLAB, nv - vz0)
			-- the ground of every column of the slab
			local surf, mat = {}, {}
			local lo, hi = math.huge, -math.huge
			for x = 1, w do
				surf[x], mat[x] = {}, {}
				for z = 1, d do
					local X = (vx0 + x - 0.5) * V - half
					local Z = (vz0 + z - 0.5) * V - half
					local y = IslandMath.height(X, Z)
					-- the air base is flat
					if math.abs(X - field.X) < 190 and math.abs(Z - field.Z) < 230 then y = field.Y end
					surf[x][z] = y
					mat[x][z] = y > 0.5 and IslandMath.material(X, Z) or 0
					local top = math.floor(y / V)
					if top < lo then lo = top end
					if top > hi then hi = top end
				end
			end
			if hi > -1 or lo < 0 then
				local vyLo = math.min(lo - 2, -2)
				local vyHi = math.max(hi, 0)
				local h = vyHi - vyLo + 1
				local materials, occupancy = {}, {}
				for x = 1, w do
					materials[x], occupancy[x] = {}, {}
					for y = 1, h do
						materials[x][y], occupancy[x][y] = {}, {}
						for z = 1, d do
							materials[x][y][z] = Enum.Material.Air
							occupancy[x][y][z] = 0
						end
					end
					for z = 1, d do
						local y = surf[x][z]
						local m = MATERIAL[mat[x][z]]
						if y > 0.5 then
							local k = math.floor(y / V)
							for vy = k - 2, k do
								local idx = vy - vyLo + 1
								materials[x][idx][z] = m
								occupancy[x][idx][z] = vy == k and math.max(0.2, (y - k * V) / V) or 1
							end
						else
							-- the sea bed and a layer of water over it, round the coast
							local bed = -2 - vyLo + 1
							materials[x][bed][z] = Enum.Material.Sand
							occupancy[x][bed][z] = 1
							materials[x][bed + 1][z] = Enum.Material.Water
							occupancy[x][bed + 1][z] = 1
						end
					end
				end
				local region = Region3.new(
					Vector3.new(vx0 * V - half, vyLo * V, vz0 * V - half),
					Vector3.new((vx0 + w) * V - half, (vyHi + 1) * V, (vz0 + d) * V - half))
				terrain:WriteVoxels(region, V, materials, occupancy)
			end
			done += 1
			if done % 40 == 0 then
				if progress then progress(done / total) end
				task.wait()
			end
		end
	end
	workspace:SetAttribute("IslandBuilt", true)
	print(string.format("Dogfight Plus: the island is built (%.0f s). Save the place now (File > Save).", os.clock() - t0))
end

return IslandBuilder
]]></ProtectedString></Properties></Item>
<Item class="Script" referent="RBX18"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Dogfight Plus for Roblox: the server's entry point.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local Data = require(script.Parent.Data)
local Shop = require(script.Parent.Shop)
local World = require(script.Parent.World)
local Rooms = require(script.Parent.Rooms)
local Combat = require(script.Parent.Combat)
local Enemies = require(script.Parent.Enemies)

Players.CharacterAutoLoads = false          -- there is no avatar: the player is the jet
local remotes = Remotes.init()

World.build()
Data.init(remotes)
Data.start()
Shop.start(remotes)
Rooms.init(remotes)
Combat.init(remotes)
Enemies.init(remotes)

Players.PlayerAdded:Connect(function(player)
	Data.load(player)
	Shop.onLoaded(player)
end)
for _, player in Players:GetPlayers() do
	task.spawn(function()
		Data.load(player)
		Shop.onLoaded(player)
	end)
end

local lastLaunch = {}
remotes.Launch.OnServerEvent:Connect(function(player, kind)
	if not Data.isLoaded(player) then return end
	if not Rooms.get(player) then Rooms.quickPlay(player) end
	local now = os.clock()
	if now - (lastLaunch[player] or 0) < 2 then return end
	lastLaunch[player] = now
	Combat.spawnPlayerJet(player, kind == "twoseat")
end)
Players.PlayerRemoving:Connect(function(player) lastLaunch[player] = nil end)

local hudTimer, coinTimer = 0, 0
RunService.Heartbeat:Connect(function(dt)
	Combat.step(dt)
	Enemies.step(dt)

	Rooms.step(dt)
	hudTimer += dt
	if hudTimer >= 0.25 then
		hudTimer = 0
		for _, player in Players:GetPlayers() do
			local jet, role = Combat.seatOf(player)
			if jet then
				local room = Rooms.get(player)
				local partner = nil
				for _, o in Combat.occupants(jet) do
					if o ~= player then partner = o.DisplayName end
				end
				remotes.Hud:FireClient(player, {
					wave = room and Enemies.wave(room) or 0, enemies = room and Enemies.count(room) or 0,
					hp = jet:GetAttribute("Health"), maxHp = jet:GetAttribute("MaxHealth"),
					missiles = jet:GetAttribute("Missiles"), flares = jet:GetAttribute("Flares"),
					role = role, partner = partner, mode = room and room.mode or "coop", team = room and room.team[player] or "A",
					scoreA = room and room.score.A or 0, scoreB = room and room.score.B or 0, markUid = jet:GetAttribute("MarkUid") or 0,
					roomName = room and room.name or "",
				})
			end
		end
	end

	-- a trickle of coins for time in the air
	coinTimer += dt
	if coinTimer >= 1 then
		coinTimer = 0
		for _, player in Players:GetPlayers() do
			if Combat.seatOf(player) then Data.addCoins(player, Config.Coins.Survive) end
		end
	end
end)

print("Dogfight Plus server ready")
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX19"><Properties><string name="Name">Rooms</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The hangar groups ("rooms"): a player opens a room, says how many more may come in (20 in all at most), and the
-- others join from the list (or with the code of a private room).  Everybody moves themselves between the two
-- teams of a team-fight room, in any split.  A room is a group inside the server: what happens in it (enemy waves,
-- the fight between the teams, the missiles) only concerns its members.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")

local Config = require(ReplicatedStorage:WaitForChild("Shared").Config)
local R = Config.Rooms

local Rooms = {}
Rooms.hooks = {}          -- left(player, room), closed(room)

local rooms = {}          -- [id] = room
local roomOf = {}         -- [Player] = room
local nextId = 1
local remotes = nil
local rng = Random.new()

function Rooms.get(player: Player)
	return roomOf[player]
end
function Rooms.byId(id)
	return rooms[id]
end

function Rooms.count(room): number
	local n = 0
	for _ in room.members do n += 1 end
	return n
end

function Rooms.players(room): { Player }
	local out = {}
	for p in room.members do table.insert(out, p) end
	return out
end

-- a text a player typed that others will read goes through Roblox's filter
local function filtered(text: string, player: Player): string
	text = string.sub(text or "", 1, R.NameMax)
	local ok, result = pcall(function()
		local f = TextService:FilterStringAsync(text, player.UserId)
		return f:GetNonChatStringForBroadcastAsync()
	end)
	if ok and typeof(result) == "string" and result ~= "" then return result end
	return player.DisplayName .. " szobája"
end

local function newCode(): string
	for _ = 1, 50 do
		local c = string.format("%04d", rng:NextInteger(0, 9999))
		local free = true
		for _, r in rooms do
			if r.code == c then free = false break end
		end
		if free then return c end
	end
	return string.format("%04d", rng:NextInteger(0, 9999))
end

local function smallerTeam(room): string
	local a, b = 0, 0
	for _, t in room.team do
		if t == "A" then a += 1 else b += 1 end
	end
	return a <= b and "A" or "B"
end

-- what the members see
function Rooms.view(room, forPlayer: Player?)
	local members = {}
	for p in room.members do
		table.insert(members, { userId = p.UserId, name = p.DisplayName, team = room.team[p] or "A", host = (p == room.host) })
	end
	table.sort(members, function(a, b) return a.name < b.name end)
	local seats = {}
	local jets = workspace:FindFirstChild("Jets")
	if jets then
		for _, j in jets:GetChildren() do
			if j:GetAttribute("RoomId") == room.id and j:GetAttribute("Seats") == 2 and j:GetAttribute("WsoId") == 0 and j:GetAttribute("SeatOpen") then
				local pilot = Players:GetPlayerByUserId(j:GetAttribute("OwnerId") or 0)
				if pilot then table.insert(seats, { userId = pilot.UserId, name = pilot.DisplayName, team = j:GetAttribute("Team") }) end
			end
		end
	end
	return {
		id = room.id, name = room.name, mode = room.mode, max = room.max, private = room.private,
		code = (forPlayer and room.members[forPlayer]) and room.private and room.code or nil,
		host = room.host and room.host.UserId or 0, members = members, seats = seats, score = room.score,
	}
end

function Rooms.push(room)
	for p in room.members do
		remotes.RoomState:FireClient(p, Rooms.view(room, p))
	end
end

local function pushNone(player: Player)
	remotes.RoomState:FireClient(player, nil)
end

function Rooms.leave(player: Player)
	local room = roomOf[player]
	if not room then return end
	roomOf[player] = nil
	room.members[player] = nil
	room.team[player] = nil
	if Rooms.hooks.left then Rooms.hooks.left(player, room) end
	if next(room.members) == nil then
		rooms[room.id] = nil
		if Rooms.hooks.closed then Rooms.hooks.closed(room) end
	else
		if room.host == player then
			for p in room.members do room.host = p break end
		end
		Rooms.push(room)
	end
	if player.Parent then pushNone(player) end
end

local function enter(player: Player, room)
	Rooms.leave(player)
	room.members[player] = true
	room.team[player] = room.mode == "pvp" and smallerTeam(room) or "A"
	roomOf[player] = room
	Rooms.push(room)
end

-- a new room: name, mode ("coop" against the AI waves, "pvp" two teams), how many more may come in, private?
function Rooms.create(player: Player, name: string, mode: string, extra: number, private: boolean)
	if typeof(name) ~= "string" then name = "" end
	extra = math.clamp(math.floor(tonumber(extra) or 3), 0, R.MaxPlayers - 1)
	local room = {
		id = nextId, name = filtered(name ~= "" and name or (player.DisplayName .. " szobája"), player), host = player,
		mode = mode == "pvp" and "pvp" or "coop", max = 1 + extra, private = private == true, code = nil,
		members = {}, team = {}, score = { A = 0, B = 0 }, created = os.time(),
	}
	nextId += 1
	if room.private then room.code = newCode() end
	rooms[room.id] = room
	enter(player, room)
	return true, room.id
end

function Rooms.list()
	local out = {}
	for _, r in rooms do
		if not r.private then
			table.insert(out, { id = r.id, name = r.name, mode = r.mode, count = Rooms.count(r), max = r.max, host = r.host and r.host.DisplayName or "" })
		end
	end
	table.sort(out, function(a, b) return a.id < b.id end)
	return out
end

-- by room id, or by the 4-digit code of a private room
function Rooms.join(player: Player, ref)
	local room = nil
	if typeof(ref) == "number" then
		room = rooms[ref]
		if room and room.private then room = nil end
	elseif typeof(ref) == "string" then
		local code = string.gsub(ref, "%s", "")
		for _, r in rooms do
			if r.private and r.code == code then room = r end
		end
	end
	if not room then return false, "Nincs ilyen szoba" end
	if roomOf[player] == room then return true, "Már itt vagy" end
	if Rooms.count(room) >= room.max then return false, "A szoba megtelt" end
	enter(player, room)
	return true, room.name
end

function Rooms.quickPlay(player: Player)
	local best = nil
	for _, r in rooms do
		if not r.private and r.mode == "coop" and Rooms.count(r) < r.max then
			if not best or Rooms.count(r) > Rooms.count(best) then best = r end
		end
	end
	if best then return Rooms.join(player, best.id) end
	return Rooms.create(player, "", "coop", 7, false)
end

-- everybody moves themselves ("A" or "B"), in any split
function Rooms.setTeam(player: Player, team)
	local room = roomOf[player]
	if not room or room.mode ~= "pvp" then return false, "Ez a szoba nem csapatharc" end
	if team ~= "A" and team ~= "B" then return false end
	if player and room.team[player] == team then return true end
	if Rooms.hooks.canSwitch and not Rooms.hooks.canSwitch(player, room) then return false, "Repülés közben nem lehet csapatot váltani" end
	room.team[player] = team
	Rooms.push(room)
	return true
end

function Rooms.setSlots(player: Player, extra)
	local room = roomOf[player]
	if not room or room.host ~= player then return false, "Csak a szoba nyitója állíthatja" end
	extra = math.clamp(math.floor(tonumber(extra) or 0), 0, R.MaxPlayers - 1)
	room.max = math.max(Rooms.count(room), 1 + extra)
	Rooms.push(room)
	return true, room.max
end

function Rooms.score(room, team: string)
	room.score[team] = (room.score[team] or 0) + 1
end

function Rooms.init(r)
	remotes = r
	remotes.ListRooms.OnServerInvoke = function() return Rooms.list() end
	remotes.CreateRoom.OnServerInvoke = function(player, name, mode, extra, private) return Rooms.create(player, name, mode, extra, private) end
	remotes.JoinRoom.OnServerInvoke = function(player, ref) return Rooms.join(player, ref) end
	remotes.LeaveRoom.OnServerInvoke = function(player) Rooms.leave(player) return true end
	remotes.QuickPlay.OnServerInvoke = function(player) return Rooms.quickPlay(player) end
	remotes.SetTeam.OnServerInvoke = function(player, team) return Rooms.setTeam(player, team) end
	remotes.SetSlots.OnServerInvoke = function(player, extra) return Rooms.setSlots(player, extra) end
	Players.PlayerRemoving:Connect(function(player) Rooms.leave(player) end)
end

-- the open rear seats change: now and then everybody gets the fresh state
function Rooms.step(dt: number)
	Rooms._t = (Rooms._t or 0) + dt
	if Rooms._t < 1.5 then return end
	Rooms._t = 0
	for _, room in rooms do Rooms.push(room) end
end

return Rooms
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX20"><Properties><string name="Name">Shop</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The shop: skins for coins, and coin packs / the double-coins pass for Robux.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Catalog = require(Shared.Catalog)
local Data = require(script.Parent.Data)
local Combat = require(script.Parent.Combat)

local Shop = {}

local function ownsPass(player: Player): boolean
	if Config.DoubleCoinsPass == 0 then return false end
	local ok, has = pcall(function() return MarketplaceService:UserOwnsGamePassAsync(player.UserId, Config.DoubleCoinsPass) end)
	return ok and has == true
end

-- called when a player's data is in: the pass is checked once per visit
function Shop.onLoaded(player: Player)
	local p = Data.get(player)
	if p and ownsPass(player) then
		p.double = true
		Data.push(player)
	end
end

function Shop.start(remotes)
	remotes.GetProfile.OnServerInvoke = function(player)
		return Data.view(player)
	end

	remotes.BuyAir.OnServerInvoke = function(player, id)
		local p = Data.get(player)
		local skin = typeof(id) == "string" and Catalog.AirById[id]
		if not p or not skin then return false, "Ismeretlen festés" end
		if p.air[id] then return false, "Ez már a tiéd" end
		if not Data.spend(player, skin.price) then return false, "Nincs elég érméd" end
		p.air[id] = true
		p.airOn = id
		Data.push(player)
		return true, skin.name .. " megvéve!"
	end

	remotes.BuyPilot.OnServerInvoke = function(player, id)
		local p = Data.get(player)
		local skin = typeof(id) == "string" and Catalog.PilotById[id]
		if not p or not skin then return false, "Ismeretlen ruha" end
		if p.pilot[id] then return false, "Ez már a tiéd" end
		if not Data.spend(player, skin.price) then return false, "Nincs elég érméd" end
		p.pilot[id] = true
		p.pilotOn = id
		Data.push(player)
		return true, skin.name .. " megvéve!"
	end

	remotes.EquipJet.OnServerInvoke = function(player, key)
		local p = Data.get(player)
		if not p then return false end
		if key == nil or key == "" then p.jetOn = nil
		else
			local ok = false
			for _, j in Config.JetModels do if j.key == key then ok = true end end
			if not ok then return false end
			p.jetOn = key
		end
		Data.push(player)
		return true
	end

	remotes.EquipAir.OnServerInvoke = function(player, id)
		local p = Data.get(player)
		if not p then return false end
		if id == nil or id == "" then p.airOn = nil
		elseif typeof(id) == "string" and p.air[id] then p.airOn = id
		else return false end
		Data.push(player)
		return true
	end

	remotes.EquipPilot.OnServerInvoke = function(player, id)
		local p = Data.get(player)
		if not p then return false end
		if id == nil or id == "" then p.pilotOn = nil
		elseif typeof(id) == "string" and p.pilot[id] then p.pilotOn = id
		else return false end
		Data.push(player)
		return true
	end

	-- a skin for Robux: the price is the skin's tier (Config.SkinRobux, 500 Ft at most); the pick is remembered until the receipt
	remotes.BuySkinRobux.OnServerInvoke = function(player, kind, id)
		local p = Data.get(player)
		if not p or (kind ~= "air" and kind ~= "pilot") then return false, "Hiba" end
		local skin = typeof(id) == "string" and (kind == "air" and Catalog.AirById[id] or Catalog.PilotById[id])
		if not skin then return false, "Ismeretlen skin" end
		if (kind == "air" and p.air or p.pilot)[id] then return false, "Ez már a tiéd" end
		local product = Config.SkinProducts[skin.rarity]
		if not product or product == 0 then return false, "A Robux-vásárlás még nincs beállítva" end
		p.pending = { kind = kind, id = id, rarity = skin.rarity }
		task.spawn(Data.save, player)
		MarketplaceService:PromptProductPurchase(player, product)
		return true, tostring(Config.SkinRobux[skin.rarity]) .. " Robux"
	end

	-- Robux: the client asks, the server opens the purchase window (only for an id that is in the Config)
	remotes.BuyProduct.OnServerInvoke = function(player, index)
		local prod = typeof(index) == "number" and Config.Products[index]
		if not prod or prod.id == 0 then return false end
		MarketplaceService:PromptProductPurchase(player, prod.id)
		return true
	end
	remotes.BuyPass.OnServerInvoke = function(player)
		if Config.DoubleCoinsPass == 0 then return false end
		MarketplaceService:PromptGamePassPurchase(player, Config.DoubleCoinsPass)
		return true
	end
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if purchased and passId == Config.DoubleCoinsPass then
			local p = Data.get(player)
			if p then p.double = true; Data.push(player) end
		end
	end)

	-- the receipt of a developer product: the coins are given once per purchase
	MarketplaceService.ProcessReceipt = function(info)
		local player = Players:GetPlayerByUserId(info.PlayerId)
		if not player then return Enum.ProductPurchaseDecision.NotProcessedYet end
		local p = Data.get(player)
		if not p then return Enum.ProductPurchaseDecision.NotProcessedYet end
		local rid = tostring(info.PurchaseId)
		if p.receipts[rid] then return Enum.ProductPurchaseDecision.PurchaseGranted end
		-- a skin: the four rarity products
		for rarity, pid in Config.SkinProducts do
			if pid ~= 0 and pid == info.ProductId then
				p.receipts[rid] = true
				local pend = p.pending
				if pend and pend.rarity == rarity then
					(pend.kind == "air" and p.air or p.pilot)[pend.id] = true
					if pend.kind == "air" then p.airOn = pend.id else p.pilotOn = pend.id end
					Combat.toast(player, "Megvetted: " .. pend.id, "good")
				else
					p.coins += Config.TierCoins[rarity]       -- the pick was lost (a restart): the same value in coins
				end
				p.pending = nil
				Data.push(player)
				task.spawn(Data.save, player)
				return Enum.ProductPurchaseDecision.PurchaseGranted
			end
		end
		for _, prod in Config.Products do
			if prod.id == info.ProductId then
				p.receipts[rid] = true
				p.coins += prod.coins          -- bought coins are not doubled
				Data.push(player)
				task.spawn(Data.save, player)
				return Enum.ProductPurchaseDecision.PurchaseGranted
			end
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
end

return Shop
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX21"><Properties><string name="Name">Tools</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Helpers for the Command Bar of Roblox Studio (View > Command Bar), run in edit mode.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared").Config)

local Tools = {}

-- Moves the imported jet models (the .glb files imported with File > Import 3D, named f16, fa18, ...) from the
-- Workspace into ReplicatedStorage.JetModels, where the game looks for them.   require(game.ServerScriptService.Server.Tools).adoptJets()
function Tools.adoptJets()
	local folder = ReplicatedStorage:FindFirstChild("JetModels")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "JetModels"
		folder.Parent = ReplicatedStorage
	end
	local n = 0
	for _, j in Config.JetModels do
		for _, c in workspace:GetChildren() do
			if c.Name == j.key and (c:IsA("Model") or c:IsA("MeshPart") or c:IsA("Folder")) then
				if c:IsA("MeshPart") then
					local m = Instance.new("Model")
					m.Name = j.key
					c.Parent = m
					c = m
				end
				c.Parent = folder
				n += 1
			end
		end
	end
	print(string.format("Dogfight Plus: %d jet model(s) moved to ReplicatedStorage.JetModels (now: %d). Save the place.", n, #folder:GetChildren()))
end

-- Lists which jets are imported.
function Tools.listJets()
	local folder = ReplicatedStorage:FindFirstChild("JetModels")
	for _, j in Config.JetModels do
		print(j.key, folder and folder:FindFirstChild(j.key) and "imported" or "-")
	end
end

return Tools
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX22"><Properties><string name="Name">World</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The playing field: a green island with hills and a runway in a wide sea, the sky and the light.
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared").Config)
local IslandMath = require(ReplicatedStorage:WaitForChild("Shared").IslandMath)

local World = {}

-- the air base (the game's own place, on the island's plateau): runway, taxiway, apron, hangars, tower
local function airBase(box, field: Vector3)
	local y = field.Y + 0.6
	local len, wid = 300, 4.5                                        -- 3000 m x 45 m at 1:10
	box("Runway", Vector3.new(wid * 2.4, 1, len), Vector3.new(field.X, y, field.Z), Color3.fromRGB(58, 62, 68))
	for i = -6, 6 do box("RunwayMark", Vector3.new(0.8, 0.2, 10), Vector3.new(field.X, y + 0.6, field.Z + i * 22), Color3.fromRGB(235, 235, 235)) end
	box("Taxiway", Vector3.new(2.6, 1, len), Vector3.new(field.X + 19, y, field.Z), Color3.fromRGB(70, 74, 80))
	box("Apron", Vector3.new(26, 1, 70), Vector3.new(field.X + 39, y, field.Z), Color3.fromRGB(78, 82, 88))
	for i = -1, 1 do box("Hangar", Vector3.new(14, 7, 12), Vector3.new(field.X + 56, y + 3.5, field.Z + i * 24), Color3.fromRGB(122, 128, 134)) end
	box("Tower", Vector3.new(3, 14, 3), Vector3.new(field.X + 30, y + 7, field.Z - 34), Color3.fromRGB(190, 196, 202))
end

function World.build()
	local W = Config.World
	local terrain = workspace.Terrain
	local function box(name, size, pos, col)
		local p = Instance.new("Part")
		p.Name = name
		p.Anchored = true
		p.Size = size
		p.Position = pos
		p.Color = col
		p.Material = Enum.Material.Concrete
		p.Parent = workspace
		return p
	end

	local island = workspace:GetAttribute("IslandBuilt") == true
	if island then
		-- the game's own island is already in the place (IslandBuilder, built once in Studio)
		airBase(box, IslandMath.airfield())
	else
		warn("Dogfight Plus: the real island is not built yet (see roblox/README.md, 'A sziget'). A simple island is used meanwhile.")
		terrain:Clear()
		terrain:FillCylinder(CFrame.new(0, -6, 0), 32, 1500, Enum.Material.Grass)
		local rng = Random.new(7)
		local mats = { Enum.Material.Grass, Enum.Material.Grass, Enum.Material.Ground, Enum.Material.Rock }
		for i = 1, 26 do
			local a, r = rng:NextNumber(0, math.pi * 2), rng:NextNumber(650, 1300)
			terrain:FillBall(Vector3.new(math.cos(a) * r, rng:NextNumber(-20, 40), math.sin(a) * r), rng:NextNumber(110, 320), mats[rng:NextInteger(1, #mats)])
		end
		terrain:FillCylinder(CFrame.new(0, -14, 0), 16, 1590, Enum.Material.Sand)
		terrain:FillCylinder(CFrame.new(0, -6, 0), 32, 1470, Enum.Material.Grass)
		airBase(box, Vector3.new(0, 10, 0))
	end

	-- the sea (a big part: cheaper than terrain water at this size)
	local sea = Instance.new("Part")
	sea.Name = "Sea"
	sea.Anchored = true
	sea.CanCollide = false
	sea.Size = Vector3.new(W.Half * 2 + 8000, 1, W.Half * 2 + 8000)
	sea.Position = Vector3.new(0, -1.6, 0)
	sea.Color = Color3.fromRGB(28, 96, 150)
	sea.Material = Enum.Material.SmoothPlastic
	sea.Transparency = 0.12
	sea.Reflectance = 0.15
	sea.Parent = workspace

	Lighting.ClockTime = 14
	Lighting.Brightness = 3
	Lighting.OutdoorAmbient = Color3.fromRGB(120, 130, 150)
	local atm = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atm.Density = 0.22
	atm.Offset = 0.2
	atm.Color = Color3.fromRGB(190, 205, 225)
	atm.Decay = Color3.fromRGB(150, 170, 200)
	atm.Glare = 0.1
	atm.Haze = 1.2
	atm.Parent = Lighting
end

-- where a player's jet starts: over the air base (the two teams of a team fight on its two sides)
function World.spawnPoint(team: string?, pvp: boolean?, rng)
	local field = IslandMath.airfield()
	local W = Config.World
	local a
	if pvp then a = (team == "A" and math.pi or 0) + rng:NextNumber(-0.5, 0.5) else a = rng:NextNumber(0, math.pi * 2) end
	local pos = Vector3.new(field.X + math.cos(a) * W.SpawnRadius, field.Y + W.SpawnHeight + rng:NextNumber(-60, 60), field.Z + math.sin(a) * W.SpawnRadius)
	local look = Vector3.new(field.X - pos.X, 0, field.Z - pos.Z).Unit
	return pos, look
end

return World
]]></ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="StarterPlayer" referent="RBX37"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX36"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX35"><Properties><string name="Name">Client</string></Properties><Item class="ModuleScript" referent="RBX25"><Properties><string name="Name">Flight</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The flight: the player's own jet is flown here, on the client (it owns the physics of its jet, so the
-- controls are instant).  An arcade model: throttle and drag set the speed, the pitch / roll / yaw rates
-- grow with speed, a stall drops the nose.  The server checks the shooting, so nothing here can hurt anybody.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local JetBuilder = require(Shared.JetBuilder)
local State = require(script.Parent.State)

local Flight = {}

local J = Config.Jet
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local active = false
local jet, body, remotes
local pos, rot, speed, throttle = Vector3.zero, CFrame.new(), 0, 0.7
local camRot = CFrame.new()
local cockpit = false
local firing = false
local lastShot = 0
local invertPitch = false
local mouseSteer = UserInputService.MouseEnabled and not UserInputService.TouchEnabled   -- M switches it
local touch = { roll = 0, pitch = 0, throttle = 0 }   -- set by the on-screen controls (Hud.luau)
local stallWarn, edgeWarn = false, false
local lockTarget = nil
local onCrash = nil

Flight.touch = touch
Flight.state = {}

local ignore = RaycastParams.new()
ignore.FilterType = Enum.RaycastFilterType.Exclude

-- ------------------------------------------------------------------ effects
local function beam(a: Vector3, b: Vector3, color: Color3)
	local len = (b - a).Magnitude
	if len < 1 then return end
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Size = Vector3.new(0.35, 0.35, len)
	p.CFrame = CFrame.lookAt((a + b) / 2, b)
	p.Parent = workspace
	TweenService:Create(p, TweenInfo.new(0.18), { Transparency = 1 }):Play()
	Debris:AddItem(p, 0.25)
end
Flight.beam = beam

-- ------------------------------------------------------------------ input
local function axis(pos_key: Enum.KeyCode, neg_key: Enum.KeyCode): number
	local v = 0
	if UserInputService:IsKeyDown(pos_key) then v += 1 end
	if UserInputService:IsKeyDown(neg_key) then v -= 1 end
	return v
end

local function readInput()
	local pitch, roll, yaw = 0, 0, 0
	-- keyboard: S / Down pulls up, W / Up pushes down; A / D (arrows) roll; Q / E rudder
	pitch += axis(Enum.KeyCode.S, Enum.KeyCode.W) + axis(Enum.KeyCode.Down, Enum.KeyCode.Up)
	roll += axis(Enum.KeyCode.D, Enum.KeyCode.A) + axis(Enum.KeyCode.Right, Enum.KeyCode.Left)
	yaw += axis(Enum.KeyCode.E, Enum.KeyCode.Q)
	-- mouse: the cursor steers (above the middle: nose up, right of the middle: bank right)
	if mouseSteer and UserInputService.MouseEnabled then
		local m = UserInputService:GetMouseLocation()
		local size = camera.ViewportSize
		local dx = (m.X - size.X / 2) / (size.X * 0.3)
		local dy = (m.Y - size.Y / 2) / (size.Y * 0.3)
		local function dead(v: number): number
			if math.abs(v) < 0.1 then return 0 end
			return math.clamp(v - math.sign(v) * 0.1, -1, 1)
		end
		roll += dead(dx)
		yaw += dead(dx) * 0.5
		pitch += -dead(dy)
	end
	-- gamepad
	for _, st in UserInputService:GetGamepadState(Enum.UserInputType.Gamepad1) do
		if st.KeyCode == Enum.KeyCode.Thumbstick1 then
			local p = st.Position
			if math.abs(p.X) > 0.12 then roll += p.X; yaw += p.X * 0.4 end
			if math.abs(p.Y) > 0.12 then pitch += -p.Y end
		elseif st.KeyCode == Enum.KeyCode.Thumbstick2 then
			if math.abs(st.Position.X) > 0.12 then yaw += st.Position.X end
		end
	end
	-- touch controls
	roll += touch.roll
	yaw += touch.roll * 0.5
	pitch += touch.pitch
	if invertPitch then pitch = -pitch end
	return math.clamp(pitch, -1, 1), math.clamp(roll, -1, 1), math.clamp(yaw, -1, 1)
end

local function readThrottle(dt: number)
	local d = 0
	if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.R) then d += 1 end
	if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.F) then d -= 1 end
	for _, st in UserInputService:GetGamepadState(Enum.UserInputType.Gamepad1) do
		if st.KeyCode == Enum.KeyCode.ButtonR2 then d += st.Position.Z end
		if st.KeyCode == Enum.KeyCode.ButtonL2 then d -= st.Position.Z end
	end
	d += touch.throttle
	throttle = math.clamp(throttle + d * 0.6 * dt, 0, 1)
end

-- the enemy in front of the nose that a missile can lock (the HUD draws the box); the one the rear seat marked comes first
local function findLock()
	local best, bestAng = nil, math.rad(Config.Missile.Cone)
	local look = rot.LookVector
	local function consider(m: Instance)
		if not m:IsA("Model") or not State.hostile(m) then return end
		local to = m:GetPivot().Position - pos
		local d = to.Magnitude
		if d < Config.Missile.Range and d > 80 then
			local ang = math.acos(math.clamp(look:Dot(to.Unit), -1, 1))
			if (Flight.markUid or 0) ~= 0 and m:GetAttribute("Uid") == Flight.markUid then ang *= 0.4 end
			if ang < bestAng then best, bestAng = m, ang end
		end
	end
	for _, m in workspace.Enemies:GetChildren() do consider(m) end
	for _, m in workspace.Jets:GetChildren() do consider(m) end
	return best
end

local function fireMissile()
	if lockTarget and lockTarget.Parent then remotes.FireMissile:FireServer(lockTarget) end
end

-- ------------------------------------------------------------------ the frame
local function step(dt: number)
	if not active or not jet or not jet.Parent then return end
	dt = math.min(dt, 0.1)
	local pitchIn, rollIn, yawIn = readInput()
	readThrottle(dt)

	-- control authority grows with speed: slow = mushy, fast = crisp
	local eff = math.clamp((speed - J.StallSpeed * 0.8) / (J.CornerSpeed - J.StallSpeed * 0.8), 0.15, 1.15)
	local dPitch = pitchIn * J.PitchRate * eff * dt
	local dRoll = rollIn * J.RollRate * dt
	local dYaw = yawIn * J.YawRate * dt

	-- a stall: the nose falls
	local stalled = speed < J.StallSpeed
	if stalled then
		dPitch -= (1 - speed / J.StallSpeed) * 0.9 * dt
	end
	stallWarn = stalled

	-- out of the field: the jet is turned back (the edge of the world)
	local W = Config.World
	local flat = Vector3.new(pos.X, 0, pos.Z)
	edgeWarn = flat.Magnitude > W.Half
	local forward = rot.LookVector
	local newLook = forward
	if edgeWarn then
		local want = (Vector3.new(-pos.X, 300 - pos.Y, -pos.Z)).Unit
		local ang = math.acos(math.clamp(forward:Dot(want), -1, 1))
		if ang > 0.01 then newLook = forward:Lerp(want, math.min(1, 0.9 * dt / ang)).Unit end
	end

	rot = rot * CFrame.Angles(dPitch, -dYaw, -dRoll)
	if edgeWarn then
		local up = rot.UpVector
		rot = CFrame.lookAt(Vector3.zero, newLook, up:Dot(newLook) > 0.98 and Vector3.new(0, 0, 1) or Vector3.new(0, 1, 0))
	end

	-- speed: thrust against drag, gravity along the climb
	local ab = throttle > 0.95
	local thrust = J.Accel * throttle * (ab and J.Afterburner or 1)
	local drag = J.Drag * speed * speed
	forward = rot.LookVector
	speed += (thrust - drag - workspace.Gravity * 0.5 * forward.Y) * dt
	speed = math.max(speed, 40)

	local vel = forward * speed
	if stalled then vel += Vector3.new(0, -(J.StallSpeed - speed) * 0.9, 0) end
	local nextPos = pos + vel * dt

	-- the ground and the sea: a crash
	ignore.FilterDescendantsInstances = { workspace.Jets, workspace.Enemies, workspace.Missiles, workspace.Effects }
	local hit = workspace:Raycast(pos, (nextPos - pos) + forward * 6, ignore)
	if hit or nextPos.Y < -2 then
		active = false
		remotes.Crashed:FireServer()
		if onCrash then onCrash() end
		return
	end
	pos = nextPos
	jet:PivotTo(CFrame.new(pos) * rot.Rotation)
	body.AssemblyLinearVelocity = vel
	body.AssemblyAngularVelocity = Vector3.zero
	JetBuilder.setFlame(jet, throttle)

	-- guns: held fire
	if firing and os.clock() - lastShot >= 1 / Config.Gun.Rate then
		lastShot = os.clock()
		remotes.Fire:FireServer()
		local origin = pos + forward * 12
		beam(origin, origin + forward * Config.Gun.Range * 0.5, Color3.fromRGB(255, 240, 140))
	end

	lockTarget = findLock()

	-- the camera: behind and above, lagging a little in the turns; V = from the cockpit
	camRot = camRot:Lerp(rot.Rotation, 1 - math.exp(-dt * 7))
	if cockpit then
		camera.CFrame = CFrame.new(pos) * rot.Rotation * CFrame.new(0, 1.9, -3.3)
		camera.FieldOfView = 78
	else
		local cp = pos + camRot.Rotation * Vector3.new(0, 6.5, 30)
		camera.CFrame = CFrame.lookAt(cp, pos + rot.LookVector * 90, camRot.UpVector)
		camera.FieldOfView = 68 + math.clamp((speed - 250) / 250, 0, 1) * 14
	end

	local s = Flight.state
	s.speed, s.alt, s.throttle, s.ab, s.stall, s.edge, s.lock, s.pos, s.look, s.mouse = speed, pos.Y, throttle, ab, stallWarn, edgeWarn, lockTarget, pos, rot.LookVector, mouseSteer
end

-- ------------------------------------------------------------------ public
function Flight.init(r)
	remotes = r
	UserInputService.InputBegan:Connect(function(input, processed)
		if not active then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1 and not processed then firing = true; return end
		if processed then return end
		local k = input.KeyCode
		if k == Enum.KeyCode.Space or k == Enum.KeyCode.ButtonA then firing = true
		elseif k == Enum.KeyCode.M then mouseSteer = not mouseSteer
		elseif k == Enum.KeyCode.X or k == Enum.KeyCode.ButtonX then fireMissile()
		elseif k == Enum.KeyCode.G or k == Enum.KeyCode.ButtonB then remotes.Flare:FireServer()
		elseif k == Enum.KeyCode.V or k == Enum.KeyCode.ButtonY then cockpit = not cockpit; if Flight.onCockpit then Flight.onCockpit(cockpit) end
		elseif k == Enum.KeyCode.I then invertPitch = not invertPitch end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.ButtonA then firing = false end
	end)
	-- the right mouse button is a key code in InputBegan only for some set-ups: take it by input type too
	UserInputService.InputBegan:Connect(function(input, processed)
		if active and not processed and input.UserInputType == Enum.UserInputType.MouseButton2 then fireMissile() end
	end)
	RunService:BindToRenderStep("DogfightFlight", Enum.RenderPriority.Camera.Value + 1, step)
end

function Flight.start(model: Model, crashed: () -> ())
	jet = model
	body = model.PrimaryPart
	local cf = body.CFrame
	pos, rot = cf.Position, cf.Rotation
	speed, throttle = J.StartSpeed, 0.7
	camRot = rot
	cockpit, firing = false, false
	onCrash = crashed
	camera.CameraType = Enum.CameraType.Scriptable
	active = true
end

function Flight.stop()
	active = false
	firing = false
	if cockpit and Flight.onCockpit then Flight.onCockpit(false) end
	cockpit = false
end

function Flight.fireMissile() fireMissile() end
function Flight.setFiring(v: boolean) firing = v end
function Flight.flare() remotes.Flare:FireServer() end
function Flight.toggleCockpit() cockpit = not cockpit; if Flight.onCockpit then Flight.onCockpit(cockpit) end end
function Flight.isActive(): boolean return active end

return Flight
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX26"><Properties><string name="Name">Hud</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The flight display: speed, altitude, throttle, hull, weapons, enemy markers, the missile lock box, warnings,
-- the toasts, a key help - and the on-screen controls on a phone / tablet.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Ui = require(script.Parent.Ui)
local State = require(script.Parent.State)

local Hud = {}

local camera = workspace.CurrentCamera
local gui
local f = {}              -- the elements
local server = { hp = 100, maxHp = 100, missiles = 0, flares = 0, wave = 0, enemies = 0 }
local profile = { coins = 0, kills = 0 }
local alertOn = false
local markers = {}
local toastBusy = 0

local function text(parent, name, props)
	local l = Ui.label(parent, "", props)
	l.Name = name
	l.Font = Enum.Font.Code
	l.TextStrokeTransparency = 0.6
	f[name] = l
	return l
end

function Hud.init(remotes, flight)
	gui = Ui.make("ScreenGui", { Name = "DogfightHud", ResetOnSpawn = false, IgnoreGuiInset = true, Enabled = false, DisplayOrder = 5, Parent = Players.LocalPlayer:WaitForChild("PlayerGui") })

	-- left bottom: speed, altitude, throttle
	local left = Ui.make("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 16, 1, -150), Size = UDim2.new(0, 230, 0, 140), Parent = gui })
	text(left, "speed", { Position = UDim2.new(0, 0, 0, 0), TextSize = 20, TextColor3 = Ui.Green })
	text(left, "alt", { Position = UDim2.new(0, 0, 0, 26), TextSize = 20, TextColor3 = Ui.Green })
	text(left, "thr", { Position = UDim2.new(0, 0, 0, 52), TextSize = 16, TextColor3 = Ui.Green })
	local bar = Ui.make("Frame", { BackgroundColor3 = Color3.fromRGB(20, 40, 30), BorderSizePixel = 0, Position = UDim2.new(0, 0, 0, 78), Size = UDim2.new(1, -20, 0, 10), Parent = left }, { Ui.corner(4) })
	f.thrFill = Ui.make("Frame", { BackgroundColor3 = Ui.Green, BorderSizePixel = 0, Size = UDim2.new(0.7, 0, 1, 0), Parent = bar }, { Ui.corner(4) })

	-- right bottom: hull and weapons
	local right = Ui.make("Frame", { BackgroundTransparency = 1, Position = UDim2.new(1, -250, 1, -150), Size = UDim2.new(0, 234, 0, 140), Parent = gui })
	text(right, "hp", { Position = UDim2.new(0, 0, 0, 0), TextSize = 18, TextColor3 = Ui.Green, TextXAlignment = Enum.TextXAlignment.Right })
	local hbar = Ui.make("Frame", { BackgroundColor3 = Color3.fromRGB(40, 20, 20), BorderSizePixel = 0, Position = UDim2.new(0, 0, 0, 26), Size = UDim2.new(1, 0, 0, 10), Parent = right }, { Ui.corner(4) })
	f.hpFill = Ui.make("Frame", { BackgroundColor3 = Ui.Green, BorderSizePixel = 0, Size = UDim2.new(1, 0, 1, 0), Parent = hbar }, { Ui.corner(4) })
	text(right, "wpn", { Position = UDim2.new(0, 0, 0, 46), TextSize = 18, TextColor3 = Ui.Amber, TextXAlignment = Enum.TextXAlignment.Right })
	text(right, "gun", { Position = UDim2.new(0, 0, 0, 72), TextSize = 14, TextColor3 = Color3.fromRGB(170, 200, 190), TextXAlignment = Enum.TextXAlignment.Right })

	-- top: coins / wave
	local top = Ui.make("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 16, 0, 12), Size = UDim2.new(0, 300, 0, 60), Parent = gui })
	text(top, "coins", { Position = UDim2.new(0, 0, 0, 0), TextSize = 22, TextColor3 = Ui.Amber })
	text(top, "kills", { Position = UDim2.new(0, 0, 0, 26), TextSize = 16, TextColor3 = Color3.fromRGB(200, 215, 210) })
	text(gui, "wave", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 12), Size = UDim2.new(0, 400, 0, 26), TextSize = 20, TextColor3 = Color3.fromRGB(235, 245, 240), TextXAlignment = Enum.TextXAlignment.Center })

	text(gui, "partner", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 40), Size = UDim2.new(0, 400, 0, 22), TextSize = 16, TextColor3 = Color3.fromRGB(150, 210, 255), TextXAlignment = Enum.TextXAlignment.Center })

	-- warnings and toasts
	text(gui, "alert", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.17, 0), Size = UDim2.new(0, 500, 0, 34), TextSize = 30, TextColor3 = Ui.Red, TextXAlignment = Enum.TextXAlignment.Center, Visible = false })
	text(gui, "warn", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.23, 0), Size = UDim2.new(0, 500, 0, 26), TextSize = 22, TextColor3 = Ui.Amber, TextXAlignment = Enum.TextXAlignment.Center })
	text(gui, "toast", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.3, 0), Size = UDim2.new(0, 560, 0, 30), TextSize = 22, TextColor3 = Color3.new(1, 1, 1), TextXAlignment = Enum.TextXAlignment.Center, TextTransparency = 1 })

	-- the aim point and the steering dot, the lock box
	f.aim = Ui.make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(0, 26, 0, 26), BackgroundTransparency = 1, Parent = gui }, { Ui.make("UIStroke", { Color = Ui.Green, Thickness = 2 }), Ui.corner(13) })
	f.dot = Ui.make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(0, 8, 0, 8), BackgroundColor3 = Ui.Amber, BorderSizePixel = 0, Parent = gui }, { Ui.corner(4) })
	f.lock = Ui.make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(0, 64, 0, 64), BackgroundTransparency = 1, Visible = false, Parent = gui }, { Ui.make("UIStroke", { Color = Ui.Red, Thickness = 3 }) })
	text(f.lock, "lockText", { Position = UDim2.new(0, 0, 1, 2), Size = UDim2.new(1, 0, 0, 18), TextSize = 14, TextColor3 = Ui.Red, TextXAlignment = Enum.TextXAlignment.Center })

	-- the key help (H)
	f.help = Ui.make("TextLabel", {
		BackgroundColor3 = Ui.Panel, BackgroundTransparency = 0.2, Position = UDim2.new(0, 16, 0, 90), Size = UDim2.new(0, 330, 0, 210), Visible = false,
		TextColor3 = Color3.fromRGB(220, 235, 230), Font = Enum.Font.Code, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Parent = gui,
		Text = "Egér: a kurzor irányít (M: ki/be)\nW / S: orr le / fel · A / D: bedöntés\nQ / E: oldalkormány\nShift / Ctrl: gáz · (R / F is)\nSzóköz vagy bal klikk: gépágyú\nX vagy jobb klikk: rakéta (előbb célozz)\nG: flare (rakéta ellen!)\nV: pilótafülke · I: fordított orr\nH: ez a súgó\n\nKontroller: bal pálca, A tűz, X rakéta,\nB flare, Y nézet, R2/L2 gáz",
	}, { Ui.corner(6), Ui.padding(10) })

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.KeyCode == Enum.KeyCode.H then f.help.Visible = not f.help.Visible end
	end)

	remotes.Hud.OnClientEvent:Connect(function(d) server = d end)
	remotes.Profile.OnClientEvent:Connect(function(p) profile = p end)
	remotes.MissileAlert.OnClientEvent:Connect(function(on) alertOn = on end)
	remotes.Toast.OnClientEvent:Connect(function(msg, kind) Hud.toast(msg, kind) end)
	remotes.Tracer.OnClientEvent:Connect(function(a, b, c) flight.beam(a, b, c) end)

	if UserInputService.TouchEnabled then Hud.touchControls(flight) end
end

function Hud.setProfile(p) profile = p end

function Hud.show(v: boolean)
	gui.Enabled = v
	alertOn = false
end

function Hud.toast(msg: string, kind: string?)
	local c = kind == "good" and Ui.Green or kind == "warn" and Ui.Amber or kind == "bad" and Ui.Red or Color3.new(1, 1, 1)
	f.toast.Text = msg
	f.toast.TextColor3 = c
	f.toast.TextTransparency = 0
	toastBusy += 1
	local mine = toastBusy
	task.delay(2.6, function()
		if mine == toastBusy then TweenService:Create(f.toast, TweenInfo.new(0.6), { TextTransparency = 1 }):Play() end
	end)
end

-- on a phone: a stick on the left half, buttons on the right
function Hud.touchControls(flight)
	local zone = Ui.make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0.5, 0, 1, 0), Parent = gui })
	local base = Ui.make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(0, 120, 0, 120), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.8, Visible = false, Parent = gui }, { Ui.corner(60) })
	local knob = Ui.make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.new(0, 50, 0, 50), BackgroundColor3 = Ui.Green, BackgroundTransparency = 0.3, Parent = base }, { Ui.corner(25) })
	local origin, id = nil, nil
	zone.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch and not id then
			id = input
			origin = Vector2.new(input.Position.X, input.Position.Y)
			base.Position = UDim2.new(0, origin.X, 0, origin.Y)
			base.Visible = true
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					id = nil
					base.Visible = false
					flight.touch.roll, flight.touch.pitch = 0, 0
				elseif id == input then
					local d = (Vector2.new(input.Position.X, input.Position.Y) - origin) / 60
					if d.Magnitude > 1 then d = d.Unit end
					knob.Position = UDim2.new(0.5, d.X * 60, 0.5, d.Y * 60)
					flight.touch.roll = d.X
					flight.touch.pitch = -d.Y
				end
			end)
		end
	end)
	local function btn(label, anchor, pos, color, down, up)
		local b = Ui.button(gui, label, { AnchorPoint = anchor, Position = pos, Size = UDim2.new(0, 84, 0, 84), BackgroundColor3 = color, TextSize = 18, BackgroundTransparency = 0.25 })
		Ui.corner(42).Parent = b
		b.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.Touch then down() end end)
		b.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.Touch and up then up() end end)
		return b
	end
	btn("TŰZ", Vector2.new(1, 1), UDim2.new(1, -20, 1, -20), Ui.Red, function() flight.setFiring(true) end, function() flight.setFiring(false) end)
	btn("RAKÉTA", Vector2.new(1, 1), UDim2.new(1, -116, 1, -60), Ui.Amber, function() flight.fireMissile() end)
	btn("FLARE", Vector2.new(1, 1), UDim2.new(1, -20, 1, -116), Color3.fromRGB(120, 200, 255), function() flight.flare() end)
	btn("GÁZ +", Vector2.new(0, 1), UDim2.new(0, 260, 1, -20), Ui.Green, function() flight.touch.throttle = 1 end, function() flight.touch.throttle = 0 end)
	btn("GÁZ -", Vector2.new(0, 1), UDim2.new(0, 260, 1, -112), Color3.fromRGB(170, 200, 190), function() flight.touch.throttle = -1 end, function() flight.touch.throttle = 0 end)
end

local function screenPoint(world: Vector3)
	local v, on = camera:WorldToViewportPoint(world)
	return Vector2.new(v.X, v.Y), on and v.Z > 0, v.Z
end

function Hud.update(dt: number, fs)
	if not gui or not gui.Enabled then return end
	camera = workspace.CurrentCamera
	local size = camera.ViewportSize
	-- the numbers
	f.speed.Text = string.format("SEB  %d km/h", math.floor((fs.speed or 0) * 0.28 * 3.6))
	f.alt.Text = string.format("MAG  %d m", math.floor((fs.alt or 0) * 0.28))
	f.thr.Text = string.format("GÁZ  %d%%%s", math.floor((fs.throttle or 0) * 100), fs.ab and "  UTÁNÉGETŐ" or "")
	f.thrFill.Size = UDim2.new(fs.throttle or 0, 0, 1, 0)
	f.thrFill.BackgroundColor3 = fs.ab and Ui.Amber or Ui.Green
	local hp, maxHp = server.hp or 100, server.maxHp or 100
	f.hp.Text = string.format("ÉLETERŐ  %d", math.max(0, math.floor(hp)))
	f.hpFill.Size = UDim2.new(math.clamp(hp / maxHp, 0, 1), 0, 1, 0)
	f.hpFill.BackgroundColor3 = hp / maxHp < 0.35 and Ui.Red or Ui.Green
	f.wpn.Text = string.format("RAKÉTA ×%d   FLARE ×%d", server.missiles or 0, server.flares or 0)
	f.gun.Text = "ÁGYÚ ∞"
	f.coins.Text = string.format("%d érme", profile.coins or 0)
	f.kills.Text = string.format("lelőtt: %d", profile.kills or 0)
	if server.mode == "pvp" then
		f.wave.Text = string.format("KÉK %d – %d PIROS  ·  te: %s", server.scoreA or 0, server.scoreB or 0, server.team == "A" and "KÉK" or "PIROS")
	else
		f.wave.Text = (server.wave or 0) > 0 and string.format("%d. HULLÁM · ellenség: %d", server.wave, server.enemies or 0) or "Hamarosan jönnek…"
	end
	if server.partner then
		f.partner.Text = (server.role == "wso" and "Pilóta: " or "Navigátor: ") .. server.partner
	elseif server.role == "pilot" and (State.room and #State.room.seats > 0) then
		f.partner.Text = "A hátsó ülés szabad – a csapattársaid beülhetnek"
	else
		f.partner.Text = ""
	end
	if fs.wso then
		f.thr.Text = "NAVIGÁTOR  ·  X rakéta · G flare · T jelölés · Z kiszállás"
		f.gun.Text = ""
	end

	-- warnings
	f.alert.Visible = alertOn
	if alertOn then
		f.alert.Text = "⚠ RAKÉTA! – G: flare, és fordulj keményen"
		f.alert.TextTransparency = (math.floor(os.clock() * 5) % 2 == 0) and 0 or 0.5
	end
	f.warn.Text = fs.stall and "ELTÖRÉS! – több gázt, süllyeszd az orrot" or fs.edge and "A harcteret elhagyod – visszafordulsz" or ""

	-- the aim point (700 studs ahead of the nose) and the cursor steering dot
	if fs.pos then
		local p, on = screenPoint(fs.pos + fs.look * 700)
		f.aim.Visible = on
		if on then f.aim.Position = UDim2.new(0, p.X, 0, p.Y) end
	end
	f.dot.Visible = fs.mouse == true
	if fs.mouse then
		local m = UserInputService:GetMouseLocation()
		f.dot.Position = UDim2.new(0, m.X, 0, m.Y)
	end

	-- markers: the enemies of the room (red), team mates (blue-ish, with the name), the other team in a team fight (red)
	local list = {}
	local me = Players.LocalPlayer.UserId
	for _, name in { "Enemies", "Jets" } do
		for _, m in workspace[name]:GetChildren() do
			if m:IsA("Model") and State.mine(m) and m:GetAttribute("OwnerId") ~= me then
				table.insert(list, m)
			end
		end
	end
	for i, m in list do
		local mk = markers[i]
		if not mk then
			mk = Ui.make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(0, 110, 0, 20), BackgroundTransparency = 1, Font = Enum.Font.Code, TextSize = 14, TextStrokeTransparency = 0.5, Parent = gui })
			markers[i] = mk
		end
		local hostile = State.hostile(m)
		local wp = m:GetPivot().Position
		local d = fs.pos and (wp - fs.pos).Magnitude or 0
		local p, on, z = screenPoint(wp)
		local who = ""
		local oid = m:GetAttribute("OwnerId")
		if oid then
			local pl = Players:GetPlayerByUserId(oid)
			who = pl and (" " .. pl.DisplayName) or ""
		end
		local marked = (server.markUid or 0) ~= 0 and m:GetAttribute("Uid") == server.markUid
		local label = string.format("%s%s%.1f%s", marked and "◎ " or (on and "▼ " or "◆ "), "", d / 1000, who)
		mk.TextColor3 = hostile and (marked and Ui.Amber or Ui.Red) or Color3.fromRGB(120, 200, 255)
		if not on then
			-- off screen: on the edge of the screen, towards it
			local dir = p - size / 2
			if z < 0 then dir = -dir end
			if dir.Magnitude < 1 then dir = Vector2.new(0, -1) end
			dir = dir.Unit
			local k = math.min((size.X / 2 - 40) / math.max(math.abs(dir.X), 1e-3), (size.Y / 2 - 40) / math.max(math.abs(dir.Y), 1e-3))
			p = size / 2 + dir * k
		end
		mk.Text = label
		mk.Position = UDim2.new(0, p.X, 0, p.Y)
		mk.Visible = true
	end
	for i = #list + 1, #markers do markers[i].Visible = false end

	local lock = fs.lock
	if lock and lock.Parent then
		local p, on = screenPoint(lock:GetPivot().Position)
		f.lock.Visible = on
		if on then
			f.lock.Position = UDim2.new(0, p.X, 0, p.Y)
			f.lockText.Text = (server.missiles or 0) > 0 and "ZÁR · X" or "NINCS RAKÉTA"
		end
	else
		f.lock.Visible = false
	end
end

return Hud
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX27"><Properties><string name="Name">Lobby</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The hangar screen: a turning preview of your jet and the shop (paint schemes and pilot outfits for coins,
-- coin packs for Robux).  Trying a skin puts it on the preview jet; buying it makes it yours.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Catalog = require(Shared.Catalog)
local JetBuilder = require(Shared.JetBuilder)
local Ui = require(script.Parent.Ui)

local Lobby = {}

local ORIGIN = Vector3.new(30000, 600, 0)
local camera = workspace.CurrentCamera
local remotes, hooks
local gui, shop, listFrame, coinsLabel, msgLabel
local profile = { coins = 0, air = {}, pilot = {} }
local tab, rarity, onlyOwned = "air", "all", false
local previewModel, previewFolder
local tryAir, tryPilot = nil, nil     -- what the preview shows while you look at a skin
local focus = "jet"                   -- "jet" or "pilot": where the camera looks
local angle = 0
local visible = false
local ready = false
local gear = "single"               -- "single" or "twoseat" (the F/A-18F with a rear seat for a team mate)
local gearButtons = {}
local roomLabel = nil
local State = require(script.Parent.State)

local function rebuildPreview()
	if previewModel then previewModel:Destroy() end
	local air = tryAir ~= nil and tryAir or profile.airOn
	local pilot = tryPilot ~= nil and tryPilot or profile.pilotOn
	if air == "" then air = nil end
	if pilot == "" then pilot = nil end
	previewModel = JetBuilder.build(air, pilot, false, gear == "twoseat", nil, profile.jetOn)
	previewModel.PrimaryPart.Anchored = true
	previewModel:PivotTo(CFrame.new(ORIGIN))
	JetBuilder.setFlame(previewModel, 0.4)
	previewModel.Parent = previewFolder
end

local function say(text: string, good: boolean?)
	msgLabel.Text = text
	msgLabel.TextColor3 = good and Ui.Green or Ui.Amber
end

local function swatchFor(skin, isPilot: boolean, parent: Instance)
	local box = Ui.make("Frame", { Size = UDim2.new(1, -12, 0, 56), Position = UDim2.new(0, 6, 0, 6), BackgroundColor3 = JetBuilder.color(isPilot and skin.suit or skin.color), BorderSizePixel = 0, ClipsDescendants = true, Parent = parent }, { Ui.corner(6) })
	if isPilot then
		Ui.make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.4, 0), Size = UDim2.new(0, 34, 0, 34), BackgroundColor3 = JetBuilder.color(skin.helmet), BorderSizePixel = 0, Parent = box }, { Ui.corner(17) })
		Ui.make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.45, 0), Size = UDim2.new(0, 26, 0, 12), BackgroundColor3 = JetBuilder.color(skin.visor), BorderSizePixel = 0, Parent = box }, { Ui.corner(6) })
		Ui.make("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 0), Size = UDim2.new(0, 10, 0.4, 0), BackgroundColor3 = JetBuilder.color(skin.accent), BorderSizePixel = 0, Parent = box })
	elseif skin.pattern then
		local pc = JetBuilder.color(skin.pcolor)
		for i = 0, 5 do
			Ui.make("Frame", { Position = UDim2.new(i / 6, 0, 0, 0), Size = UDim2.new(1 / 12, 0, 1, 0), BackgroundColor3 = pc, BackgroundTransparency = 0.2, BorderSizePixel = 0, Rotation = 0, Parent = box })
		end
	end
	if not isPilot and skin.metal and skin.metal > 0.6 then
		Ui.make("Frame", { Size = UDim2.new(1, 0, 0.4, 0), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.7, BorderSizePixel = 0, Parent = box })
	end
end

local function owned(isPilot: boolean, id: string): boolean
	return (isPilot and profile.pilot or profile.air)[id] == true
end
local function worn(isPilot: boolean, id: string): boolean
	return (isPilot and profile.pilotOn or profile.airOn) == id
end

local function card(skin, isPilot: boolean)
	local id = skin.id
	local f = Ui.make("Frame", { BackgroundColor3 = Ui.Panel, BorderSizePixel = 0, Parent = listFrame }, { Ui.corner(8), Ui.make("UIStroke", { Color = Ui.RarityColor[skin.rarity], Thickness = worn(isPilot, id) and 3 or 1 }) })
	swatchFor(skin, isPilot, f)
	Ui.label(f, skin.name, { Position = UDim2.new(0, 8, 0, 68), Size = UDim2.new(1, -16, 0, 18), TextSize = 14, Font = Enum.Font.GothamBold })
	local extra = isPilot and string.format(" · üveg %d%%%s", math.floor((skin.visorT or 1) * 100), skin.mirror and " tükör" or "") or ""
	Ui.label(f, Catalog.Rarity[skin.rarity] .. extra, { Position = UDim2.new(0, 8, 0, 86), Size = UDim2.new(1, -16, 0, 14), TextSize = 12, TextColor3 = Ui.RarityColor[skin.rarity] })
	local isOwned = owned(isPilot, id)
	local label = worn(isPilot, id) and "Viseled" or isOwned and "Felszerel" or (tostring(skin.price) .. " érme")
	local b = Ui.button(f, label, { Position = UDim2.new(0, 8, 0, 106), Size = UDim2.new(1, -16, 0, 30), TextSize = 14,
		BackgroundColor3 = worn(isPilot, id) and Color3.fromRGB(60, 80, 70) or isOwned and Color3.fromRGB(140, 200, 255) or Ui.Amber })
	b.Activated:Connect(function()
		if worn(isPilot, id) then return end
		local ok, msg
		if isOwned then
			ok = (isPilot and remotes.EquipPilot or remotes.EquipAir):InvokeServer(id)
			msg = ok and "Felszerelve" or "Nem sikerült"
		else
			ok, msg = (isPilot and remotes.BuyPilot or remotes.BuyAir):InvokeServer(id)
		end
		say(msg or "", ok)
		if isPilot then tryPilot = nil else tryAir = nil end
	end)
	-- the same skin for Robux (real money, at most 500 Ft: Config.SkinRobux); hidden once it is yours
	if not isOwned then
		local rb = Config.SkinRobux[skin.rarity]
		local huf = math.floor(rb * Config.Money.HufPerRobux + 0.5)
		Ui.button(f, string.format("R$ %d (≈ %d Ft)", rb, huf), { Position = UDim2.new(0, 8, 0, 140), Size = UDim2.new(1, -16, 0, 30), TextSize = 13, BackgroundColor3 = Color3.fromRGB(120, 200, 255) }, function()
			local ok, m = remotes.BuySkinRobux:InvokeServer(isPilot and "pilot" or "air", id)
			say(m or "", ok)
		end)
	end
	-- looking at it: the preview jet wears it
	local look = Ui.make("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 100), ZIndex = 1, Parent = f })
	look.Activated:Connect(function()
		if isPilot then tryPilot, focus = id, "pilot" else tryAir, focus = id, "jet" end
		rebuildPreview()
	end)
end

local function render()
	if not ready then return end
	for _, c in listFrame:GetChildren() do
		if c:IsA("GuiObject") then c:Destroy() end
	end
	coinsLabel.Text = string.format("%d érme", profile.coins or 0)
	if tab == "jet" then
		local have = ReplicatedStorage:FindFirstChild("JetModels")
		local any = false
		for _, j in Config.JetModels do
			local ok = have ~= nil and have:FindFirstChild(j.key) ~= nil
			any = any or ok
			local f = Ui.make("Frame", { BackgroundColor3 = Ui.Panel, BorderSizePixel = 0, Parent = listFrame }, { Ui.corner(8), Ui.make("UIStroke", { Color = profile.jetOn == j.key and Ui.Green or Color3.fromRGB(60, 80, 86), Thickness = profile.jetOn == j.key and 3 or 1 }) })
			Ui.label(f, j.name, { Position = UDim2.new(0, 8, 0, 10), Size = UDim2.new(1, -16, 0, 40), TextSize = 15, Font = Enum.Font.GothamBold, TextWrapped = true })
			Ui.label(f, string.format("hossz %.1f m", j.length), { Position = UDim2.new(0, 8, 0, 56), Size = UDim2.new(1, -16, 0, 16), TextSize = 12, TextColor3 = Color3.fromRGB(150, 170, 165) })
			local label = profile.jetOn == j.key and "Ezzel repülsz" or ok and "Kiválasztom" or "nincs importálva"
			Ui.button(f, label, { Position = UDim2.new(0, 8, 0, 100), Size = UDim2.new(1, -16, 0, 30), TextSize = 13, BackgroundColor3 = ok and Ui.Amber or Color3.fromRGB(70, 80, 84) }, function()
				if ok then
					remotes.EquipJet:InvokeServer(j.key)
				else
					say("Ez a gép még nincs importálva a Studióba (lásd a README-t)", false)
				end
			end)
		end
		if not any then
			Ui.label(listFrame, "Még egy gép sincs importálva: a játék a kockákból épített gépet használja.", { Size = UDim2.new(0, 480, 0, 40), TextWrapped = true })
		end
		return
	end
	if tab == "coins" then
		local any = false
		for i, prod in Config.Products do
			if prod.id ~= 0 then
				any = true
				local f = Ui.make("Frame", { BackgroundColor3 = Ui.Panel, BorderSizePixel = 0, Parent = listFrame }, { Ui.corner(8) })
				Ui.label(f, prod.label, { Position = UDim2.new(0, 8, 0, 10), Size = UDim2.new(1, -16, 0, 22), TextSize = 17, Font = Enum.Font.GothamBold })
				Ui.label(f, prod.coins .. " érme", { Position = UDim2.new(0, 8, 0, 42), Size = UDim2.new(1, -16, 0, 30), TextSize = 24, TextColor3 = Ui.Amber, Font = Enum.Font.GothamBold })
				Ui.button(f, "Vásárlás (Robux)", { Position = UDim2.new(0, 8, 1, -42), Size = UDim2.new(1, -16, 0, 34), TextSize = 14 }, function() remotes.BuyProduct:InvokeServer(i) end)
			end
		end
		if Config.DoubleCoinsPass ~= 0 then
			any = true
			local f = Ui.make("Frame", { BackgroundColor3 = Ui.Panel, BorderSizePixel = 0, Parent = listFrame }, { Ui.corner(8), Ui.make("UIStroke", { Color = Ui.Amber, Thickness = 2 }) })
			Ui.label(f, "Dupla érme", { Position = UDim2.new(0, 8, 0, 10), Size = UDim2.new(1, -16, 0, 22), TextSize = 17, Font = Enum.Font.GothamBold })
			Ui.label(f, "mindent kétszer annyit érsz", { Position = UDim2.new(0, 8, 0, 40), Size = UDim2.new(1, -16, 0, 40), TextSize = 14, TextWrapped = true })
			Ui.button(f, profile.double and "Megvan" or "Vásárlás (Robux)", { Position = UDim2.new(0, 8, 1, -42), Size = UDim2.new(1, -16, 0, 34), TextSize = 14 }, function() if not profile.double then remotes.BuyPass:InvokeServer() end end)
		end
		if not any then
			Ui.label(listFrame, "A Robux-csomagok hamarosan itt lesznek.", { Size = UDim2.new(0, 300, 0, 40), TextWrapped = true })
		end
		return
	end
	local isPilot = tab == "pilot"
	local list = isPilot and Catalog.Pilot or Catalog.Air
	for _, skin in list do
		if (rarity == "all" or skin.rarity == rarity) and (not onlyOwned or owned(isPilot, skin.id)) then card(skin, isPilot) end
	end
end

function Lobby.paintGear()
	for id, b in gearButtons do
		b.BackgroundColor3 = id == gear and Ui.Amber or Color3.fromRGB(70, 86, 92)
		b.TextColor3 = id == gear and Color3.fromRGB(16, 22, 20) or Color3.new(1, 1, 1)
	end
end

-- the line under the coins: which room you are in
function Lobby.setRoom(room)
	if not roomLabel then return end
	if room then
		roomLabel.Text = string.format("Szoba: %s · %d/%d fő · %s", room.name, #room.members, room.max, room.mode == "pvp" and ("csapatharc, te: " .. (State.team == "A" and "KÉK" or "PIROS")) or "együtt az ellenség ellen")
	else
		roomLabel.Text = "Nem vagy szobában – az Indulás egy nyilvános szobába tesz."
	end
end

function Lobby.setProfile(p)
	profile = p
	if ready then
		tryAir, tryPilot = nil, nil
		rebuildPreview()
		render()
	end
end

function Lobby.init(r, h)
	remotes, hooks = r, h
	camera = workspace.CurrentCamera
	previewFolder = Ui.make("Folder", { Name = "Preview", Parent = workspace })
	gui = Ui.make("ScreenGui", { Name = "DogfightLobby", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 10, Parent = Players.LocalPlayer:WaitForChild("PlayerGui") })

	Ui.label(gui, "DOGFIGHT PLUS", { Position = UDim2.new(0, 28, 0, 22), Size = UDim2.new(0, 500, 0, 54), TextSize = 46, Font = Enum.Font.GothamBlack, TextColor3 = Ui.Green })
	Ui.label(gui, "Légiharc a barátaiddal – lődd le a hullámokat, gyűjts érméket, öltöztesd a gépedet és a pilótádat.", { Position = UDim2.new(0, 30, 0, 78), Size = UDim2.new(0, 520, 0, 40), TextSize = 16, TextWrapped = true, TextColor3 = Color3.fromRGB(200, 215, 210) })
	coinsLabel = Ui.label(gui, "", { Position = UDim2.new(0, 30, 0, 126), Size = UDim2.new(0, 300, 0, 30), TextSize = 24, TextColor3 = Ui.Amber, Font = Enum.Font.GothamBold })
	roomLabel = Ui.label(gui, "", { Position = UDim2.new(0, 30, 0, 156), Size = UDim2.new(0, 520, 0, 20), TextSize = 15, TextColor3 = Color3.fromRGB(190, 210, 205) })
	Ui.button(gui, "▶ INDULÁS", { Position = UDim2.new(0, 30, 0, 184), Size = UDim2.new(0, 220, 0, 56), TextSize = 24, BackgroundColor3 = Ui.Green }, function() hooks.onPlay(gear) end)
	local function gearBtn(id, label, x)
		local b = Ui.button(gui, label, { Position = UDim2.new(0, x, 0, 248), Size = UDim2.new(0, 150, 0, 34), TextSize = 14 })
		gearButtons[id] = b
		b.Activated:Connect(function() gear = id; Lobby.paintGear(); rebuildPreview() end)
	end
	gearBtn("single", "Együléses", 30)
	gearBtn("twoseat", "Kétüléses (F/A-18F)", 186)
	Lobby.paintGear()
	Ui.button(gui, "👥 Szobák / Csapat", { Position = UDim2.new(0, 30, 0, 290), Size = UDim2.new(0, 220, 0, 44), TextSize = 18, BackgroundColor3 = Color3.fromRGB(150, 210, 255) }, function() hooks.onRooms() end)
	local hang = Ui.button(gui, "🛒 Hangár / Shop", { Position = UDim2.new(0, 30, 0, 342), Size = UDim2.new(0, 220, 0, 44), TextSize = 18 }, function() shop.Visible = not shop.Visible end)
	hang.Name = "HangarButton"
	Ui.label(gui, "Irányítás: egér + W/S/A/D · Szóköz tűz · X rakéta · G flare · H súgó (repülés közben)", { Position = UDim2.new(0, 30, 1, -40), Size = UDim2.new(0, 700, 0, 24), TextSize = 14, TextColor3 = Color3.fromRGB(170, 190, 185) })

	-- the shop panel on the right
	shop = Ui.make("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -20, 0.5, 0), Size = UDim2.new(0, 560, 0.88, 0), BackgroundColor3 = Color3.fromRGB(14, 20, 24), BackgroundTransparency = 0.08, Visible = true, Parent = gui }, { Ui.corner(10), Ui.padding(12) })
	local tabs = Ui.make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 38), Parent = shop }, { Ui.make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8) }) })
	local function tabBtn(id, label)
		Ui.button(tabs, label, { Size = UDim2.new(0, 150, 0, 34), TextSize = 15, BackgroundColor3 = Color3.fromRGB(40, 56, 62), TextColor3 = Color3.new(1, 1, 1) }, function()
			tab = id
			tryAir, tryPilot = nil, nil
			focus = id == "pilot" and "pilot" or "jet"
			rebuildPreview()
			render()
		end)
	end
	tabBtn("air", "Gép festése (" .. #Catalog.Air .. ")")
	tabBtn("pilot", "Pilóta (" .. #Catalog.Pilot .. ")")
	tabBtn("jet", "Gép típusa")
	tabBtn("coins", "Érmék")
	local chips = Ui.make("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 44), Size = UDim2.new(1, 0, 0, 30), Parent = shop }, { Ui.make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6) }) })
	local function chip(id, label)
		Ui.button(chips, label, { Size = UDim2.new(0, 92, 0, 28), TextSize = 13, BackgroundColor3 = Ui.RarityColor[id] or Color3.fromRGB(200, 210, 215) }, function() rarity = id; render() end)
	end
	chip("all", "Mind"); chip("C", "Gyakori"); chip("R", "Ritka"); chip("E", "Epikus"); chip("L", "Legendás")
	Ui.button(chips, "Csak a megvettek", { Size = UDim2.new(0, 120, 0, 28), TextSize = 13, BackgroundColor3 = Color3.fromRGB(80, 96, 100), TextColor3 = Color3.new(1, 1, 1) }, function() onlyOwned = not onlyOwned; render() end)
	msgLabel = Ui.label(shop, "", { Position = UDim2.new(0, 0, 0, 78), Size = UDim2.new(1, 0, 0, 20), TextSize = 15 })
	listFrame = Ui.make("ScrollingFrame", {
		Position = UDim2.new(0, 0, 0, 102), Size = UDim2.new(1, 0, 1, -102), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 8,
		CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = shop,
	}, { Ui.make("UIGridLayout", { CellSize = UDim2.new(0, 160, 0, 178), CellPadding = UDim2.new(0, 8, 0, 8), SortOrder = Enum.SortOrder.LayoutOrder }) })
	ready = true

	-- the camera circles the preview jet while the lobby is up
	RunService:BindToRenderStep("DogfightLobbyCam", Enum.RenderPriority.Camera.Value + 1, function(dt)
		if not visible then return end
		angle += dt * 0.35
		camera.CameraType = Enum.CameraType.Scriptable
		if focus == "pilot" then
			local c = ORIGIN + Vector3.new(0, 1.7, -2.8)
			local pos = c + Vector3.new(math.cos(angle) * 3.6, 0.9, math.sin(angle) * 3.6)
			camera.CFrame = CFrame.lookAt(pos, c)
			camera.FieldOfView = 55
		else
			local pos = ORIGIN + Vector3.new(math.cos(angle) * 46, 9 + math.sin(angle * 0.7) * 5, math.sin(angle) * 46)
			camera.CFrame = CFrame.lookAt(pos, ORIGIN)
			camera.FieldOfView = 55
		end
	end)
end

function Lobby.show(v: boolean)
	visible = v
	gui.Enabled = v
	if v then
		camera = workspace.CurrentCamera
		tryAir, tryPilot = nil, nil
		focus = "jet"
		rebuildPreview()
		render()
	end
end

return Lobby
]]></ProtectedString></Properties></Item>
<Item class="LocalScript" referent="RBX28"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Dogfight Plus for Roblox: the client's entry point (lobby -> flight or rear seat -> lobby).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local Flight = require(script.Parent.Flight)
local Hud = require(script.Parent.Hud)
local Lobby = require(script.Parent.Lobby)
local RoomsUi = require(script.Parent.RoomsUi)
local State = require(script.Parent.State)
local Visibility = require(script.Parent.Visibility)
local Wso = require(script.Parent.Wso)
local Visor = require(script.Parent.Visor)

local player = Players.LocalPlayer
local remotes = Remotes.get()
local profile = nil
local state = "lobby"          -- lobby, launching, flying (pilot), wso (rear seat), dead

local function goLobby()
	state = "lobby"
	Flight.stop()
	Wso.stop()
	Hud.show(false)
	Lobby.show(true)
end

local function crashed()
	state = "dead"
	Hud.toast("Lezuhantál!", "bad")
	task.delay(2.4, function() if state == "dead" then goLobby() end end)
end

local function play(gear)
	if state ~= "lobby" then return end
	state = "launching"
	remotes.Launch:FireServer(gear)
	local jets = workspace:WaitForChild("Jets")
	local jet = jets:WaitForChild("Jet_" .. player.Name, 8)
	if not jet then
		state = "lobby"
		return
	end
	jet:WaitForChild("Body")
	RoomsUi.show(false)
	Lobby.show(false)
	Hud.show(true)
	state = "flying"
	Flight.start(jet, crashed)
	Hud.toast(gear == "twoseat" and "Kétüléses gép: a csapattársak beülhetnek hátulra · Szóköz: tűz · X: rakéta · G: flare" or "Vadássz! Szóköz: tűz · X: rakéta · G: flare · H: súgó", "info")
end

-- you sit in the rear seat of somebody's jet (the server tells us which): the pilot flies, you work the weapons
local function onSeat(jet)
	if jet then
		if state ~= "lobby" then return end
		RoomsUi.show(false)
		Lobby.show(false)
		Hud.show(true)
		state = "wso"
		Wso.start(jet)
		Hud.toast("Hátsó ülés: X rakéta · G flare · T jelölés · Z kiszállás", "info")
	elseif state == "wso" then
		goLobby()
	end
end

Hud.init(remotes, Flight)
Flight.init(remotes)
Wso.init(remotes, function()
	remotes.LeaveSeat:InvokeServer()
end)
Lobby.init(remotes, { onPlay = play, onRooms = function() RoomsUi.toggle() end })
RoomsUi.init(remotes, { onSeat = function() end })
Visibility.init()
Visor.init()
Flight.onCockpit = function(on) Visor.set(profile and profile.pilotOn, on) end

remotes.Seat.OnClientEvent:Connect(onSeat)
remotes.RoomState.OnClientEvent:Connect(function(room)
	State.set(room)
	Lobby.setRoom(room)
end)
remotes.Hud.OnClientEvent:Connect(function(d) Flight.markUid = d.markUid or 0 end)
remotes.Profile.OnClientEvent:Connect(function(p)
	profile = p
	Hud.setProfile(p)
	Lobby.setProfile(p)
end)
remotes.Died.OnClientEvent:Connect(function(reason)
	if state ~= "flying" and state ~= "wso" then return end        -- a crash was already handled by crashed()
	Flight.stop()
	Wso.stop()
	state = "dead"
	Hud.toast("Vége: " .. tostring(reason), "bad")
	task.delay(2.4, function() if state == "dead" then goLobby() end end)
end)

-- the profile (coins, skins): asked until the server has it
task.spawn(function()
	local p
	repeat
		p = remotes.GetProfile:InvokeServer()
		if not p then task.wait(0.5) end
	until p
	profile = p
	Hud.setProfile(p)
	Lobby.setProfile(p)
end)

goLobby()
Lobby.setRoom(nil)

RunService.RenderStepped:Connect(function(dt)
	if state == "flying" then Hud.update(dt, Flight.state)
	elseif state == "wso" then Hud.update(dt, Wso.state) end
end)
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX29"><Properties><string name="Name">RoomsUi</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The rooms screen: your room (members, teams, slots, the open rear seats), a quick start, a new room and the list.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared").Config)
local Ui = require(script.Parent.Ui)
local State = require(script.Parent.State)

local RoomsUi = {}

local remotes, gui, body, msg
local open = false
local form = { name = "", mode = "coop", extra = 3, private = false }
local list = {}
local listTimer = 0
local codeText = ""
local onSeat = nil          -- called after a rear seat is taken
local MAX = Config.Rooms.MaxPlayers

local function say(text: string?, good: boolean?)
	if msg then
		msg.Text = text or ""
		msg.TextColor3 = good and Ui.Green or Ui.Amber
	end
end

local function section(title: string)
	local f = Ui.make("Frame", { BackgroundColor3 = Color3.fromRGB(24, 34, 40), BorderSizePixel = 0, Size = UDim2.new(1, -12, 0, 10), AutomaticSize = Enum.AutomaticSize.Y, Parent = body }, {
		Ui.corner(8), Ui.padding(10), Ui.make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	Ui.label(f, title, { Size = UDim2.new(1, 0, 0, 22), TextSize = 18, Font = Enum.Font.GothamBold, TextColor3 = Ui.Amber })
	return f
end

local function row(parent: Instance, height: number?)
	return Ui.make("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, height or 34), Parent = parent }, {
		Ui.make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), VerticalAlignment = Enum.VerticalAlignment.Center }),
	})
end

local function modeName(mode: string): string
	return mode == "pvp" and "Csapatharc (két csapat egymás ellen)" or "Együtt az ellenség ellen"
end

local render

local function myRoomSection()
	local r = State.room
	local s = section(r and ("A szobád: " .. r.name) or "Nem vagy szobában")
	if not r then
		Ui.label(s, "Nyiss egy szobát, vagy lépj be egybe – vagy nyomj a Gyors játékra.", { Size = UDim2.new(1, 0, 0, 20), TextSize = 14, TextWrapped = true })
		return
	end
	local me = Players.LocalPlayer.UserId
	local isHost = r.host == me
	Ui.label(s, string.format("%s · %d/%d fő%s", modeName(r.mode), #r.members, r.max, r.private and " · privát" or ""), { Size = UDim2.new(1, 0, 0, 20), TextSize = 14 })
	if r.private and r.code then
		Ui.label(s, "Belépési kód: " .. r.code .. "  (ezt add meg a barátaidnak)", { Size = UDim2.new(1, 0, 0, 22), TextSize = 18, TextColor3 = Ui.Green, Font = Enum.Font.GothamBold })
	end
	-- the slots: only the room's opener changes them
	if isHost then
		local rw = row(s)
		Ui.label(rw, "Még ennyien jöhetnek be:", { Size = UDim2.new(0, 190, 0, 28), TextSize = 14 })
		Ui.button(rw, "−", { Size = UDim2.new(0, 34, 0, 28), TextSize = 20 }, function() remotes.SetSlots:InvokeServer(r.max - 2) end)
		Ui.label(rw, tostring(r.max - 1), { Size = UDim2.new(0, 30, 0, 28), TextSize = 18, TextXAlignment = Enum.TextXAlignment.Center, Font = Enum.Font.GothamBold })
		Ui.button(rw, "+", { Size = UDim2.new(0, 34, 0, 28), TextSize = 20 }, function() remotes.SetSlots:InvokeServer(r.max) end)
		Ui.label(rw, "(összesen legfeljebb " .. MAX .. " fő)", { Size = UDim2.new(0, 190, 0, 28), TextSize = 12, TextColor3 = Color3.fromRGB(150, 170, 165) })
	end
	-- the members, by team in a team fight
	if r.mode == "pvp" then
		local cols = row(s, 10)
		cols.AutomaticSize = Enum.AutomaticSize.Y
		cols.Size = UDim2.new(1, 0, 0, 10)
		cols:FindFirstChildOfClass("UIListLayout").VerticalAlignment = Enum.VerticalAlignment.Top
		for _, t in { "A", "B" } do
			local c = Ui.make("Frame", { BackgroundColor3 = t == "A" and Color3.fromRGB(20, 40, 70) or Color3.fromRGB(70, 28, 28), BorderSizePixel = 0, Size = UDim2.new(0.5, -6, 0, 10), AutomaticSize = Enum.AutomaticSize.Y, Parent = cols }, {
				Ui.corner(6), Ui.padding(8), Ui.make("UIListLayout", { Padding = UDim.new(0, 3) }),
			})
			local n = 0
			for _, m in r.members do if m.team == t then n += 1 end end
			Ui.label(c, (t == "A" and "KÉK" or "PIROS") .. " csapat · " .. n .. " fő · pont: " .. (r.score[t] or 0), { Size = UDim2.new(1, 0, 0, 20), TextSize = 15, Font = Enum.Font.GothamBold })
			for _, m in r.members do
				if m.team == t then Ui.label(c, (m.host and "★ " or "") .. m.name .. (m.userId == me and "  (te)" or ""), { Size = UDim2.new(1, 0, 0, 18), TextSize = 14 }) end
			end
			if State.team ~= t then
				Ui.button(c, "Átlépek ide", { Size = UDim2.new(1, 0, 0, 28), TextSize = 14, BackgroundColor3 = Ui.Green }, function()
					local ok, m2 = remotes.SetTeam:InvokeServer(t)
					if not ok then say(m2 or "Nem sikerült", false) end
				end)
			else
				Ui.label(c, "← itt vagy", { Size = UDim2.new(1, 0, 0, 22), TextSize = 13, TextColor3 = Ui.Green })
			end
		end
	else
		for _, m in r.members do
			Ui.label(s, (m.host and "★ " or "• ") .. m.name .. (m.userId == me and "  (te)" or ""), { Size = UDim2.new(1, 0, 0, 18), TextSize = 14 })
		end
	end
	-- the open rear seats of two-seat jets of my team
	for _, st in r.seats do
		if st.userId ~= me and st.team == State.team then
			local rw = row(s)
			Ui.label(rw, st.name .. " kétüléses gépének hátsó ülése szabad", { Size = UDim2.new(0, 330, 0, 28), TextSize = 14 })
			Ui.button(rw, "Beülök", { Size = UDim2.new(0, 110, 0, 28), TextSize = 14, BackgroundColor3 = Ui.Green }, function()
				local ok, m2 = remotes.JoinSeat:InvokeServer(st.userId)
				say(m2, ok)
				if ok and onSeat then onSeat() end
			end)
		end
	end
	Ui.button(s, "Kilépek a szobából", { Size = UDim2.new(0, 190, 0, 30), TextSize = 14, BackgroundColor3 = Color3.fromRGB(200, 120, 110) }, function()
		remotes.LeaveRoom:InvokeServer()
	end)
end

local function createSection()
	local s = section("Új szoba nyitása")
	local rw = row(s)
	Ui.label(rw, "Név:", { Size = UDim2.new(0, 50, 0, 30), TextSize = 14 })
	local box = Ui.make("TextBox", { Size = UDim2.new(0, 260, 0, 30), BackgroundColor3 = Color3.fromRGB(38, 50, 56), TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.Gotham, TextSize = 15,
		PlaceholderText = "pl. A mi hangárunk", Text = form.name, ClearTextOnFocus = false, Parent = rw }, { Ui.corner(5) })
	box.FocusLost:Connect(function() form.name = string.sub(box.Text, 1, Config.Rooms.NameMax) end)
	local m = row(s)
	Ui.label(m, "Mód:", { Size = UDim2.new(0, 50, 0, 30), TextSize = 14 })
	for _, md in { "coop", "pvp" } do
		Ui.button(m, md == "pvp" and "Csapatharc" or "Együtt (AI)", { Size = UDim2.new(0, 130, 0, 30), TextSize = 14,
			BackgroundColor3 = form.mode == md and Ui.Amber or Color3.fromRGB(70, 86, 92), TextColor3 = form.mode == md and Color3.fromRGB(16, 22, 20) or Color3.new(1, 1, 1) }, function() form.mode = md; render() end)
	end
	local x = row(s)
	Ui.label(x, "Még ennyien jöhetnek be:", { Size = UDim2.new(0, 190, 0, 30), TextSize = 14 })
	Ui.button(x, "−", { Size = UDim2.new(0, 34, 0, 30), TextSize = 20 }, function() form.extra = math.max(0, form.extra - 1); render() end)
	Ui.label(x, tostring(form.extra), { Size = UDim2.new(0, 34, 0, 30), TextSize = 18, TextXAlignment = Enum.TextXAlignment.Center, Font = Enum.Font.GothamBold })
	Ui.button(x, "+", { Size = UDim2.new(0, 34, 0, 30), TextSize = 20 }, function() form.extra = math.min(MAX - 1, form.extra + 1); render() end)
	Ui.label(x, "(összesen " .. (form.extra + 1) .. ", legfeljebb " .. MAX .. ")", { Size = UDim2.new(0, 190, 0, 30), TextSize = 12, TextColor3 = Color3.fromRGB(150, 170, 165) })
	local p = row(s)
	Ui.button(p, form.private and "☑ Privát (kóddal lehet belépni)" or "☐ Privát (kóddal lehet belépni)", { Size = UDim2.new(0, 300, 0, 30), TextSize = 14,
		BackgroundColor3 = form.private and Ui.Green or Color3.fromRGB(70, 86, 92), TextColor3 = form.private and Color3.fromRGB(16, 22, 20) or Color3.new(1, 1, 1) }, function() form.private = not form.private; render() end)
	Ui.button(s, "Szoba megnyitása", { Size = UDim2.new(0, 220, 0, 38), TextSize = 16, BackgroundColor3 = Ui.Green }, function()
		local ok, id = remotes.CreateRoom:InvokeServer(form.name, form.mode, form.extra, form.private)
		say(ok and "Szoba megnyitva" or "Nem sikerült", ok)
	end)
end

local function joinSection()
	local s = section("Csatlakozás")
	Ui.button(s, "⚡ Gyors játék (együtt, bárkivel)", { Size = UDim2.new(0, 300, 0, 38), TextSize = 16 }, function()
		local ok, m = remotes.QuickPlay:InvokeServer()
		say(ok and "Bent vagy" or tostring(m), ok)
	end)
	local rw = row(s)
	Ui.label(rw, "Privát szoba kódja:", { Size = UDim2.new(0, 160, 0, 30), TextSize = 14 })
	local box = Ui.make("TextBox", { Size = UDim2.new(0, 90, 0, 30), BackgroundColor3 = Color3.fromRGB(38, 50, 56), TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.Code, TextSize = 18,
		PlaceholderText = "0000", Text = codeText, ClearTextOnFocus = false, Parent = rw }, { Ui.corner(5) })
	box.FocusLost:Connect(function() codeText = box.Text end)
	Ui.button(rw, "Belépek", { Size = UDim2.new(0, 100, 0, 30), TextSize = 14 }, function()
		local ok, m = remotes.JoinRoom:InvokeServer(box.Text)
		say(m, ok)
	end)
	Ui.label(s, "Nyilvános szobák:", { Size = UDim2.new(1, 0, 0, 20), TextSize = 14, TextColor3 = Ui.Amber })
	if #list == 0 then
		Ui.label(s, "Most nincs nyitott szoba.", { Size = UDim2.new(1, 0, 0, 20), TextSize = 14, TextColor3 = Color3.fromRGB(150, 170, 165) })
	end
	for _, r in list do
		local line = row(s)
		Ui.label(line, string.format("%s · %s · %d/%d", r.name, r.mode == "pvp" and "csapatharc" or "együtt", r.count, r.max), { Size = UDim2.new(0, 360, 0, 28), TextSize = 14 })
		Ui.button(line, r.count >= r.max and "Tele" or "Belépek", { Size = UDim2.new(0, 100, 0, 28), TextSize = 14 }, function()
			local ok, m = remotes.JoinRoom:InvokeServer(r.id)
			say(m, ok)
		end)
	end
end

render = function()
	if not body then return end
	for _, c in body:GetChildren() do
		if c:IsA("GuiObject") then c:Destroy() end
	end
	myRoomSection()
	joinSection()
	createSection()
end

local function refreshList()
	local ok, l = pcall(function() return remotes.ListRooms:InvokeServer() end)
	if ok and typeof(l) == "table" then list = l end
	if open then render() end
end

function RoomsUi.init(r, hooks)
	remotes = r
	onSeat = hooks and hooks.onSeat
	gui = Ui.make("ScreenGui", { Name = "DogfightRooms", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 20, Enabled = false, Parent = Players.LocalPlayer:WaitForChild("PlayerGui") })
	local panel = Ui.make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.new(0, 700, 0.9, 0), BackgroundColor3 = Color3.fromRGB(14, 20, 24), Parent = gui }, { Ui.corner(10), Ui.padding(12) })
	Ui.label(panel, "Hangár-csoportok (szobák)", { Size = UDim2.new(1, -120, 0, 30), TextSize = 22, Font = Enum.Font.GothamBold, TextColor3 = Ui.Green })
	Ui.button(panel, "Bezár", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 90, 0, 30), TextSize = 14 }, function() RoomsUi.show(false) end)
	msg = Ui.label(panel, "", { Position = UDim2.new(0, 0, 0, 34), Size = UDim2.new(1, 0, 0, 20), TextSize = 15 })
	body = Ui.make("ScrollingFrame", { Position = UDim2.new(0, 0, 0, 58), Size = UDim2.new(1, 0, 1, -58), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 8,
		CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = panel }, { Ui.make("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }) })
	State.onChange(function() if open then render() end end)
	task.spawn(function()
		while true do
			task.wait(3)
			if open then refreshList() end
		end
	end)
end

function RoomsUi.show(v: boolean)
	open = v
	gui.Enabled = v
	if v then
		say("")
		task.spawn(refreshList)
		render()
	end
end

function RoomsUi.toggle() RoomsUi.show(not open) end

return RoomsUi
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX30"><Properties><string name="Name">State</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- What the client knows about its room (filled from the server's RoomState events), shared by the screens.
local State = {
	room = nil,        -- the last RoomState table, or nil when not in a room
	roomId = nil,
	team = "A",
	mode = "coop",
	listeners = {},
}

function State.set(room)
	State.room = room
	State.roomId = room and room.id or nil
	State.mode = room and room.mode or "coop"
	State.team = "A"
	if room then
		for _, m in room.members do
			if m.userId == game:GetService("Players").LocalPlayer.UserId then State.team = m.team end
		end
	end
	for _, f in State.listeners do f(room) end
end

function State.onChange(f)
	table.insert(State.listeners, f)
end

-- is this jet / enemy model of my room?
function State.mine(model: Instance): boolean
	return State.roomId ~= nil and model:GetAttribute("RoomId") == State.roomId
end

-- hostile to me: the AI of my room, or (in a team fight) a jet of the other team
function State.hostile(model: Instance): boolean
	if not State.mine(model) then return false end
	if model.Parent == workspace:FindFirstChild("Enemies") then return true end
	if State.mode == "pvp" and model.Parent == workspace:FindFirstChild("Jets") then
		return model:GetAttribute("Team") ~= State.team and model:GetAttribute("OwnerId") ~= game:GetService("Players").LocalPlayer.UserId
	end
	return false
end

return State
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX31"><Properties><string name="Name">Ui</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Small helpers to build the screens in code (no hand-made GUI objects to keep in sync).
local Ui = {}

function Ui.make(class: string, props: { [string]: any }?, children: { Instance }?): Instance
	local o = Instance.new(class)
	local parent = nil
	for k, v in props or {} do
		if k == "Parent" then parent = v else o[k] = v end
	end
	for _, c in children or {} do c.Parent = o end
	if parent then o.Parent = parent end
	return o
end

function Ui.corner(r: number?): UICorner
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 6)
	return c
end

function Ui.padding(p: number): UIPadding
	local u = Instance.new("UIPadding")
	u.PaddingTop, u.PaddingBottom, u.PaddingLeft, u.PaddingRight = UDim.new(0, p), UDim.new(0, p), UDim.new(0, p), UDim.new(0, p)
	return u
end

function Ui.label(parent: Instance, text: string, props: { [string]: any }?): TextLabel
	local l = Ui.make("TextLabel", {
		BackgroundTransparency = 1, Text = text, TextColor3 = Color3.fromRGB(230, 240, 235), Font = Enum.Font.GothamMedium,
		TextSize = 16, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, 0, 0, 20),
	})
	for k, v in props or {} do l[k] = v end
	l.Parent = parent
	return l
end

function Ui.button(parent: Instance, text: string, props: { [string]: any }?, onClick: (() -> ())?): TextButton
	local b = Ui.make("TextButton", {
		Text = text, Font = Enum.Font.GothamBold, TextSize = 16, TextColor3 = Color3.fromRGB(16, 22, 20),
		BackgroundColor3 = Color3.fromRGB(255, 200, 64), AutoButtonColor = true, Size = UDim2.new(0, 140, 0, 38),
	}, { Ui.corner(6) })
	for k, v in props or {} do b[k] = v end
	b.Parent = parent
	if onClick then b.Activated:Connect(onClick) end
	return b
end

Ui.Green = Color3.fromRGB(107, 255, 133)
Ui.Amber = Color3.fromRGB(255, 200, 64)
Ui.Red = Color3.fromRGB(255, 90, 70)
Ui.Panel = Color3.fromRGB(18, 26, 30)
Ui.RarityColor = {
	C = Color3.fromRGB(159, 176, 191), R = Color3.fromRGB(90, 176, 255), E = Color3.fromRGB(197, 139, 255), L = Color3.fromRGB(255, 200, 64),
}

return Ui
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX32"><Properties><string name="Name">Visibility</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Several rooms share one sky, but you only see your own: the jets, enemies and missiles of the other rooms are
-- made invisible here (on this client only).
local State = require(script.Parent.State)

local Visibility = {}

local function apply(model: Instance)
	local hidden = State.roomId ~= nil and model:GetAttribute("RoomId") ~= State.roomId
	local function one(d: Instance)
		if d:IsA("BasePart") then d.LocalTransparencyModifier = hidden and 1 or 0
		elseif d:IsA("Trail") or d:IsA("PointLight") then d.Enabled = not hidden end
	end
	one(model)
	for _, d in model:GetDescendants() do one(d) end
end

function Visibility.init()
	for _, name in { "Jets", "Enemies", "Missiles" } do
		local f = workspace:WaitForChild(name)
		f.ChildAdded:Connect(function(c) task.defer(apply, c) end)
		for _, c in f:GetChildren() do apply(c) end
	end
	State.onChange(function()
		for _, name in { "Jets", "Enemies", "Missiles" } do
			for _, c in workspace[name]:GetChildren() do apply(c) end
		end
	end)
	-- a sweep now and then (the seat parts of a jet appear later)
	task.spawn(function()
		while true do
			task.wait(1)
			for _, name in { "Jets", "Enemies", "Missiles" } do
				for _, c in workspace[name]:GetChildren() do apply(c) end
			end
		end
	end)
end

return Visibility
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX33"><Properties><string name="Name">Visor</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The visor is real glass: from the cockpit view everything is seen through its tint (darker and coloured, with a
-- dark rim).  Clear visors change nothing.  Never darker than 25% so that the game stays playable.
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Catalog = require(Shared.Catalog)
local JetBuilder = require(Shared.JetBuilder)
local Ui = require(script.Parent.Ui)

local Visor = {}
local cc, gui
local edges = {}

function Visor.init()
	cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "DogfightVisor"
	cc.Enabled = false
	cc.Parent = Lighting
	gui = Ui.make("ScreenGui", { Name = "DogfightVisor", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 1, Enabled = false, Parent = Players.LocalPlayer:WaitForChild("PlayerGui") })
	-- the dark rim of the visor: four strips fading towards the middle
	local function edge(pos, size, rot)
		local f = Ui.make("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, Position = pos, Size = size, BackgroundTransparency = 0.6, Parent = gui })
		local g = Instance.new("UIGradient")
		g.Rotation = rot
		g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
		g.Parent = f
		table.insert(edges, f)
	end
	edge(UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 0.16, 0), 90)
	edge(UDim2.new(0, 0, 0.84, 0), UDim2.new(1, 0, 0.16, 0), -90)
	edge(UDim2.new(0, 0, 0, 0), UDim2.new(0.12, 0, 1, 0), 0)
	edge(UDim2.new(0.88, 0, 0, 0), UDim2.new(0.12, 0, 1, 0), 180)
end

-- outfitId: the worn pilot outfit (or nil), on: the cockpit view is on
function Visor.set(outfitId: string?, on: boolean)
	local o = outfitId and Catalog.PilotById[outfitId]
	if not on or not o or (o.visorT or 1) >= 0.95 then
		cc.Enabled = false
		gui.Enabled = false
		return
	end
	local T = math.max(0.25, o.visorT)
	local k = 1 - T
	cc.TintColor = Color3.new(1, 1, 1):Lerp(JetBuilder.color(o.visor), math.min(0.85, k * 0.95))
	cc.Brightness = -k * 0.22
	cc.Contrast = 0.04 + k * 0.1
	cc.Saturation = -k * 0.1
	cc.Enabled = true
	for _, e in edges do e.BackgroundTransparency = 1 - math.min(0.55, 0.12 + k * 0.5) end
	gui.Enabled = true
end

return Visor
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX34"><Properties><string name="Name">Wso</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The rear seat of a two-seat jet: you do not fly, you look around from behind the jet (the cursor turns the view),
-- lock enemies in a wide cone, fire the jet's missiles, drop flares and mark a target for the pilot.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage:WaitForChild("Shared").Config)
local State = require(script.Parent.State)

local Wso = {}

local camera = workspace.CurrentCamera
local active = false
local jet, remotes, onLeave
local lockTarget = nil
local yaw, pitch = 0, 0.15
Wso.state = { wso = true }

local function findLock(origin: Vector3, look: Vector3)
	local best, bestAng = nil, math.rad(40)
	local function consider(m: Instance)
		if not m:IsA("Model") or not State.hostile(m) then return end
		local to = m:GetPivot().Position - origin
		local d = to.Magnitude
		if d < Config.Missile.Range and d > 60 then
			local ang = math.acos(math.clamp(look:Dot(to.Unit), -1, 1))
			if ang < bestAng then best, bestAng = m, ang end
		end
	end
	for _, m in workspace.Enemies:GetChildren() do consider(m) end
	for _, m in workspace.Jets:GetChildren() do consider(m) end
	return best
end

local function step(dt: number)
	if not active then return end
	if not jet or not jet.Parent then return end
	camera = workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Scriptable
	local cf = jet:GetPivot()
	-- the cursor turns the view round the jet
	local m = UserInputService:GetMouseLocation()
	local size = camera.ViewportSize
	local dx = math.clamp((m.X - size.X / 2) / (size.X / 2), -1, 1)
	local dy = math.clamp((m.Y - size.Y / 2) / (size.Y / 2), -1, 1)
	local ty, tp = -dx * 2.6, 0.12 - dy * 0.7
	yaw += (ty - yaw) * math.min(1, dt * 6)
	pitch += (tp - pitch) * math.min(1, dt * 6)
	local rotView = cf.Rotation * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
	local camPos = cf.Position + rotView * Vector3.new(0, 4, 34)
	camera.CFrame = CFrame.lookAt(camPos, cf.Position)
	camera.FieldOfView = 70
	local look = (cf.Position - camPos).Unit                       -- where the view is aimed
	lockTarget = findLock(cf.Position, look)

	local body = jet.PrimaryPart
	local vel = body and body.AssemblyLinearVelocity or Vector3.zero
	local s = Wso.state
	s.speed, s.alt, s.throttle, s.ab, s.stall, s.edge, s.lock = vel.Magnitude, cf.Position.Y, 0, false, false, false, lockTarget
	s.pos, s.look, s.mouse = camPos, look, false
end

function Wso.init(r, leave)
	remotes = r
	onLeave = leave
	RunService:BindToRenderStep("DogfightWso", Enum.RenderPriority.Camera.Value + 1, step)
	local function act()
		if lockTarget and lockTarget.Parent then remotes.FireMissile:FireServer(lockTarget) end
	end
	UserInputService.InputBegan:Connect(function(input, processed)
		if not active then return end
		if input.UserInputType == Enum.UserInputType.MouseButton2 and not processed then act() return end
		if input.UserInputType == Enum.UserInputType.MouseButton3 then remotes.Mark:FireServer(lockTarget) return end
		if processed then return end
		local k = input.KeyCode
		if k == Enum.KeyCode.X or k == Enum.KeyCode.Space or k == Enum.KeyCode.ButtonX then act()
		elseif k == Enum.KeyCode.G or k == Enum.KeyCode.ButtonB then remotes.Flare:FireServer()
		elseif k == Enum.KeyCode.T or k == Enum.KeyCode.ButtonY then remotes.Mark:FireServer(lockTarget)
		elseif k == Enum.KeyCode.Z then if onLeave then onLeave() end end
	end)
end

function Wso.start(model: Model)
	jet = model
	active = true
	yaw, pitch = 0, 0.15
end

function Wso.stop()
	active = false
	jet = nil
end

function Wso.isActive(): boolean
	return active
end

return Wso
]]></ProtectedString></Properties></Item>
</Item>
</Item>
</Item>
