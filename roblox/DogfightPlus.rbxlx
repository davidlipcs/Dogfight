	{ id = "p_arctic", name = "Sarki farkas", price = 2500, rarity = "R", desc = "Fehér-szürke téli ruha, szögletes farkas-csíkos sisak, kék tükörbevonatú napellenző: erős fényben is hűvös, éles kép.", suit = 0xDFE5EA, suit2 = 0x9FB0C0, helmet = 0xF4F8FB, helmet2 = 0x6A8CB0, pattern = "wolf", visor = 0x4A78C8, visorT = 0.3, mirror = True, accent = 0x2A5AB0, glove = 0x6C7A88, callsign = "WOLF", patch = "unit", pressure = False },
	{ id = "p_night", name = "Éjszakai vadász", price = 4500, rarity = "E", desc = "Fekete ruha, matt fekete sisak vörös áramköri csíkokkal, zöld éjjellátó-üveg: sötétben tiszta, de zöld a világ.", suit = 0x1B1D21, suit2 = 0x2C2F35, helmet = 0x16181B, helmet2 = 0xC8281E, pattern = "circuit", visor = 0x2E9A48, visorT = 0.38, mirror = False, accent = 0xC8281E, glove = 0x101113, callsign = "GHOST", patch = "skull", pressure = False },
	{ id = "p_baron", name = "Vörös báró", price = 4500, rarity = "E", desc = "Sötétvörös ruha, vörös sisak fehér csíkkal, réz színű polarizált üveg: a fényes felhők fölött csökkenti a vakítást.", suit = 0x8A2A24, suit2 = 0x4A1410, helmet = 0xB83026, helmet2 = 0xF4F0E8, pattern = "stripes", visor = 0xC87A28, visorT = 0.5, mirror = False, accent = 0xF4F0E8, glove = 0x2A1210, callsign = "BARON", patch = "cross", pressure = False },
	{ id = "p_commander", name = "Arany parancsnok", price = 8000, rarity = "L", desc = "Éjkék ruha arany zsinórral, hófehér sisak arany peremmel és csillaggal, arany tükörüveg: nagyon sötét, nagyon elegáns.", suit = 0x1D2A4A, suit2 = 0x0F1730, helmet = 0xF8F4E8, helmet2 = 0xD4A832, pattern = "trim", visor = 0xD9B24A, visorT = 0.28, mirror = True, accent = 0xD4A832, glove = 0x14182A, callsign = "COMMAND", patch = "star", pressure = False },
	{ id = "p_cyber", name = "Nexus", price = 4500, rarity = "E", desc = "Sötétszürke ruha ciánkék LED-csíkokkal, fényes sisak áramköri mintával, ciánkék kijelző-üveg: hideg, jövőbeli kilátás.", suit = 0x24282E, suit2 = 0x3B424B, helmet = 0x2B3139, helmet2 = 0x38E6FF, pattern = "circuit", visor = 0x38D2FF, visorT = 0.55, mirror = False, accent = 0x38E6FF, glove = 0x15181C, callsign = "NEXUS", patch = "unit", pressure = False },
	{ id = "p_hu", name = "Magyar sas", price = 2500, rarity = "R", desc = "Zöld ruha piros-fehér-zöld szegéllyel, fehér sisak nemzeti csíkkal, rézszínű polarizált üveg.", suit = 0x40603F, suit2 = 0x2A402B, helmet = 0xF4F4F0, helmet2 = 0xCD2A3E, pattern = "tricolor", visor = 0xB8742F, visorT = 0.5, mirror = False, accent = 0xCD2A3E, glove = 0x24301F, callsign = "SAS", patch = "flag-hu", pressure = False },
	{ id = "p_orbit", name = "Magaslati pilóta", price = 8000, rarity = "L", desc = "Fehér nyomásálló ruha, kupolás fehér sisak narancs részletekkel, arany napellenzővel: a legmagasabb szintű védelem és a legsötétebb arany kilátás.", suit = 0xF0F0EE, suit2 = 0xD0D4D8, helmet = 0xF8F8F8, helmet2 = 0xE86A1A, pattern = "trim", visor = 0xDCB64A, visorT = 0.35, mirror = True, accent = 0xE86A1A, glove = 0xC8CCD0, callsign = "ORBIT", patch = "unit", pressure = True },
}

Catalog.AirById = {}
Catalog.PilotById = {}
for _, s in Catalog.Air do Catalog.AirById[s.id] = s end
for _, s in Catalog.Pilot do Catalog.PilotById[s.id] = s end

return Catalog
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Everything that can be tuned (economy, weapons, the jet, the Robux shop) in one place.
local Config = {}

Config.DataStoreName = "DogfightPlus_v1"

Config.Coins = {
	Start = 500,          -- a new player's coins
	PerKill = 100,        -- for one enemy jet
	WaveBonus = 150,      -- for clearing a wave (times the wave number, at most 10x)
	Survive = 1,          -- coins per second in the air (a trickle, so a calm minute still pays)
}

-- Money: what a Robux is worth in forints (check the current price in the Roblox shop and change it here) and the
-- most a single skin may cost in real money.  The Robux price of a skin is its rarity's tier, capped by this.
Config.Money = { HufPerRobux = 4.5, MaxSkinHuf = 500 }
local maxRobux = math.floor(Config.Money.MaxSkinHuf / Config.Money.HufPerRobux)     -- 111 Robux = 500 Ft at 4.5 Ft / Robux
Config.SkinRobux = {                    -- Robux price of a skin by rarity (C common, R rare, E epic, L legendary)
	C = math.min(15, maxRobux), R = math.min(35, maxRobux), E = math.min(65, maxRobux), L = math.min(110, maxRobux),
}
-- the skin purchases go through four Developer Products, one per rarity, priced at the Robux amounts above
-- (Creator Dashboard > Monetization > Developer Products).  The skin the player picked is remembered on the server
-- and handed over when the receipt arrives.  An id of 0 = not created yet: the Robux button stays hidden.
Config.SkinProducts = { C = 0, R = 0, E = 0, L = 0 }
Config.TierCoins = { C = 600, R = 1500, E = 3500, L = 8000 }        -- the coin price of the same tiers (the fallback value of a lost purchase)

-- coin packs for Robux (robux = the price you set on the product).  Even the biggest skin (8000 coins) stays under 500 Ft.
Config.Products = {
	{ id = 0, coins = 1500, robux = 20, label = "Kis csomag" },
	{ id = 0, coins = 4000, robux = 50, label = "Közepes csomag" },
	{ id = 0, coins = 9000, robux = 110, label = "Nagy csomag" },
	{ id = 0, coins = 20000, robux = 220, label = "Hatalmas csomag" },
}
-- Game Pass (Creator Dashboard > Monetization > Passes): the coins you earn count double
Config.DoubleCoinsPass = 0

Config.Rooms = {
	MaxPlayers = 20,      -- the most people in one room (hangar group)
	NameMax = 24,
	PvpKillCoins = 150,
	ScoreToWin = 0,       -- 0: the team fight never ends
}

Config.Jet = {
	Health = 100,
	StallSpeed = 140,     -- studs/s
	CornerSpeed = 330,
	Accel = 180,          -- studs/s^2 at full throttle
	Drag = 0.001247,
	Afterburner = 1.6,    -- thrust multiplier
	PitchRate = 1.35,     -- rad/s at the corner speed
	RollRate = 2.8,
	YawRate = 0.45,
	StartSpeed = 300,
	Missiles = 4,
	MissileReload = 9,    -- seconds per missile
	Flares = 12,
	FlareTime = 1.6,      -- how long a flare burst protects
	FlareCooldown = 0.5,
}

-- The jets of the game (the same .glb models as the browser game, imported into Studio - see roblox/README.md).  length: the
-- real length in metres = studs; a jet that is not imported (not in ReplicatedStorage.JetModels) is built from parts instead.
-- flip: true / false forces the nose direction of an imported model (nil: worked out from the shape).
Config.JetModels = {
	{ key = "f16", name = "F-16C Viper", length = 15.0 },
	{ key = "fa18", name = "F/A-18E Super Hornet", length = 18.3 },
	{ key = "f15", name = "F-15EX Eagle II", length = 19.4 },
	{ key = "f22", name = "F-22A Raptor", length = 18.9 },
	{ key = "f35", name = "F-35A Lightning II", length = 15.7 },
	{ key = "gripen", name = "JAS 39 Gripen", length = 14.1 },
	{ key = "typhoon", name = "Eurofighter Typhoon", length = 15.96 },
	{ key = "rafale", name = "Dassault Rafale", length = 15.3 },
	{ key = "su35", name = "Szu-35", length = 21.9 },
	{ key = "su57", name = "Szu-57", length = 20.1 },
	{ key = "mig29", name = "MiG-29", length = 17.3 },
	{ key = "mig31", name = "MiG-31", length = 22.7 },
	{ key = "j20", name = "J-20", length = 20.3 },
	{ key = "t38", name = "T-38 Talon", length = 14.1 },
	{ key = "t45", name = "T-45 Goshawk", length = 12.0 },
	{ key = "t6", name = "T-6 Texan II", length = 10.2 },
}
Config.JetModelFlip = {}                -- e.g. { f16 = true } turns an imported jet round if it flies backwards
Config.EnemyModels = { "su35", "mig29", "typhoon", "su57", "mig31", "rafale", "j20" }   -- the enemies use these when imported

Config.Gun = { Damage = 7, Range = 1500, Rate = 14, Radius = 13, Heat = 0.045 }
Config.Missile = { Damage = 60, Speed = 520, TurnRate = 1.9, Life = 9, Range = 3200, FuseRadius = 14, Cone = 28 }

-- The island is the game's own (IslandBuilder.luau): 1 metre of the game = Island.StudsPerMeter studs across, and the
-- heights are Island.HeightScale studs per metre (a little exaggerated, so that the hills read next to a 15 stud jet).
Config.Island = { StudsPerMeter = 0.1, HeightScale = 0.12, Voxel = 4 }

Config.World = {
	Half = 5120,          -- the playing field is +-Half studs (the whole island: 102.4 km * 0.1)
	SpawnHeight = 520,    -- above the air base
	SpawnRadius = 700,
	EnemyRing = 3300,     -- the enemy waves come in from this far (from the island's middle)
	EnemyAltitude = { 450, 1000 },
}

Config.Enemy = {
	Speed = 310,
	TurnRate = 1.05,      -- rad/s, the player can out-turn them at the corner speed
	GunRange = 700,
	GunDamage = 3,        -- per shot, 5 shots a second while on target
	MissileRange = 2400,
	MissileCooldown = 14,
	FlareChance = 0.25,   -- the chance that an enemy shakes off a missile (once per missile)
	Health = 70,
	WaveBase = 2,         -- wave n has WaveBase + n jets, at most MaxActive at once
	MaxActive = 6,
	WaveDelay = 8,
}

Config.PvP = false

return Config
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">Island</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- GENERATED by tools/roblox_island.py: the game's island as a grid for the Roblox terrain.
return {
	N = 384,                      -- cells per side
	SizeMeters = 102400.0,           -- the island's side in the game (metres)
	Offset = 300.0,               -- metres added to the heights before packing
	Unit = 0.25,                 -- metres per height unit
	HeightRows = 128,             -- rows in each of IslandH1..3
	MinHeight = -220.0,
	MaxHeight = 4240.8,
	Airfield = { x = 19000.0, y = -26000.0, elevation = 225.0 },   -- the home air base (metres, the game's frame: y is north)
	RunwayLength = 3000, RunwayWidth = 45,
}
]]></ProtectedString></Properties></Item>
