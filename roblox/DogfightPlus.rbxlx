<Item class="ModuleScript" referent="RBX33"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The remote events and functions between the server and the players.  The server creates them (Remotes.init()),
-- the clients wait for them (Remotes.get()).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = {}

local EVENTS = {
	"Fire",           -- client -> server: the gun is firing
	"FireMissile",    -- client -> server: a missile at an enemy (the Model)
	"Flare",          -- client -> server: drop flares
	"Crashed",        -- client -> server: my jet hit the ground / the sea
	"Launch",         -- client -> server: take off (kind: "single" or "twoseat")
	"Mark",           -- client -> server: the rear seat marks an enemy (the Model) for the pilot
	"Seat",           -- server -> client: you sit in the rear seat of this jet (the Model), or nil: you left it
	"RoomState",      -- server -> client: the room you are in (members, teams, open rear seats)
	"Tracer",         -- server -> clients: a line of tracer fire (from, to, color)
	"Hud",            -- server -> client: { wave, enemies, missiles, flares, hp }
	"Toast",          -- server -> client: a short message (text, kind)
	"MissileAlert",   -- server -> client: true / false, a missile is coming at you
	"Died",           -- server -> client: the jet is gone (reason)
	"Profile",        -- server -> client: the coins, the owned and the equipped things
	"Earn",           -- client -> server: coins earned in the match (the server limits the rate)
	"SaveCareer",     -- client -> server: the career table (kills, medals ...)
	"Net",            -- both ways: a batch of messages of the match (shared/game/Net.luau); the server hands it to the others of the room
	"SaveBest",       -- client -> server: a race record (kind "race" / "canyon" / "tube", time, best lap)
	"SaveWar",        -- client -> server: the war career ({ war, pilot }, shared/game/Campaign.luau)
}
local FUNCTIONS = {
	"BuyAir", "BuyPilot", "EquipAir", "EquipPilot", "EquipJet",    -- shop: (id) -> ok, message
	"BuyProduct", "BuyPass",                            -- Robux: (index) -> ok
	"GetProfile",
	"ClaimDaily", "GetMissions", "ClaimMission", "GetLeaderboard",   -- the daily reward, the daily missions, the top list
	"BuySkinRobux",                                     -- (kind "air"/"pilot", id): the Robux purchase of a skin
	"ListRooms", "CreateRoom", "JoinRoom", "LeaveRoom", "QuickPlay", "SetTeam", "SetSlots",   -- the hangar groups
	"OpenSeat", "JoinSeat", "LeaveSeat",                -- the rear seat of a two-seat jet: the pilot opens it (open, aircraft key, loadout pairs), a team mate takes / leaves it
}

function Remotes.init()
	local folder = Instance.new("Folder")
	folder.Name = "Remotes"
	for _, n in EVENTS do
		local e = Instance.new("RemoteEvent")
		e.Name = n
		e.Parent = folder
	end
	for _, n in FUNCTIONS do
		local f = Instance.new("RemoteFunction")
		f.Name = n
		f.Parent = folder
	end
	folder.Parent = ReplicatedStorage
	return folder
end

function Remotes.get()
	local folder = ReplicatedStorage:WaitForChild("Remotes")
	local t = {}
	for _, n in EVENTS do t[n] = folder:WaitForChild(n) end
	for _, n in FUNCTIONS do t[n] = folder:WaitForChild(n) end
	return t
end

return Remotes
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX34"><Properties><string name="Name">SoundMap</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- GENERATED by tools/make_roblox_sounds.py: where each sound of roblox/audio/dogfight_sounds.wav is (seconds).  Upload that one file to
-- Roblox (see roblox/README.md) and put its asset id into Config.SoundId, or into the attribute SoundAssetId of ReplicatedStorage.
return {
	engine = { start = 0.500, length = 2.000, loop = true },
	afterburner = { start = 2.800, length = 2.000, loop = true },
	whine = { start = 5.100, length = 1.000, loop = true },
	gun = { start = 6.400, length = 0.500, loop = true },
	growl = { start = 7.200, length = 1.000, loop = true },
	lock_tone = { start = 8.500, length = 1.000, loop = true },
	rwr_lock = { start = 9.800, length = 1.000, loop = true },
	rwr_launch = { start = 11.100, length = 1.000, loop = true },
	wind = { start = 12.400, length = 2.000, loop = true },
	flyby = { start = 14.700, length = 2.000, loop = true },
	whoosh = { start = 17.000, length = 1.000, loop = true },
	rwr_new = { start = 18.300, length = 0.350, loop = false },
	launch = { start = 18.950, length = 1.600, loop = false },
	hit = { start = 20.850, length = 0.250, loop = false },
	explosion = { start = 21.400, length = 2.500, loop = false },
	boom = { start = 24.200, length = 1.400, loop = false },
	splash = { start = 25.900, length = 0.700, loop = false },
	medal = { start = 26.900, length = 1.100, loop = false },
}
]]></ProtectedString></Properties></Item>
<Item class="Folder" referent="RBX48"><Properties><string name="Name">game</string></Properties><Item class="ModuleScript" referent="RBX35"><Properties><string name="Name">Camera</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The flight camera: the port of FlightCamera of web/js/game.js (without the three.js camera object).  The mouse moves an aim
-- point on the sphere round the jet (the instructor flies the nose there); with C / right mouse held the head looks round
-- freely; in the cockpit the head turns about the neck and the eyes lean past the seat; V = cockpit, N = look down at the displays.
-- Everything is in the simulation's frame (metres; x east, y north, z up; the view looks along +Y of its orientation).  After
-- update(): self.position (a vector), self.orientation (a quaternion, with the shake), self.fov (vertical, degrees), self.shift.
-- Common subset of Lua 5.4 and Luau.
local M = require(script.Parent.Parent.sim.SimMath)
local V, add, sub, mul, dot, cross, norm, clamp, DEG = M.V, M.add, M.sub, M.mul, M.dot, M.cross, M.norm, M.clamp, M.DEG
local qaxis, qmul, qlook, fwdOf, upOf, xform = M.qaxis, M.qmul, M.qlook, M.fwdOf, M.upOf, M.xform
local atan2, sin, cos, exp, abs, min, max = M.atan2, math.sin, math.cos, math.exp, math.abs, math.min, math.max

local C = {}
C.CHASE_DISTANCE, C.CHASE_HEIGHT = 26, 5.5
C.HEAD_YAW = 160 * DEG                                   -- a pilot turns the head at most 160 degrees each way
C.SENS_BASE = 0.09                                       -- "100 %" on the sensitivity sliders
C.STICK_GAIN, C.STICK_DEADZONE = 0.045, 0.07
local NECK, EYE_FROM_NECK, LEAN_SIDE, LEAN_FWD = V(0, -0.09, -0.06), V(0, 0.09, 0.06), 0.18, 0.12
C.COCKPIT_SHIFT = 0.13

local function ease(t) t = clamp(t, 0, 1); return t * t * (3 - 2 * t) end

local Cam = {}
Cam.__index = Cam
function C.new(terrain)
	local self = setmetatable({}, Cam)
	self.terrain, self.eye = terrain, V(0, 2.4, 1.1)
	self.sensitivity, self.stickSens, self.invertY = C.SENS_BASE * 0.6, 0.6, false
	self.aim, self.look = M.Q(), M.Q()
	self.freeLook, self.cockpit, self.position, self.fov, self.phase, self.zoom = false, false, V(), 70, 0, 0
	self.headYaw, self.headPitch, self.headG = 0, 0, 0
	self.panelLook, self.panel, self.panelFov = false, nil, 30
	self.baseFov = 70
	self.follow, self.followLabel = nil, ""
	self.orientation, self.shift, self.kick = M.Q(), 0, 0
	self.rand = function() return math.random() end
	return self
end
function Cam:reset(ac)
	self.aim = qlook(ac.forward)
	self.look = self.aim:clone()
end
function Cam:aimDirection() return fwdOf(self.aim) end
function Cam:setFreeLook(on)
	if on and not self.freeLook and not self.cockpit then self.look = self.aim:clone() end
	if on then self.panelLook = false end
	self.freeLook = on
end
function Cam:rotate(yawDeg, pitchDeg)
	if self.cockpit and self.freeLook then                   -- turning the head inside the cockpit
		self.headYaw = clamp(self.headYaw + yawDeg * DEG, -C.HEAD_YAW, C.HEAD_YAW)
		self.headPitch = clamp(self.headPitch + pitchDeg * DEG, -0.9, 1.4)
		return
	end
	local q = self.freeLook and self.look or self.aim
	q = qmul(qaxis(V(0, 0, 1), yawDeg * DEG), q)             -- yaw around world up
	q = qmul(q, qaxis(V(1, 0, 0), pitchDeg * DEG)):normalize() -- pitch around local right
	if self.freeLook then self.look = q else self.aim = q end
end
function Cam:mouseDelta(dx, dy)
	self:rotate(-dx * self.sensitivity, -dy * self.sensitivity * (self.invertY and -1 or 1))
end
-- rolls the view back upright (the aim point never stays tilted)
function C.level(q, dt, rate)
	rate = rate or 1.6
	local fwd = fwdOf(q)
	if abs(fwd.z) > 0.96 then return q end
	local up = upOf(q)
	local want = norm(sub(V(0, 0, 1), mul(fwd, fwd.z)))
	local ang = atan2(dot(cross(up, want), fwd), dot(up, want))
	local step
	if abs(ang) < 2.5 then step = clamp(ang, -rate * dt, rate * dt) else step = ang * min(1, rate * 0.6 * dt) end
	return qmul(q, qaxis(V(0, 1, 0), step))
end

function Cam:update(dt, ac)
	self.aim = C.level(self.aim, dt)
	if self.freeLook then self.look = C.level(self.look, dt) end
	if not ac then return end
	local view = self.freeLook and self.look or self.aim
	local f = self.follow
	local terrain = self.terrain
	if f then
		-- missile cam / kill cam: behind the followed object, looking where it goes
		view = qlook(f.dir)
		self.position = add(sub(f.pos, mul(f.dir, f.dist)), mul(upOf(view), f.height))
		local ground = terrain:height(self.position.x, self.position.y)
		if self.position.z < ground + 3 then self.position.z = ground + 3 end
	elseif self.cockpit and ac.alive then
		-- the pilot's head is part of the jet: the view rolls, pitches and yaws with it.  Under G the head sags or lifts a few cm.
		if not self.freeLook then
			-- the head comes back to the front, or with N turns down to the instrument panel
			local k = exp(-6 * dt)
			local p = (self.panelLook and self.panel) and atan2(self.panel.z - self.eye.z, self.panel.y - self.eye.y) or 0
			self.headYaw = self.headYaw * k
			self.headPitch = p + (self.headPitch - p) * k
		end
		local sag = clamp(-(ac.fm.gLoad - 1) * 0.012, -0.06, 0.09)
		self.headG = self.headG + (sag - self.headG) * min(1, dt * 6)
		local head = qmul(qaxis(V(0, 0, 1), self.headYaw), qaxis(V(1, 0, 0), self.headPitch))
		view = qmul(ac.quat, head)
		local lean = ease((abs(self.headYaw) - 40 * DEG) / (100 * DEG))
		local body = V(-M.sign(self.headYaw) * LEAN_SIDE * lean, LEAN_FWD * lean, self.headG)
		local eye = add(add(self.eye, NECK), add(xform(head, EYE_FROM_NECK), body))
		self.position = add(ac.pos, xform(ac.quat, eye))
	else
		local dist = ac.alive and C.CHASE_DISTANCE or 70
		self.position = add(sub(ac.pos, mul(fwdOf(view), dist)), mul(upOf(view), C.CHASE_HEIGHT))
		local ground = terrain:height(self.position.x, self.position.y)
		if self.position.z < ground + 3 then self.position.z = ground + 3 end
	end
	self.phase = self.phase + dt
	local shake = 0
	if ac.alive and ac.gun.firing then shake = shake + 0.07 end
	if ac.alive and ac.fm.gLoad > 6 then shake = shake + (ac.fm.gLoad - 6) * 0.03 end
	if self.kick > 0 then
		shake = shake + self.kick * 0.6
		self.kick = max(0, self.kick - dt * 1.6)                       -- a blast nearby
	end
	local q = view
	if shake > 0 then
		q = qmul(q, qmul(qaxis(V(1, 0, 0), sin(self.phase * 53) * shake * DEG), qaxis(V(0, 0, 1), sin(self.phase * 71) * shake * DEG)))
	end
	self.orientation = q
	local panel = self.cockpit and self.panelLook and ac.alive and not f
	local b = self.baseFov
	local target
	if panel then target = self.panelFov
	elseif f then target = b
	else target = ({ self.cockpit and b + 5 or b, b * 0.64, b * 0.4 })[self.zoom + 1] end
	self.fov = self.fov + (target - self.fov) * min(1, dt * 8)
	-- cockpit: the picture is shifted so the HUD sits above the screen centre (a lens shift in the browser)
	local shift = (self.cockpit and ac.alive and not panel and not f) and C.COCKPIT_SHIFT or 0
	self.shift = self.shift + (shift - self.shift) * min(1, dt * 8)
end

return C
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX36"><Properties><string name="Name">Campaign</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- World War 3: the strategic game behind the career - the port of web/js/campaign.js.
--  * four powers that start at war with everybody - the USA, Europe (the European air forces fight together from the first day), Russia
--    and China.  Trust is earned (joint missions, help when somebody is attacked) and only then can two powers ally.
--  * every power has its real air force (fighters by type, public estimates 2025-26) and builds new jets every month at the real rate,
--    as far as its budget pays.  You see your own numbers exactly, the others only as intelligence estimates.
--  * the war is fought on fronts at real places; every day the fronts fight it out by the quality and number of the jets and pilots
--    sent there; your own missions add what you actually did.
--  * a power whose fighters are gone is out; the last power (or alliance) with an air force wins.
-- The state is a plain table (strings, numbers, booleans, tables), so it can be saved as it is.
-- Common subset of Lua 5.4 and Luau.
local C = {}

C.DAY_PER_MISSION = 2

-- air-to-air quality of each type (10 = best)
C.QUALITY = { f22 = 10, f35 = 8.6, su57 = 7.6, j20 = 8.0, f15 = 7.6, su35 = 7.4, typhoon = 7.6, rafale = 7.5, gripen = 6.7,
	f16 = 6.6, fa18 = 6.6, mig31 = 5.6, mig29 = 5.4, f15a = 7.2 }
-- what a new jet costs (million dollars, flyaway)
C.COST = { f22 = 150, f35 = 82, f15 = 90, f16 = 65, fa18 = 70, typhoon = 100, rafale = 95, gripen = 55, su35 = 85, su57 = 100, j20 = 110, mig31 = 60, mig29 = 30, f15a = 40 }
local QUALITY, COST = C.QUALITY, C.COST

C.POWER_IDS = { "us", "eu", "ru", "cn" }
local POWER_IDS = C.POWER_IDS
-- fleet: fighters by type; production: the most a line builds per month; income: million dollars a day for new jets
C.POWERS = {
	us = { name = "Egyesült Államok", short = "USA", colour = { 74, 127, 216 },
		fleet = { f22 = 180, f35 = 650, f15 = 30, f16 = 900, fa18 = 500 }, production = { f35 = 10, f15 = 2 }, income = 24, pilots = 3200, skill = 1.0 },
	eu = { name = "Európa", short = "EU", colour = { 60, 192, 160 },
		fleet = { typhoon = 370, rafale = 200, gripen = 104, f35 = 75, f16 = 48 }, production = { typhoon = 1, rafale = 1.5, gripen = 1, f35 = 2 }, income = 9, pilots = 1300, skill = 0.95 },
	ru = { name = "Oroszország", short = "RU", colour = { 216, 74, 74 },
		fleet = { su35 = 130, su57 = 28, mig31 = 120, mig29 = 90 }, production = { su35 = 1.5, su57 = 1 }, income = 5, pilots = 1100, skill = 0.85 },
	cn = { name = "Kína", short = "CN", colour = { 224, 176, 48 },
		fleet = { j20 = 300, su35 = 24 }, production = { j20 = 10 }, income = 20, pilots = 1500, skill = 0.85 },
}
local POWERS = C.POWERS

-- the fronts: real places and who meets whom
C.FRONTS = {
	{ id = "baltic", name = "Baltikum", sides = { "eu", "us", "ru" }, why = "Észtország, Lettország, Litvánia légtere" },
	{ id = "poland", name = "Lengyel–belarusz határ", sides = { "eu", "us", "ru" }, why = "a Suwałki-folyosó" },
	{ id = "blacksea", name = "Fekete-tenger", sides = { "eu", "us", "ru" }, why = "a Krím és a tengeri útvonalak" },
	{ id = "arctic", name = "Észak-Norvégia", sides = { "eu", "us", "ru" }, why = "a Kola-félsziget bázisai" },
	{ id = "hungary", name = "Magyarország", sides = { "eu", "ru" }, why = "Európa szíve – a magyar Gripenek otthona" },
	{ id = "alaska", name = "Alaszka – Bering-szoros", sides = { "us", "ru" }, why = "Amerika és Oroszország 80 km-re" },
	{ id = "taiwan", name = "Tajvani-szoros", sides = { "us", "cn" }, why = "a Csendes-óceán kulcsa" },
	{ id = "scs", name = "Dél-kínai-tenger", sides = { "us", "cn" }, why = "mesterséges szigetek, kifutópályákkal" },
	{ id = "japan", name = "Japán-tenger", sides = { "us", "cn", "ru" }, why = "három nagyhatalom találkozik" },
	{ id = "siberia", name = "Amur-folyó (orosz–kínai határ)", sides = { "ru", "cn" }, why = "a két szomszéd régi vitája" },
	{ id = "atlantic", name = "Izland – az Atlanti-óceán kapuja", sides = { "us", "eu" }, why = "Keflavík és a GIUK-rés: itt csak az európai légierővel kerülsz szembe" },
	{ id = "india", name = "Himalája – Ladakh", sides = { "cn", "us" }, why = "a világ teteje" },
}
local FRONTS = C.FRONTS
function C.front(id)
	for _, f in ipairs(FRONTS) do
		if f.id == id then return f end
	end
	return nil
end

local clamp = function(x, lo, hi) if x < lo then return lo elseif x > hi then return hi else return x end end
local floor = math.floor

local function sortedKeys(t)
	local out = {}
	for k in pairs(t) do out[#out + 1] = k end
	table.sort(out)
	return out
end
C.sortedKeys = sortedKeys

-- the order the browser's tables list their types in (the random draws walk through them in this order, so it decides who loses what)
C.FLEET_ORDER = { us = { "f22", "f35", "f15", "f16", "fa18" }, eu = { "typhoon", "rafale", "gripen", "f35", "f16" }, ru = { "su35", "su57", "mig31", "mig29" }, cn = { "j20", "su35" } }
C.PROD_ORDER = { us = { "f35", "f15" }, eu = { "typhoon", "rafale", "gripen", "f35" }, ru = { "su35", "su57" }, cn = { "j20" } }
local function ordered(t, list)
	local out, seen = {}, {}
	for _, k in ipairs(list or {}) do
		if t[k] ~= nil then out[#out + 1] = k; seen[k] = true end
	end
	local rest = {}
	for k in pairs(t) do
		if not seen[k] then rest[#rest + 1] = k end
	end
	table.sort(rest)
	for _, k in ipairs(rest) do out[#out + 1] = k end
	return out
end

local function pairKey(a, b)
	if a < b then return a .. "-" .. b end
	return b .. "-" .. a
end

function C.totalFleet(fleet)
	local s = 0
	for _, v in pairs(fleet) do s = s + v end
	return s
end
local totalFleet = C.totalFleet
function C.strength(fleet, skill)
	local s = 0
	for k, v in pairs(fleet) do s = s + v * (QUALITY[k] or 6) end
	return s * (skill or 1)
end
local strength = C.strength

local function log(w, text)
	table.insert(w.log, 1, { day = w.day, text = text })
	if #w.log > 80 then table.remove(w.log) end
end

local function copyFleet(f)
	local o = {}
	for k, v in pairs(f) do o[k] = v end
	return o
end

-- a fresh war: everybody against everybody, Europe together
function C.newWar(playerPower, seed)
	playerPower = playerPower or "us"
	local w = { version = 1, seed = seed or os.time(), day = 0, started = false, player = playerPower, powers = {}, trust = {}, allied = {}, war = {}, fronts = {},
		intel = {}, log = {}, offers = {}, over = false, missions = 0, policy = { production = {}, focus = false } }
	for _, id in ipairs(POWER_IDS) do
		local p = POWERS[id]
		w.powers[id] = { fleet = copyFleet(p.fleet), start = totalFleet(p.fleet), lost = {}, built = {}, out = false, pilots = p.pilots, money = p.income * 20, spent = 0, fleetFrac = {}, damage = 0 }
	end
	local T = { ["eu-us"] = 25, ["ru-us"] = -60, ["cn-us"] = -55, ["eu-ru"] = -55, ["cn-eu"] = -25, ["cn-ru"] = 5 }
	for k, v in pairs(T) do w.trust[k] = v; w.allied[k] = false; w.war[k] = true end
	for _, f in ipairs(FRONTS) do w.fronts[f.id] = { control = {}, heat = 0.5, lastBattle = false } end
	for _, id in ipairs(POWER_IDS) do
		if id ~= playerPower then w.intel[id] = 0.35 end                  -- estimate error (+-35 %)
	end
	return w
end

function C.trustOf(w, a, b) return w.trust[pairKey(a, b)] or 0 end
function C.alliedWith(w, a, b) return a == b or w.allied[pairKey(a, b)] == true end
function C.atWar(w, a, b) return a ~= b and not w.allied[pairKey(a, b)] and w.war[pairKey(a, b)] == true end
local trustOf, alliedWith, atWar = C.trustOf, C.alliedWith, C.atWar

function C.changeTrust(w, a, b, d, why)
	local k = pairKey(a, b)
	w.trust[k] = clamp((w.trust[k] or 0) + d, -100, 100)
	if why then log(w, string.format("%s–%s bizalom %s%d: %s", POWERS[a].short, POWERS[b].short, d > 0 and "+" or "", floor(d + (d < 0 and -0.5 or 0.5)), why)) end
end
local changeTrust = C.changeTrust

-- what the player sees of a power's air force: exact for your own and your allies', an estimate for the rest
function C.seenFleet(w, id)
	local real = w.powers[id].fleet
	if id == w.player or alliedWith(w, id, w.player) then return { fleet = copyFleet(real), exact = true } end
	local e = w.intel[id] or 0.35
	local out = {}
	for k, v in pairs(real) do
		local noise = math.sin((w.seed % 997) + #k * 7.3 + w.day * 0.13 + #id) * e          -- stable per day
		out[k] = math.max(0, floor(v * (1 + noise) / 5 + 0.5) * 5)
	end
	return { fleet = out, exact = false, error = e }
end

-- ---------------------------------------------------------------- diplomacy
function C.proposeAlliance(w, from, to)
	local t = trustOf(w, from, to)
	if alliedWith(w, from, to) then return { ok = false, text = "Már szövetségesek vagytok." } end
	if t < 60 then return { ok = false, text = string.format("%s nem bízik bennetek eléggé (bizalom: %d / 60).", POWERS[to].name, floor(t + 0.5)) } end
	w.allied[pairKey(from, to)] = true
	w.war[pairKey(from, to)] = false
	log(w, "SZÖVETSÉG: " .. POWERS[from].name .. " és " .. POWERS[to].name)
	return { ok = true, text = POWERS[to].name .. " elfogadta: szövetségesek vagytok!" }
end
function C.proposeCeasefire(w, from, to)
	local t = trustOf(w, from, to)
	local weak = totalFleet(w.powers[to].fleet) / w.powers[to].start
	if t > 0 or weak < 0.35 then
		w.war[pairKey(from, to)] = false
		log(w, "TŰZSZÜNET: " .. POWERS[from].name .. " és " .. POWERS[to].name)
		changeTrust(w, from, to, 10, "tűzszünet")
		return { ok = true, text = "Tűzszünet " .. POWERS[to].name .. " és köztetek." }
	end
	return { ok = false, text = POWERS[to].name .. " elutasította a tűzszünetet." }
end
function C.declareWar(w, from, to)
	w.allied[pairKey(from, to)] = false
	w.war[pairKey(from, to)] = true
	changeTrust(w, from, to, -40, "hadüzenet")
	for _, o in ipairs(POWER_IDS) do
		if o ~= from and o ~= to and alliedWith(w, o, to) then changeTrust(w, from, o, -20, "megtámadtátok a szövetségesét (" .. POWERS[to].short .. ")") end
	end
end

-- ---------------------------------------------------------------- the daily battles on the fronts
local function seeded(w)
	local s = (w.seed + w.day * 7919) % 2147483647
	return function()
		s = (s * 16807) % 2147483647
		return (s - 1) / 2147483646
	end
end

-- remove a fraction of a power's fleet (spread over the types; the better ones survive a little better)
function C.loseJets(w, id, frac)
	local P = w.powers[id]
	local total = 0
	for _, k in ipairs(ordered(P.fleet, C.FLEET_ORDER[id])) do
		local v = P.fleet[k]
		local q = QUALITY[k] or 6
		local f = frac * (1.25 - q / 20)
		local exact = v * f
		local n = floor(exact) + (math.random() < exact % 1 and 1 or 0)
		local lost = math.min(v, n)
		P.fleet[k] = v - lost
		P.lost[k] = (P.lost[k] or 0) + lost
		total = total + lost
	end
	return total
end

local function checkOut(w)
	for _, id in ipairs(POWER_IDS) do
		local P = w.powers[id]
		if not P.out and totalFleet(P.fleet) <= math.max(3, P.start * 0.02) then
			P.out = true
			log(w, POWERS[id].name .. " légiereje megsemmisült – kiesett a háborúból!")
		end
	end
	-- the end: everybody left is allied (or at peace) with everybody else
	local left = {}
	for _, id in ipairs(POWER_IDS) do
		if not w.powers[id].out then left[#left + 1] = id end
	end
	local fighting = false
	for _, a in ipairs(left) do
		for _, b in ipairs(left) do
			if a < b and atWar(w, a, b) then fighting = true end
		end
	end
	local playerLeft = false
	for _, id in ipairs(left) do
		if id == w.player then playerLeft = true end
	end
	if not fighting and not w.over then
		w.over = { day = w.day, winners = left, player = playerLeft }
		log(w, playerLeft and "A HÁBORÚ VÉGET ÉRT – GYŐZTETEK!" or "A HÁBORÚ VÉGET ÉRT – a te oldalad elvesztette a légierejét.")
	end
	if w.powers[w.player].out and not w.over then w.over = { day = w.day, winners = left, player = false } end
end

-- one day: production, then the battles.  skip: a front id that is not simulated (the player fights there himself)
function C.simulateDay(w, skip)
	local r = seeded(w)
	local report = {}
	w.day = w.day + 1
	for _, id in ipairs(POWER_IDS) do
		local P = w.powers[id]
		if not P.out then
			local dmg = (P.damage or 0) > 0 and 1 - P.damage or 1
			P.money = P.money + POWERS[id].income * dmg                                   -- the budget of the day
			P.money = math.min(P.money, POWERS[id].income * 60)                          -- no endless savings: two months at most
			P.fleetFrac = P.fleetFrac or {}
			local first = w.policy.production and w.policy.production[id]
			local order = ordered(POWERS[id].production, C.PROD_ORDER[id])
			if first then
				local rest = {}
				for _, k in ipairs(order) do
					if k ~= first then rest[#rest + 1] = k end
				end
				if POWERS[id].production[first] then table.insert(rest, 1, first) end
				order = rest
			end
			for _, k in ipairs(order) do
				local perMonth, cost = POWERS[id].production[k], COST[k] or 80
				P.fleetFrac[k] = math.min(1.5, (P.fleetFrac[k] or 0) + perMonth / 30 * dmg)
				while P.fleetFrac[k] >= 1 and P.money >= cost do
					P.fleetFrac[k] = P.fleetFrac[k] - 1
					P.money = P.money - cost
					P.spent = P.spent + cost
					P.fleet[k] = (P.fleet[k] or 0) + 1
					P.built[k] = (P.built[k] or 0) + 1
				end
			end
			if (P.damage or 0) > 0 then P.damage = math.max(0, P.damage - 0.01) end    -- repairs
		end
	end
	if not w.started then return report end
	for _, f in ipairs(FRONTS) do
		if skip ~= f.id then
			local sides = {}
			for _, s in ipairs(f.sides) do
				if not w.powers[s].out then sides[#sides + 1] = s end
			end
			for i = 1, #sides do
				for j = i + 1, #sides do
					local a, b = sides[i], sides[j]
					if atWar(w, a, b) then
						local heat = w.fronts[f.id].heat * (0.6 + 0.8 * r())
						local function commit(id)
							local n = 0
							for _, x in ipairs(FRONTS) do
								for _, s in ipairs(x.sides) do if s == id then n = n + 1 end end
							end
							return 0.06 * heat / math.max(1, n / 3)
						end
						local ca, cb = commit(a), commit(b)
						local sa, sb = strength(w.powers[a].fleet, POWERS[a].skill) * ca, strength(w.powers[b].fleet, POWERS[b].skill) * cb
						if sa >= 1 and sb >= 1 then
							local ka, kb = 0.05 * sb / (sa + sb), 0.05 * sa / (sa + sb)       -- fraction of the committed jets lost
							local la, lb = C.loseJets(w, a, ka * ca), C.loseJets(w, b, kb * cb)
							w.fronts[f.id].lastBattle = { day = w.day, a = a, b = b, la = la, lb = lb }
							changeTrust(w, a, b, -0.02)
							report[#report + 1] = { front = f.id, a = a, b = b, la = la, lb = lb }
						end
					end
				end
			end
		end
	end
	checkOut(w)
	return report
end

-- what really happened in the player's mission.  result: { losses = { power = { type = n } }, front, won, trust = { power = d }, trustWhy, intel, strike }
function C.applyMission(w, result)
	for power, byType in pairs(result.losses or {}) do
		local P = w.powers[power]
		if P then
			for k, n in pairs(byType) do
				local m = math.min(P.fleet[k] or 0, n)
				P.fleet[k] = (P.fleet[k] or 0) - m
				P.lost[k] = (P.lost[k] or 0) + m
			end
		end
	end
	if result.front and w.fronts[result.front] then
		w.fronts[result.front].heat = clamp(w.fronts[result.front].heat + (result.won and -0.05 or 0.08), 0.2, 1)
	end
	for other, d in pairs(result.trust or {}) do changeTrust(w, w.player, other, d, result.trustWhy) end
	if result.intel then
		for id in pairs(w.intel) do w.intel[id] = math.max(0.05, w.intel[id] - result.intel) end
	end
	if result.strike then
		local P = w.powers[result.strike]
		P.damage = clamp((P.damage or 0) + 0.25, 0, 0.8)
		log(w, "Gyárak bombázva: " .. POWERS[result.strike].name .. " gyártása -25 %")
	end
	w.missions = w.missions + 1
	checkOut(w)
end

-- the other powers' own decisions every few days (alliances fall apart or form, allies help each other, ceasefires, strikes on factories,
-- offers to the player)
function C.aiDiplomacy(w)
	local r = seeded(w)
	local function ratio(id) return totalFleet(w.powers[id].fleet) / math.max(1, w.powers[id].start) end
	local offers = {}
	for _, o in ipairs(w.offers or {}) do
		if w.day - o.day <= 10 and not w.powers[o.from].out then offers[#offers + 1] = o end
	end
	w.offers = offers
	local function hasOffer(from, type_)
		for _, o in ipairs(w.offers) do
			if o.from == from and o.type == type_ then return true end
		end
		return false
	end
	local function hit(id, by, d)
		local P = w.powers[id]
		P.damage = clamp((P.damage or 0) + d, 0, 0.8)
		log(w, string.format("%s bombázta %s gyárait (a gyártás −%d %%)", POWERS[by].name, id == w.player and "a te" or POWERS[id].name, floor(d * 100 + 0.5)))
	end
	for _, a in ipairs(POWER_IDS) do
		for _, b in ipairs(POWER_IDS) do
			if a < b and not w.powers[a].out and not w.powers[b].out then
				local pl = a == w.player or b == w.player
				local other = a == w.player and b or a
				if not pl then
					local common = 0
					for _, c in ipairs(POWER_IDS) do
						if c ~= a and c ~= b and atWar(w, a, c) and atWar(w, b, c) then common = common + 1 end
					end
					changeTrust(w, a, b, common * 0.6)
				end
				local t = trustOf(w, a, b)
				local skipRest = false
				-- an alliance dies of distrust (yours included)
				if alliedWith(w, a, b) and t < 20 then
					w.allied[pairKey(a, b)] = false
					w.war[pairKey(a, b)] = true
					log(w, string.format("SZÖVETSÉG FELBONTVA: %s és %s (bizalom %d)", POWERS[a].name, POWERS[b].name, floor(t + 0.5)))
					skipRest = true
				end
				-- a truce is called off when the trust is gone
				if not skipRest and not alliedWith(w, a, b) and not atWar(w, a, b) and t < -40 then
					C.declareWar(w, a, b)
					log(w, "TŰZSZÜNET FELMONDVA: " .. POWERS[a].name .. " és " .. POWERS[b].name)
					skipRest = true
				end
				if not skipRest and alliedWith(w, a, b) then
					-- the strong ally helps the weak one: two of its best jets
					local s, wk = a, b
					if ratio(b) > ratio(a) then s, wk = b, a end
					if ratio(wk) < 0.6 and ratio(s) > 0.8 and r() < 0.35 then
						local keys = sortedKeys(w.powers[s].fleet)
						table.sort(keys, function(x, y) return (QUALITY[x] or 6) > (QUALITY[y] or 6) end)
						local typ = nil
						for _, k in ipairs(keys) do
							if not typ and w.powers[s].fleet[k] > 10 then typ = k end
						end
						if typ then
							w.powers[s].fleet[typ] = w.powers[s].fleet[typ] - 2
							w.powers[wk].fleet[typ] = (w.powers[wk].fleet[typ] or 0) + 2
							changeTrust(w, a, b, 1)
							log(w, string.format("%s 2 %s-t küldött szövetségesének (%s)", POWERS[s].name, string.upper(typ), POWERS[wk].name))
						end
					end
					skipRest = true
				end
				if not skipRest and atWar(w, a, b) then
					local weak = math.min(ratio(a), ratio(b))
					if not pl and t >= 10 and weak < 0.55 then
						w.war[pairKey(a, b)] = false
						changeTrust(w, a, b, 10)
						log(w, "TŰZSZÜNET: " .. POWERS[a].name .. " és " .. POWERS[b].name .. " (a veszteségektől megfogyatkozva)")
						skipRest = true
					elseif t <= -60 and r() < 0.06 then
						local victim = w.player
						if not pl then victim = ratio(a) < ratio(b) and a or b end
						hit(victim, victim == a and b or a, 0.15)
					end
				end
				if not skipRest and not pl and not alliedWith(w, a, b) and t >= 70 then
					w.allied[pairKey(a, b)] = true
					w.war[pairKey(a, b)] = false
					log(w, "SZÖVETSÉG: " .. POWERS[a].name .. " és " .. POWERS[b].name)
					skipRest = true
				end
				if not skipRest and pl then
					if t >= 70 and not hasOffer(other, "alliance") then
						table.insert(w.offers, { from = other, type = "alliance", day = w.day })
						log(w, string.format("%s szövetséget ajánl neked (bizalom %d)", POWERS[other].name, floor(t + 0.5)))
					elseif atWar(w, a, b) and t >= 25 and (ratio(other) < 0.55 or ratio(w.player) < 0.5) and not hasOffer(other, "ceasefire") then
						table.insert(w.offers, { from = other, type = "ceasefire", day = w.day })
						log(w, string.format("%s tűzszünetet ajánl (bizalom %d)", POWERS[other].name, floor(t + 0.5)))
					end
				end
			end
		end
	end
end

-- the player answers an offer
function C.answerOffer(w, i, accept)
	local o = (w.offers or {})[i]
	if not o then return { ok = false, text = "" } end
	table.remove(w.offers, i)
	if not accept then
		changeTrust(w, w.player, o.from, -3, "elutasítottad az ajánlatukat")
		return { ok = true, text = "Elutasítottad." }
	end
	if o.type == "alliance" then return C.proposeAlliance(w, w.player, o.from) end
	return C.proposeCeasefire(w, w.player, o.from)
end

-- the enemies of the player at a front
function C.frontEnemies(w, frontId)
	local f = C.front(frontId)
	local out = {}
	for _, s in ipairs(f.sides) do
		if atWar(w, w.player, s) and not w.powers[s].out then out[#out + 1] = s end
	end
	return out
end

-- n jets drawn from a fleet by numbers
function C.pickTypes(fleet, n, rnd, power)
	rnd = rnd or math.random
	local keys = ordered(fleet, C.FLEET_ORDER[power])
	local sum = 0
	for _, k in ipairs(keys) do
		if fleet[k] > 0 then sum = sum + fleet[k] end
	end
	local out = {}
	for _ = 1, n do
		if sum > 0 then
			local x = rnd() * sum
			for _, k in ipairs(keys) do
				local v = fleet[k]
				if v > 0 then
					x = x - v
					if x <= 0 then out[#out + 1] = k break end
				end
			end
		end
	end
	return out
end

-- the budget as the player sees it: money, the daily income, and how many jets a month it really pays for
function C.budgetOf(w, id)
	local P = w.powers[id]
	local inc = POWERS[id].income * (1 - (P.damage or 0))
	local monthly, cost = 0, 0
	for k, perMonth in pairs(POWERS[id].production) do
		monthly = monthly + perMonth
		cost = cost + perMonth * (COST[k] or 80)
	end
	local afford = math.min(monthly, inc * 30 / (cost / monthly))
	return { money = floor((P.money or 0) + 0.5), income = floor(inc * 10 + 0.5) / 10, perMonth = floor(afford * 10 + 0.5) / 10, capacity = monthly }
end

-- ---------------------------------------------------------------- the career of the pilot in the war (ranks, awards)
C.RANKS = { "hadnagy", "főhadnagy", "százados", "őrnagy", "alezredes", "ezredes", "dandártábornok" }
C.PROMOTE_AT = { 0, 3, 8, 14, 22, 32, 45 }
C.KINDS = { sweep = "Légtérfölény (sweep)", cap = "Légtérvédelmi járőr (CAP)" }

-- the pilot: { name, callsign, rank, sorties, kills, awards = {}, order, assigned }
function C.newPilot(name, callsign)
	return { name = name or "Pilóta", callsign = callsign or "VIPER", rank = 0, sorties = 0, kills = 0, awards = {}, jet = "f16" }
end

local function award(pilot, name)
	for _, a in ipairs(pilot.awards) do
		if a == name then return false end
	end
	table.insert(pilot.awards, name)
	return true
end
C.award = award

-- the order of the day: the front, the enemies there by their real fleets, your flight and help, sized by rank.  over: { kind, jet, tod }
function C.makeOrder(w, pilot, frontId, over)
	over = over or {}
	local f = C.front(frontId)
	local enemies = C.frontEnemies(w, frontId)
	local rank = pilot.rank or 0
	local foe = enemies[math.random(#enemies)]
	local big = math.random() < 0.35 + rank * 0.05
	local nRed = big and 4 + math.random(0, 2) or 2 + math.random(0, 1)          -- at most 6; a mission sends them in groups of 4
	local red = {}
	for _, t in ipairs(C.pickTypes(w.powers[foe].fleet, nRed, nil, foe)) do red[#red + 1] = { type = t, n = 1, power = foe } end
	local blue = {}
	local nBlue = math.max(0, nRed - 2 + (rank >= 2 and 0 or 1))
	for _, t in ipairs(C.pickTypes(w.powers[w.player].fleet, nBlue, nil, w.player)) do
		blue[#blue + 1] = { type = (t == "f22" and math.random() < 0.5) and "f15" or t, n = 1, power = w.player, label = POWERS[w.player].short }
	end
	for _, id in ipairs(POWER_IDS) do
		if id ~= w.player and alliedWith(w, w.player, id) then
			local onFront = false
			for _, s in ipairs(f.sides) do if s == id then onFront = true end end
			if onFront then
				local t = trustOf(w, w.player, id)
				local n = t >= 85 and 4 or (t >= 70 and 3 or 2)
				for _, ty in ipairs(C.pickTypes(w.powers[id].fleet, n, nil, id)) do blue[#blue + 1] = { type = ty, n = 1, power = id, label = POWERS[id].short } end
			end
		end
	end
	return { front = frontId, foe = foe, role = rank < 1 and "wing" or "lead", red = red, blue = blue, rank = rank,
		skill = ({ "normal", "normal", "hard", "hard", "ace", "ace", "ace" })[rank + 1], minutes = 8, bearing = math.random() * math.pi * 2,
		kind = over.kind or (math.random() < 0.3 and "cap" or "sweep"), jet = over.jet or pilot.jet or "f16", tod = over.tod or "day" }
end

-- the mission table for Mission.luau from an order
function C.missionOf(w, pilot, o)
	local f = C.front(o.front)
	local blue = {}
	for _, b in ipairs(o.blue) do blue[#blue + 1] = { type = b.type, n = b.n, power = b.power, label = b.label } end
	return { kind = o.kind, role = o.role, playerType = o.jet, red = o.red, blue = blue, skill = o.skill, minutes = o.minutes, bearing = o.bearing,
		front = o.front, foe = o.foe, power = w.player, tod = o.tod,
		title = string.format("%s: %d %s gép", f.name, #o.red, POWERS[o.foe].short), callsign = pilot.callsign .. " 1-" .. (o.role == "wing" and 2 or 1) }
end

-- a mission has been flown: what it does to the war and the pilot.  r: the result of Mission.luau.  -> { lines = {...} }
function C.afterMission(w, pilot, m, r)
	local foe = m.foe
	local losses = {}
	losses[foe] = {}
	losses[w.player] = {}
	for _, e in ipairs(r.redLost or {}) do
		local p = e.power or foe
		losses[p] = losses[p] or {}
		losses[p][e.type] = (losses[p][e.type] or 0) + 1
	end
	for _, e in ipairs(r.blueLost or {}) do
		local p = e.power or w.player
		losses[p] = losses[p] or {}
		losses[p][e.type] = (losses[p][e.type] or 0) + 1
	end
	local trust = {}
	for _, b in ipairs(m.blue) do
		if b.power ~= w.player then trust[b.power] = (trust[b.power] or 0) + (r.won and 4 or 1) end
	end
	local f = C.front(m.front)
	local hasEu = false
	for _, b in ipairs(m.blue) do if b.power == "eu" then hasEu = true end end
	for _, s in ipairs(f.sides) do
		if s == "eu" and not hasEu and r.won and w.player ~= "eu" then trust.eu = 3 end            -- you helped Europe's front
	end
	C.applyMission(w, { losses = losses, front = m.front, won = r.won, trust = trust, trustWhy = "közös harc a fronton", intel = 0.02 })
	local lines = {}
	-- whoever you fight trusts you less: every enemy jet you shoot down costs trust with its country, and a little with its allies
	local b0 = trustOf(w, w.player, foe)
	local shot = #(r.redLost or {})
	local d = 3 + 1.2 * shot
	changeTrust(w, w.player, foe, -d, string.format("harcoltatok egymás ellen (%d lelőtt gép)", shot))
	for _, o in ipairs(POWER_IDS) do
		if o ~= w.player and o ~= foe and alliedWith(w, foe, o) then
			changeTrust(w, w.player, o, -d * 0.4, "megtámadtátok a szövetségesét (" .. POWERS[foe].short .. ")")
		end
	end
	lines[#lines + 1] = string.format("Bizalom %s: %d → %d (harc ellenük)", POWERS[foe].short, floor(b0 + 0.5), floor(trustOf(w, w.player, foe) + 0.5))
	C.passDays(w, C.DAY_PER_MISSION)
	pilot.sorties = pilot.sorties + 1
	pilot.kills = pilot.kills + (r.kills or 0)
	if (r.kills or 0) >= 3 and award(pilot, "Silver Star") then lines[#lines + 1] = "Silver Star – 3 légi győzelem egy bevetésen" end
	if (r.kills or 0) >= 5 and award(pilot, "Medal of Honor") then lines[#lines + 1] = "Medal of Honor – 5 győzelem egy bevetésen!" end
	if pilot.kills >= 5 and award(pilot, "ÁSZ") then lines[#lines + 1] = "ÁSZ – 5 légi győzelem" end
	if pilot.sorties % 5 == 0 and award(pilot, "Air Medal (" .. pilot.sorties .. " bevetés)") then lines[#lines + 1] = "Air Medal – " .. pilot.sorties .. " bevetés" end
	if r.won and #m.red >= 8 and award(pilot, "Distinguished Flying Cross") then lines[#lines + 1] = "Distinguished Flying Cross – győzelem túlerő ellen" end
	local score = pilot.sorties + pilot.kills * 2
	while (pilot.rank or 0) < 6 and score >= C.PROMOTE_AT[(pilot.rank or 0) + 2] do
		pilot.rank = (pilot.rank or 0) + 1
		local extra = ({ [2] = " – mostantól te választod a feladatot és az időpontot", [3] = " – mostantól te választod a frontot és a gépet",
			[4] = " – MI-kötelékeket küldhetsz ki", [5] = " – politikai döntések" })[pilot.rank] or ""
		lines[#lines + 1] = "ELŐLÉPTETÉS: " .. C.RANKS[pilot.rank + 1] .. extra
	end
	return { lines = lines }
end

-- days go by: the war goes on, the powers decide
function C.passDays(w, n)
	for _ = 1, n do
		C.simulateDay(w)
		if w.day % 4 == 0 then C.aiDiplomacy(w) end
	end
end

-- a flight of AI pilots flies a mission the player does not fly: the numbers decide.  n: how many jets (2-8).  -> { redLost, blueLost, won }
function C.sendFlight(w, frontId, n)
	local enemies = C.frontEnemies(w, frontId)
	local foe = enemies[math.random(#enemies)]
	local nRed = math.max(2, n + math.random(0, 2) - 1)
	local reds = C.pickTypes(w.powers[foe].fleet, nRed, nil, foe)
	local mine = C.pickTypes(w.powers[w.player].fleet, n, nil, w.player)
	local ours, theirs = 0, 0
	for _, t in ipairs(mine) do ours = ours + 62 * (QUALITY[t] or 6) end
	for _, t in ipairs(reds) do theirs = theirs + (QUALITY[t] or 6) * 55 * POWERS[foe].skill end
	local p = ours / (ours + theirs)
	local losses = {}
	losses[foe] = {}
	losses[w.player] = {}
	local redLost, blueLost = 0, 0
	for _, t in ipairs(reds) do
		if math.random() < p * 0.75 then redLost = redLost + 1; losses[foe][t] = (losses[foe][t] or 0) + 1 end
	end
	for _, t in ipairs(mine) do
		if math.random() < (1 - p) * 0.45 then blueLost = blueLost + 1; losses[w.player][t] = (losses[w.player][t] or 0) + 1 end
	end
	C.applyMission(w, { losses = losses, front = frontId, won = redLost > blueLost })
	C.passDays(w, C.DAY_PER_MISSION)
	return { foe = foe, redLost = redLost, blueLost = blueLost, reds = #reds, mine = #mine, won = redLost > blueLost }
end

return C
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX37"><Properties><string name="Name">Career</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Career: what the player did over every match, plus the medals - the port of web/js/career.js.  The data is a plain table that
-- the client keeps with the server's profile (Profile.career); onSave(data) is called when it should be stored.
-- Common subset of Lua 5.4 and Luau.
local C = {}

C.ACHIEVEMENTS = {
	{ id = "first", name = "Első győzelem", desc = "Lőj le egy ellenséget" },
	{ id = "guns", name = "Közelharcos", desc = "Lelövés gépágyúval" },
	{ id = "fox2", name = "Fox 2!", desc = "Lelövés AIM-9M hőkövetővel" },
	{ id = "fox3", name = "Fox 3!", desc = "Lelövés AIM-120A-val" },
	{ id = "maneuver", name = "Manőverkill", desc = "Az üldözött ellenség a földbe csapódik" },
	{ id = "ace", name = "Ász", desc = "5 lelövés egyetlen életen belül" },
	{ id = "evade", name = "Kicselezve", desc = "Kerülj ki egy rád kilőtt rakétát" },
	{ id = "cobra", name = "Kobra", desc = "Rázz le egy rakétát Cobra manőverrel (F-16 extrém mód)" },
	{ id = "home", name = "Hazaértem", desc = "Szállj le a bázison, és fegyverezz újra" },
	{ id = "wave5", name = "Kitartó", desc = "Érd el az 5. hullámot" },
	{ id = "stealth", name = "Raptor-vadász", desc = "Lőj le egy F-22A-t" },
	{ id = "duel3", name = "Párbajhős", desc = "Nyerj 3 párbajt egymás után" },
	{ id = "survivor", name = "Túlélő", desc = "Túlélés módban érd el a 4. hullámot" },
	{ id = "veteran", name = "Veterán", desc = "Lelövés Nehéz vagy Ász fokozaton" },
	{ id = "team", name = "Csapatjátékos", desc = "A kísérőd lelő egy ellenséget" },
	{ id = "score5k", name = "Ötezres", desc = "Szerezz 5000 pontot egy játékban" },
	{ id = "trap", name = "Hordozós pilóta", desc = "Szállj le a hordozóra fékezőkötéllel" },
	{ id = "gsuit", name = "Centrifuga", desc = "Bírd ki a 7 G-t a centrifugában" },
	{ id = "wings", name = "Pilótaszárnyak", desc = "Végezd el a pilótaképzést" },
	{ id = "ww3", name = "A szabad világ védője", desc = "Nyerd meg a 3. világháborús hadjáratot" },
}

local function fresh()
	return {
		matches = 0, kills = 0, deaths = 0, gunKills = 0, irKills = 0, arhKills = 0, crashKills = 0, missilesFired = 0,
		flightTime = 0, bestScore = 0, bestWave = 0, bestStreak = 0, bestSurvival = 0, duelWins = 0, perPlane = {}, medals = {},
	}
end

local Career = {}
Career.__index = Career
-- data: the stored table (or nil); onSave(data): store it
function C.new(data, onSave)
	local self = setmetatable({}, Career)
	self.data = fresh()
	if data then
		for k, v in pairs(data) do self.data[k] = v end
	end
	self.data.perPlane = self.data.perPlane or {}
	self.data.medals = self.data.medals or {}
	self.onSave, self.dirty, self.saveTimer = onSave, false, 0
	return self
end
function Career:save()
	self.dirty = false
	if self.onSave then self.onSave(self.data) end
end
function Career:tick(dt)
	self.data.flightTime = self.data.flightTime + dt
	self.saveTimer = self.saveTimer + dt
	if self.saveTimer > 10 then
		self.saveTimer = 0
		self:save()
	end
end
function Career:reset()
	self.data = fresh()
	self:save()
end
function Career:has(id) return self.data.medals[id] ~= nil end
-- returns the achievement when it is new
function Career:award(id)
	if self:has(id) then return nil end
	for _, a in ipairs(C.ACHIEVEMENTS) do
		if a.id == id then
			self.data.medals[id] = os.time()
			self:save()
			return a
		end
	end
	return nil
end
function Career:best(key, value)
	if value > (self.data[key] or 0) then
		self.data[key] = value
		self.dirty = true
	end
end

-- points for a kill: by weapon, times the difficulty, plus a bonus for a streak (kills in one life)
C.DIFF_MULT = { easy = 0.6, normal = 1, hard = 1.5, ace = 2 }
function C.killPoints(weapon, difficulty, streak)
	local base = weapon == "crash" and 120 or weapon == "AIM-9M" and 100 or weapon == "AIM-120A" and 80 or 150
	local streakMult = 1 + math.min(4, math.max(0, streak - 1)) * 0.25
	return math.floor(base * (C.DIFF_MULT[difficulty] or 1) * streakMult + 0.5)
end
function C.isGun(weapon)
	return weapon ~= nil and weapon ~= "AIM-9M" and weapon ~= "AIM-120A" and weapon ~= "crash" and weapon ~= "tailstrike"
end
function C.weaponLabel(weapon)
	if weapon == "crash" then return "MANŐVER" end
	if weapon == "AIM-9M" or weapon == "AIM-120A" then return weapon end
	return "ÁGYÚ"
end
function C.formatTime(s)
	local h, m = math.floor(s / 3600), math.floor((s % 3600) / 60)
	if h > 0 then return h .. " ó " .. m .. " p" end
	return m .. " perc"
end

return C
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX38"><Properties><string name="Name">Carrier</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The aircraft carrier ("USS Dogfight", CVN-80) anchored 15 km south of the home base: the port of web/js/carrier.js without the model.  Its flight
-- deck is part of the ground: terrain:height() returns the deck height over it, so landing, taxiing and taking off work with the normal flight
-- model.  Plus what only a carrier has: an angled landing deck with four arresting wires (a trap, or a bolter), two bow catapults and the
-- optical landing system (the meatball).  Real numbers: 333 m long, 77 m wide flight deck, 9 degree angled deck, deck ~19 m above the sea.
-- Common subset of Lua 5.4 and Luau.
local M = require(script.Parent.Parent.sim.SimMath)
local V = M.V
local sin, cos, abs, tan, pi = math.sin, math.cos, math.abs, math.tan, math.pi

local C = {}
C.DECK_Z = 19.5
local DECK_Z = C.DECK_Z
local ANGLE = -9 * pi / 180                            -- the landing deck points 9 degrees to port of the bow
-- deck outline in the carrier's frame (x starboard, y bow), metres
C.OUTLINE = { { 22, 166 }, { 24, 40 }, { 24, -150 }, { 12, -166 }, { -26, -166 }, { -47, 34 }, { -47, 70 }, { -30, 96 }, { -18, 166 } }
C.WIRES = { 52, 64, 76, 88 }                          -- distance of the wires from the stern, along the landing line
C.CATS = { { 9, 30, 160 }, { -9, 30, 160 } }          -- { x, start y, end y }
local OUTLINE, WIRES, CATS = C.OUTLINE, C.WIRES, C.CATS

local function inside(x, y)
	local c = false
	local j = #OUTLINE
	for i = 1, #OUTLINE do
		local xi, yi, xj, yj = OUTLINE[i][1], OUTLINE[i][2], OUTLINE[j][1], OUTLINE[j][2]
		if (yi > y) ~= (yj > y) and x < ((xj - xi) * (y - yi)) / (yj - yi) + xi then c = not c end
		j = i
	end
	return c
end

local Carrier = {}
Carrier.__index = function(t, k)
	if k == "landingHeading" then return t.heading + ANGLE * 180 / pi end
	return Carrier[k]
end

function C.new(terrain, x, y, heading)
	local self = setmetatable({}, Carrier)
	self.terrain, self.x, self.y, self.heading = terrain, x or 21000, y or -42000, heading or 0
	self.cos, self.sin = cos(self.heading * pi / 180), sin(self.heading * pi / 180)
	self.landStart, self.landDir = { -8, -166 }, { sin(ANGLE), cos(ANGLE) }
	self.active = true
	-- the deck becomes ground: wrap the terrain's height and the airfield's "paved" test
	local baseHeight = terrain.height
	local af = terrain.airfield
	local basePaved = af.onPaved
	terrain.height = function(t, px, py)
		if self:onDeck(px, py) then return DECK_Z end
		return baseHeight(t, px, py)
	end
	af.onPaved = function(a, px, py) return self:onDeck(px, py) or basePaved(a, px, py) end
	terrain.isWater = function(px, py) return (not self:onDeck(px, py)) and terrain:rawHeight(px, py) < 0 end
	terrain.carrier = self
	return self
end
-- world -> carrier frame
function Carrier:local_(px, py)
	local dx, dy = px - self.x, py - self.y
	return dx * self.cos - dy * self.sin, dx * self.sin + dy * self.cos
end
function Carrier:world(lx, ly, z)
	return V(self.x + lx * self.cos + ly * self.sin, self.y - lx * self.sin + ly * self.cos, z or DECK_Z)
end
function Carrier:onDeck(px, py)
	if not self.active then return false end
	if abs(px - self.x) > 200 or abs(py - self.y) > 200 then return false end
	local lx, ly = self:local_(px, py)
	return inside(lx, ly)
end
-- how far along the landing line from the stern, and how far off it (m)
function Carrier:landing(px, py)
	local lx, ly = self:local_(px, py)
	local sx, sy = self.landStart[1], self.landStart[2]
	local dx, dy = self.landDir[1], self.landDir[2]
	local rx, ry = lx - sx, ly - sy
	return rx * dx + ry * dy, rx * dy - ry * dx                      -- along, off
end
-- a point on the glide slope (3.5 degrees) behind the stern, for approaches and the meatball
function Carrier:glide(px, py, pz)
	local along, off = self:landing(px, py)
	local dist = 60 - along                                          -- aim at the third wire
	local want = DECK_Z + tan(3.5 * pi / 180) * dist
	return { dist = dist, off = off, high = pz - 2 - want, behind = dist > 0 }
end
-- a parking / catapult spot in the world: x, y, heading
function Carrier:catapult(k)
	local c = CATS[(k or 0) + 1]
	local p = self:world(c[1], c[2])
	return p.x, p.y, self.heading
end
function Carrier:onCatapult(px, py)
	local lx, ly = self:local_(px, py)
	for _, c in ipairs(CATS) do
		if abs(lx - c[1]) < 6 and ly > c[2] - 8 and ly < c[3] then return true end
	end
	return false
end
function Carrier:inWires(px, py)
	local along, off = self:landing(px, py)
	return abs(off) < 14 and along > WIRES[1] - 14 and along < WIRES[4] + 10
end
function Carrier:wireNumber(px, py)
	local along = self:landing(px, py)
	local best, bd = 1, 1e9
	for i, w in ipairs(WIRES) do
		local d = abs(along - w)
		if d < bd then bd, best = d, i end
	end
	return best
end

return C
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX39"><Properties><string name="Name">Controls</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- From the devices to the jet: the port of applyInput / flyStick of web/js/game.js.  Outside the mouse moves the aim circle and the
-- jet points its nose there; in the cockpit the mouse is the control stick itself (push = nose down, pull = nose up, sideways =
-- roll).  Keys: W/S pitch, A/D roll, Q/E rudder, Shift/Z throttle, B air brake, X flares, left mouse = gun.
-- input: { dx, dy (mouse travel this frame, px), held(name) -> bool, mouse = { [0]=left, [1]=middle, [2]=right }, locked (bool) }
-- Common subset of Lua 5.4 and Luau.
local Cam = require(script.Parent.Camera)
local M = require(script.Parent.Parent.sim.SimMath)
local clamp = M.clamp

local K = {}

local function axis(held, pos, neg)
	local p, n = held(pos), held(neg)
	if p and not n then return 1 end
	if n and not p then return -1 end
	return nil
end

-- Mouse joystick for the cockpit.  The stick stays exactly where you put it - nothing pulls it back to the middle, so a slow turn
-- or a long hard break can be held as long as you want.  A small dead zone makes neutral easy to find.
local function flyStick(match, cam, dx, dy)
	local s = match.stick
	local inv = cam.invertY and -1 or 1
	local k = Cam.SENS_BASE * cam.stickSens * Cam.STICK_GAIN
	s.x = clamp(s.x + dx * k, -1, 1)
	s.y = clamp(s.y + dy * k * inv, -1, 1)
end

-- returns nothing; sets the controls of the match's player
function K.apply(match, cam, input, dt)
	local p = match.player
	local held = input.held
	local joystick = cam.cockpit and not cam.freeLook
	if joystick then flyStick(match, cam, input.dx, input.dy)
	else cam:mouseDelta(input.dx, input.dy) end
	if input.pad then                          -- right stick: the aim circle (or the head, with the left stick pressed in)
		cam:setFreeLook(input.pad.l3 == true)
		cam:rotate(-input.pad.rx * 110 * dt, -input.pad.ry * 80 * dt * (cam.invertY and -1 or 1))
	end
	local pitch, roll, yaw = axis(held, "s", "w"), axis(held, "d", "a"), axis(held, "e", "q")      -- S = nose up (pull), W = nose down (push)
	if joystick then
		local dz = function(v) return math.abs(v) < Cam.STICK_DEADZONE and 0 or (v - M.sign(v) * Cam.STICK_DEADZONE) / (1 - Cam.STICK_DEADZONE) end
		if pitch == nil then pitch = dz(match.stick.y) end
		if roll == nil then roll = dz(match.stick.x) end
	else
		match.stick.x, match.stick.y = 0, 0
	end
	if input.pad then                          -- a controller: the left stick flies the jet directly (stick back = nose up)
		if input.pad.lx ~= 0 or input.pad.ly ~= 0 then
			if axis(held, "s", "w") == nil then pitch = input.pad.ly end
			if axis(held, "d", "a") == nil then roll = input.pad.lx end
		end
	end
	local manual = pitch ~= nil or roll ~= nil
	-- flying with the keys: the mouse aim point rides on the nose, so letting go does not yank the jet back
	if manual then cam.aim = M.qlook(p.forward) end
	match:applyInput(dt, {
		aim = cam:aimDirection(), pitch = pitch, roll = roll, yaw = yaw,
		throttleUp = held("shift") or (input.pad and input.pad.rt), throttleDown = held("z") or held("control") or (input.pad and input.pad.lt),
		brake = held("b") or (input.pad and input.pad.down), trigger = input.mouse[0] or (input.pad and input.pad.rb) or false,
		flare = held("x") or (input.pad and input.pad.lb) or false,
	})
	if not (input.pad and input.pad.l3) then cam:setFreeLook(held("c") or input.mouse[2] or false) end
	cam.stick = joystick and match.stick or nil
end

return K
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX40"><Properties><string name="Name">Hud</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The HUD, radar scope, RWR and cockpit warnings: the port of web/js/hud.js.  It draws on an abstract canvas g (the client's
-- GuiCanvas, or a recorder in the tests) with: g:line(x1,y1,x2,y2,c), g:arc(x,y,r,c,a0,a1), g:strokeRect(x,y,w,h,c), g:fillRect(x,y,w,h,c),
-- g:fillCircle(x,y,r,c), g:dashed(x1,y1,x2,y2,c,on,off), g:text(str,x,y,c,size,align,font), g:vignette(rgb,alpha,inner), g:lineWidth(w).
-- Colours are { r, g, b, a } (0..255, a 0..1).  Common subset of Lua 5.4 and Luau.
local M = require(script.Parent.Parent.sim.SimMath)
local Specs = require(script.Parent.Parent.sim.Specs)
local W = require(script.Parent.Parent.sim.Weapons)
local V, add, sub, mul, dot, len, norm, clamp, DEG = M.V, M.add, M.sub, M.mul, M.dot, M.len, M.norm, M.clamp, M.DEG
local toLocal, xform, angleBetween, headingDeg, atan2 = M.toLocal, M.xform, M.angleBetween, M.headingDeg, M.atan2
local sin, cos, floor, abs, min, max, sqrt, pi = math.sin, math.cos, math.floor, math.abs, math.min, math.max, math.sqrt, math.pi
local IR, ARH = Specs.IR, Specs.ARH
local STT, ACM, OFF, SEARCH = W.STT, W.ACM, W.OFF, W.SEARCH

local H = {}
local GREEN, DIM, AMBER, RED = { 107, 255, 133, 0.95 }, { 107, 255, 133, 0.5 }, { 255, 200, 64, 1 }, { 255, 77, 64, 1 }
local WHITE, ENEMY, CYAN = { 245, 245, 245, 0.95 }, { 255, 84, 72, 0.95 }, { 115, 217, 255, 0.95 }
H.GREEN, H.DIM, H.AMBER, H.RED, H.WHITE, H.ENEMY, H.CYAN = GREEN, DIM, AMBER, RED, WHITE, ENEMY, CYAN
local LEVEL_COLOR = { good = GREEN, warn = AMBER, bad = RED, info = WHITE }
local TITLE = "title"                                   -- the display font of the browser game (Oswald / Impact)

local function fix(x, n) return string.format("%." .. (n or 1) .. "f", x) end
local function round(x) return floor(x + 0.5) end
local function pad(s, n) s = tostring(s); return string.rep(" ", max(0, n - #s)) .. s end
local function pad0(s, n) s = tostring(s); return string.rep("0", max(0, n - #s)) .. s end
local function padEnd(s, n) s = tostring(s); return s .. string.rep(" ", max(0, n - #s)) end
local function blinkOf(t, rate) return floor(t * rate) % 2 == 0 end

local Hud = {}
Hud.__index = Hud
function H.new(g)
	local self = setmetatable({}, Hud)
	self.g = g
	self.messages, self.killfeed, self.markers, self.hitmarker, self.time = {}, {}, true, 0, 0
	self.dlz, self.dlzTimer, self.popups, self.damage, self.medal = nil, 0, {}, 0, nil
	self.w, self.h, self.u = 1280, 720, 0.8
	self.black, self.red = 0, 0
	return self
end

-- score popup under the centre ("+150 ÁGYÚ"), rises and fades
function Hud:popup(text, color)
	self.popups[#self.popups + 1] = { text = text, color = color or GREEN, t = 1.8 }
	while #self.popups > 4 do table.remove(self.popups, 1) end
end
function Hud:showMedal(a) self.medal = { a = a, t = 4.5 } end
function Hud:message(text, level, duration, key)
	level, duration = level or "info", duration or 2.5
	key = key or text
	for _, m in ipairs(self.messages) do
		if m.key == key then
			m.text, m.color, m.t = text, LEVEL_COLOR[level] or WHITE, duration
			return
		end
	end
	self.messages[#self.messages + 1] = { text = text, color = LEVEL_COLOR[level] or WHITE, t = duration, key = key }
	while #self.messages > 4 do table.remove(self.messages, 1) end
end
function Hud:handleEvent(kind, d, player)
	if kind == "message" and d.to == player then self:message(d.text, d.level or "info")
	elseif kind == "kill" then
		local text
		if d.killer and d.killer ~= d.victim then text = d.killer.name .. " → " .. d.victim.name .. "  [" .. tostring(d.weapon) .. "]"
		else text = d.victim.name .. " lezuhant" end
		self.killfeed[#self.killfeed + 1] = { text = text, color = d.killer == player and GREEN or d.victim == player and RED or WHITE, t = 7 }
		while #self.killfeed > 5 do table.remove(self.killfeed, 1) end
		if d.killer == player and d.victim ~= player then self:message("CÉLPONT MEGSEMMISÍTVE", "good", 3) end
	elseif kind == "hit" and d.shooter == player and d.target ~= player then self.hitmarker = 0.25
	elseif kind == "hit" and d.target == player then self.damage = min(0.8, self.damage + 0.45)
	elseif kind == "pitbull" and d.missile.shooter == player then self:message("PITBULL - AIM-120 aktív", "good") end
end

-- screen projection of a world point: x, y in px or nil when it is behind the camera (the picture is a perspective view)
function Hud:project(p)
	local c = self.cam
	local v = toLocal(c.orientation, sub(p, c.position))
	if v.y < 1 then return nil end
	local f = self.h / 2 / math.tan(c.fov * DEG / 2)
	return self.w / 2 + v.x / v.y * f, self.h / 2 - v.z / v.y * f
end

-- ------------------------------------------------------------ primitives
function Hud:line(x1, y1, x2, y2, c) self.g:line(x1, y1, x2, y2, c) end
function Hud:circle(x, y, r, c, a0, a1) self.g:arc(x, y, r, c, a0, a1) end
function Hud:rect(x, y, hw, hh, c) self.g:strokeRect(x - hw, y - hh, 2 * hw, 2 * hh, c) end
function Hud:poly(pts, c, closed)
	if closed == nil then closed = true end
	for i = 1, #pts - 1 do self.g:line(pts[i][1], pts[i][2], pts[i + 1][1], pts[i + 1][2], c) end
	if closed and #pts > 2 then self.g:line(pts[#pts][1], pts[#pts][2], pts[1][1], pts[1][2], c) end
end
function Hud:brackets(x, y, r, c)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sy in ipairs({ -1, 1 }) do
			self:poly({ { x + sx * r, y + sy * r * 0.6 }, { x + sx * r, y + sy * r }, { x + sx * r * 0.6, y + sy * r } }, c, false)
		end
	end
end
function Hud:text(t, x, y, c, size, align, font) self.g:text(t, x, y, c, size or 13, align or "left", font) end
function Hud:dashed(x1, y1, x2, y2, c, on, off) self.g:dashed(x1, y1, x2, y2, c, on, off) end

-- player: the Aircraft; world; view = { position, orientation, fov }; camCtl: the flight camera; game: the state table of the match
-- (wave, kills, deaths, score, streak, credits, modeLine, banner, subBanner, meatball, bt, raceTarget, missionLine)
function Hud:update(dt, player, world, view, camCtl, game, w, h)
	self.player, self.cam, self.state = player, view, game
	self.w, self.h, self.u = w, h, min(w, h) / 900
	local g = self.g
	g:lineWidth(max(1.2, 1.6 * self.u))
	self.time, self.dt = self.time + dt, dt
	self.hitmarker = max(0, self.hitmarker - dt)
	for _, l in ipairs({ self.messages, self.killfeed, self.popups }) do for _, m in ipairs(l) do m.t = m.t - dt end end
	local function alive(list) local out = {} for _, m in ipairs(list) do if m.t > 0 then out[#out + 1] = m end end return out end
	self.messages, self.killfeed, self.popups = alive(self.messages), alive(self.killfeed), alive(self.popups)
	self:gEffects(player, dt)
	self:damageFlash(dt)
	if player and player.alive and camCtl.cockpit and camCtl.panelLook then
		-- looking down at the displays: only the warnings and messages stay over them
		self.cockpit = true
		self:warnings(player, world)
	elseif player and player.alive then
		self:incomingMissiles(player)
		if not camCtl.follow then self:flightSymbols(player, camCtl) end
		self:targets(player, world)
		self:navMarks(player)
		if game.raceTarget then self:raceMark(player, game.raceTarget) end
		self:weaponSymbols(player, world, dt)
		if not camCtl.follow then self:panels(player, world) end
		if not self.hideScopes then
			self:radarScope(player)
			self:rwrScope(player)
		end
		self:warnings(player, world)
		self:missileList(player, world)
	end
	self:overlay(game)
	self:extras(game, camCtl)
end

-- the carrier's optical landing system: the amber ball against the green datum lights, the line-up error and the distance to the wires
function Hud:meatballBox(m)
	local u, g = self.u, self.g
	local cx, cy, hh = self.w - 70 * u, self.h / 2 - 40 * u, 70 * u
	g:fillRect(cx - 34 * u, cy - hh - 26 * u, 68 * u, 2 * hh + 70 * u, { 4, 10, 14, 0.55 })
	self:line(cx - 28 * u, cy, cx - 10 * u, cy, GREEN); self:line(cx + 10 * u, cy, cx + 28 * u, cy, GREEN)
	self:rect(cx, cy, 6 * u, hh, DIM)
	local k = clamp(m.high / 12, -1, 1)
	local by = cy - k * hh
	local col = abs(k) < 0.7 and AMBER or RED
	g:fillCircle(cx, by, 7 * u, k < -0.7 and RED or col)
	self:text("MEATBALL", cx, cy - hh - 14 * u, CYAN, 10 * u + 2, "center")
	local lu
	if abs(m.off) < 8 then lu = { "VONALBAN", GREEN } elseif m.off > 0 then lu = { "◀ BALRA", AMBER } else lu = { "JOBBRA ▶", AMBER } end
	self:text(lu[1], cx, cy + hh + 14 * u, lu[2], 10 * u + 2, "center")
	self:text(k > 0.25 and "MAGAS" or k < -0.25 and "ALACSONY" or "JÓ", cx, cy + hh + 28 * u, k < -0.7 and RED or WHITE, 10 * u + 2, "center")
	self:text(round(m.dist) .. " m", cx, cy + hh + 42 * u, DIM, 10 * u + 2, "center")
end
-- ring race: the next ring - a ring marker with the distance, or an arrow at the edge
function Hud:raceMark(ac, c)
	local u = self.u
	local px, py = self:project(c)
	local d = len(sub(c, ac.pos))
	if not px then self:edgeArrow(c, AMBER); return end
	self:circle(px, py, 16 * u, AMBER); self:circle(px, py, 3 * u, AMBER)
	self:text("GYŰRŰ " .. fix(d / 1000) .. " km", px, py - 26 * u, AMBER, 12 * u + 2, "center")
end
-- red flash at the screen edges when the player is hit
function Hud:damageFlash(dt)
	if self.damage <= 0.01 then self.damage = 0; return end
	self.g:vignette({ 255, 30, 20 }, self.damage * 0.75, 0.45)
	self.damage = max(0, self.damage - dt * 1.4)
end
-- added layer: score, game mode line, popups, medal banner, camera label
function Hud:extras(game, camCtl)
	local u = self.u
	local fs = 12 * u + 3
	if game.score ~= nil and not self.tutorial then
		local streak = (game.streak or 0) > 1 and ("   SOROZAT " .. game.streak) or ""
		self:text("PONT " .. game.score .. streak .. "   KREDIT " .. (game.credits or 0), 20 * u, 82 * u, AMBER, fs)
	end
	if game.bt then                                       -- bullet time (hangar mod): charge bar
		local x, y, w, b = 20 * u, 122 * u, 120 * u, game.bt
		local on = b.active > 0
		self.g:strokeRect(x, y - 5 * u, w, 10 * u, DIM)
		self.g:fillRect(x, y - 5 * u, w * (on and b.active / 4 or b.charge), 10 * u, on and AMBER or b.charge >= 1 and GREEN or DIM)
		self:text(on and "BULLET TIME" or b.charge >= 1 and "O = bullet time" or "bullet time töltődik", x + w + 8 * u, y, on and AMBER or DIM, 10 * u + 2)
	end
	if game.modeLine and game.modeLine ~= "" then self:text(game.modeLine, 20 * u, 102 * u, WHITE, 11 * u + 2) end
	local y = self.h / 2 + 70 * u
	for _, p in ipairs(self.popups) do
		local k = min(1, p.t / 0.5)
		local rise = (1.8 - p.t) * 26 * u
		local c = { p.color[1], p.color[2], p.color[3], (p.color[4] or 1) * k }
		self:text(p.text, self.w / 2, y - rise, c, 22 * u + 4, "center", TITLE)
		y = y + 30 * u
	end
	if self.medal then
		local m = self.medal
		m.t = m.t - (self.dt or 1 / 60)
		if m.t <= 0 then self.medal = nil
		else
			local k = min(1, m.t / 0.6)
			local bw, bh = 360 * u, 64 * u
			local x, top = self.w / 2 - bw / 2, 120 * u
			self.g:fillRect(x, top, bw, bh, { 20, 27, 34, 0.88 * k })
			self.g:strokeRect(x, top, bw, bh, { 255, 200, 64, k })
			self:text("★ ÚJ KITÜNTETÉS", self.w / 2, top + 18 * u, AMBER, 11 * u + 2, "center")
			self:text(m.a.name, self.w / 2, top + 36 * u, WHITE, 18 * u + 3, "center", TITLE)
			self:text(m.a.desc, self.w / 2, top + 54 * u, DIM, 10 * u + 2, "center")
		end
	end
	if game.meatball then self:meatballBox(game.meatball) end
	if camCtl and camCtl.followLabel and camCtl.followLabel ~= "" then self:text(camCtl.followLabel, self.w / 2, 70 * u, CYAN, 15 * u + 3, "center", TITLE) end
end

function Hud:flightSymbols(ac, camCtl)
	local u = self.u
	local aimPos = add(camCtl.position, mul(camCtl:aimDirection(), 3000))
	local ax, ay = self:project(aimPos)
	if camCtl.stick and not self.touchLayout then self:stickGauge(camCtl.stick)
	elseif ax and not (camCtl.freeLook and not camCtl.cockpit) then self:circle(ax, ay, 14 * u, WHITE)
	elseif not ax and camCtl.cockpit then self:edgeArrow(aimPos, WHITE) end
	local x, y = self:project(add(ac.pos, mul(ac.forward, 800)))
	if x then
		local r, gap = 22 * u, 6 * u
		self:line(x - r, y, x - gap, y, GREEN); self:line(x + gap, y, x + r, y, GREEN)
		self:line(x, y - r, x, y - gap, GREEN); self:line(x, y + gap, x, y + r, GREEN)
		if self.hitmarker > 0 then
			local k = 20 * u
			for _, s in ipairs({ { -1, -1 }, { 1, 1 }, { -1, 1 }, { 1, -1 } }) do self:line(x + s[1] * k, y + s[2] * k, x + s[1] * k * 0.4, y + s[2] * k * 0.4, WHITE) end
		end
	end
	if ac.speed > 20 then
		local fx, fy = self:project(add(ac.pos, mul(norm(ac.vel), 800)))
		if fx then
			local r = 8 * u
			self:circle(fx, fy, r, GREEN)
			self:line(fx - 22 * u, fy, fx - r, fy, GREEN); self:line(fx + r, fy, fx + 22 * u, fy, GREEN); self:line(fx, fy - r, fx, fy - 17 * u, GREEN)
		end
	end
	self.cockpit = camCtl.cockpit
	if camCtl.cockpit then self:pitchLadder(ac, camCtl) end
end
-- where the mouse joystick is: box = full deflection, dot = the stick (down = pulled back)
function Hud:stickGauge(s)
	local u = self.u
	local r, cx, cy = 26 * u, 116 * u, self.h - 270 * u                      -- above the RWR scope
	self:rect(cx, cy, r, r, DIM)
	self:line(cx - r, cy, cx + r, cy, DIM); self:line(cx, cy - r, cx, cy + r, DIM)
	local x, y, dz = cx + s.x * r, cy + s.y * r, 0.07
	self:rect(cx, cy, r * dz, r * dz, DIM)                                   -- neutral band
	local neutral = abs(s.x) < dz and abs(s.y) < dz
	self.g:fillCircle(x, y, 4 * u + 1, neutral and GREEN or WHITE)
	self:text("BOTKORMÁNY", cx, cy + r + 12 * u, DIM, 9 * u + 2, "center")
end
function Hud:pitchLadder(ac, camCtl)
	local hdg = atan2(ac.forward.x, ac.forward.y)
	local pitch = math.asin(clamp(ac.forward.z, -1, 1)) / DEG
	local function dir(h, e) return V(sin(h) * cos(e), cos(h) * cos(e), sin(e)) end
	for e = -80, 80, 10 do
		if abs(e - pitch) <= 16 then                                           -- like the real HUD: only near the boresight
			local inner, outer = 2, 9
			if e == 0 then inner, outer = 1.5, 25 end
			for _, s in ipairs({ -1, 1 }) do
				local ax, ay = self:project(add(camCtl.position, mul(dir(hdg + s * inner * DEG, e * DEG), 5000)))
				local bx, by = self:project(add(camCtl.position, mul(dir(hdg + s * outer * DEG, e * DEG), 5000)))
				if ax and bx then
					self:line(ax, ay, bx, by, e >= 0 and GREEN or DIM)
					if e ~= 0 and s == 1 then self:text(tostring(e), bx + 6, by, e >= 0 and GREEN or DIM, 11 * self.u + 2) end
				end
			end
		end
	end
end
function Hud:lockTarget(ac, sp)
	if sp and sp.guidance == IR and ac.irSeeker.locked and not ac.irSeeker.target.isFlare then return ac.irSeeker.target end
	local r = ac.radar
	if r.mode == STT and r.locked and r.locked.alive then return r.locked end
	return nil
end
function Hud:targets(ac, world)
	if not self.markers then return end
	local u = self.u
	local nearest = nil
	for _, t in ipairs(world.aircraft) do
		if t.alive and t.team ~= ac.team and (not nearest or len(sub(t.pos, ac.pos)) < len(sub(nearest.pos, ac.pos))) then nearest = t end
	end
	self.nearestEnemy = nearest
	local locked = self:lockTarget(ac, ac.selectedSpec)
	-- the target the rear seat marked
	local mk = self.state and self.state.wsoMark
	if mk and mk ~= ac and mk.alive then
		local mx, my = self:project(mk.pos)
		if mx then
			local k = 16 * u
			self:poly({ { mx, my - k }, { mx + k, my }, { mx, my + k }, { mx - k, my } }, AMBER)
			self:text("JELÖLT", mx, my + k + 12 * u, AMBER, 10 * u + 2, "center")
		end
	end
	for _, t in ipairs(world.aircraft) do
		if t ~= ac and t.alive and t.team == ac.team then               -- wingman: cyan ring with the distance
			local px, py = self:project(t.pos)
			local d = len(sub(t.pos, ac.pos))
			if px and d < 40000 then
				self:circle(px, py, 9 * u, CYAN)
				self:text((t.tag or "KÍSÉRŐ") .. " " .. ((t.ghost and d < 10000) and (round(d) .. " m") or fix(d / 1000)), px, py - 18 * u, CYAN, 10 * u + 2, "center")
			end
		elseif t ~= ac and t.alive and t.team ~= ac.team then
			local d = len(sub(t.pos, ac.pos))
			if d <= 80000 then
				local px, py = self:project(t.pos)
				if px and t ~= locked then                                    -- (the locked one is drawn by the lock box)
					self:poly({ { px - 8 * u, py - 20 * u }, { px + 8 * u, py - 20 * u }, { px, py - 10 * u } }, ENEMY)
					self:text(fix(d / 1000), px, py - 30 * u, ENEMY, 11 * u + 2, "center")
					-- in radar lock range and not locked yet: tell how (a stealthy F-22 only shows up on radar much closer)
					local lockable = min(ac.spec.radar.lockRange, W.radarRange(ac.spec.radar.searchRange, W.rcs(t, ac.pos)))
					if ac.radar.mode ~= STT and t == nearest then
						if d < lockable then self:text("T = lock", px, py + 2 * u, AMBER, 11 * u + 2, "center")
						elseif t.spec.rcsFront < 0.01 and d < 40000 then
							self:text("lopakodó - radar ~" .. string.format("%.0f", lockable / 1000) .. " km-től", px, py + 2 * u, DIM, 10 * u + 2, "center")
						end
					end
				end
			end
		end
	end
end
-- the combat zone (amber) and the home base (cyan): marker with the distance, and an arrow at the screen edge towards the zone
function Hud:navMarks(ac)
	local n, u = self.nav, self.u
	if not n then return end
	local dz = sqrt((n.zone.x - ac.pos.x) ^ 2 + (n.zone.y - ac.pos.y) ^ 2)
	local db = sqrt((n.base.x - ac.pos.x) ^ 2 + (n.base.y - ac.pos.y) ^ 2)
	local where = nil
	if db < n.base.r then where = { "BIZTONSÁGI ZÓNA (bázis) - itt nem támadnak", CYAN } elseif dz < n.zone.r then where = { "HARCI ZÓNA", ENEMY } end
	if where then self:text(where[1], 20 * u, 62 * u, where[2], 11 * u + 2) end
	if not self.markers then return end
	if dz > n.zone.r then
		local pos = V(n.zone.x, n.zone.y, max(ac.pos.z, 3500))
		local px, py = self:project(pos)
		if px then
			local k = 11 * u
			self:poly({ { px, py - k }, { px + k, py }, { px, py + k }, { px - k, py } }, AMBER)
			self:text("HARCI ZÓNA " .. string.format("%.0f", (dz - n.zone.r) / 1000) .. " km", px, py - 22 * u, AMBER, 12 * u + 2, "center")
		else self:edgeArrow(pos, AMBER) end
	end
	if n.carrier then                                      -- the carrier: cyan ship mark with the distance
		local dc = sqrt((n.carrier.x - ac.pos.x) ^ 2 + (n.carrier.y - ac.pos.y) ^ 2)
		local px, py
		if dc > 900 then px, py = self:project(V(n.carrier.x, n.carrier.y, 40)) end
		if px then
			local k = 9 * u
			self:poly({ { px - k, py }, { px - k * 0.6, py + k * 0.6 }, { px + k * 0.6, py + k * 0.6 }, { px + k, py } }, CYAN)
			self:text("HORDOZÓ " .. fix(dc / 1000, dc < 10000 and 1 or 0) .. " km", px, py + 20 * u, CYAN, 11 * u + 2, "center")
		end
	end
	if db > 3000 then
		local px, py = self:project(V(n.base.x, n.base.y, 300))
		if px then
			local k = 8 * u
			self:rect(px, py, k, k, CYAN)
			self:text("BÁZIS " .. string.format("%.0f", db / 1000) .. " km", px, py + 20 * u, CYAN, 11 * u + 2, "center")
		end
	end
end
function Hud:edgeArrow(pos, c)
	local v = toLocal(self.cam.orientation, sub(pos, self.cam.position))
	local ang = atan2(v.x, v.z)
	local r = min(self.w, self.h) * 0.38
	local x, y = self.w / 2 + sin(ang) * r, self.h / 2 - cos(ang) * r
	local tip = { x + sin(ang) * 22 * self.u, y - cos(ang) * 22 * self.u }
	local side = { cos(ang) * 12 * self.u, sin(ang) * 12 * self.u }
	self:poly({ { x + side[1], y + side[2] }, tip, { x - side[1], y - side[2] } }, c)
end
function Hud:weaponSymbols(ac, world, dt)
	local u, r = self.u, ac.radar
	if r.mode == STT and r.trackPos then
		local t = r.locked
		local px, py = self:project(r.trackPos)
		local col = r.lostTime == 0 and GREEN or AMBER
		if not px then self:edgeArrow(r.trackPos, col)
		elseif r.lostTime > 0 then self:text("MEM", px, py + 40 * u, AMBER, 12 * u + 2, "center") end
		if t and len(sub(t.pos, ac.pos)) < ac.spec.gun.maxLeadRange then
			local aim = W.gunLead(ac.pos, ac.vel, t.pos, t.vel, ac.spec.gun)
			local d = len(sub(t.pos, ac.pos))
			local lx, ly = self:project(add(ac.pos, mul(aim, d)))
			if lx then
				self:circle(lx, ly, 20 * u, WHITE); self:circle(lx, ly, 2.5 * u, WHITE)
				local frac = clamp(d / ac.spec.gun.maxLeadRange, 0, 1)
				self:circle(lx, ly, 24 * u, WHITE, -pi / 2, -pi / 2 + pi * 2 * (1 - frac))
			end
		end
	elseif r.pending then
		local px, py = self:project(r.pending.pos)
		if px and blinkOf(self.time, 8) then self:brackets(px, py, 24 * u, AMBER) end
	elseif r.mode == ACM then
		local s, pts = r.spec, {}
		local corners = { { -s.acmAz, s.acmElLow }, { s.acmAz, s.acmElLow }, { s.acmAz, s.acmElHigh }, { -s.acmAz, s.acmElHigh } }
		local all = true
		for _, c in ipairs(corners) do
			local az, el = c[1], c[2]
			local d = xform(ac.quat, V(sin(az * DEG) * cos(el * DEG), cos(az * DEG) * cos(el * DEG), sin(el * DEG)))
			local x, y = self:project(add(ac.pos, mul(d, 3000)))
			if x then pts[#pts + 1] = { x, y } else all = false end
		end
		if all then self:poly(pts, { 255, 200, 64, 0.5 }) end
	end
	if r.selected and r.mode ~= STT and r.selected.alive then
		local px, py = self:project(r.selected.pos)
		if px then self:brackets(px, py, 20 * u, DIM) end
	end
	local sp = ac.selectedSpec
	self:missilePaths(ac, world)
	if not sp then return end
	if sp.guidance == IR and ac.irSeeker.axis then
		local s = ac.irSeeker
		local px, py = self:project(add(ac.pos, mul(s.axis, 2000)))
		if px then
			if s.locked then
				self:circle(px, py, 26 * u, GREEN); self:circle(px, py, 29 * u, GREEN)
				self:poly({ { px, py - 7 * u }, { px + 7 * u, py }, { px, py + 7 * u }, { px - 7 * u, py } }, GREEN)
			else
				-- search circle as big as the seeker's search cone (wide with the lock assist)
				local fov = (s.acqFov or s.spec.seekerFov) * DEG
				local rad = max(26 * u, math.tan(fov) / math.tan(self.cam.fov * DEG / 2) * self.h / 2)
				self:circle(px, py, rad, s.candidate and (floor(self.time * 10) % 2 == 1 and WHITE or GREEN) or DIM)
			end
		end
	end
	self:dlzBar(ac, sp, dt)
	self:lockBox(ac, sp)
end
-- big square around the locked aircraft + where a missile fired now would meet it
function Hud:lockBox(ac, sp)
	local t = self:lockTarget(ac, sp)
	if not t then return end
	local u, r = self.u, ac.radar
	local pos = (r.mode == STT and r.locked == t and r.trackPos) and r.trackPos or t.pos
	local px, py = self:project(pos)
	local rel = sub(pos, ac.pos)
	local d = len(rel)
	local inRange = self.dlz and sp and d > sp.minRange and d < self.dlz[1]
	local blink = blinkOf(self.time, 4)
	local col = inRange and RED or GREEN
	-- predicted intercept point: where the target will be when a missile launched now reaches it
	if sp then
		local tt = W.flyoutTime(sp, ac.speed, ac.pos.z, d)
		local ip = pos
		for _ = 1, 4 do
			if tt == nil then break end
			ip = add(pos, mul(t.vel, tt))
			tt = W.flyoutTime(sp, ac.speed, ac.pos.z, len(sub(ip, ac.pos)))
		end
		local ax, ay = self:project(add(ac.pos, mul(ac.forward, 25)))
		local bx, by
		if tt ~= nil then bx, by = self:project(ip) end
		if ax and bx then
			self:dashed(ax, ay, bx, by, col, 10 * u, 7 * u)
			if px then self:dashed(px, py, bx, by, ENEMY, 4 * u, 5 * u) end
			local k = 9 * u
			self:line(bx - k, by - k, bx + k, by + k, col); self:line(bx - k, by + k, bx + k, by - k, col)
			self:circle(bx, by, 13 * u, col)
			self:text("találat ~" .. fix(tt, 0) .. " s", bx + 18 * u, by + 14 * u, col, 11 * u + 2)
		end
	end
	if not px then return end
	-- box sized to the target's wingspan on screen
	local pxPerM = self.h / 2 / math.tan(self.cam.fov * DEG / 2) / max(d, 1)
	local hs = clamp(7 * pxPerM, 26 * u, 140 * u)
	self.g:lineWidth(max(2.5, 3 * u))
	self:rect(px, py, hs, hs, col)
	self.g:lineWidth(max(1.2, 1.6 * u))
	for _, s in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
		-- outer corner ticks make the box readable against bright clouds
		self:line(px + s[1] * (hs + 4 * u), py + s[2] * hs, px + s[1] * (hs + 12 * u), py + s[2] * hs, col)
		self:line(px + s[1] * hs, py + s[2] * (hs + 4 * u), px + s[1] * hs, py + s[2] * (hs + 12 * u), col)
	end
	local vc = -dot(sub(t.vel, ac.vel), norm(rel))
	self:text("LOCK  " .. (sp and sp.name or ""), px - hs, py - hs - 14 * u, col, 13 * u + 3, "left", TITLE)
	self:text(fix(d / 1000) .. " km   Vc " .. (vc * 3.6 >= 0 and "+" or "") .. round(vc * 3.6), px - hs, py + hs + 14 * u, col, 11 * u + 2)
	if inRange and blink then self:text("LŐHETSZ!  (Space)", px, py + hs + 34 * u, RED, 15 * u + 4, "center", TITLE)
	elseif not inRange and sp and sp.guidance == IR and d > 9000 and ac:missileCount("AIM-120A") > 0 then
		self:text("messze van - válts AIM-120-ra (2)", px, py + hs + 34 * u, AMBER, 12 * u + 2, "center")
	elseif not inRange and sp and self.dlz and d >= self.dlz[1] then self:text("még messze", px, py + hs + 34 * u, AMBER, 12 * u + 2, "center")
	elseif not inRange and sp and d <= sp.minRange then self:text("túl közel", px, py + hs + 34 * u, AMBER, 12 * u + 2, "center") end
end
-- own missiles in flight: marker on the missile and its path to the target
function Hud:missilePaths(ac, world)
	local u = self.u
	for _, m in ipairs(world.missiles) do
		if m.shooter == ac and m.alive then
			local mx, my = self:project(m.pos)
			local aim = m.guidedTarget and m.guidedTarget.pos or m.estPos
			local ax, ay
			if aim then ax, ay = self:project(aim) end
			if mx and ax then self:dashed(mx, my, ax, ay, CYAN, 6 * u, 6 * u) end
			if mx then
				self:poly({ { mx, my - 7 * u }, { mx + 7 * u, my }, { mx, my + 7 * u }, { mx - 7 * u, my } }, CYAN)
				local ttg = W.timeToImpact(m)
				if ttg ~= nil and ttg < 99 then self:text(fix(ttg) .. " s", mx + 10 * u, my - 10 * u, CYAN, 11 * u + 2) end
			end
		end
	end
end
function Hud:dlzBar(ac, sp, dt)
	local r = ac.radar
	local tgt = r.mode == STT and r.locked or nil
	if sp.guidance == IR and ac.irSeeker.locked and not ac.irSeeker.target.isFlare then tgt = ac.irSeeker.target end
	if not tgt then self.dlz = nil; return end
	local rel = sub(tgt.pos, ac.pos)
	local d = len(rel)
	local closing = -dot(tgt.vel, norm(rel))
	self.dlzTimer = self.dlzTimer - dt
	if not self.dlz or self.dlzTimer <= 0 then
		local zmax, zne = W.launchZone(sp, ac.speed, ac.pos.z, closing)
		self.dlz = { zmax, zne }
		self.dlzTimer = 0.5
	end
	local rmax, rne = self.dlz[1], self.dlz[2]
	local rmin, u = sp.minRange, self.u
	local x, y0, y1 = self.w / 2 + 210 * u, self.h / 2 + 140 * u, self.h / 2 - 140 * u
	local scale = max(rmax * 1.25, d * 1.05, 2000)
	local function ry(v) return y0 + (y1 - y0) * clamp(v / scale, 0, 1) end
	self:line(x, ry(rmin), x, ry(rmax), GREEN)
	for _, v in ipairs({ rmax, rmin }) do self:line(x - 8 * u, ry(v), x + 8 * u, ry(v), GREEN) end
	self:line(x - 13 * u, ry(rne), x + 13 * u, ry(rne), GREEN)
	local yy = ry(d)
	self:poly({ { x - 24 * u, yy - 8 * u }, { x - 10 * u, yy }, { x - 24 * u, yy + 8 * u } }, WHITE, false)
	self:text(fix(rmax / 1000), x + 14 * u, ry(rmax), DIM, 11 * u + 2)
	local tag = nil
	if rmin < d and d < rne then tag = { "NO ESC", RED } elseif rmin < d and d < rmax then tag = { "IN RNG", GREEN } elseif d <= rmin then tag = { "MIN", AMBER } end
	if tag then self:text(tag[1], x - 20 * u, y0 + 22 * u, tag[2], 12 * u + 2) end
end
function Hud:panels(ac, world)
	local fm, u = ac.fm, self.u
	local fs = 13 * u + 3
	local lh = fs * 1.35
	local x, y = self.w / 2 - 330 * u, self.h / 2 - 90 * u
	local cmd = ac.controls.throttle
	local thr = cmd > 1 and "AB" or (round(cmd * 100) .. "%")
	local eng = fm.engine > 1.001 and "AB" or (round(fm.engine * 100) .. "%")
	local rows = {
		{ "IAS " .. pad(round(fm.ias * 3.6), 5) .. " km/h", GREEN }, { "TAS " .. pad(round(ac.speed * 3.6), 5), DIM },
		{ "M   " .. pad(fix(fm.mach, 2), 5), GREEN }, { "G   " .. pad(fix(fm.gLoad), 5), fm.gLoad > ac.spec.gMax * 0.85 and AMBER or GREEN },
		{ "AoA " .. pad(fix(fm.alpha / DEG), 5), fm.alpha / DEG > ac.spec.alphaLimit * 0.8 and AMBER or GREEN },
		{ "THR  " .. thr, cmd > 1 and AMBER or GREEN }, { "MOT  " .. eng, abs(fm.engine - cmd) > 0.02 and DIM or GREEN },
		{ fm.gearPos > 0.98 and "GEAR DOWN" or fm.gearPos > 0.02 and "GEAR TRANSIT" or "GEAR UP", fm.gearPos > 0.98 and GREEN or fm.gearPos > 0.02 and AMBER or DIM },
	}
	if ac.onGround then rows[#rows + 1] = { "GS  " .. pad(round(ac.speed * 3.6), 5) .. " km/h", GREEN } end
	if ac.extreme then rows[#rows + 1] = { (ac.spec.tvcAlways and "TVC" or "TVC EXTRÉM") .. (ac.fm.alpha / DEG > 50 and "  COBRA" or ""), ac.spec.tvcAlways and DIM or AMBER } end
	if ac.bayOpenAny > 0.05 then rows[#rows + 1] = { "FEGYVERTÉR NYITVA", AMBER } end
	if ac.controls.brakes and ac.onGround then rows[#rows + 1] = { "BRAKES", AMBER }
	elseif ac.controls.airbrake then rows[#rows + 1] = { "SPD BRK", AMBER } end
	for i, r in ipairs(rows) do self:text(r[1], x, y + (i - 1) * lh, r[2], fs) end
	-- during the tutorial its card covers the right side: the right column goes under the left one
	local terr = world.terrain:height(ac.pos.x, ac.pos.y)
	local xr = self.tutorial and x or self.w / 2 + 250 * u
	local yr = self.tutorial and y + (#rows + 0.6) * lh or y
	local fuelCol = fm.fuel < ac.spec.internalFuel * 0.12 and RED or fm.fuel < ac.spec.internalFuel * 0.28 and AMBER or GREEN
	local right = {
		{ "ALT " .. pad(round(ac.pos.z), 6) .. " m", GREEN }, { "AGL " .. pad(round(ac.pos.z - terr), 6), DIM },
		{ "VS  " .. ((fm.vel.z >= 0 and "+" or "") .. round(fm.vel.z)), GREEN }, { "HDG    " .. pad0(round(headingDeg(ac.forward)), 3), GREEN },
		{ "FUEL " .. pad(round(fm.fuel), 5) .. " kg", fuelCol }, { "HP   " .. pad(max(0, round(ac.hp)), 5), ac.hp > 50 and GREEN or RED },
	}
	for i, r in ipairs(right) do self:text(r[1], xr, yr + (i - 1) * lh, r[2], fs) end
	-- weapons
	local function reloadText(k)
		local n, lo = 0, nil
		for _, s in ipairs(ac.stations) do
			if s.key == k and not s.loaded and s.reload ~= nil then n = n + 1; lo = lo and min(lo, s.reload) or s.reload end
		end
		if n > 0 then return " +" .. n .. " (" .. math.ceil(lo) .. "s)" end
		return ""
	end
	-- in the cockpit the weapon lines go to the top of the screen: the bottom shows the displays
	local yb = self.cockpit and 92 * u or self.h - 78 * u
	local parts = {}
	for _, k in ipairs(ac:weaponKeys()) do
		local t = k .. " ×" .. ac:missileCount(k) .. reloadText(k)
		parts[#parts + 1] = k == ac.selected and ("[" .. t .. "]") or (" " .. t .. " ")
	end
	self:text(table.concat(parts, "   "), self.w / 2, yb, GREEN, fs, "center")
	self:text("GUN " .. ac.gun.ammo .. "    FLR " .. ac.flares .. "   CHF " .. ac.chaff, self.w / 2, yb + lh, GREEN, fs, "center")
	local sp = ac.selectedSpec
	local status, col = "", GREEN
	if sp and sp.guidance == IR then
		local s = ac.irSeeker
		if s.locked then status = "AIM-9M: LOCK  (F: elenged)"
		elseif s.candidate then status, col = "AIM-9M: HŐFORRÁS A KERESŐBEN - F: lock", WHITE
		else status, col = "AIM-9M: keresés (growl)", DIM end
	elseif sp and sp.guidance == ARH then
		if ac.radar.mode == STT then status = "AIM-120A: radar lock OK"
		else status, col = "AIM-120A: nincs lock (maddog) - T: radar lock", AMBER end
	end
	self:text(status, self.w / 2, yb + 2 * lh, col, fs, "center")
	local r = ac.radar
	if r.mode == STT and r.trackPos then
		local rel = sub(r.trackPos, ac.pos)
		local vc = -dot(sub(r.trackVel, ac.vel), norm(rel))
		local asp = round(angleBetween(r.trackVel, sub(ac.pos, r.trackPos)) / DEG)
		self:text("STT " .. fix(len(rel) / 1000) .. " km  Vc " .. round(vc * 3.6) .. " km/h  ASP " .. asp .. (r.notched and "  NOTCH!" or ""), self.w / 2, yb + 3 * lh, r.notched and AMBER or GREEN, fs, "center")
	elseif r.mode == ACM then self:text("ACM: tedd az orrod elé a célt", self.w / 2, yb + 3 * lh, AMBER, fs, "center") end
end
function Hud:radarScope(ac)
	local r = ac.radar
	local sp, u = r.spec, self.u
	local size = 200 * u
	local hw = size / 2
	-- touch layout: the buttons own the bottom corners, the scope goes up under the top buttons
	local cx = self.w - hw - 24 * u
	local cy = self.touchLayout and 175 * u + hw or self.h - hw - 24 * u
	local left, top, bottom = cx - hw, cy - hw, cy + hw
	self.g:fillRect(left, top, size, size, { 4, 16, 8, 0.45 })
	self:rect(cx, cy, hw, hw, DIM)
	local tgt = r.locked or r.selected or r.pending
	local scale = 40000
	if r.mode == ACM then scale = 20000
	elseif tgt then
		local d = len(sub(tgt.pos, ac.pos))
		scale = 80000
		for _, s in ipairs({ 10000, 20000, 40000, 80000 }) do if d < s * 0.85 then scale = s; break end end
	end
	local azMax = sp.scanAz * DEG
	local function toXY(az, d) return cx + clamp(az / azMax, -1, 1) * hw, bottom - min(d / scale, 1) * size end
	for k = 1, 3 do
		local y = bottom - size * k / 4
		self:line(left, y, left + 8 * u, y, DIM); self:line(left + size - 8 * u, y, left + size, y, DIM)
	end
	for _, az in ipairs({ -30, 0, 30 }) do
		local x = cx + az / sp.scanAz * hw
		self:line(x, bottom, x, bottom - 8 * u, DIM)
	end
	self:text(r.mode .. "  " .. (scale / 1000) .. " km", left + 4 * u, top - 10 * u, GREEN, 11 * u + 2)
	self:text("RADAR", left + size, top - 10 * u, DIM, 11 * u + 2, "right")
	if r.mode == OFF then self:text("KI", cx, cy, DIM, 18 * u, "center"); return end
	if r.mode == SEARCH then
		local x = cx + r.beamAz / azMax * hw
		self:line(x, bottom, x, top, { 107, 255, 133, 0.25 })
	elseif r.mode == ACM then
		local w = sp.acmAz / sp.scanAz * hw
		local y = bottom - min(sp.acmRange / scale, 1) * size
		self:poly({ { cx - w, bottom }, { cx - w, y }, { cx + w, y }, { cx + w, bottom } }, AMBER, false)
	end
	for t, c in pairs(r.contacts) do
		if t ~= r.locked then
			local x, y = toXY(c.az, c.range)
			self.g:fillRect(x - 4 * u, y - 4 * u, 8 * u, 8 * u, GREEN)
			if t == r.selected then
				self:brackets(x, y, 12 * u, GREEN)
				self:text(fix(t.pos.z / 1000), x + 15 * u, y, DIM, 10 * u + 2)
			end
		end
	end
	if r.pending and blinkOf(self.time, 8) then
		local az, _, d = r:anglesTo(r.pending.pos)
		local x, y = toXY(az, d)
		self:brackets(x, y, 14 * u, AMBER)
	end
	if r.locked and r.trackPos then
		local az, _, d = r:anglesTo(r.trackPos)
		local x, y = toXY(az, d)
		local col = r.lostTime > 0 and AMBER or GREEN
		self:poly({ { x, y - 10 * u }, { x + 10 * u, y }, { x, y + 10 * u }, { x - 10 * u, y } }, col)
		local hl = toLocal(ac.quat, r.trackVel)
		local hn = sqrt(hl.x * hl.x + hl.y * hl.y)
		if hn > 1 then self:line(x, y, x + hl.x / hn * 24 * u, y - hl.y / hn * 24 * u, col) end
		self:text(fix(r.trackPos.z / 1000), x + 15 * u, y, col, 10 * u + 2)
	end
end
function Hud:rwrScope(ac)
	local u = self.u
	local R = 90 * u
	local cx = R + 26 * u
	local cy = self.touchLayout and 125 * u + R or self.h - R - 26 * u
	self.g:fillCircle(cx, cy, R, { 4, 16, 8, 0.45 })
	self:circle(cx, cy, R, DIM); self:circle(cx, cy, R * 0.5, { 107, 255, 133, 0.25 })
	for k = 0, 11 do
		local a = k * pi / 6
		self:line(cx + sin(a) * R, cy - cos(a) * R, cx + sin(a) * R * 0.92, cy - cos(a) * R * 0.92, DIM)
	end
	self:text("RWR", cx - R, cy - R + 4 * u, DIM, 11 * u + 2)
	local blink = blinkOf(self.time, 6)
	for _, t in ipairs(ac.rwr.threats) do
		local rad, col = R * 0.82, GREEN
		local skip = false
		if t.level == "launch" then
			if not blink then skip = true end
			rad, col = R * 0.32, RED
		elseif t.level == "lock" then rad, col = R * 0.58, AMBER end
		if not skip then
			local x, y = cx + sin(t.bearing) * rad, cy - cos(t.bearing) * rad
			self:text(t.symbol, x, y, col, 14 * u + 2, "center")
			if t.level ~= "search" then self:circle(x, y, 13 * u, col) end
		end
	end
end
function Hud:warnings(ac, world)
	local u, terr = self.u, world.terrain
	local blink = blinkOf(self.time, 4)
	local y = self.h / 2 - 220 * u
	local function big(t, c, s)
		s = s or 30
		self:text(t, self.w / 2, y, c, s * u + 4, "center", TITLE)
		y = y + (s + 12) * u
	end
	local ahead = add(ac.pos, mul(ac.vel, 4))
	local agl = ac.pos.z - terr:height(ac.pos.x, ac.pos.y)
	if not ac.onGround and ac.fm.gearPos < 0.5 and (ahead.z < terr:height(ahead.x, ahead.y) + 60 or (agl < 150 and ac.vel.z < -15)) and blink then big("PULL UP", RED) end
	if ac.rwr.maxLevel >= 3 then
		if blink then big("MISSILE!", RED) end
	elseif ac.rwr.maxLevel == 2 then big("RADAR LOCK", AMBER, 22) end
	if ac.fm.ias < 70 and not ac.onGround then big("SPEED LOW", AMBER, 22) end
	if not ac.onGround and ac.fm.gearPos < 0.98 and agl < 300 and ac.fm.ias < 95 and ac.vel.z < -2 and blink then big("FUTÓMŰ!", RED, 24) end
	if ac.fm.gearPos > 0.02 and ac.fm.ias > 155 and blink then big("GEAR SPEED", AMBER, 22) end
	if ac.fm.fuel > 0 and ac.fm.fuel < ac.spec.internalFuel * 0.12 then big("BINGO FUEL", AMBER, 22) end
	local my = self.h / 2 - 130 * u
	for _, m in ipairs(self.messages) do
		self:text(m.text, self.w / 2, my, m.color, 16 * u + 3, "center")
		my = my + 22 * u + 4
	end
end
function Hud:missileList(ac, world)
	local y = 110 * self.u
	for _, m in ipairs(world.missiles) do
		if m.shooter == ac then
			local ttg = W.timeToImpact(m)
			local col = (m.status == "TRACK" or m.status == "ACTIVE" or m.status == "DATALINK") and CYAN or AMBER
			self:text(m.spec.name .. " " .. padEnd(m.status, 8) .. " " .. ((ttg ~= nil and ttg < 99) and (fix(ttg) .. "s") or "--"), self.w - 20 * self.u, y, col, 11 * self.u + 3, "right")
			y = y + 18 * self.u + 3
		end
	end
end
-- G-LOC grey-out / blackout under sustained positive G, red-out under negative G
function Hud:gEffects(ac, dt)
	if not ac or not ac.alive then self.black, self.red = 0, 0; return end
	local g = ac.fm.gLoad
	-- G-suit: up to ~8 G the pilot keeps the picture; a held 9 G turn greys out slowly (~6 s)
	self.black = clamp(self.black + (g > 8.2 and (g - 8.2) * 0.12 or g < 7 and -0.4 or 0) * dt, 0, 1)
	self.red = clamp(self.red + (g < -1.8 and (-g - 1.8) * 0.35 or -0.6) * dt, 0, 1)
	if self.black > 0.01 then self.g:vignette({ 0, 0, 0 }, min(0.97, self.black * 1.4), 0.75 - self.black * 0.8, self.black > 0.6 and (self.black - 0.6) * 2.2 or 0) end
	if self.red > 0.01 then self.g:vignette({ 150, 0, 0 }, min(0.97, self.red * 1.4), 0.75 - self.red * 0.8, self.red > 0.6 and (self.red - 0.6) * 2.2 or 0) end
end
-- missiles flying at the player: red marker (or edge arrow) with distance and time to impact
function Hud:incomingMissiles(ac)
	local u = self.u
	local blink = blinkOf(self.time, 6)
	for _, e in ipairs(ac.rwr.incoming) do
		local m, dist = e.missile, e.dist
		local px, py = self:project(m.pos)
		local closing = dot(sub(m.vel, ac.vel), norm(sub(ac.pos, m.pos)))
		local tti = closing > 1 and dist / closing or nil
		if not px then self:edgeArrow(m.pos, RED)
		else
			local k = 14 * u
			self:poly({ { px, py - k }, { px + k, py }, { px, py + k }, { px - k, py } }, RED)
			if blink then self:circle(px, py, 22 * u, RED) end
			self:text("RAKÉTA " .. fix(dist / 1000) .. " km" .. ((tti ~= nil and tti < 60) and ("  " .. fix(tti) .. " s") or ""), px + 26 * u, py, RED, 12 * u + 2)
		end
	end
end
function Hud:overlay(game)
	local u = self.u
	local fs = 12 * u + 3
	self:text((game.missionLine or ("HULLÁM " .. (game.wave or 0))) .. "   LELŐVE " .. (game.kills or 0) .. "   HALÁL " .. (game.deaths or 0), 20 * u, 22 * u, WHITE, fs)
	local hint = self.cockpit and "H = súgó   Esc = menü   N = kijelzők nézése   J / K / L = lapozás" or "H = súgó   Esc = menü   V = kabin   N = kijelzők"
	self:text(hint, 20 * u, 42 * u, DIM, 11 * u + 2)
	-- F-16: where the extreme mode is (it has no menu entry, only the key)
	local p = self.player
	if p and p.alive and p.spec.tvc and not p.spec.tvcAlways then
		self:text(p.extreme and "Tab = EXTRÉM mód KI" or "Tab = EXTRÉM mód (TVC, 9 G, Cobra)", 20 * u + self.g:measure(hint .. "   ", 11 * u + 2), 42 * u, AMBER, 11 * u + 2)
	end
	local y = 22 * u
	for _, k in ipairs(self.killfeed) do
		self:text(k.text, self.w - 20 * u, y, k.color, fs, "right")
		y = y + 20 * u + 3
	end
	if game.banner and game.banner ~= "" then self:text(game.banner, self.w / 2, self.h / 2 - 40 * u, WHITE, 44 * u + 6, "center", TITLE) end
	if game.subBanner and game.subBanner ~= "" then self:text(game.subBanner, self.w / 2, (game.banner and game.banner ~= "") and self.h / 2 + 10 * u or 80 * u, WHITE, 15 * u + 3, "center") end
end

return H
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX41"><Properties><string name="Name">Match</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- A match: the game flow of web/js/game.js without the pictures, the input devices and the menus - spawning the player,
-- the enemy waves, the wingman, duel, survival, ring races, scoring and medals, the throttle lever, the ejection.
-- The client (client/Game.luau) feeds it the player's controls and draws what happens.
-- Written in the common subset of Lua 5.4 and Luau, so it is tested outside of Roblox (roblox/tests).
local M = require(script.Parent.Parent.sim.SimMath)
local Sim = require(script.Parent.Parent.sim.Sim)
local AI = require(script.Parent.Parent.sim.AI)
local Specs = require(script.Parent.Parent.sim.Specs)
local Race = require(script.Parent.Race)
local Career = require(script.Parent.Career)
local Tutorial = require(script.Parent.Tutorial)
local CarrierLib = require(script.Parent.Carrier)
local Radio = require(script.Parent.Radio)
local Net = require(script.Parent.Net)
local Mission = require(script.Parent.Mission)
local V, add, sub, mul, len, norm, copy, clamp, DEG = M.V, M.add, M.sub, M.mul, M.len, M.norm, M.copy, M.clamp, M.DEG
local atan2, rng = M.atan2, M.rng
local abs = math.abs
local IR = Specs.IR
local AIRCRAFT, TRAINERS, BANDITS = Specs.AIRCRAFT, Specs.TRAINERS, Specs.BANDITS
local WEAPON_CLASS = Specs.WEAPON_CLASS

local G = {}

-- the matches that can be played with a friend, and how far apart the two start (m)
G.NET_SCENS = { race = true, canyon = true, tube = true, free = true }
G.NET_SIDE = { race = 40, canyon = 25, tube = 35, free = 90 }

-- The fight happens on the far side of the map: the enemies live in the combat zone and never attack anyone near the home
-- base (safe area), so taking off and landing is quiet.  An air start puts the player on the way there, just outside the zone.
local ZONE, ENGAGE_MARGIN, SAFE_RADIUS = { x = -14000, y = 16000, r = 16000 }, 12000, 14000
G.ZONE, G.SAFE_RADIUS = ZONE, SAFE_RADIUS
local CAT_HINT = "KATAPULT: adj teljes gázt (Shift tartva, 100%), és a katapult kilő az orr felé  ·  utána húzd az orrot (S), G = futómű"
local TAKEOFF_HINT_NOAB = "FELSZÁLLÁS: Shift tartva = gáz 100%-ig  ·  felemelkedési sebességnél emeld az egeret (vagy S)  ·  G = futómű"
local TAKEOFF_HINT = "FELSZÁLLÁS: Shift tartva = gáz 100%-ig, újra Shift = utánégető  ·  ~280 km/h-nál emeld az egeret (vagy S)  ·  G = futómű"
local SPLASH = { "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten" }
local WAVE_DELAY, FIRST_WAVE_DELAY, RELOAD_TIME, MAX_ENEMIES, MAX_ACTIVE, REINFORCE_GAP = 5, 25, 10, 6, 4, 70
local THROTTLE_RATE, MAX_AB = 0.4, 1.1
G.TAKEOFF_HINT, G.TAKEOFF_HINT_NOAB = TAKEOFF_HINT, TAKEOFF_HINT_NOAB

local function noop() end

local Match = {}
Match.__index = Match

function G.freshState()
	return { wave = 0, kills = 0, deaths = 0, banner = "", subBanner = "", paused = false, waveTimer = FIRST_WAVE_DELAY, waveActive = false,
		score = 0, streak = 0, reserve = 0, reserveT = 0, spawned = 0, duelWins = 0, duelLosses = 0, duelStreak = 0, over = false, modeLine = "", credits = 0 }
end

-- opts: scenario (waves, survival, duel, race, canyon, tube, free), enemies, difficulty, enemyTypes, aircraft, loadout, airStart,
--       wingman, mode ("arcade")
-- env:  terrain, seed, career (Career), hangar { pilotSkin, skin, modOn(id), upgraded(spec), earn(n) }, hud { message, popup, showMedal },
--       sounds { play }, radio { say }, onSpawn(ac, spec), clock() (seconds), best { race, canyon, tube, tubeLap }, onRecord(kind, ...)
function G.new(opts, env)
	local self = setmetatable({}, Match)
	self.opts, self.env = opts or {}, env
	self.terrain = env.terrain
	self.world = Sim.newWorld(self.terrain, env.seed or math.floor(os.clock() * 1e6) % 1000000000)
	self.rnd = self.world.rnd
	self.career = env.career or Career.new(nil, nil)
	self.hangar = env.hangar or { pilotSkin = nil, skin = nil, modOn = function() return false end, upgraded = function(_, s) return s end, earn = noop }
	self.hud = env.hud or { message = noop, popup = noop, showMedal = noop }
	self.sounds = env.sounds or { play = noop }
	self.radio = env.radio or Radio.new(self)
	self.clock = env.clock or os.clock
	self.state = G.freshState()
	self.threats, self.hitBy = {}, {}
	self.bt = { charge = 1, active = 0 }
	self.player, self.pilot, self.wingman, self.killCam, self.race = nil, nil, nil, nil, nil
	self.stick = { x = 0, y = 0, idle = 0 }
	self.nav = { zone = { x = ZONE.x, y = ZONE.y, r = ZONE.r, engage = ZONE.r + ENGAGE_MARGIN },
		base = { x = self.terrain.airfield.x, y = self.terrain.airfield.y, r = SAFE_RADIUS }, wave = 0, enemies = 0 }
	self.prevPos, self.myFin, self.ejectArm, self.thrPress = nil, nil, 0, -1e9
	self.events = {}                                    -- the world's events of the last frame, for the view
	self.guest = self.opts.netGuest == true
	self.wso = self.opts.wsoOf ~= nil                   -- the rear seat of another player's jet: the player is a copy of that jet
	self.wsoMark, self.wsoMarkT, self.wsoFlare, self.wsoName, self.wsoFired = nil, nil, 0, nil, -1e9
	-- the carrier, 21 km east and 42 km south of the island's middle (its deck is ground for the flight model)
	self.carrier = self.terrain.carrier or CarrierLib.new(self.terrain, 21000, -42000, 0)
	self.nav.carrier = { x = self.carrier.x, y = self.carrier.y }
	self.wasOnDeck, self.catState, self.trapped, self.towTimer = false, nil, false, 0
	self:spawnPlayer()
	if self.opts.mission then self.mission = Mission.new(self, self.opts.mission) end
	if self.opts.tutorial then self.tutorial = Tutorial.new(self, env.cam) end
	return self
end

function Match:scenario()
	if self.opts.tutorial then return "waves" end
	return self.opts.scenario or "waves"
end
-- the host of a co-op room runs the enemies; the guests only see them (Net.luau)
function Match:setGuest(on) self.guest = on == true end
function Match:wantWingman()
	local sc = self:scenario()
	return self.opts.wingman and not self.opts.tutorial and not self.guest and sc ~= "pvp" and sc ~= "duel" and sc ~= "race" and sc ~= "canyon" and sc ~= "tube" and sc ~= "free" and not self.opts.benchmark
end
function Match:enemiesAlive()
	local out = {}
	for _, a in ipairs(self.world.aircraft) do
		if a.team ~= "blue" and a.alive then out[#out + 1] = a end
	end
	return out
end

-- ---------------------------------------------------------------- spawning
function Match:spawnPlayer()
	local w, terrain = self.world, self.terrain
	if self.radio.reset then self.radio:reset() end
	if self.player then
		local keep = {}
		for _, a in ipairs(w.aircraft) do if a ~= self.player then keep[#keep + 1] = a end end
		w.aircraft = keep
	end
	if self.wso then self:spawnSlave() return end
	local sc = self:scenario()
	local duel, canyon, tube, free = sc == "duel", sc == "canyon", sc == "tube", sc == "free"
	local pvp = sc == "pvp"
	local race = sc == "race" or canyon or tube
	local air = self.opts.airStart or duel or race or free or pvp
	local field = terrain.airfield
	local pos, heading, speed = nil, 0, 0
	local st = self.state
	if race then
		-- ring race: 3 km north of the base, heading north, the first ring ahead
		local start = V(field.x, field.y + 3000, 0)
		if not self.race then
			local env = self.env
			local onRecord = env.onRecord or noop
			local best = env.best or {}
			if canyon then self.race = Race.Canyon.new(terrain, { best = best.canyon, onRecord = function(t) onRecord("canyon", t) end })
			elseif tube then self.race = Race.Tube.new(terrain, V(field.x, field.y + 3500, 0), { best = best.tube, bestLap = best.tubeLap, onRecord = function(t, lap) onRecord("tube", t, lap) end })
			else self.race = Race.Race.new(terrain, start, 0, { best = best.race, onRecord = function(t) onRecord("race", t) end }) end
		end
		self.race:reset()
		if tube then
			local pose = self.race:startPose()
			pos, heading, speed = pose.pos, pose.heading, 230
		else
			local r0 = self.race.rings[1]
			pos = add(r0.c, mul(r0.n, -1800))
			if canyon then pos.z = math.max(r0.c.z, terrain:height(pos.x, pos.y) + 90)
			else pos.z = math.max(r0.c.z + 60, terrain:height(pos.x, pos.y) + 250) end
			speed = canyon and 270 or 220
			heading = atan2(r0.n.x, r0.n.y) / DEG
		end
		self.prevPos, self.myFin = nil, nil
	elseif duel then
		-- duel: in the combat zone, heading north; the opponent comes head-on (spawnDuel)
		pos = V(ZONE.x, ZONE.y - 7000, 5000)
		pos.z = math.max(pos.z, terrain:height(pos.x, pos.y) + 1500)
		speed = 250
		local keep = {}
		for _, a in ipairs(w.aircraft) do
			if a.team ~= "blue" and a.alive then a.alive = false end
		end
		for _, a in ipairs(w.aircraft) do if a.team == "blue" then keep[#keep + 1] = a end end
		w.aircraft = keep
		st.waveActive, st.waveTimer = false, 3
	elseif pvp then
		-- team fight: the two teams start on the two sides of the combat zone, facing each other
		local red = self.env.netTeam == "red"
		local slot = (self.env.netSlot or 0) % 8
		pos = V(ZONE.x + (red and 7000 or -7000), ZONE.y + (slot - 3.5) * 700, 4500 + (slot % 3) * 350)
		pos.z = math.max(pos.z, terrain:height(pos.x, pos.y) + 1500)
		speed, heading = 250, red and 270 or 90
	elseif free then
		-- free flight: over the base, heading north
		pos = V(field.x, field.y + 2500, 0)
		pos.z = math.max(1800, terrain:height(pos.x, pos.y) + 900)
		speed = 230
	elseif air then
		-- between the base and the combat zone, heading for the zone
		local k = 0.45
		pos = V(field.x + (ZONE.x - field.x) * k, field.y + (ZONE.y - field.y) * k, 4500)
		pos.z = math.max(pos.z, terrain:height(pos.x, pos.y) + 1500)
		speed = 250
		heading = atan2(ZONE.x - pos.x, ZONE.y - pos.y) / DEG
	elseif self.opts.carrierStart and self.carrier.active then
		local cx, cy, ch = self.carrier:catapult(0)            -- on catapult 1, facing the bow
		pos, heading = V(cx, cy, 0), ch
	else
		local p = field:startPosition()
		pos, heading = V(p[1], p[2], 0), 0
	end
	if self.env.netSide and G.NET_SCENS[sc] then              -- two players: side by side, not on top of each other
		local side, h = self.env.netSide, heading * DEG
		pos = copy(pos)
		pos.x = pos.x + math.cos(h) * side * G.NET_SIDE[sc]
		pos.y = pos.y - math.sin(h) * side * G.NET_SIDE[sc]
	end
	-- the hangar: engine-room upgrades, the paint scheme and the mods ride on the player's jet
	local hg = self.hangar
	local base = AIRCRAFT[self.opts.aircraft] or TRAINERS[self.opts.aircraft] or AIRCRAFT.f16
	local spec = self.opts.benchmark and base or hg:upgraded(base)
	local ac = Sim.newAircraft(spec, "Te (" .. spec.callsign .. " 1)", self.env.netTeam or "blue", pos, heading, speed, { isPlayer = true, livery = "viper", lockAssist = true,
		missiles = Specs.missilesFor(spec, false), loadout = spec.trainer and "default" or self.opts.loadout or "default", rnd = rng(math.floor(self.rnd() * 1e9)),
		outfit = hg.pilotSkin, skin = hg.skin, blastMult = hg:modOn("bigboom") and 1.6 or 1,
		tracerColor = hg:modOn("tracer") and { 0.85, 0.4, 1, 0.45, 0.1, 0.7 } or nil })
	ac.specKey = AIRCRAFT[self.opts.aircraft] and self.opts.aircraft or TRAINERS[self.opts.aircraft] and self.opts.aircraft or "f16"
	if air then
		ac.controls.throttle = 0.95
	else
		ac.fm:placeOnGround(pos.x, pos.y, terrain:height(pos.x, pos.y), heading)
		ac.controls.throttle = 0
		st.subBanner = (self.opts.carrierStart and self.carrier.active) and CAT_HINT or (spec.noAB and TAKEOFF_HINT_NOAB or TAKEOFF_HINT)
	end
	w:addAircraft(ac)
	ac.twoSeat = self.opts.twoSeat == true
	self.player, self.pilot = ac, AI.newPlayerPilot(ac)
	self.killCam, self.followM = nil, nil
	self.threats, self.hitBy = {}, {}
	if self.env.onSpawn then self.env.onSpawn(ac, spec) end
	if self.wingman and self.wingman.alive then self.wingman.pilot.lead = ac
	elseif air and self:wantWingman() then self:spawnWingman() end
	if sc == "survival" and st.wave == 0 then st.waveTimer = air and 12 or FIRST_WAVE_DELAY end
end

-- the rear seat: the player is a copy of the pilot's jet (it follows the pilot's packets, its sensors run, nothing hurts it here)
function Match:spawnSlave()
	local w = self.world
	local key = self.opts.aircraft
	local spec = AIRCRAFT[key] or TRAINERS[key] or AIRCRAFT.fa18
	local ac = Sim.newAircraft(spec, "Pilóta (" .. spec.callsign .. ")", self.env.netTeam or "blue", V(self.terrain.airfield.x, self.terrain.airfield.y, 3000), 0, 200,
		{ isPlayer = true, livery = "viper", lockAssist = true, missiles = Specs.missilesFor(spec, false), loadout = self.opts.loadout or "default",
			rnd = rng(math.floor(self.rnd() * 1e9)) })
	ac.specKey = AIRCRAFT[key] and key or "fa18"
	ac.twoSeat = true
	Net.makeSlave(ac, self.clock)
	w:addAircraft(ac)
	self.player = ac
	self.pilot = { think = noop, fly = noop }
	self.killCam, self.followM = nil, nil
	self.threats, self.hitBy = {}, {}
	if self.env.onSpawn then self.env.onSpawn(ac, spec) end
	self.hud:message("HÁTSÓ ÜLÉS: T = célpont jelölése a pilótának · Space = rakéta · X = flare · 1/2 = fegyver · Y = következő cél", "info", 8, "wso")
end

-- the pilot's machine: an order from the rear seat (the Session checked who sent it).  a: "fire" (key: AIM-9M / AIM-120A), "flare", "mark"
function Match:wsoDo(a, key, target, name)
	local p = self.player
	if not p or not p.alive or p.ejected or self.wso then return end
	local who = name or "WSO"
	if a == "fire" then
		if key ~= "AIM-9M" and key ~= "AIM-120A" then return end
		local m = p:fireFrom(self.world, key, target)
		if m then self.hud:message(who .. ": " .. (key == "AIM-9M" and "FOX 2" or "FOX 3") .. "!", "good", 2, "wso")
		else self.hud:message(who .. ": nincs több " .. key, "warn", 1.5, "wso") end
	elseif a == "flare" then
		self.wsoFlare = 1.6
		self.hud:message(who .. ": FLARE!", "info", 1.2, "wso")
	elseif a == "mark" then
		if target and target.alive then
			self.wsoMark, self.wsoMarkT = target, 30
			self.hud:message(who .. " jelölt: " .. target.name .. " – T = lock", "good", 3, "wso")
		end
	end
end

-- the rear seat's keys (a press): k as in the browser game
function Match:wsoKey(k, camForward)
	local p = self.player
	if not p or not p.alive then return end
	local function msg(t, l, d) self.hud:message(t, l or "info", d or 1.6, "wso") end
	local send = self.env.wsoSend or noop
	if k == "t" or k == "y" then
		local cands = {}
		for _, a in ipairs(self.world.aircraft) do
			if a ~= p and a.alive and a.team ~= p.team then
				local rel = sub(a.pos, p.pos)
				local off = M.angleBetween(camForward or p.forward, rel)
				if k == "y" or off < 40 * DEG then cands[#cands + 1] = { t = a, key = k == "t" and off or len(rel) } end
			end
		end
		table.sort(cands, function(x, y) return x.key < y.key end)
		if #cands == 0 then msg(k == "t" and "Nincs cél a nézési irányban" or "Nincs ellenség", "warn") return end
		local pick = cands[1].t
		for i, c in ipairs(cands) do
			if c.t == self.wsoMark then pick = cands[(i % #cands) + 1].t end
		end
		self.wsoMark = pick
		send("mark", nil, pick)
		msg(string.format("JELÖLT: %s · %.1f km", pick.name, len(sub(pick.pos, p.pos)) / 1000), "good", 2)
	elseif k == "Space" then
		local key = p.selected
		if not key then return end
		if self.clock() - self.wsoFired < 0.6 then return end
		if p:missileCount(key) == 0 then msg("NINCS TÖBB " .. key, "warn") return end
		local tg = self.wsoMark
		if not tg or not tg.alive then msg("Előbb jelölj célt (T)", "warn") return end
		self.wsoFired = self.clock()
		send("fire", key, tg)
		msg((key == "AIM-9M" and "FOX 2" or "FOX 3") .. " – kérés a pilótának", "good", 1.5)
	elseif k == "x" then
		send("flare")
		msg("FLARE kérés a pilótának", "info", 1.2)
	elseif k == "1" then if p:select("AIM-9M") then msg("AIM-9M", "info", 1) end
	elseif k == "2" then if p:select("AIM-120A") then msg("AIM-120A", "info", 1) end
	end
end

-- the wingman joins behind and to the right of the player (same type, the weaker AI airframe and missiles)
function Match:spawnWingman()
	local p = self.player
	local spec = BANDITS[p.spec.id] or BANDITS[p.spec.model] or BANDITS.f16
	local fwd = norm(V(p.forward.x, p.forward.y, 0), V(0, 1, 0))
	local right = V(fwd.y, -fwd.x, 0)
	local pos = add(add(p.pos, mul(fwd, -260)), mul(right, 170))
	pos.z = math.max(p.pos.z + 20, self.terrain:height(pos.x, pos.y) + 300)
	local loadout = spec.id == "f16" and "default" or Specs.buildLoadout(spec, 2, 4).layout
	local ac = Sim.newAircraft(spec, spec.callsign .. " 2 (kísérő)", "blue", pos, atan2(fwd.x, fwd.y) / DEG, math.max(200, p.speed),
		{ livery = "viper", missiles = Specs.missilesFor(spec, true), loadout = loadout, rnd = rng(math.floor(self.rnd() * 1e9)) })
	AI.newWingmanPilot(ac, p)
	self.world:addAircraft(ac)
	self.wingman = ac
	self.hud:message("KÍSÉRŐ CSATLAKOZOTT - " .. ac.name, "good", 3)
	if self.env.onSpawn then self.env.onSpawn(ac, spec) end
end

-- a wave appears in the combat zone, on its far side from the player, facing the player's way in
function Match:spawnWave()
	local st, p = self.state, self.player
	if self:scenario() == "duel" then self:spawnDuel(); return end
	st.wave = st.wave + 1
	if self:wantWingman() and (not self.wingman or not self.wingman.alive) then self:spawnWingman() end
	self.career:best("bestWave", st.wave)
	if st.wave >= 5 then self:medal("wave5") end
	if self:scenario() == "survival" then
		self.career:best("bestSurvival", st.wave)
		if st.wave >= 4 then self:medal("survivor") end
	end
	local count = math.min((self.opts.enemies or 2) + st.wave - 1, MAX_ENEMIES)
	local now = math.min(count, MAX_ACTIVE)
	st.reserve, st.reserveT, st.spawned = count - now, 0, 0
	self:spawnEnemies(now, 0)
	st.waveActive = true
	local toZone = math.max(0, math.sqrt((ZONE.x - p.pos.x) ^ 2 + (ZONE.y - p.pos.y) ^ 2) - ZONE.r)
	local extra = st.reserve > 0 and (" (egyszerre " .. now .. ", a többi erősítésként jön)") or ""
	local far = toZone > 1000 and (" (" .. string.format("%.0f", toZone / 1000) .. " km)") or ""
	self.hud:message(st.wave .. ". HULLÁM - " .. count .. " ellenség" .. extra .. " a harci zónában" .. far, "warn", 5)
end

function Match:enemyType(r)
	local list = {}
	local src = self.opts.enemyTypes or { self.opts.enemyType or "f16" }
	for _, k in ipairs(src) do if BANDITS[k] then list[#list + 1] = k end end
	if #list == 0 then return "f16" end
	return list[math.floor(r() * #list) + 1]
end

-- n enemies in a line across the combat zone (back: metres further away, for reinforcements)
function Match:spawnEnemies(n, back)
	local st, p, r = self.state, self.player, self.rnd
	local from = norm(V(ZONE.x - p.pos.x, ZONE.y - p.pos.y, 0), V(0, 1, 0))
	local center = add(V(ZONE.x, ZONE.y, 0), mul(from, ZONE.r * 0.35 + back))
	local side = V(from.y, -from.x, 0)
	local area = { x = self.nav.zone.x, y = self.nav.zone.y, r = self.nav.zone.r, engage = self.nav.zone.engage, safe = self.nav.base }
	for i = 0, n - 1 do
		local pos = add(center, mul(side, (i - (n - 1) / 2) * 3500 + r.uniform(-800, 800)))
		pos.z = math.max(r.uniform(3000, 7500), self.terrain:height(pos.x, pos.y) + 1500)
		local heading = atan2(-from.x, -from.y) / DEG + r.uniform(-20, 20)
		local typ = self:enemyType(r)
		local spec = BANDITS[typ]
		local loadout = (typ == "f16" or spec.proc) and "default" or Specs.buildLoadout(spec, 2, 4).layout
		st.spawned = st.spawned + 1
		local ac = Sim.newAircraft(spec, "Bandita " .. st.spawned .. " (" .. spec.short .. ")", "red", pos, heading, 240,
			{ livery = "viper", missiles = Specs.missilesFor(spec, true), loadout = loadout, rnd = rng(math.floor(r() * 1e9)) })
		AI.newAIPilot(ac, self.opts.difficulty or "normal", area)
		ac.specKey = typ
		self.world:addAircraft(ac)
		if self.env.onSpawn then self.env.onSpawn(ac, spec) end
	end
end

-- duel: one opponent 9 km ahead, head-on, same height; every round starts with a full jet
function Match:spawnDuel()
	local st, p, r = self.state, self.player, self.rnd
	st.wave = st.wave + 1
	p:rearm()
	p.hp, p.burning = p.spec.hp, false
	p.fm.fuel = p.spec.internalFuel
	for _, s in ipairs(p.stations) do s.reload = nil end
	local fwd = norm(V(p.forward.x, p.forward.y, 0), V(0, 1, 0))
	local pos = add(p.pos, mul(fwd, 9000))
	pos.x, pos.y = clamp(pos.x, -38000, 38000), clamp(pos.y, -38000, 38000)
	pos.z = clamp(p.pos.z + r.uniform(-400, 400), self.terrain:height(pos.x, pos.y) + 1500, 9000)
	local typ = self:enemyType(r)
	local spec = BANDITS[typ]
	local loadout = (typ == "f16" or spec.proc) and "default" or Specs.buildLoadout(spec, 2, 4).layout
	local ac = Sim.newAircraft(spec, "Ellenfél (" .. spec.short .. ")", "red", pos, atan2(p.pos.x - pos.x, p.pos.y - pos.y) / DEG, 240,
		{ livery = "viper", missiles = Specs.missilesFor(spec, true), loadout = loadout, rnd = rng(math.floor(r() * 1e9)) })
	AI.newAIPilot(ac, self.opts.difficulty or "normal", nil)
	ac.specKey = typ
	self.world:addAircraft(ac)
	if self.env.onSpawn then self.env.onSpawn(ac, spec) end
	st.waveActive = true
	self.hud:message(st.wave .. ". PÁRBAJ - " .. spec.short .. " szemből, 9 km", "warn", 4)
end

-- ------------------------------------------------------------------ the player's controls
function Match:canAct() return not self.state.paused and self.player ~= nil and self.player.alive end

-- Throttle like a real lever with a MIL detent: a tap moves it 5 %, holding slews it 40 %/s.  Going up it stops at 100 %
-- (MIL); the afterburner needs a new press of Shift there.  Down from AB goes straight to MIL.
function Match:throttleStep(dir)
	local c = self.player.controls
	self.thrPress = self.clock()
	if dir > 0 then
		if c.throttle >= 0.999 then
			if c.throttle < MAX_AB and not self.player.spec.noAB then
				c.throttle = MAX_AB
				self.hud:message("UTÁNÉGETŐ BE", "warn", 1.2, "thr")
			end
		else
			c.throttle = math.min(1, math.floor(c.throttle * 20 + 1e-6) / 20 + 0.05)
		end
	elseif c.throttle > 1.001 then
		c.throttle = 1
		self.hud:message("UTÁNÉGETŐ KI", "info", 1.2, "thr")
	else
		c.throttle = math.max(0, math.ceil(c.throttle * 20 - 1e-6) / 20 - 0.05)
	end
end
function Match:throttleInput(dt, up, down)
	local c = self.player.controls
	local dir = (up and not down) and 1 or (down and not up) and -1 or 0
	if dir == 0 or self.clock() - self.thrPress < 0.3 then return end
	if dir > 0 and c.throttle < 1 then c.throttle = math.min(1, c.throttle + THROTTLE_RATE * dt)
	elseif dir < 0 then c.throttle = c.throttle > 1 and 1 or math.max(0, c.throttle - THROTTLE_RATE * dt) end
end

-- inp: { aim (direction, sim frame), pitch, roll, yaw (-1..1 or nil), throttleUp, throttleDown, brake, trigger, flare, camPos (the camera's forward for the T key) }
function Match:applyInput(dt, inp)
	local p, c = self.player, self.player.controls
	self.pilot.aim = inp.aim or self.pilot.aim
	self.pilot.pitch, self.pilot.roll, self.pilot.yaw = inp.pitch, inp.roll, inp.yaw
	if inp.throttleSet then c.throttle = inp.throttleSet end
	self:throttleInput(dt, inp.throttleUp, inp.throttleDown)
	c.airbrake = inp.brake == true
	c.brakes = inp.brake == true and p.onGround
	p.trigger = inp.trigger == true
	p.cmHold = inp.flare == true or self.wsoFlare > 0
end

-- the keys that are not held (a press): k as in the browser game
function Match:onKey(k, camForward)
	if not self:canAct() then return end
	local p = self.player
	local function msg(t, l, d) self.hud:message(t, l or "info", d or 1.5) end
	if k == "shift" then self:throttleStep(1); return end
	if k == "z" or k == "control" then self:throttleStep(-1); return end
	if k == "Space" then
		local m = p:fireMissile(self.world)
		if m then
			local fox = m.spec.guidance == IR and "FOX 2" or "FOX 3"
			msg(m.pending and (fox .. " - fegyvertér nyílik") or fox)
		end
	elseif k == "f" then
		if not p.selectedSpec or p.selectedSpec.guidance ~= IR then p:select("AIM-9M") end
		if p.irSeeker.locked then
			p:toggleIrLock(self.world)
			msg("KERESŐ ELENGEDVE", "info", 1.2)
		elseif p:toggleIrLock(self.world) then
			msg("SEEKER LOCK - Space: indítás", "good")
		else
			msg("Nincs ellenség az orr előtt (±30°)", "warn")
		end
	elseif k == "t" then
		-- the target the rear seat marked first; else the enemy closest to where you are looking (mouse aim, or free look)
		local mk = self.wsoMark
		local dir = camForward or p.forward
		if mk and mk.alive and p.radar.locked ~= mk and p.radar.pending ~= mk then
			dir = norm(sub(mk.pos, p.pos))
			local res = p.radar:quickLock(self.world, dir, 12)
			if res == "none" or res == "keep" then msg("A jelölt cél nincs a radar látószögében – fordulj felé", "warn", 2) end
			return
		end
		local res = p.radar:quickLock(self.world, dir)
		local t = ({ unlocked = { "UNLOCK", "info" }, locking = { "LOCKOLÁS...", "info" }, keep = { "Nincs másik cél", "info" },
			none = { "Nincs cél a nézési irányban - fordulj felé", "warn" } })[res]
		if t then msg(t[1], t[2], 1.6) end
	elseif k == "y" then p.radar:cycleTarget()
	elseif k == "r" then
		p.radar:togglePower()
		msg("RADAR " .. (p.radar.on and "BE" or "KI"), "info", 1.2)
	elseif k == "1" then if p:select("AIM-9M") then msg("AIM-9M", "info", 1) end
	elseif k == "2" then if p:select("AIM-120A") then msg("AIM-120A", "info", 1) end
	elseif k == "Tab" then
		if p:toggleExtreme() then
			msg(p.extreme and "EXTRÉM MÓD BE - tolóerő-vektorálás, 9 G, teljes húzás = Cobra" or "EXTRÉM MÓD KI", p.extreme and "warn" or "info", 2.5)
		elseif p.spec.tvcAlways then msg("F-22: a tolóerő-vektorálás mindig be van kapcsolva", "info")
		else msg("Ezen a gépen nincs tolóerő-vektorálás (F-16 és F-15 ACTIVE)", "warn") end
	elseif k == "g" then
		if p:toggleGear() then msg("FUTÓMŰ " .. (p.fm.gearDown and "KI" or "BE"))
		else msg("A földön nem húzható be a futómű", "warn") end
	end
end

function Match:cycleWeapon(dir)
	if not self:canAct() then return end
	local p = self.player
	local keys = p:weaponKeys()
	local loaded = {}
	for _, k in ipairs(keys) do if p:missileCount(k) > 0 then loaded[#loaded + 1] = k end end
	local list = #loaded > 0 and loaded or keys
	if #list == 0 then return end
	local idx = 0
	for i, k in ipairs(list) do if k == p.selected then idx = i end end
	local n
	if idx == 0 then n = 1 else n = ((idx - 1 + (dir > 0 and 1 or -1)) % #list) + 1 end
	local nextKey = list[n]
	if nextKey ~= p.selected and p:select(nextKey) then
		self.hud:message(nextKey .. "  (" .. p:missileCount(nextKey) .. ")", "info", 1)
	end
end

-- Ctrl+E twice (like the real handle: a deliberate pull): the seat fires, the pilot comes down under the parachute and lives;
-- the jet flies on with nobody at the controls and is lost
function Match:ejectHandle()
	local p, now = self.player, self.clock()
	if not p or not p.alive or p.ejected then return end
	if p.onGround and p.speed < 30 then
		self.hud:message("A földön állva nem katapultálunk – szállj ki rendesen", "info", 2, "eject")
		return
	end
	if self.ejectArm == 0 or now - self.ejectArm > 2.5 then
		self.ejectArm = now
		self.hud:message("KATAPULTÁLÁS: Ctrl+E még egyszer!", "warn", 1.5, "eject")
		return
	end
	self.ejectArm = 0
	p.ejected = true
	p.pilot = { think = noop, fly = function() p.controls.pitch = 0.05; p.controls.roll = 0; p.controls.yaw = 0 end }
	p.trigger = false
	local st = self.state
	st.banner = "KATAPULTÁLTÁL!"
	st.subBanner = "A pilóta életben van – a " .. p.spec.short .. " elveszett  ·  Enter: új gép"
	self.sounds:play("eject")
	self.radio:say("you", (self.opts.callsign or "VIPER 1-1") .. ", EJECTING, EJECTING!")
	self.radio:say("awacs", (self.opts.callsign or "VIPER 1-1") .. ", Magic copies, good chute. Rescue is on the way.", 4.5)
	self.career.data.ejections = (self.career.data.ejections or 0) + 1
	if self.env.onEject then self.env.onEject(p) end
end

function Match:respawn()
	if self.mission and (self.mission.over or (self.player and not self.player.alive)) then self.mission:leave() return end
	if self.player and self.player.ejected then
		self.state.banner, self.state.subBanner = "", ""
		if self.env.onRespawn then self.env.onRespawn() end
		self:spawnPlayer()
		return
	end
	if self.race and self.race.finished then
		self.state.banner, self.state.subBanner = "", ""
		self:spawnPlayer()
		return
	end
	if self.state.over then
		self.career.data.matches = self.career.data.matches + 1
		self:restart()
		return
	end
	if self.player and not self.player.alive then
		self.state.banner, self.state.subBanner = "", ""
		self:spawnPlayer()
	end
end
-- a new match with the same options (survival: after the end)
function Match:restart()
	local w = Sim.newWorld(self.terrain, math.floor(self.rnd() * 1e9))
	self.world, self.rnd = w, w.rnd
	self.state = G.freshState()
	self.player, self.wingman, self.killCam, self.race = nil, nil, nil, nil
	self.bt = { charge = 1, active = 0 }
	if self.env.onRestart then self.env.onRestart() end
	self:spawnPlayer()
end

-- ------------------------------------------------------------------ the frame
-- dt: seconds of the frame.  Returns the world's events (also kept in self.events), after the scoring has seen them.
function Match:update(dt)
	local st = self.state
	if not st.paused then
		local bt = self.bt
		if bt.active > 0 then bt.active = math.max(0, bt.active - dt) else bt.charge = math.min(1, bt.charge + dt / 20) end
		local wdt = bt.active > 0 and dt * 0.35 or dt
		self.world:update(wdt)
		if self.race and self.player.alive then self:raceStep(wdt) end
		if self.player.alive and not self.player.ejected and self.carrier.active and not self.wso then self:carrierStep(dt) end
		if self.mission then self.mission:update(dt) end
		if self.wsoFlare > 0 then self.wsoFlare = self.wsoFlare - dt end
		if self.wsoMark then
			if self.wsoMarkT then self.wsoMarkT = self.wsoMarkT - dt end
			if not self.wsoMark.alive or (self.wsoMarkT and self.wsoMarkT <= 0) then self.wsoMark, self.wsoMarkT = nil, nil end
		end
		if self.player.alive and not self.player.onGround then self.career:tick(dt) end
		for _, m in ipairs(self.player.rwr.incoming) do self.threats[m.missile] = true end
		if self.tutorial then self.tutorial:update(dt) end
		self:gameFlow(dt)
		if self.radio.update then self.radio:update(dt) end
	end
	local events = self.world:drainEvents()
	for _, e in ipairs(events) do
		self:onEvent(e[1], e[2])
		self:extraEvent(e[1], e[2])
		if self.tutorial then self.tutorial:onEvent(e[1], e[2]) end
	end
	self.events = events
	local nav = self.nav
	nav.wave, nav.enemies = st.wave, #self:enemiesAlive()
	st.modeLine = self:modeLine() .. (self.wsoName and (" · WSO: " .. self.wsoName) or "")
	st.wsoMark = self.wsoMark
	st.meatball = self:meatball()
	st.credits = self.hangar.credits and self.hangar:credits() or 0
	return events
end

-- carrier: arresting wires on touchdown, bolters, the catapult; the deck counts as paved for rearming
function Match:carrierStep(dt)
	local p, cv, st = self.player, self.carrier, self.state
	local fm = p.fm
	local on = p.onGround and cv:onDeck(p.pos.x, p.pos.y)
	if on and not self.wasOnDeck and p.speed > 22 then
		if fm.gearDown and cv:inWires(p.pos.x, p.pos.y) then
			fm.arrest, self.catState, self.trapped = 30, nil, true
			local n = cv:wireNumber(p.pos.x, p.pos.y)
			self.hud:message("BEAKADT - " .. n .. ". fékezőkötél" .. (n == 3 and " (tökéletes!)" or ""), "good", 4, "trap")
			if not self.opts.tutorial and not self.opts.benchmark then self:medal("trap") end
			if self.env.onTrap then self.env.onTrap(n) end
		else
			self.hud:message("BOLTER! Teljes gáz, és emelkedj újra", "warn", 3, "trap")
		end
	end
	self.wasOnDeck = on
	if self.trapped and p.speed < 3 then               -- the wire stopped the jet: throttle back, brakes on
		self.trapped, p.controls.throttle, fm.parkBrake, self.towTimer = false, 0, true, 2.5
		self.hud:message("ELKAPVA! A fedélzeti személyzet a katapulthoz vontat...", "good", 3, "trap")
	end
	if self.towTimer > 0 and on then
		self.towTimer = self.towTimer - dt
		if self.towTimer <= 0 then                      -- towed to catapult 1 (rearmed and refuelled by the deck crew)
			local x, y, h = cv:catapult(0)
			fm:placeOnGround(x, y, CarrierLib.DECK_Z, h)
			p.controls.throttle = 0
			p:rearm()
			p.hp, p.burning = p.spec.hp, false
			fm.fuel = p.spec.internalFuel
			if self.env.onCatapultTow then self.env.onCatapultTow() end
			self.hud:message("A KATAPULTON - teljes gáz = kilövés", "info", 4, "trap")
		end
	end
	if fm.parkBrake and ((not on) or p.controls.throttle >= 0.99) then fm.parkBrake = false end
	-- catapult: stopped on the track at full throttle -> 1 s run-up, then the shuttle fires
	local cat = self.catState
	if on and cv:onCatapult(p.pos.x, p.pos.y) and fm.gearDown and p.speed < 3 and p.controls.throttle >= 0.99 and not cat then
		self.catState = { t = 0, fired = false }
		cat = self.catState
		self.hud:message("KATAPULT ÉLESÍTVE...", "warn", 1.5, "cat")
	end
	if cat then
		cat.t = cat.t + dt
		if not cat.fired and cat.t > 1.0 then
			cat.fired, fm.catapultAcc = true, 30
			self.hud:message("KATAPULT!", "good", 2, "cat")
			if self.env.onKick then self.env.onKick(0.8) end
		end
		if cat.fired and ((not p.onGround) or p.speed > 88) then
			fm.catapultAcc, self.catState = 0, nil
			-- off the bow: the aim point goes 12 degrees up so the jet climbs away from the sea
			if self.env.onCatapultOff then self.env.onCatapultOff() end
		end
		if not cat.fired and (p.controls.throttle < 0.99 or not on) then self.catState = nil end
	end
	if st.subBanner == CAT_HINT and not p.onGround then st.subBanner = "" end
end
-- optical landing system: shown while flying an approach to the carrier (behind it, gear down, within 4 km)
function Match:meatball()
	local p = self.player
	if not p or not p.alive or p.onGround or not p.fm.gearDown then return nil end
	local g = self.carrier:glide(p.pos.x, p.pos.y, p.pos.z)
	if not g.behind or g.dist > 4500 or abs(g.off) > 700 then return nil end
	return g
end

function Match:addScore(n)
	if self.wso then n = math.floor(n / 2) end                    -- the rear seat gets half of a kill
	self.state.score = self.state.score + n
	if not self.opts.tutorial and not self.opts.benchmark then self.hangar:earn(n) end
end
function Match:medal(id)
	if self.opts.benchmark then return end
	local a = self.career:award(id)
	if not a then return end
	self.hud:showMedal(a)
	self.sounds:play("medal", 0.7)
end

function Match:onEvent(kind, d)
	-- the wingman's own radio calls
	if self.wingman then
		if kind == "launch" and d.missile and d.missile.shooter == self.wingman then self.radio:event("wing_fox") end
		if kind == "kill" and d.killer == self.wingman then self.radio:event("wing_splash") end
	end
	if self.mission then self.mission:onEvent(kind, d) end
	if kind ~= "kill" then return end
	local st, p, scen = self.state, self.player, self:scenario()
	if d.victim == p and p.ejected then
		self.hud:message("Az elhagyott gép lezuhant – a pilóta életben van", "info", 3, "eject")
		return
	end
	if d.victim == p then
		st.deaths, st.streak = st.deaths + 1, 0
		if not self.opts.tutorial then self.career.data.deaths = self.career.data.deaths + 1 end
		if d.killer and d.killer ~= p and d.killer.alive then self.killCam = { killer = d.killer, t = 4 } end
		st.banner = d.weapon ~= "crash" and "LELŐTTEK!" or "LEZUHANTÁL!"
		local again = "Enter: újraéledés"
		st.subBanner = self.opts.tutorial and "Pár másodperc, és újra a levegőben vagy – a lecke elölről indul"
			or (again .. "  ·  Esc: menü (főmenü, új játék)")
		if scen == "duel" and not self.opts.tutorial then
			st.duelLosses, st.duelStreak = st.duelLosses + 1, 0
			st.subBanner = "Párbaj elvesztve  ·  " .. again .. " (új kör)"
		end
		if scen == "survival" then
			local rec = st.score > (self.career.data.bestScore or 0)
			self.career:best("bestScore", st.score)
			self.career:best("bestSurvival", st.wave)
			self.career:save()
			st.over, st.banner = true, "VÉGE"
			st.subBanner = "Túlélés: " .. st.wave .. ". hullám · " .. st.score .. " pont" .. (rec and " · ÚJ REKORD!" or "") .. "  ·  Enter: új játék"
		end
		self.career:save()
	elseif d.killer == p then
		st.kills = st.kills + 1
		local weapon = WEAPON_CLASS[d.weapon] or d.weapon
		if self.opts.tutorial or self.opts.benchmark then return end
		st.streak = st.streak + 1
		local pts = Career.killPoints(weapon, self.opts.difficulty or "normal", st.streak)
		self:addScore(pts)
		self.hud:popup("+" .. pts .. " " .. Career.weaponLabel(weapon) .. (st.streak > 1 and (" ×" .. st.streak) or ""))
		local c = self.career.data
		c.kills = c.kills + 1
		if weapon == "crash" then c.crashKills = c.crashKills + 1
		elseif weapon == "AIM-9M" then c.irKills = c.irKills + 1
		elseif weapon == "AIM-120A" then c.arhKills = c.arhKills + 1
		else c.gunKills = c.gunKills + 1 end
		c.perPlane[p.spec.id] = (c.perPlane[p.spec.id] or 0) + 1
		self.career:best("bestStreak", st.streak)
		self.career:best("bestScore", st.score)
		self.sounds:play("splash", 0.6)
		self:medal("first")
		if weapon == "crash" then self:medal("maneuver") elseif weapon == "AIM-9M" then self:medal("fox2")
		elseif weapon == "AIM-120A" then self:medal("fox3") elseif Career.isGun(weapon) then self:medal("guns") end
		if st.streak >= 5 then self:medal("ace") end
		if d.victim.spec.id == "f22" then self:medal("stealth") end
		c.victims = c.victims or {}
		c.victims[d.victim.spec.id] = (c.victims[d.victim.spec.id] or 0) + 1
		if self.opts.difficulty == "hard" or self.opts.difficulty == "ace" then self:medal("veteran") end
		if st.score >= 5000 then self:medal("score5k") end
		self.career:save()
	elseif d.killer and d.killer == self.wingman and d.victim.team ~= "blue" then
		self:addScore(50)
		self.hud:popup("+50 KÍSÉRŐ", "rgba(115,217,255,0.95)")
		self:medal("team")
	end
end

-- the extra effects of events: medals that do not come from kills
function Match:extraEvent(kind, d)
	local p = self.player
	if not p then return end
	if kind == "hit" and d.target == p then
		if d.missile then self.hitBy[d.missile] = true end
	elseif kind == "launch" and d.shooter == p then
		if not self.opts.tutorial then self.career.data.missilesFired = self.career.data.missilesFired + 1 end
	elseif kind == "missile_end" then
		local m = d.missile
		if self.threats[m] and not self.hitBy[m] and p.alive and not self.opts.tutorial then
			self:addScore(50)
			self.hud:popup("+50 KICSELEZVE", "rgba(115,217,255,0.95)")
			self:medal("evade")
		end
		self.threats[m], self.hitBy[m] = nil, nil
	elseif kind == "cobra" and d.target == p and not self.opts.tutorial then
		self:medal("cobra")
	end
end

-- ring race: passing rings, the finish, a ring missed
function Match:raceStep(dt)
	local p, r, st = self.player, self.race, self.state
	local prev = self.prevPos or copy(p.pos)
	self.prevPos = copy(p.pos)
	local ev = r:update(dt, p, prev)
	local sc = self:scenario()
	local fmt = Race.fmtTime
	if ev == "finish" then self.myFin = (sc == "tube") and r.finalTime or r.time end
	if sc == "tube" and ev == "lap" then
		self:addScore(60)
		self.hud:popup((r.lap - 1) .. ". KÖR  " .. fmt(r.lastLap), "rgba(255,200,64,0.95)")
		self.sounds:play("medal", 0.4)
	elseif sc == "tube" and ev == "out" then
		self.hud:message("KILÓGTÁL A CSŐBŐL – az idő duplán számít", "warn", 2, "race")
	elseif ev == "ring" and sc == "tube" then
		self:addScore(5)
	elseif ev == "ring" then
		self:addScore(20)
		self.hud:popup((sc == "canyon" and "KAPU" or "GYŰRŰ") .. " " .. r.next .. "/" .. #r.rings, "rgba(255,200,64,0.95)")
		self.sounds:play("splash", 0.4)
	elseif ev == "miss" and sc ~= "tube" then
		self.hud:message("MELLÉ! Fordulj vissza a gyűrűhöz", "warn", 2, "race")
	elseif ev == "target" then
		self.world:emit("explosion", { pos = r.targetPos, size = 3, ground = true })
		self:addScore(150)
		self.hud:popup("CÉLPONT MEGSEMMISÍTVE", "rgba(255,90,60,0.95)")
		self.sounds:play("medal", 0.5)
		self.hud:message("CÉLPONT TALÁLVA – most húzd fel meredeken a gerincen át!", "good", 5, "race")
	elseif ev == "radar" then
		self.hud:message("RADARKONTAKT! +5 s – repülj alacsonyabban (350 m alatt)", "warn", 3, "race")
	elseif ev == "finish" and sc == "tube" then
		local reward = 400 + (r.record and 250 or 0)
		self:addScore(reward)
		st.banner = "CÉL!  " .. fmt(r.finalTime) .. "  (" .. r.laps .. " kör)"
		st.subBanner = (r.record and "ÚJ REKORD! · " or ("rekord: " .. fmt(r.best) .. " · ")) .. "legjobb kör " .. fmt(r.bestLap)
			.. (r.penalty > 0.5 and (" · csőből kilógás +" .. string.format("%.1f", r.penalty) .. " s") or "") .. " · +" .. reward .. " kredit  ·  Enter: újra"
		self.sounds:play("medal", 0.7)
		self.career:save()
	elseif ev == "finish" and sc == "canyon" then
		local reward = r.success and (500 + (r.record and 250 or 0)) or 100
		self:addScore(reward)
		st.banner = r.success and ("KÜLDETÉS TELJESÍTVE  " .. fmt(r.time)) or ("TÚL LASSÚ  " .. fmt(r.time))
		st.subBanner = (r.success and (r.record and "ÚJ REKORD! · " or ("rekord: " .. fmt(r.best) .. " · ")) or ("a határidő " .. fmt(Race.CANYON_LIMIT) .. " volt · "))
			.. "+" .. reward .. " kredit  ·  Enter: újra"
		self.sounds:play(r.success and "medal" or "splash", 0.7)
		self.career:save()
	elseif ev == "finish" then
		local reward = 300 + (r.record and 200 or 0)
		self:addScore(reward)
		st.banner = "CÉL!  " .. fmt(r.time)
		st.subBanner = (r.record and "ÚJ REKORD! · " or ("rekord: " .. fmt(r.best) .. " · ")) .. "+" .. reward .. " kredit  ·  Enter: újra"
		self.sounds:play("medal", 0.7)
		self.career:best("bestScore", st.score)
		self.career:save()
	end
	return ev
end

function Match:modeLine()
	local st, sc = self.state, self:scenario()
	if self.opts.tutorial then return "" end
	local fmt = Race.fmtTime
	local friend = self.env.friendLine and self.env.friendLine() or ""
	if self.mission then return self.mission:line() end
	if self.wso then return "HÁTSÓ ÜLÉS · te jelölsz és lősz, a pilóta repül" end
	if sc == "race" and self.race then
		local r = self.race
		return "GYŰRŰVERSENY · " .. math.min(r.next, #r.rings) .. "/" .. #r.rings .. " · " .. fmt(r.time) .. " · rekord " .. fmt(r.best) .. friend
	end
	if sc == "tube" and self.race then
		local r = self.race
		return "ALAGÚTFUTAM · kör " .. r.lap .. "/" .. r.laps .. " · " .. fmt(r.clock) .. (r.lastLap and (" · utolsó " .. fmt(r.lastLap)) or "")
			.. (r.bestLap and (" · legjobb " .. fmt(r.bestLap)) or "") .. (r.outside and " · KILÓGSZ A CSŐBŐL" or "") .. friend
	end
	if sc == "pvp" then
		local sc2 = self.env.teamScore and self.env.teamScore() or { blue = 0, red = 0 }
		return "CSAPATHARC · KÉK " .. sc2.blue .. " : " .. sc2.red .. " PIROS · te: " .. (self.env.netTeam == "red" and "PIROS" or "KÉK")
	end
	if sc == "free" then return "KÖZÖS REPÜLÉS" .. (self.env.friendLine and " · a barátoddal" or " · egyedül") end
	if sc == "canyon" and self.race then
		local r = self.race
		local t = r.time + r.penalty
		local left = Race.CANYON_LIMIT - t
		return "KANYONFUTÁS · " .. (r.hit and "célpont találva · húzz fel!" or "cél: a völgy végén") .. " · " .. fmt(t) .. " / " .. fmt(Race.CANYON_LIMIT)
			.. (left < 0 and " · LEJÁRT" or "") .. (r.penalty > 0 and (" · radar +" .. r.penalty .. " s") or "") .. " · rekord " .. fmt(r.best) .. friend
	end
	if sc == "duel" then
		return "PÁRBAJ · győzelem " .. st.duelWins .. " · vereség " .. st.duelLosses .. (st.duelStreak > 1 and (" · " .. st.duelStreak .. " egymás után") or "")
	end
	if sc == "survival" then return "TÚLÉLÉS · egy életed van · rekord: " .. (self.career.data.bestSurvival or 0) .. ". hullám" end
	if self.guest then return "KÖZÖS HARC · " .. (st.wave or 0) .. ". hullám (a szoba nyitója vezeti)" end
	if self.wingman then
		return "KÍSÉRŐ: " .. (self.wingman.alive and "a levegőben" or "lelőtték, a következő hullámmal visszajön")
	end
	return ""
end

function Match:gameFlow(dt)
	local st, p = self.state, self.player
	if not p.alive then return end
	local terrain = self.terrain
	local field = terrain.airfield
	local airborne = (not p.onGround) and p.pos.z - terrain:height(p.pos.x, p.pos.y) > 150
	if (st.subBanner == TAKEOFF_HINT or st.subBanner == TAKEOFF_HINT_NOAB) and airborne then
		st.subBanner = ""
		self.hud:message("SIKERES FELSZÁLLÁS - húzd be a futóművet (G)", "good", 4)
	end
	local sc = self:scenario()
	if sc == "race" or sc == "canyon" or sc == "tube" or sc == "free" or sc == "pvp" or sc == "mission" then return end
	local runsWaves = not self.guest                        -- the host's machine runs the enemies
	-- reinforcements: the rest of a big wave comes in groups, when the first ones are thinned out (or after a while)
	if runsWaves and not self.opts.tutorial and st.waveActive and st.reserve > 0 then
		st.reserveT = st.reserveT + dt
		if #self:enemiesAlive() <= 1 or st.reserveT > REINFORCE_GAP then
			local n = math.min(st.reserve, 3)
			self:spawnEnemies(n, 6000)
			st.reserve, st.reserveT = st.reserve - n, 0
			self.hud:message("ERŐSÍTÉS: még " .. n .. " ellenség érkezik" .. (st.reserve > 0 and (" (utána még " .. st.reserve .. ")") or ""), "warn", 4, "reinf")
		end
	end
	if runsWaves and not self.opts.tutorial and st.waveActive and not (st.reserve > 0) and #self:enemiesAlive() == 0 then
		st.waveActive, st.waveTimer = false, WAVE_DELAY
		if sc == "duel" then
			st.duelWins, st.duelStreak = st.duelWins + 1, st.duelStreak + 1
			self:addScore(300)
			self.career.data.duelWins = self.career.data.duelWins + 1
			self.hud:popup("+300 PÁRBAJ", "rgba(255,200,64,0.95)")
			self.hud:message("PÁRBAJ MEGNYERVE - a következő ellenfél pár másodperc múlva jön", "good", 4)
			if st.duelStreak >= 3 then self:medal("duel3") end
			st.waveTimer = 4
		else
			local bonus = 100 * st.wave
			self:addScore(bonus)
			self.hud:popup("+" .. bonus .. " HULLÁM", "rgba(255,200,64,0.95)")
			if sc == "survival" then
				st.waveTimer = 4
				self.hud:message("HULLÁM TELJESÍTVE - a következő mindjárt jön", "good", 4)
			else
				self.hud:message("HULLÁM TELJESÍTVE - leszállhatsz a bázison újrafegyverezni", "good", 5)
			end
		end
		self.career:best("bestScore", st.score)
		self.career:save()
	end
	if runsWaves and not self.opts.tutorial and self:wantWingman() and not self.wingman and airborne then self:spawnWingman() end
	if runsWaves and not self.opts.tutorial and not st.waveActive and airborne then
		st.waveTimer = st.waveTimer - dt
		if st.waveTimer <= 0 then self:spawnWave() end
	end
	-- arcade: every fired missile comes back on its rail RELOAD_TIME seconds later
	if self.opts.mode == "arcade" then
		for _, s in ipairs(p.stations) do
			if s.loaded then
				s.reload = nil
			else
				s.reload = (s.reload or RELOAD_TIME) - dt
				if s.reload <= 0 then
					s.loaded, s.reload = true, nil
					p:updateStores()
					if not p.selected or p:missileCount(p.selected) == 0 then p:select(s.key) end
					self.hud:message(s.key .. " ÚJRATÖLTVE", "good", 1.5, "reload")
				end
			end
		end
		-- the gun and the flare / chaff dispensers refill too (full in 10 s, after a 2 s pause)
		self.gunIdle = p.gun.firing and 0 or (self.gunIdle or 0) + dt
		self.cmIdle = p.cmHold and 0 or (self.cmIdle or 0) + dt
		local function refill(have, max, idle, key)
			if have >= max or idle < 2 then self[key] = 0; return have end
			self[key] = (self[key] or 0) + max / RELOAD_TIME * dt
			local n = math.floor(self[key])
			self[key] = self[key] - n
			return math.min(max, have + n)
		end
		p.gun.ammo = refill(p.gun.ammo, p.spec.gun.ammo, self.gunIdle, "ammoAcc")
		p.flares = refill(p.flares, p.spec.cm.flares, self.cmIdle, "flareAcc")
		p.chaff = refill(p.chaff, p.spec.cm.chaff, self.cmIdle, "chaffAcc")
	end
	if self.hangar:modOn("infcm") and not self.opts.benchmark then p.flares, p.chaff = p.spec.cm.flares, p.spec.cm.chaff end
	-- landing on the base (on the concrete, slowed down) rearms, refuels and repairs at once
	local needs = p.hp < p.spec.hp or p.fm.fuel < p.spec.internalFuel * 0.95 or p.gun.ammo < p.spec.gun.ammo or p.flares < p.spec.cm.flares
	if not needs then
		for _, s in ipairs(p.stations) do if not s.loaded then needs = true end end
	end
	if p.onGround and p.speed < 25 and needs and field:onPaved(p.pos.x, p.pos.y) then
		p:rearm()
		p.hp, p.burning = p.spec.hp, false
		p.fm.fuel = p.spec.internalFuel
		for _, s in ipairs(p.stations) do s.reload = nil end
		self.hud:message("ÚJRAFEGYVERZÉS, TANKOLÁS, JAVÍTÁS KÉSZ", "good", 4, "service")
		if not self.opts.tutorial then self:medal("home") end
	end
end

G.SPLASH = SPLASH
return G
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX42"><Properties><string name="Name">Mfd</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The cockpit displays (multi function displays): the port of web/js/mfd.js.  Pages like the real ones - radar (B-scope), situation map
-- (HSD), stores (SMS), engines and performance, RWR and the data line (DED / UFCD) - drawn on canvases the client gives to the displays
-- (display.g, a GuiCanvas of display.w x display.h pixels with the methods of shared/game/Hud.luau plus g:fillPoly(pts, c)).
-- Common subset of Lua 5.4 and Luau.
local M = require(script.Parent.Parent.sim.SimMath)
local Specs = require(script.Parent.Parent.sim.Specs)
local W = require(script.Parent.Parent.sim.Weapons)
local Flight = require(script.Parent.Parent.sim.Flight)
local V, sub, len, norm, dot, clamp, DEG = M.V, M.sub, M.len, M.norm, M.dot, M.clamp, M.DEG
local toLocal, headingDeg, angleBetween = M.toLocal, M.headingDeg, M.angleBetween
local sin, cos, floor, abs, min, max, sqrt, atan2, pi = math.sin, math.cos, math.floor, math.abs, math.min, math.max, math.sqrt, M.atan2, math.pi
local IR, ARH = Specs.IR, Specs.ARH
local STT, ACM, OFF = W.STT, W.ACM, W.OFF

local C = {
	bg = { 2, 8, 5, 1 }, g = { 82, 255, 115, 1 }, gd = { 44, 156, 71, 1 }, gdd = { 20, 69, 31, 1 }, w = { 234, 255, 234, 1 }, a = { 255, 194, 58, 1 },
	r = { 255, 75, 59, 1 }, c = { 98, 217, 255, 1 },
}
local PAGE_NAMES = { radar = "RDR", sa = "SA", sms = "SMS", eng = "ENG", rwr = "RWR" }

-- screen name -> size, pages and the key that cycles them (the screens of the browser's cockpit models)
local LAYOUTS = {
	f16 = {
		{ name = "mfd_l", w = 512, h = 512, pages = { "radar", "sms", "eng" }, key = "J" },
		{ name = "mfd_r", w = 512, h = 512, pages = { "sa", "eng", "sms" }, key = "K" },
		{ name = "ded", w = 512, h = 180, pages = { "ded" } },
		{ name = "rwr", w = 256, h = 256, pages = { "rwrmini" } },
	},
	fa18 = {
		{ name = "screen_ddi_l", w = 512, h = 512, pages = { "eng", "sms", "rwr" }, key = "J" },
		{ name = "screen_ddi_r", w = 512, h = 512, pages = { "radar", "sms" }, key = "K" },
		{ name = "screen_ampcd", w = 512, h = 512, pages = { "sa", "rwr" }, key = "L" },
		{ name = "screen_ufcd", w = 512, h = 420, pages = { "ded" } },
	},
	f15 = {
		{ name = "screen_lad_l", w = 512, h = 512, pages = { "radar", "sms" }, key = "J" },
		{ name = "screen_lad_r", w = 512, h = 512, pages = { "sa", "eng", "rwr" }, key = "K" },
		{ name = "screen_ufc", w = 512, h = 205, pages = { "ded" } },
	},
	f22 = {
		{ name = "screen_mfd_l", w = 512, h = 512, pages = { "eng", "rwr" }, key = "J" },
		{ name = "screen_mfd_r", w = 512, h = 512, pages = { "radar", "sms" }, key = "K" },
		{ name = "screen_pmfd", w = 512, h = 512, pages = { "sa", "rwr" }, key = "L" },
		{ name = "screen_mfd_c", w = 512, h = 512, pages = { "sms" } },
		{ name = "screen_ufd_l", w = 512, h = 394, pages = { "ded" } },
		{ name = "screen_ufd_r", w = 333, h = 256, pages = { "rwrmini" } },
	},
}
local SIDE_KEYS = { left = "J", right = "K", center = "L" }

local function bearingTo(ac, p) return ((atan2(p.x - ac.pos.x, p.y - ac.pos.y) / DEG) + 360) % 360 end
local function pad3(d) return string.format("%03d", floor(d + 0.5) % 360) end
local function km(m) return m >= 10000 and string.format("%.0f", m / 1000) or string.format("%.1f", m / 1000) end
local function fix(x, n) return string.format("%." .. (n or 1) .. "f", x) end
local function round(x) return floor(x + 0.5) end
local function padL(s, n) s = tostring(s); return string.rep(" ", max(0, n - #s)) .. s end
local function padR(s, n) s = tostring(s); return s .. string.rep(" ", max(0, n - #s)) end
local function count(t) local n = 0 for _ in pairs(t) do n = n + 1 end return n end

local D = {}
D.LAYOUTS = LAYOUTS

local Mfd = {}
Mfd.__index = Mfd

-- spec: the aircraft spec; returns the displays (a list of { name, w, h, pages, key, page }) - the client gives each one its canvas g
function D.new(spec)
	local self = setmetatable({}, Mfd)
	self.spec, self.time, self.gHi, self.gLo, self.dlzCache = spec, 0, 1, 1, {}
	self.list = {}
	local layout = LAYOUTS[spec.mfdLayout or ""] or LAYOUTS[spec.model] or LAYOUTS.f16
	for _, lay in ipairs(layout) do
		self.list[#self.list + 1] = { name = lay.name, w = lay.w, h = lay.h, pages = lay.pages, key = lay.key, page = 1 }
	end
	return self
end

function Mfd:cycle(side)
	for _, d in ipairs(self.list) do
		if d.key == SIDE_KEYS[side] and #d.pages > 1 then
			d.page = d.page % #d.pages + 1
			return PAGE_NAMES[d.pages[d.page]]
		end
	end
	return nil
end

-- every display with a canvas is drawn; info: { zone, base, wave, enemies }
function Mfd:update(dt, ac, world, info)
	self.time = self.time + dt
	if ac.alive then
		self.gHi = max(self.gHi, ac.fm.gLoad)
		self.gLo = min(self.gLo, ac.fm.gLoad)
	end
	for _, d in ipairs(self.list) do
		if d.g then self:draw(d, ac, world, info) end
	end
end

-- ----------------------------------------------------------------- primitives
local function text(g, t, x, y, col, size, align) g:text(t, x, y, col, size, align or "left") end
local function line(g, x1, y1, x2, y2, col, w)
	g:lineWidth(w or 2.5)
	g:line(x1, y1, x2, y2, col)
end
local function circle(g, x, y, r, col, w)
	g:lineWidth(w or 2.5)
	g:arc(x, y, r, col)
end
local function poly(g, pts, col, fill, w)
	if fill then g:fillPoly(pts, col)
	else
		g:lineWidth(w or 2.5)
		for i = 1, #pts do
			local a, b = pts[i], pts[i % #pts + 1]
			g:line(a[1], a[2], b[1], b[2], col)
		end
	end
end
local function box(g, x, y, w, h, col, lw)
	g:lineWidth(lw or 2.5)
	g:strokeRect(x, y, w, h, col)
end
local function dashedLine(g, x1, y1, x2, y2, col, w, on, off)
	g:lineWidth(w or 2.5)
	g:dashed(x1, y1, x2, y2, col, on, off)
end

function Mfd:draw(d, ac, world, info)
	local g, Wd, H = d.g, d.w, d.h
	g:fillRect(0, 0, Wd, H, C.bg)
	if not ac.alive then
		text(g, "NO DATA", Wd / 2, H / 2, C.gd, round(H / 8), "center")
		return
	end
	local page = d.pages[d.page]
	self[page](self, g, Wd, H, ac, world, info, d)
	if #d.pages > 1 then self:osb(g, Wd, H, d) end
end

-- push-button labels along the bottom edge: the pages of this display, the shown one boxed
function Mfd:osb(g, Wd, H, d)
	local n = #d.pages
	local step = Wd / (n + 1)
	for i, p in ipairs(d.pages) do
		local x = step * i
		local active = i == d.page
		text(g, PAGE_NAMES[p], x, H - 18, active and C.w or C.gd, 24, "center")
		if active then box(g, x - 34, H - 34, 68, 32, C.w, 2) end
	end
	if d.key then text(g, d.key, Wd - 14, H - 18, C.gdd, 20, "right") end
end

-- ------------------------------------------------------------------ radar
function Mfd:radar(g, Wd, H, ac, world, info)
	local r = ac.radar
	local sp = r.spec
	local x0, x1, y0, y1 = 34, Wd - 74, 62, H - 150
	local cx, sw, sh = (x0 + x1) / 2, x1 - x0, y1 - y0
	local tgt = r.locked or r.pending or r.selected
	local scale = sp.searchRange > 80000 and 80000 or 40000
	if r.mode == ACM then scale = 20000
	elseif tgt then
		local dd = len(sub(tgt.pos, ac.pos))
		scale = 160000
		for _, s in ipairs({ 10000, 20000, 40000, 80000, 160000 }) do if dd < s * 0.85 then scale = s; break end end
	end
	text(g, r.mode == OFF and "RDR OFF" or r.mode, 14, 24, r.mode == STT and C.w or C.g, 28)
	text(g, (scale / 1000) .. " KM", Wd / 2 - 20, 24, C.g, 28, "center")
	text(g, string.match(sp.name, "APG%-%d+") or "RADAR", Wd - 14, 24, C.gd, 22, "right")
	-- scope frame, azimuth and range ticks
	box(g, x0, y0, sw, sh, C.gd, 2)
	local azMax = sp.scanAz * DEG
	local function toXY(az, dist) return cx + clamp(az / azMax, -1, 1) * sw / 2, y1 - min(dist / scale, 1) * sh end
	for _, az in ipairs({ -30, 0, 30 }) do
		local x = cx + az / sp.scanAz * sw / 2
		dashedLine(g, x, y0, x, y1, C.gdd, 2, 4, 10)
	end
	for k = 1, 3 do
		local y = y1 - sh * k / 4
		line(g, x0, y, x0 + 14, y, C.gd); line(g, x1 - 14, y, x1, y, C.gd)
	end
	text(g, tostring(scale / 2000), x0 + 18, y1 - sh / 2, C.gd, 20)
	if r.mode == OFF then text(g, "R = RADAR BE", cx, (y0 + y1) / 2, C.a, 30, "center")
	elseif r.mode == ACM then
		local w = sp.acmAz / sp.scanAz * sw / 2
		local y = y1 - min(sp.acmRange / scale, 1) * sh
		poly(g, { { cx - w, y1 }, { cx - w, y }, { cx + w, y }, { cx + w, y1 } }, C.a)
	elseif r.mode ~= STT then
		local x = cx + r.beamAz / azMax * sw / 2
		line(g, x, y1, x, y0, { 82, 255, 115, 0.35 }, 3)
	end
	-- own heading caret
	poly(g, { { cx, y1 + 4 }, { cx - 10, y1 + 20 }, { cx + 10, y1 + 20 } }, C.g)
	for t, c in pairs(r.contacts) do
		if t ~= r.locked then
			local x, y = toXY(c.az, c.range)
			local col = t.team == ac.team and C.c or C.g
			g:fillRect(x - 9, y - 9, 18, 18, col)
			local hl = toLocal(ac.quat, c.vel)
			local hn = sqrt(hl.x * hl.x + hl.y * hl.y)
			if hn > 1 then line(g, x, y, x + hl.x / hn * 30, y - hl.y / hn * 30, col) end
			text(g, string.format("%.0f", c.pos.z / 1000), x + 14, y + 16, C.gd, 20)
			if t == r.selected then box(g, x - 16, y - 16, 32, 32, C.w, 2) end
		end
	end
	if r.pending and floor(self.time * 8) % 2 == 0 then
		local az, _, dd = r:anglesTo(r.pending.pos)
		local x, y = toXY(az, dd)
		box(g, x - 20, y - 20, 40, 40, C.a, 3)
	end
	local lines
	if r.locked and r.trackPos then
		local az, _, dd = r:anglesTo(r.trackPos)
		local x, y = toXY(az, dd)
		local col = r.lostTime > 0 and C.a or C.w
		poly(g, { { x, y - 16 }, { x + 16, y }, { x, y + 16 }, { x - 16, y } }, col, true)
		local hl = toLocal(ac.quat, r.trackVel)
		local hn = sqrt(hl.x * hl.x + hl.y * hl.y)
		if hn > 1 then line(g, x, y, x + hl.x / hn * 44, y - hl.y / hn * 44, col, 3.5) end
		local t = r.locked
		local rel = sub(r.trackPos, ac.pos)
		local vc = -dot(sub(r.trackVel, ac.vel), norm(rel))
		local aspDeg = angleBetween(r.trackVel, sub(ac.pos, r.trackPos)) / DEG
		local side = toLocal(t.quat, sub(ac.pos, t.pos)).x >= 0 and "R" or "L"
		local tm = len(r.trackVel) / select(2, Flight.isa(r.trackPos.z))
		lines = {
			{ "STT  " .. km(dd) .. " KM   VC " .. (vc >= 0 and "+" or "") .. round(vc * 3.6), r.notched and C.a or C.w },
			{ "MAG " .. fix(r.trackPos.z / 1000) .. " KM  M" .. fix(tm, 2) .. "  ASP " .. round(aspDeg) .. side, C.g },
			{ "NCTR: " .. (t.spec.short or t.spec.name) .. (r.notched and "   NOTCH!" or r.lostTime > 0 and "   MEMÓRIA" or ""), (r.notched or r.lostTime > 0) and C.a or C.g },
		}
	else
		local n = 0
		for t in pairs(r.contacts) do if t.team ~= ac.team then n = n + 1 end end
		lines = {
			{ "CÉLOK: " .. n, C.g },
			{ r.mode == ACM and "ACM: CÉL AZ ORR ELÉ" or "T = LOCK   Y = KÖV. CÉL", r.mode == ACM and C.a or C.gd },
			{ r.selected and ("KIJELÖLT: " .. km(len(sub(r.selected.pos, ac.pos))) .. " KM  " .. fix(r.selected.pos.z / 1000) .. " KM MAG") or "", C.gd },
		}
	end
	for i, l in ipairs(lines) do text(g, l[1], 22, y1 + 40 + (i - 1) * 30, l[2], 24) end
	self:dlz(g, Wd, H, ac, x1 + 34, y0, y1)
end

-- launch zone of the selected missile against the locked target: Rmax, no-escape range, Rmin, the target
function Mfd:dlz(g, Wd, H, ac, x, y0, y1)
	local sp, r = ac.selectedSpec, ac.radar
	local t = r.mode == STT and r.locked or nil
	if sp and sp.guidance == IR and ac.irSeeker.locked and not ac.irSeeker.target.isFlare then t = ac.irSeeker.target end
	text(g, sp and (sp.guidance == IR and "9M" or "120") or "--", x, y0 - 18, C.g, 22, "center")
	if not sp or not t then return end
	local rel = sub(t.pos, ac.pos)
	local dd = len(rel)
	local closing = -dot(t.vel, norm(rel))
	local z = self.dlzCache[sp]
	if not z or self.time - z.time > 0.5 then
		local a, b = W.launchZone(sp, ac.speed, ac.pos.z, closing)
		z = { time = self.time, rmax = a, rne = b }
		self.dlzCache[sp] = z
	end
	local rmax, rne, rmin = z.rmax, z.rne, sp.minRange
	local scale = max(rmax * 1.25, dd * 1.05, 2000)
	local function ry(v) return y1 - (y1 - y0) * clamp(v / scale, 0, 1) end
	line(g, x, ry(rmin), x, ry(rmax), C.g, 4)
	for _, v in ipairs({ rmax, rmin }) do line(g, x - 12, ry(v), x + 12, ry(v), C.g, 3) end
	line(g, x - 18, ry(rne), x + 18, ry(rne), C.g, 3)
	local yy = ry(dd)
	local inRng = dd > rmin and dd < rmax
	poly(g, { { x - 30, yy - 11 }, { x - 14, yy }, { x - 30, yy + 11 } }, inRng and C.r or C.w, true)
	text(g, km(rmax), x, ry(rmax) - 18, C.gd, 20, "center")
	if inRng and floor(self.time * 4) % 2 == 0 then text(g, dd < rne and "NOESC" or "SHOOT", x, y1 + 24, C.r, 20, "center") end
end

-- ------------------------------------------------------- situation map
function Mfd:sa(g, Wd, H, ac, world, info)
	local hdg = atan2(ac.forward.x, ac.forward.y)
	local ch, sh = cos(hdg), sin(hdg)
	local cx, cy = Wd / 2, H * 0.66
	local enemies = {}
	for _, t in ipairs(world.aircraft) do if t.alive and t.team ~= ac.team then enemies[#enemies + 1] = t end end
	local nearest = math.huge
	for _, t in ipairs(enemies) do nearest = min(nearest, len(sub(t.pos, ac.pos))) end
	local toZone = info.zone and sqrt((info.zone.x - ac.pos.x) ^ 2 + (info.zone.y - ac.pos.y) ^ 2) or 0
	local range = 40000
	if nearest < 14000 then range = 20000 elseif nearest > 40000 and toZone > 38000 then range = 80000 end
	local k = (H * 0.58) / range
	local function toS(p)
		local rx, ry = p.x - ac.pos.x, p.y - ac.pos.y
		return cx + (rx * ch - ry * sh) * k, cy - (rx * sh + ry * ch) * k
	end
	-- (the display's frame clips what is drawn outside of it)
	circle(g, cx, cy, range * k, C.gd, 3); circle(g, cx, cy, range * k / 2, C.gd, 2.5)
	for a = 0, 330, 30 do
		local ang = a * DEG - hdg
		local r0 = range * k
		local r1 = r0 - (a % 90 ~= 0 and 10 or 18)
		line(g, cx + sin(ang) * r0, cy - cos(ang) * r0, cx + sin(ang) * r1, cy - cos(ang) * r1, C.gd, 2)
		if a % 90 == 0 then text(g, string.sub("ÉKDN", 1, 0) .. ({ "É", "K", "D", "N" })[a / 90 + 1], cx + sin(ang) * (r0 - 34), cy - cos(ang) * (r0 - 34), C.gd, 22, "center") end
	end
	if info.base then
		local bx, by = toS(info.base)
		circle(g, bx, by, info.base.r * k, { 98, 217, 255, 0.55 }, 2.5)
		g:fillRect(bx - 4, by - 16, 8, 32, C.c)
		text(g, "BÁZIS", bx + 12, by - 18, C.c, 20)
	end
	if info.zone then
		local zx, zy = toS(info.zone)
		circle(g, zx, zy, info.zone.r * k, { 255, 75, 59, 0.7 }, 3)
		text(g, "HARCI ZÓNA", zx, zy, { 255, 75, 59, 0.85 }, 20, "center")
	end
	-- contacts: radar tracks filled, the rest of the picture (datalink) hollow
	for _, t in ipairs(enemies) do
		local x, y = toS(t.pos)
		local th = atan2(t.forward.x, t.forward.y) - hdg
		local tri = {}
		for _, p in ipairs({ { 0, -14 }, { 10, 10 }, { -10, 10 } }) do
			tri[#tri + 1] = { x + p[1] * cos(th) - p[2] * sin(th), y + p[1] * sin(th) + p[2] * cos(th) }
		end
		local tracked = ac.radar.contacts[t] ~= nil or ac.radar.locked == t
		poly(g, tri, C.r, tracked)
		local vx, vy = sin(th), -cos(th)
		line(g, x + vx * 14, y + vy * 14, x + vx * 34, y + vy * 34, C.r, 2)
		text(g, string.format("%.0f", t.pos.z / 1000), x + 14, y + 14, C.r, 18)
		if ac.radar.locked == t then box(g, x - 20, y - 20, 40, 40, C.w, 2.5) end
	end
	-- missiles: ours cyan, the ones coming at us red
	local blink = floor(self.time * 6) % 2 == 0
	for _, m in ipairs(world.missiles) do
		if m.alive then
			local x, y = toS(m.pos)
			if m.shooter == ac then g:fillCircle(x, y, 5, C.c)
			elseif (m.guidedTarget == ac or m.intended == ac) and blink then text(g, "M", x, y, C.r, 26, "center") end
		end
	end
	-- RWR bearings on the outer ring
	for _, t in ipairs(ac.rwr.threats) do
		local r0 = range * k + 2
		local col = t.level == "launch" and C.r or t.level == "lock" and C.a or C.gd
		line(g, cx + sin(t.bearing) * r0, cy - cos(t.bearing) * r0, cx + sin(t.bearing) * (r0 - 24), cy - cos(t.bearing) * (r0 - 24), col, 5)
	end
	-- own aircraft
	poly(g, { { cx, cy - 18 }, { cx + 12, cy + 12 }, { cx, cy + 5 }, { cx - 12, cy + 12 } }, C.w, true)
	box(g, Wd / 2 - 46, 6, 92, 40, C.g, 2.5)
	text(g, pad3(headingDeg(ac.forward)), Wd / 2, 27, C.w, 30, "center")
	text(g, (range / 1000) .. " KM", 12, 27, C.gd, 22)
	text(g, #enemies .. " BANDITA", Wd - 12, 27, #enemies > 0 and C.r or C.gd, 22, "right")
	local rows = {}
	if info.zone then rows[#rows + 1] = { "ZÓNA " .. pad3(bearingTo(ac, info.zone)) .. "° " .. km(max(0, toZone - info.zone.r)) .. " KM", toZone < info.zone.r and C.r or C.a } end
	if info.base then rows[#rows + 1] = { "BÁZIS " .. pad3(bearingTo(ac, info.base)) .. "° " .. km(sqrt((info.base.x - ac.pos.x) ^ 2 + (info.base.y - ac.pos.y) ^ 2)) .. " KM", C.c } end
	for i, r in ipairs(rows) do text(g, r[1], i > 1 and Wd - 12 or 12, H - 76, r[2], 21, i > 1 and "right" or "left") end
end

-- ----------------------------------------------------------------- stores
function Mfd:sms(g, Wd, H, ac, world, info)
	local sp, sel = ac.spec, ac.selected
	text(g, "SMS", 14, 26, C.g, 30)
	box(g, Wd - 196, 8, 184, 36, C.g, 2.5)
	text(g, "MASTER ARM", Wd - 104, 27, C.w, 22, "center")
	-- planform from the spec's dimensions, stations at their real spanwise positions
	local span = sp.wingSpan
	local sx, cx, cy = (Wd - 60) / span, Wd / 2, 190
	local half = span / 2 * sx
	local lenPx = min(sp.length * sx * 0.62, 230)
	poly(g, { { cx, cy - lenPx * 0.62 }, { cx + 16, cy - lenPx * 0.3 }, { cx + half, cy + 18 }, { cx + half, cy + 34 }, { cx + 22, cy + 40 },
		{ cx + 70, cy + lenPx * 0.42 }, { cx + 16, cy + lenPx * 0.38 }, { cx, cy + lenPx * 0.42 }, { cx - 16, cy + lenPx * 0.38 },
		{ cx - 70, cy + lenPx * 0.42 }, { cx - 22, cy + 40 }, { cx - half, cy + 34 }, { cx - half, cy + 18 }, { cx - 16, cy - lenPx * 0.3 } }, C.gd)
	for _, st in ipairs(ac.stations) do
		local p = sp.stations[st.number]
		local x = cx + p[1] * sx
		local y = cy + 34 + (abs(p[1]) < 1.5 and 30 or 0)
		local is9 = st.spec.guidance == IR
		local col = not st.loaded and C.gdd or st.key == sel and C.w or C.g
		if st.loaded then g:fillRect(x - 15, y, 30, 54, col) else box(g, x - 15, y, 30, 54, col, 2) end
		text(g, is9 and "9" or "120", x, y + 70, st.loaded and col or C.gdd, is9 and 22 or 18, "center")
		text(g, tostring(st.number), x, y - 14, C.gd, 18, "center")
		if not st.loaded and st.reload ~= nil then text(g, tostring(math.ceil(st.reload)), x, y + 27, C.a, 18, "center") end
	end
	local rows = {}
	for _, key in ipairs(ac:weaponKeys()) do
		local total = 0
		for _, s in ipairs(ac.stations) do if s.key == key then total = total + 1 end end
		rows[#rows + 1] = { (key == sel and ">" or " ") .. " " .. padR(key, 9) .. " " .. ac:missileCount(key) .. " / " .. total, key == sel and C.w or C.g }
	end
	rows[#rows + 1] = { "  GUN " .. sp.gun.name .. "  " .. ac.gun.ammo .. " RDS", ac.gun.ammo > 0 and C.g or C.a }
	rows[#rows + 1] = { "  FLARE " .. ac.flares .. "   CHAFF " .. ac.chaff, ac.flares > 0 and C.g or C.a }
	local s = ac.selectedSpec
	local status, col = "", C.g
	if s and s.guidance == IR then
		local sk = ac.irSeeker
		status = sk.locked and "AIM-9M: LOCK" or sk.candidate and "AIM-9M: HŐFORRÁS (F)" or "AIM-9M: KERESÉS"
		col = sk.locked and C.w or sk.candidate and C.a or C.gd
	elseif s and s.guidance == ARH then
		local lock = ac.radar.mode == STT
		status = lock and "AIM-120A: RADAR LOCK OK" or "AIM-120A: NINCS LOCK (T)"
		col = lock and C.w or C.a
	end
	rows[#rows + 1] = { "  " .. status, col }
	for i, r in ipairs(rows) do text(g, r[1], 18, 318 + (i - 1) * 30, r[2], 23) end
end

-- ---------------------------------------------------- engines, fuel, performance
function Mfd:eng(g, Wd, H, ac, world, info)
	local fm, sp = ac.fm, ac.spec
	local n = sp.engines or 1
	local e = fm.engine
	local ab, dry = clamp((e - 1) / 0.1, 0, 1), min(e, 1)
	local rpm = e > 1 and 100 + 2 * ab or 64 + 36 * dry ^ 0.7
	local noz = e > 1 and 25 + 75 * ab or 8 + 30 * (1 - dry)
	local egt = 420 + 430 * dry ^ 1.6 + 40 * ab
	local title = "ENG  F110-GE-129"
	if n > 1 then title = ({ f22 = "ENG  F119-PW-100 ×2", f15 = "ENG  F110-GE-129 ×2" })[sp.id] or "ENG  F414-GE-400 ×2" end
	text(g, title, 14, 26, C.g, 26)
	local colW = n > 1 and 112 or 150
	for k = 0, n - 1 do
		local x, top, bh = 30 + k * colW, 64, 180
		text(g, n > 1 and ({ "BAL", "JOBB" })[k + 1] or "RPM", x + 30, top, C.gd, 20, "center")
		box(g, x + 10, top + 18, 40, bh, C.gd, 2)
		local f = clamp((rpm - 50) / 55, 0, 1)
		g:fillRect(x + 12, top + 20 + bh * (1 - f), 36, max(0, bh * f - 4), e > 1 and C.a or C.g)
		text(g, round(rpm) .. "%", x + 30, top + bh + 40, e > 1 and C.a or C.w, 24, "center")
		text(g, "NOZ " .. round(noz), x + 30, top + bh + 70, C.g, 19, "center")
	end
	local ff, thr = fm.fuelFlow * 3600 / n, fm.thrust / n / 1000
	local L = {
		{ "EGT " .. round(egt) .. "°C", egt > 870 and C.a or C.g },
		{ "FF  " .. round(ff) .. " KG/H" .. (n > 1 and " ×2" or ""), C.g },
		{ "THR " .. fix(thr) .. " KN" .. (n > 1 and " ×2" or ""), C.g },
		{ e > 1 and ("AB  " .. round(ab * 100) .. "%") or "AB  KI", e > 1 and C.a or C.gd },
	}
	local xl = n > 1 and 262 or 210
	for i, l in ipairs(L) do text(g, l[1], xl, 82 + (i - 1) * 34, l[2], 23) end
	local mass = fm.mass
	local tw = fm.thrust / (mass * 9.81)
	local ps = fm.vel.z + dot(fm.vel, fm.accel) / 9.81
	local toBase = info.base and sqrt((info.base.x - ac.pos.x) ^ 2 + (info.base.y - ac.pos.y) ^ 2) or 0
	local perKm = sp.fuelFlowDry * 0.35 / 0.23
	local bingo = toBase / 1000 * perKm + sp.internalFuel * 0.08
	local minutes = fm.fuelFlow > 0.01 and fm.fuel / fm.fuelFlow / 60 or 99
	local R = {
		{ "T/W " .. fix(tw, 2), tw >= 1 and C.w or C.g },
		{ "PS  " .. (ps >= 0 and "+" or "") .. round(ps) .. " M/S", ps >= 0 and C.g or C.a },
		{ "D   " .. string.format("%.0f", fm.drag / 1000) .. " KN", C.g },
		{ "M " .. fix(fm.mach, 2) .. "  " .. round(fm.ias * 3.6) .. " KM/H", C.g },
		{ "AOA " .. fix(fm.alpha / DEG) .. "° / " .. sp.alphaLimit .. "°", fm.alpha / DEG > sp.alphaLimit * 0.8 and C.a or C.g },
		{ "G " .. fix(fm.gLoad) .. "  (+" .. fix(self.gHi) .. " / " .. fix(self.gLo) .. ")", fm.gLoad > sp.gMax * 0.85 and C.a or C.g },
	}
	for i, l in ipairs(R) do text(g, l[1], xl, 222 + (i - 1) * 27, l[2], 22) end
	local fy = H - 112
	local frac = clamp(fm.fuel / sp.internalFuel, 0, 1)
	local low = fm.fuel < bingo
	box(g, 14, fy - 14, Wd - 28, 26, C.gd, 2)
	g:fillRect(16, fy - 12, (Wd - 32) * frac, 22, low and C.r or frac < 0.3 and C.a or C.g)
	text(g, "FUEL " .. round(fm.fuel) .. " KG   " .. (minutes < 99 and (floor(minutes) .. " PERC") or ""), 14, fy + 32, low and C.r or C.w, 23)
	text(g, "BINGO " .. round(bingo), Wd - 14, fy + 32, low and C.r or C.gd, 21, "right")
	text(g, "TÖMEG " .. fix(mass / 1000) .. " T", Wd - 14, 26, C.gd, 21, "right")
end

-- -------------------------------------------------------------------- RWR
function Mfd:rwr(g, Wd, H, ac, world, info, d, mini)
	local cx = Wd / 2
	local cy = mini and H / 2 or H * 0.42
	local R = mini and min(Wd, H) * 0.44 or Wd * 0.34
	circle(g, cx, cy, R, C.gd, mini and 2 or 2.5); circle(g, cx, cy, R * 0.5, C.gdd, 2)
	for k = 0, 11 do
		local a = k * pi / 6
		line(g, cx + sin(a) * R, cy - cos(a) * R, cx + sin(a) * R * 0.9, cy - cos(a) * R * 0.9, C.gd, 2)
	end
	poly(g, { { cx, cy - 10 }, { cx + 8, cy + 8 }, { cx - 8, cy + 8 } }, C.g)
	if not mini then text(g, "RWR  ALR-67", 14, 26, C.g, 26) end
	local blink = floor(self.time * 6) % 2 == 0
	for _, t in ipairs(ac.rwr.threats) do
		local rad, col = R * 0.8, C.g
		local skip = false
		if t.level == "launch" then
			rad, col = R * 0.3, C.r
			if not blink then skip = true end
		elseif t.level == "lock" then rad, col = R * 0.55, C.a end
		if not skip then
			local x, y = cx + sin(t.bearing) * rad, cy - cos(t.bearing) * rad
			text(g, t.symbol, x, y, col, mini and 26 or 34, "center")
			if t.level ~= "search" then circle(g, x, y, mini and 18 or 26, col, 3) end
		end
	end
	if mini then return end
	local rows = {}
	for _, e in ipairs(ac.rwr.incoming) do
		local m, dist = e.missile, e.dist
		local closing = dot(sub(m.vel, ac.vel), norm(sub(ac.pos, m.pos)))
		local tti = closing > 1 and dist / closing or nil
		rows[#rows + 1] = { "RAKÉTA " .. m.spec.name .. " " .. km(dist) .. " KM" .. ((tti ~= nil and tti < 60) and ("  " .. string.format("%.0f", tti) .. " S") or ""), C.r }
	end
	if #rows == 0 then
		local n = #ac.rwr.threats
		rows[1] = { n > 0 and (n .. " RADAR FIGYEL") or "NINCS FENYEGETÉS", n > 0 and C.a or C.gd }
	end
	rows[#rows + 1] = { "FLARE " .. ac.flares .. "   CHAFF " .. ac.chaff .. "   (X)", C.g }
	for i = 1, min(4, #rows) do text(g, rows[i][1], 18, H * 0.42 + R + 36 + (i - 1) * 30, rows[i][2], 22) end
end
function Mfd:rwrmini(g, Wd, H, ac, world, info, d) self:rwr(g, Wd, H, ac, world, info, d, true) end

-- ----------------------------------------------- data line (DED / UFCD)
function Mfd:ded(g, Wd, H, ac, world, info)
	local fm = ac.fm
	local rows = {}
	local toZone = info.zone and sqrt((info.zone.x - ac.pos.x) ^ 2 + (info.zone.y - ac.pos.y) ^ 2) or 0
	local toBase = info.base and sqrt((info.base.x - ac.pos.x) ^ 2 + (info.base.y - ac.pos.y) ^ 2) or 0
	local where = nil
	if info.base and toBase < info.base.r then where = { "BÁZIS: BIZTONSÁGI ZÓNA", C.c }
	elseif info.zone and toZone < info.zone.r then where = { "HARCI ZÓNÁBAN", C.r } end
	if info.zone then rows[#rows + 1] = { "ZÓNA " .. pad3(bearingTo(ac, info.zone)) .. "° " .. padL(km(max(0, toZone - info.zone.r)), 4) .. "  BÁZ " .. pad3(bearingTo(ac, info.base)) .. "° " .. km(toBase), C.g } end
	local perKm = ac.spec.fuelFlowDry * 0.35 / 0.23
	local bingo = toBase / 1000 * perKm + ac.spec.internalFuel * 0.08
	rows[#rows + 1] = { "FUEL " .. padL(round(fm.fuel), 5) .. "  BINGO " .. round(bingo), fm.fuel < bingo and C.r or C.g }
	local parts = {}
	for _, k in ipairs(ac:weaponKeys()) do parts[#parts + 1] = (k == "AIM-9M" and "9M" or "120") .. "×" .. ac:missileCount(k) end
	rows[#rows + 1] = { table.concat(parts, " ") .. "  GUN " .. ac.gun.ammo, C.g }
	rows[#rows + 1] = where or { "HULLÁM " .. (info.wave or 0) .. "  BANDITA " .. (info.enemies or 0), C.gd }
	if H > Wd * 0.6 then                       -- the Hornet's taller UFCD: flight data and fuel endurance too
		local minutes = fm.fuelFlow > 0.01 and floor(fm.fuel / fm.fuelFlow / 60) or 99
		table.insert(rows, 2, { "ALT " .. round(ac.pos.z) .. "  M" .. fix(fm.mach, 2) .. "  G" .. fix(fm.gLoad), C.w })
		table.insert(rows, 4, { "IDŐ " .. minutes .. " PERC  FF " .. round(fm.fuelFlow * 3600), C.g })
		rows[#rows + 1] = { "FLARE " .. ac.flares .. "  CHAFF " .. ac.chaff, C.gd }
	end
	local lh = H / (#rows + 0.4)
	local fs = min(floor(lh * 0.66), floor(Wd / 19))
	for i, r in ipairs(rows) do text(g, r[1], 12, lh * (i - 0.3), r[2], fs) end
end

return D
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX43"><Properties><string name="Name">Mission</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- A sortie of the war career: the jets of both sides in the sky of a front, your flight, the radio and the result for the war
-- (Campaign.luau).  The port of web/js/mission.js for the kinds 'sweep' (clear the sky of enemy fighters) and 'cap' (hold the area for
-- the time given).  The air policing (intercept) and the fighter school of the browser career are not in the Roblox version.
--  role: 'wing' (an AI lead flies ahead, you are number two) or 'lead' (you lead, your AI wingman follows your orders)
-- Written in the common subset of Lua 5.4 and Luau, so it is tested outside of Roblox (roblox/tests).
local M = require(script.Parent.Parent.sim.SimMath)
local Sim = require(script.Parent.Parent.sim.Sim)
local AI = require(script.Parent.Parent.sim.AI)
local Specs = require(script.Parent.Parent.sim.Specs)
local V, add, sub, mul, len, norm, clamp, DEG = M.V, M.add, M.sub, M.mul, M.len, M.norm, M.clamp, M.DEG
local atan2, rng = M.atan2, M.rng
local BANDITS = Specs.BANDITS

local Mission = {}
Mission.__index = Mission

local MAX_ACTIVE_RED, REINFORCE_GAP = 4, 90
local function copyVec(v) return V(v.x, v.y, v.z) end

-- m: { kind, role, playerType, blue = { { type, n, power, label } }, red = { { type, n, power } }, skill, minutes, title, front, bearing, callsign }
function Mission.new(g, m)
	local self = setmetatable({}, Mission)
	self.g, self.m = g, m
	self.t, self.over, self.result = 0, false, nil
	self.phase = "ingress"
	self.kills, self.blueLost, self.redLost = {}, {}, {}
	local f = g.terrain.airfield
	local r = rng(math.floor(g.rnd() * 1e9))
	self.rnd = r
	-- the fight: 24 km from the base, on the enemy's side of it
	local bearing = m.bearing or 60 * DEG
	local dir = norm(V(math.sin(bearing), math.cos(bearing), 0))
	local lim = g.terrain.half - 12000
	local P = V(clamp(f.x + dir.x * 24000, -lim, lim), clamp(f.y + dir.y * 24000, -lim, lim), 0)
	self.P = P
	self.dir = norm(sub(P, V(f.x, f.y, 0)), dir)
	self.area = { x = P.x, y = P.y, r = 20000, engage = 36000, safe = g.nav.base }
	g.nav.zone = { x = P.x, y = P.y, r = 20000, engage = 36000 }               -- the HUD's zone mark: the fight
	local p = g.player
	local start = add(P, mul(self.dir, -16000))
	local z = math.max(5000, g.terrain:height(start.x, start.y) + 1800)
	local hdg = atan2(self.dir.x, self.dir.y)
	-- an air start on the way to the fight
	local delta = V(start.x - p.pos.x, start.y - p.pos.y, z - p.pos.z)
	local fm = p.fm
	fm.onGround = false
	fm.pos = V(start.x, start.y, z)
	fm.vel = mul(V(math.sin(hdg), math.cos(hdg), 0), 230)
	fm.quat = M.qheading(hdg / DEG, 0)
	fm.gearDown, fm.gearPos = false, 0
	fm.groundZ = nil
	p.controls.throttle = 0.9
	fm.engine = 0.9
	if g.wingman and g.wingman.alive then
		local w = g.wingman
		w.fm.pos = add(w.fm.pos, delta)
		w.fm.vel = copyVec(fm.vel)
		w.fm.quat = fm.quat:clone()
	end
	if g.env.onTeleport then g.env.onTeleport() end
	g.radio.callsign = m.callsign or "VIPER 1-1"

	local side = V(self.dir.y, -self.dir.x, 0)
	self.side = side
	local function mk(spec, team, pos, heading, name)
		local loadout = (spec.proc or spec.internal or spec.id == "f16") and "default" or Specs.buildLoadout(spec, 2, 4).layout
		local ac = Sim.newAircraft(spec, name, team, pos, heading / DEG, 230,
			{ livery = "viper", missiles = Specs.missilesFor(spec, true), loadout = loadout, rnd = rng(math.floor(r() * 1e9)) })
		ac.specKey = spec.id
		g.world:addAircraft(ac)
		if g.env.onSpawn then g.env.onSpawn(ac, spec) end
		return ac
	end
	self.mk = mk
	-- your flight: the AI lead (you on its wing)
	if m.role == "wing" then
		local spec = BANDITS[m.leadType or m.playerType] or BANDITS.f16
		local lead = mk(spec, "blue", add(add(p.pos, add(mul(self.dir, 260), mul(side, -180))), V(0, 0, 20)), hdg, ((m.callsign or "VIPER 1-1"):gsub("-%d$", "-1")) .. " (vezér)")
		AI.newAIPilot(lead, "ace", self.area)
		lead.isLead = true
		self.lead = lead
		g.radio.callsign = (m.callsign or "VIPER 1-1"):gsub("-%d$", "-2")
	end
	-- more friendly flights (allies), on both sides of yours
	local k = 0
	for _, grp in ipairs(m.blue or {}) do
		for _ = 1, grp.n do
			k = k + 1
			local spec = BANDITS[grp.type] or BANDITS.f16
			local pos = add(add(p.pos, mul(side, ((k % 2 == 1) and 1 or -1) * (2500 + 1200 * math.floor(k / 2)))), mul(self.dir, -800 * math.floor(k / 2)))
			local ac = mk(spec, "blue", pos, hdg, string.format("%s %d (%s)", grp.label or "Szövetséges", k, spec.short))
			AI.newAIPilot(ac, m.allySkill or "normal", self.area)
			ac.power = grp.power
		end
	end
	-- the other side: at most 4 at once, the rest as reinforcements once the first group is thinned out
	self.red = {}
	local queue = {}
	for _, grp in ipairs(m.red or {}) do
		for _ = 1, grp.n do queue[#queue + 1] = grp end
	end
	self.reserveRed = {}
	for i = MAX_ACTIVE_RED + 1, #queue do self.reserveRed[#self.reserveRed + 1] = queue[i] end
	self.reinfT, self.redK = 0, 0
	for i = 1, math.min(MAX_ACTIVE_RED, #queue) do self:spawnRed(queue[i], 0) end
	self:say("awacs", self:briefLine(), 0.4)
	return self
end

function Mission:spawnRed(grp, back)
	local g, m, r = self.g, self.m, self.rnd
	self.redK = self.redK + 1
	local k = self.redK - 1
	local spec = BANDITS[grp.type] or BANDITS.su35
	local pos = add(add(self.P, mul(self.dir, 14000 + back + r() * 5000)), mul(self.side, ((k % 5) - 2) * 2600))
	pos.z = math.max(r() * 3000 + 4000, g.terrain:height(pos.x, pos.y) + 1500)
	local hdg = atan2(self.dir.x, self.dir.y) + math.pi
	local ac = self.mk(spec, "red", pos, hdg, string.format("%s %d", spec.short, self.redK))
	ac.power = grp.power
	AI.newAIPilot(ac, m.skill or "normal", self.area)
	self.red[#self.red + 1] = ac
	return ac
end

function Mission:say(who, text, delay) self.g.radio:say(who, text, delay or 0.4) end

function Mission:bearingTo(a)
	local p = self.g.player
	return string.format("%03d", math.floor(((atan2(a.pos.x - p.pos.x, a.pos.y - p.pos.y) / DEG) + 360) % 360 + 0.5) % 360)
end

function Mission:briefLine()
	local cs = self.g.radio.callsign
	local brg = string.format("%03d", math.floor(((atan2(self.P.x, self.P.y) / DEG) + 360) % 360 + 0.5) % 360)
	return string.format("%s, Magic: %d hostile%s, bullseye %s. %s Fence in.", cs, #self.red, #self.red > 1 and "s" or "", brg, self.m.kind == "cap" and "Hold the CAP." or "Clear the sky.")
end

function Mission:aliveReds()
	local out = {}
	for _, a in ipairs(self.red) do
		if a.alive then out[#out + 1] = a end
	end
	return out
end

function Mission:onEvent(kind, d)
	if self.over or kind ~= "kill" then return end
	local v = d.victim
	local g = self.g
	local id = v.specKey or (v.spec and (v.spec.model or v.spec.id))
	if v.team == "red" then
		self.redLost[#self.redLost + 1] = { type = id, power = v.power or self.m.foe }
		if d.killer == g.player then self.kills[#self.kills + 1] = v.spec.short end
		if self.lead and self.lead.alive and d.killer == self.lead then self:say("lead", "Splash one!", 0.2) end
	elseif v.team == "blue" then
		if v ~= g.player then self.blueLost[#self.blueLost + 1] = { type = id, power = v.power or self.m.power } end
		if v == self.lead then self:say("awacs", g.radio.callsign .. ", your lead is down! You have the flight.", 0.6) end
	end
end

function Mission:update(dt)
	if self.over then return end
	self.t = self.t + dt
	local g, m = self.g, self.m
	local p = g.player
	local reds = self:aliveReds()
	local near = 1e9
	for _, a in ipairs(reds) do near = math.min(near, len(sub(a.pos, p.pos))) end
	if self.phase == "ingress" and near < 32000 then
		self.phase = "merge"
		local cs = g.radio.callsign
		if m.role == "wing" then self:say("lead", string.format("%s, tally %d, engage! Two, cover me.", (cs:gsub("-%d$", "-1")), #reds))
		else self:say("awacs", string.format("%s, %d hostiles, %d miles, hot. Cleared to engage.", cs, #reds, math.floor(near / 1852 + 0.5))) end
	end
	if #self.reserveRed > 0 and self.phase ~= "ingress" then
		self.reinfT = self.reinfT + dt
		if #reds <= 1 or self.reinfT > REINFORCE_GAP then
			local n = math.min(#self.reserveRed, 3)
			for _ = 1, n do
				local grp = table.remove(self.reserveRed, 1)
				self:spawnRed(grp, 6000)
			end
			self.reinfT = 0
			self:say("awacs", string.format("%s, reinforcements: %d more hostile%s inbound, bearing %s.", g.radio.callsign, n, n > 1 and "s" or "", self:bearingTo(self.red[#self.red])))
		end
	end
	if #reds == 0 and #self.red > 0 and #self.reserveRed == 0 then
		self:say("awacs", g.radio.callsign .. ", picture clean. Good work, RTB.")
		self:finish(true)
		return
	end
	if m.kind == "cap" and self.t > (m.minutes or 8) * 60 then
		self:say("awacs", "CAP time complete, RTB.")
		self:finish(true)
		return
	end
	if self.t > (m.minutes or 12) * 60 + 300 then self:finish(m.kind == "cap") return end
	if not p.alive and not self.over then self:finish(false, "killed") end
	if p.ejected and not self.over then self:finish(false, "ejected") end
end

function Mission:finish(won, why)
	if self.over then return end
	self.over = true
	local g = self.g
	local p = g.player
	local lostOwn = p.ejected or not p.alive
	local blueLost = {}
	for _, e in ipairs(self.blueLost) do blueLost[#blueLost + 1] = e end
	if lostOwn then blueLost[#blueLost + 1] = { type = self.m.playerType, power = self.m.power } end
	self.result = {
		won = won, why = why, status = p.ejected and "ejected" or (not p.alive and "shot_down" or "ok"), kills = #self.kills, killTypes = self.kills,
		blueLost = blueLost, redLost = self.redLost, time = self.t,
	}
	g.hud:message(won and "KÜLDETÉS TELJESÍTVE – Enter: jelentés" or "KÜLDETÉS VÉGE – Enter: jelentés", won and "good" or "warn", 6, "mission")
	g.state.subBanner = "Enter: jelentés (debriefing)"
end

-- Enter after the mission: the report
function Mission:leave()
	if self.left then return end
	self.left = true
	if not self.result then self:finish(false, "abort") end
	if self.g.env.onMissionEnd then self.g.env.onMissionEnd(self.result, self.m) end
end

-- the HUD's line under the top
function Mission:line()
	local m = self.m
	local reds = #self:aliveReds()
	local total = #self.red + #self.reserveRed
	local head = (m.title or "BEVETÉS"):upper()
	if m.kind == "cap" then
		return string.format("%s · CAP %d s · ellenség %d", head, math.max(0, math.floor((m.minutes or 8) * 60 - self.t)), reds)
	end
	return string.format("%s · ellenség %d/%d · lelövéseid %d", head, reds + #self.reserveRed, total, #self.kills)
end

return Mission
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX44"><Properties><string name="Name">Net</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Playing together: the port of the idea of web/js/net.js (every player flies their own jet in their own simulation and sees the others as
-- "ghost" aircraft that follow the packets they send) extended to a room of up to 20 players and a shared enemy:
--   * every player is the authority of their own jet (position, damage, death),
--   * in a co-op room the room's host runs the enemy AI and sends its state; the others see the enemies as ghosts,
--   * guns: the shooter finds the hit and tells the victim's machine how much damage ("dmg"); missiles: the launch is sent ("launch") and
--     every machine flies its own copy of the missile, but only the one that hits its own jet / its own AI hurts it,
--   * kills are announced to everybody ("kill").
-- The session knows nothing about Roblox: bus = { send(msg), clock() -> seconds, userId, name, team ("blue" / "red"), isHost() -> bool }.
-- Common subset of Lua 5.4 and Luau.
local M = require(script.Parent.Parent.sim.SimMath)
local Sim = require(script.Parent.Parent.sim.Sim)
local Weapons = require(script.Parent.Parent.sim.Weapons)
local Specs = require(script.Parent.Parent.sim.Specs)
local V, copy = M.V, M.copy
local exp, floor, sqrt = math.exp, math.floor, math.sqrt

local N = {}

local function r1(x) return floor(x * 10 + 0.5) / 10 end
local function r3(x) return floor(x * 1000 + 0.5) / 1000 end

-- the jet's state as a packet (positions to the decimetre, the rest rounded)
function N.snapshot(ac)
	local p, v, q, c = ac.pos, ac.vel, ac.quat, ac.controls
	return {
		t = "s", p = { r1(p.x), r1(p.y), r1(p.z) }, v = { floor(v.x + 0.5), floor(v.y + 0.5), floor(v.z + 0.5) },
		q = { r3(q.x), r3(q.y), r3(q.z), r3(q.w) }, c = { r3(c.pitch), r3(c.roll), r3(c.yaw) }, e = r3(ac.fm.engine), g = ac.fm.gearDown and 1 or 0,
		hp = floor(ac.hp), al = ac.alive and 1 or 0, bn = ac.burning and 1 or 0, cr = ac.crashed and 1 or 0, gn = (ac.gun.firing and ac.alive) and 1 or 0,
		ej = ac.ejected and 1 or 0, fl = ac.flares, ld = N.loadedMask(ac),
	}
end

-- which stations still hold a missile: "1011" (in the order of ac.stations) - the rear seat's copy of the jet needs it
function N.loadedMask(ac)
	local t = {}
	for i, st in ipairs(ac.stations) do t[i] = (st.loaded and not st.launch) and "1" or "0" end
	return table.concat(t)
end

-- ------------------------------------------------------------------ the ghost's pilot
local Ghost = {}
Ghost.__index = Ghost
local function newGhostPilot(ac, clock)
	local self = setmetatable({}, Ghost)
	self.ac, self.clock, self.fresh = ac, clock, true
	self.target = M.Q()
	self.snap = nil
	ac.pilot, ac.ghost = self, true
	return self
end
function Ghost:receive(s)
	local q = s.q
	self.target.x, self.target.y, self.target.z, self.target.w = q[1], q[2], q[3], q[4]
	self.snap = { p = s.p, v = s.v, c = s.c, e = s.e, g = s.g, at = self.clock() }
	if self.ac.slave then N.applyExtras(self.ac, s) end
end
function Ghost:think() end
function Ghost:fly(dt)
	local s, ac = self.snap, self.ac
	if not s then return end
	local fm = ac.fm
	local age = math.min(self.clock() - s.at, 0.4)
	local tx, ty, tz = s.p[1] + s.v[1] * age, s.p[2] + s.v[2] * age, s.p[3] + s.v[3] * age
	local dx, dy, dz = tx - fm.pos.x, ty - fm.pos.y, tz - fm.pos.z
	local far = sqrt(dx * dx + dy * dy + dz * dz) > 300
	local k = (self.fresh or far) and 1 or 1 - exp(-dt * 12)
	fm.pos.x, fm.pos.y, fm.pos.z = fm.pos.x + dx * k, fm.pos.y + dy * k, fm.pos.z + dz * k
	-- the attitude: a normalised linear blend towards the packet's quaternion (the short way round)
	local q, t = fm.quat, self.target
	local d = q.x * t.x + q.y * t.y + q.z * t.z + q.w * t.w
	local sg = d < 0 and -1 or 1
	q.x, q.y, q.z, q.w = q.x + (t.x * sg - q.x) * k, q.y + (t.y * sg - q.y) * k, q.z + (t.z * sg - q.z) * k, q.w + (t.w * sg - q.w) * k
	q:normalize()
	fm.vel.x, fm.vel.y, fm.vel.z = s.v[1], s.v[2], s.v[3]
	fm.engine = s.e
	ac.controls.pitch, ac.controls.roll, ac.controls.yaw, ac.controls.throttle = s.c[1], s.c[2], s.c[3], s.e
	fm.gearDown, fm.gearPos, fm.onGround = s.g == 1, s.g == 1 and 1 or 0, false
	self.fresh = false
end
N.GhostPilot = Ghost

-- the rear seat's copy of the pilot's jet: follows the packets like a ghost, but its sensors run and nothing can hurt it here
function N.applyExtras(ac, s)
	if s.fl then ac.flares = s.fl end
	if s.ld then
		for i, st in ipairs(ac.stations) do
			if st.loaded and string.sub(s.ld, i, i) == "0" then st.loaded = false end
			if not st.loaded and string.sub(s.ld, i, i) == "1" then st.loaded = true end
		end
		ac:updateStores()
		if ac.selected and ac:missileCount(ac.selected) == 0 then ac:afterLaunch() end
	end
end
function N.makeSlave(ac, clock)
	newGhostPilot(ac, clock)
	ac.slave = true
	ac.takeDamage = function() end
	ac.kill = function() end
	ac.crash = function() end
	return ac
end

local function specOf(key)
	return Specs.AIRCRAFT[key] or Specs.TRAINERS[key] or Specs.BANDITS[key]
end

local function isGunWeapon(w)
	return w ~= nil and Specs.WEAPON_CLASS[w] == nil and w ~= "crash" and w ~= "tailstrike" and w ~= "AIM-9M" and w ~= "AIM-120A"
end

-- ------------------------------------------------------------------ the session
local Session = {}
Session.__index = Session

-- match: the Match (its world, player and state are read all the time: a new world replaces the old one after a restart)
function N.new(match, bus)
	local self = setmetatable({}, Session)
	self.match, self.bus = match, bus
	self.wsoOf = match.opts.wsoOf                    -- a number: this machine sits in the rear seat of that player's jet (match.player is its copy)
	self.myId = "u" .. tostring(self.wsoOf or bus.userId)
	self.humans = {}                   -- id -> ghost of another player
	self.enemies = {}                  -- id -> ghost of the host's AI jets (guests only)
	self.local_ = {}                   -- id -> the host's own AI jets (so that messages can name them)
	self.nextEnemy = 1
	self.t = { snap = 0, hello = 0, en = 0, st = 0, need = 0, host = 0, wso = 0 }
	self.pilotSeen, self.pilotGone = bus.clock(), false
	self.wsoUser, self.wsoSeen = nil, 0             -- the pilot's side: who sits in my rear seat
	self.score = { blue = 0, red = 0 }
	self.wasHost = bus.isHost()
	self.hostNow = self.wasHost
	return self
end

function Session:world() return self.match.world end
function Session:clock() return self.bus.clock() end

-- the id of an aircraft in messages
function Session:idOf(ac)
	if not ac then return nil end
	if ac == self.match.player then return self.myId end
	if ac.netId then return ac.netId end
	return nil
end
local function newId(self, ac)
	local id = "e" .. self.nextEnemy
	self.nextEnemy = self.nextEnemy + 1
	ac.netId = id
	self.local_[id] = ac
	return id
end
function Session:byId(id)
	if id == nil then return nil end
	if id == self.myId then return self.match.player end
	return self.humans[id] or self.enemies[id] or self.local_[id]
end

local function dropGhost(self, g)
	g.alive, g.crashed, g.deathTime = false, true, self:world().time - 100
	local keep = {}
	for _, a in ipairs(self:world().aircraft) do if a ~= g then keep[#keep + 1] = a end end
	self:world().aircraft = keep
end

local function makeGhost(self, id, key, name, team, human, skin, outfit)
	local spec = specOf(key)
	if not spec then return nil end
	local w = self:world()
	local g = Sim.newAircraft(spec, name, team, V(0, 0, -5000), 0, 0, { livery = "viper", missiles = Specs.missilesFor(spec, not human), skin = skin, outfit = outfit })
	newGhostPilot(g, function() return self:clock() end)
	g.netId, g.human, g.specKey, g.tag = id, human, key, human and name or nil
	local bus = self.bus
	-- authority is the other machine: my guns tell it, my missiles are copied over there
	g.takeDamage = function(_, amount, source, weapon)
		if source == self.match.player and isGunWeapon(weapon) then bus.send({ t = "dmg", to = id, a = amount, w = weapon }) end
	end
	g.kill = function() end
	w:addAircraft(g)
	return g
end

-- a state packet of a player's jet applied to the copy of it in this world
local function applyState(self, g, m)
	local w = self:world()
	g.pilot:receive(m)
	g.lastSeen = self:clock()
	local wasCrashed = g.crashed
	g.hp, g.burning, g.ejected = m.hp, m.bn == 1, m.ej == 1
	g.gun.firing = m.gn == 1
	if m.al == 1 then g.alive, g.crashed = true, false
	else
		if g.alive then g.alive, g.deathTime = false, w.time end
		if m.cr == 1 and not wasCrashed then
			g.crashed = true
			g.fm.vel = V()
			w:emit("explosion", { pos = copy(g.pos), size = 2.5, ground = true })
		end
	end
end

-- ------------------------------------------------------------------ incoming
-- what comes from the other machines is not trusted: a malformed or absurd packet is dropped (the server only relays)
local function isNum(x, lo, hi) return type(x) == "number" and x == x and x >= lo and x <= hi end
local function isVec(v, n, lim)
	if type(v) ~= "table" then return false end
	for i = 1, n do
		if not isNum(v[i], -lim, lim) then return false end
	end
	return true
end
local function validSnap(m)
	return isVec(m.p, 3, 2e5) and isVec(m.v, 3, 3000) and isVec(m.q, 4, 2) and isVec(m.c, 3, 2) and isNum(m.e, 0, 2) and isNum(m.hp, -1e4, 1e4)
		and isNum(m.fl or 0, 0, 1000) and (m.ld == nil or (type(m.ld) == "string" and #m.ld <= 24))
end
local MAX_GUN_DAMAGE = 40                                       -- the most one packet may hurt a jet

function Session:onMessage(from, m)
	if type(m) ~= "table" or type(m.t) ~= "string" or type(from) ~= "number" then return end
	local t = m.t
	if t == "s" and not validSnap(m) then return end
	if t == "en" then
		if type(m.list) ~= "table" or #m.list > 40 then return end
		for _, e in ipairs(m.list) do
			if type(e) ~= "table" or not validSnap(e) or type(e.id) ~= "string" or type(e.a) ~= "string" then return end
		end
	end
	if t == "launch" and not (type(m.s) == "string" and type(m.k) == "string" and isVec(m.p, 3, 2e5) and isVec(m.v, 3, 3000) and isVec(m.d, 3, 2)) then return end
	if t == "dmg" and not (type(m.to) == "string" and isNum(m.a, 0, MAX_GUN_DAMAGE) and type(m.w) == "string") then return end
	if t == "kill" and type(m.v) ~= "string" then return end
	if t == "hello" and type(m.a) ~= "string" then return end
	if t == "st" and not (m.wave == nil or isNum(m.wave, 0, 1e4)) then return end
	local id = "u" .. tostring(from)
	local w = self:world()
	if self.wsoOf and id == self.myId then
		-- the pilot whose rear seat this is
		if t == "s" then
			applyState(self, self.match.player, m)
			self.pilotSeen = self:clock()
			return
		elseif t == "bye" then self.pilotGone = true; return
		elseif t == "hello" or t == "need" then return end                 -- (the jet itself is the copy; the rest - enemies, missiles - is as for anybody)
	end
	if t == "wsohello" then
		if m.to == self.bus.userId then
			if self.wsoUser ~= from then self.t.hello = 0 end
			self.wsoUser, self.wsoSeen, self.wsoName, self.wsoOutfit = from, self:clock(), m.n, m.pl
			self.match.wsoName = m.n
		end
		return
	elseif t == "wso" then
		if m.to == self.bus.userId and from == self.wsoUser then
			self.wsoSeen = self:clock()
			self.match:wsoDo(m.a, m.k, self:byId(m.tg), self.wsoName)
		end
		return
	end
	if t == "hello" then
		local g = self.humans[id]
		if g and g.specKey ~= m.a then dropGhost(self, g); self.humans[id] = nil; g = nil end
		if not g then self.humans[id] = makeGhost(self, id, m.a, m.n or "Pilóta", m.tm or "blue", true, m.sk, m.pl) end
		local gg = self.humans[id]
		if gg then
			gg.team, gg.name, gg.tag, gg.skin, gg.outfit = m.tm or "blue", m.n or gg.name, m.n or gg.tag, m.sk, m.pl
			gg.twoSeat, gg.wsoOutfit = m.ts == 1, m.wo
		end
	elseif t == "s" then
		local g = self.humans[id]
		if not g then
			if self:clock() - self.t.need > 1 then
				self.t.need = self:clock()
				self.bus.send({ t = "need" })
			end
			return
		end
		applyState(self, g, m)
	elseif t == "need" then
		self.t.hello = 0                                      -- answer with our hello next step
	elseif t == "bye" then
		local g = self.humans[id]
		if g then dropGhost(self, g); self.humans[id] = nil end
	elseif t == "en" then
		if self.hostNow then return end
		local seen = {}
		for _, e in ipairs(m.list) do
			seen[e.id] = true
			local g = self.enemies[e.id]
			if not g then
				g = makeGhost(self, e.id, e.a, e.n or "Bandita", "red", false)
				self.enemies[e.id] = g
			end
			if g then
				g.pilot:receive(e)
				g.lastSeen = self:clock()
				g.hp, g.burning = e.hp, e.bn == 1
				if e.al == 1 then g.alive, g.crashed = true, false
				elseif g.alive then g.alive, g.deathTime = false, w.time end
				if e.cr == 1 and not g.crashed then
					g.crashed = true
					w:emit("explosion", { pos = copy(g.pos), size = 2.5, ground = true })
				end
			end
		end
	elseif t == "st" then
		if self.hostNow then return end
		local st = self.match.state
		st.wave, st.waveActive = m.wave or st.wave, m.active == true
	elseif t == "launch" then
		local shooter = self:byId(m.s)
		if not shooter or (shooter == self.match.player and not self.wsoOf) then return end
		local spec = shooter.missiles and shooter.missiles[m.k] or Specs.MISSILES[m.k]
		if not spec then return end
		local target = self:byId(m.tg)
		local pos, vel, dir = V(m.p[1], m.p[2], m.p[3]), V(m.v[1], m.v[2], m.v[3]), V(m.d[1], m.d[2], m.d[3])
		local mis = Weapons.newMissile(spec, shooter, pos, vel, dir, w.rnd, target, nil)
		mis.replicated = true
		w:addMissile(mis)
	elseif t == "dmg" then
		local victim = self:byId(m.to)
		local source = self.humans[id]
		if victim and victim.alive and not victim.ghost then victim:takeDamage(m.a, source, m.w, w) end
	elseif t == "kill" then
		local victim, killer = self:byId(m.v), self:byId(m.k)
		if victim and victim ~= self.match.player and not (victim.netId and self.local_[victim.netId]) then
			victim.alive, victim.burning = false, true
			victim.deathTime = victim.deathTime or w.time
			w:emit("kill", { victim = victim, killer = killer, weapon = m.w })
		end
		if self.match:scenario() == "pvp" and victim then
			local team = killer and killer.team or nil
			if team and victim.team ~= team then self.score[team] = self.score[team] + 1 end
		end
	end
end

-- ------------------------------------------------------------------ the frame
local function remove(self, map)
	for id, g in pairs(map) do dropGhost(self, g); map[id] = nil end
end

function Session:step(dt)
	local match, bus, T = self.match, self.bus, self.t
	local now = self:clock()
	local p = match.player
	for k, v in pairs(T) do if k ~= "need" then T[k] = v - dt end end
	-- hosting changes (the host left): the new host takes over the enemies
	local host = bus.isHost()
	if host ~= self.hostNow then
		self.hostNow = host
		if host then remove(self, self.enemies); match:setGuest(false)
		else
			for _, a in ipairs(self:world().aircraft) do
				if a.team == "red" and not a.ghost and not a.human then a.alive, a.crashed, a.deathTime = false, true, self:world().time - 100 end
			end
			self.local_ = {}
			match:setGuest(true)
		end
	end
	if self.wsoOf then
		-- the rear seat: only says it is there; the jet is flown (and the packets come) from the pilot's machine
		if T.wso <= 0 then
			T.wso = 2
			bus.send({ t = "wsohello", to = self.wsoOf, n = bus.name, pl = bus.outfit })
		end
		for id, g in pairs(self.humans) do
			if g.lastSeen and now - g.lastSeen > 6 then dropGhost(self, g); self.humans[id] = nil end
		end
		for id, g in pairs(self.enemies) do
			if g.lastSeen and now - g.lastSeen > 1.5 then dropGhost(self, g); self.enemies[id] = nil end
		end
		if now - self.pilotSeen > 8 then self.pilotGone = true end
		return
	end
	if self.wsoUser and now - self.wsoSeen > 6 then
		self.wsoUser, self.wsoName, self.wsoOutfit, match.wsoName = nil, nil, nil, nil
		T.hello = 0
	end
	if T.hello <= 0 and p then
		T.hello = 3
		bus.send({ t = "hello", n = bus.name, a = p.specKey or "f16", tm = bus.team, sk = p.skin, pl = p.outfit,
			ts = p.twoSeat and 1 or 0, wo = self.wsoUser and self.wsoOutfit or nil })
	end
	if T.snap <= 0 and p then
		T.snap = 1 / 15
		bus.send(N.snapshot(p))
	end
	if host then
		if T.en <= 0 then
			T.en = 0.1
			local list = {}
			for _, a in ipairs(self:world().aircraft) do
				if a.team == "red" and not a.ghost and not a.human and (a.alive or not a.crashed) then
					local id = a.netId or newId(self, a)
					local s = N.snapshot(a)
					s.id, s.a, s.n, s.t = id, a.specKey or "f16", a.name, nil
					list[#list + 1] = s
				end
			end
			bus.send({ t = "en", list = list })
		end
		if T.st <= 0 then
			T.st = 1
			bus.send({ t = "st", wave = match.state.wave, active = match.state.waveActive })
		end
	end
	-- ghosts that went quiet
	for id, g in pairs(self.humans) do
		if g.lastSeen and now - g.lastSeen > 6 then dropGhost(self, g); self.humans[id] = nil end
	end
	for id, g in pairs(self.enemies) do
		if g.lastSeen and now - g.lastSeen > 1.5 then dropGhost(self, g); self.enemies[id] = nil end
	end
end

-- the world's events of the frame: what happened to what this machine is the authority of is told to the others
function Session:onEvents(events)
	if self.wsoOf then return end
	local match, bus = self.match, self.bus
	local p = match.player
	for _, e in ipairs(events) do
		local kind, d = e[1], e[2]
		if kind == "launch" then
			local m = d.missile
			local s = m.shooter
			if not m.replicated and s and not s.ghost and (s == p or s == match.wingman or (self.hostNow and s.team == "red")) then
				local sid = self:idOf(s) or (s.team == "red" and newId(self, s)) or nil
				if sid then
					local tg = m.guidedTarget or m.intended
					bus.send({ t = "launch", s = sid, k = (m.spec.guidance == Specs.IR) and "AIM-9M" or "AIM-120A", p = { r1(m.pos.x), r1(m.pos.y), r1(m.pos.z) }, v = { r1(m.vel.x), r1(m.vel.y), r1(m.vel.z) },
						d = { r3(m.dir.x), r3(m.dir.y), r3(m.dir.z) }, tg = tg and self:idOf(tg) or nil })
				end
			end
		elseif kind == "kill" then
			local v, k = d.victim, d.killer
			local mine = v == p or (self.hostNow and v.team == "red" and not v.ghost and not v.human)
			if mine then
				local vid = self:idOf(v) or (v.netId)
				if vid then bus.send({ t = "kill", v = vid, k = self:idOf(k), w = d.weapon }) end
				if match:scenario() == "pvp" and k and v.team ~= k.team then self.score[k.team] = self.score[k.team] + 1 end
			end
		end
	end
end

-- the rear seat gives the pilot's machine an order: a = "fire" (k: AIM-9M / AIM-120A), "flare", "mark"; target: an aircraft of this world
function Session:wsoSend(a, key, target)
	if not self.wsoOf then return end
	self.bus.send({ t = "wso", to = self.wsoOf, a = a, k = key, tg = target and target.netId or nil })
end

function Session:leave()
	if not self.wsoOf then self.bus.send({ t = "bye" }) end
	remove(self, self.humans)
	remove(self, self.enemies)
end

return N
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX45"><Properties><string name="Name">Race</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- Ring race (Gyűrűverseny), canyon run (Kanyonfutam) and tunnel run (Alagútfutam): the port of web/js/race.js, canyon.js and
-- tube.js without the pictures.  Every ring has c (centre), n (the way through), and the fields color / opacity / visible that
-- paint() sets and the client draws.  The course is worked out from the terrain itself, so times can be compared.
-- Common subset of Lua 5.4 and Luau (tested outside of Roblox).
local M = require(script.Parent.Parent.sim.SimMath)
local V, add, sub, mul, dot, len, norm = M.V, M.add, M.sub, M.mul, M.dot, M.len, M.norm
local sin, cos, atan, abs, max, min, sqrt, pi = math.sin, math.cos, math.atan, math.abs, math.max, math.min, math.sqrt, math.pi
local atan2 = M.atan2

local R = {}

local function wrap(a) return atan2(sin(a), cos(a)) end

-- ------------------------------------------------------------------ the ring race
local Race = {}
Race.__index = function(t, k)
	local m = Race[k]
	if m ~= nil then return m end
	if k == "target" then
		if t.finished then return nil end
		return t.rings[t.next + 1]
	end
	return nil
end
R.Race = Race

R.RINGS, R.STEP, R.RING_R = 18, 1600, 55

-- opts: rings (count), goal (where the course heads), best (the record so far), R (ring radius), onRecord(time)
function Race.new(terrain, start, heading, opts)
	local self = setmetatable({}, Race)
	Race.init(self, terrain, start, heading, opts)
	return self
end
function Race.init(self, terrain, start, heading, opts)
	opts = opts or {}
	self.terrain = terrain
	self.count = opts.rings or R.RINGS
	self.goal = opts.goal
	self.keep = opts.record ~= false
	self.R = opts.R or R.RING_R
	self.onRecord = opts.onRecord
	self.best = opts.best
	self.rings = self:layout(start, heading)
	self:reset()
end
function Race:layout(start, heading)
	local t = self.terrain
	local lim, out = t.half * 0.8, {}
	local p, h = V(start.x, start.y, 0), heading
	local function ground(x, y) return t:height(x, y) end
	local goal = self.goal or V(-12000, 9000, 0)
	for i = 0, self.count - 1 do
		local best = nil
		local want = 28 * sin(i * 0.9) * pi / 180
		local toGoal = atan2(goal.x - p.x, goal.y - p.y)
		for a = -50, 50, 10 do
			local hh = h + a * pi / 180
			local q = V(p.x + sin(hh) * R.STEP, p.y + cos(hh) * R.STEP, 0)
			local g, gm = ground(q.x, q.y), ground((p.x + q.x) / 2, (p.y + q.y) / 2)
			local score = (g + gm * 0.6) * 0.5 + abs(a * pi / 180 - want) * 260 + abs(wrap(hh - toGoal)) * 220
			if g < 15 then score = score + 900 end
			if abs(q.x) > lim or abs(q.y) > lim then score = score + 5000 end
			if not best or score < best.score then best = { score = score, q = q, hh = hh } end
		end
		local top = 0
		for k = 0, 6 do
			top = max(top, ground(p.x + (best.q.x - p.x) * k / 6, p.y + (best.q.y - p.y) * k / 6))
		end
		local c = V(best.q.x, best.q.y, max(top + 140, ground(best.q.x, best.q.y) + 110, 180))
		out[#out + 1] = { c = c, n = norm(V(best.q.x - p.x, best.q.y - p.y, 0)) }
		p, h = best.q, best.hh
	end
	return out
end
function Race:reset()
	self.next, self.time, self.running, self.finished, self.missTime = 0, 0, false, false, -9
	self:paint()
end
-- colours are sRGB hex numbers like the browser's
function Race:paint()
	for i, r in ipairs(self.rings) do
		local k = i - 1
		r.visible = k >= self.next
		r.color = k == self.next and 0xffc840 or k == self.next + 1 and 0x6bff85 or 0x9fb0bf
		r.opacity = k == self.next and 0.95 or k == self.next + 1 and 0.7 or 0.35
	end
end
-- returns "ring" | "finish" | "miss" | nil.  prev: where the aircraft was a step ago
function Race:update(dt, ac, prev)
	if self.finished then return nil end
	if self.running then self.time = self.time + dt end
	local r = self.rings[self.next + 1]
	local s0, s1 = dot(sub(prev, r.c), r.n), dot(sub(ac.pos, r.c), r.n)
	if s0 < 0 and s1 >= 0 then
		local hit = add(prev, mul(sub(ac.pos, prev), s0 / (s0 - s1)))
		local off = len(sub(hit, r.c))
		if off <= self.R then
			self.next = self.next + 1
			self.running = true
			if self.next >= #self.rings then
				self.finished = true
				self.record = (not self.best) or self.time < self.best
				if self.record and self.keep then
					self.best = self.time
					if self.onRecord then self.onRecord(self.time) end
				end
				self:paint()
				return "finish"
			end
			self:paint()
			return "ring"
		end
		if off < self.R * 2.5 then return "miss" end
	end
	return nil
end

-- m:ss.s
function R.fmtTime(s)
	if s == nil then return "--" end
	local m = math.floor(s / 60)
	local sec = string.format("%.1f", s % 60)
	if #sec < 4 then sec = "0" .. sec end
	return m .. ":" .. sec
end

-- ------------------------------------------------------------------ the canyon run
local Canyon = setmetatable({}, { __index = Race })
Canyon.__index = function(t, k)
	local m = Canyon[k]
	if m ~= nil then return m end
	if k == "finalTime" then return t.time + t.penalty end
	return getmetatable(Canyon).__index[k] or Race.__index(t, k)
end
R.Canyon = Canyon
R.CANYON_LIMIT, R.CANYON_GATES, R.CANYON_STEP, R.CANYON_FLOOR = 135, 30, 850, 75

function Canyon.new(terrain, opts)
	opts = opts or {}
	local self = setmetatable({}, Canyon)
	self.limit, self.penalty, self.exposure = R.CANYON_LIMIT, 0, 0
	self.canyonOnRecord = opts.onRecord
	Race.init(self, terrain, V(0, 0, 0), 0, { rings = R.CANYON_GATES + 2, R = 60, record = false, best = opts.best })
	local g = self.rings[self.targetIdx + 1]
	local tp = add(g.c, mul(g.n, 260))
	self.targetPos = V(tp.x, tp.y, terrain:height(tp.x, tp.y))
	self:reset()
	return self
end
function Canyon:layout()
	local t = self.terrain
	local function g(x, y) return t:height(x, y) end
	local lim = t.half * 0.82
	local GATES, STEP, FLOOR = R.CANYON_GATES, R.CANYON_STEP, R.CANYON_FLOOR
	-- 1. the deepest gorge: the point with the most relief around it
	local best = nil
	local x = -lim
	while x <= lim do
		local y = -lim
		while y <= lim do
			local h = g(x, y)
			if h >= 25 then
				local top = h
				for a = 0, 7 do
					top = max(top, g(x + cos(a * pi / 4) * 2400, y + sin(a * pi / 4) * 2400))
				end
				local score = top - h - max(0, h - 600) * 0.2
				if not best or score > best.score then best = { score = score, x = x, y = y, h = h } end
			end
			y = y + 800
		end
		x = x + 800
	end
	local function follow(p0, h0, n)
		local out, p, h, cost = {}, V(p0.x, p0.y, 0), h0, 0
		for _ = 1, n do
			local pick = nil
			for a = -24, 24, 4 do
				local hh = h + a * pi / 180
				local q = V(p.x + sin(hh) * STEP, p.y + cos(hh) * STEP, 0)
				local gq, gm = g(q.x, q.y), g((p.x + q.x) / 2, (p.y + q.y) / 2)
				local sx, sy = cos(hh) * 220, -sin(hh) * 220
				local wall = min(g(q.x + sx, q.y + sy), g(q.x - sx, q.y - sy)) - gq
				local score = gq + gm * 0.5 + abs(a) * 1.4 - min(wall, 300) * 0.35
				if gq < 15 then score = score + 800 end
				if abs(q.x) > lim or abs(q.y) > lim then score = score + 6000 end
				if not pick or score < pick.score then pick = { score = score, q = q, hh = hh, gq = gq } end
			end
			cost = cost + pick.gq
			out[#out + 1] = pick
			p, h = pick.q, pick.hh
		end
		return { out = out, cost = cost }
	end
	-- 2. the direction along the gorge that is longest and lowest
	local line = nil
	for k = 0, 15 do
		local h0 = k * pi / 8
		local r = follow(best, h0, GATES)
		if not line or r.cost < line.cost then line = r end
	end
	local rings = {}
	local prev = V(best.x, best.y, 0)
	for _, s in ipairs(line.out) do
		rings[#rings + 1] = { c = V(s.q.x, s.q.y, s.gq + FLOOR), n = norm(V(s.q.x - prev.x, s.q.y - prev.y, 0)) }
		prev = s.q
	end
	-- 3. the target gate is the last gate; after it the pull-up over the ridge
	self.targetIdx = #rings - 1
	local last = rings[#rings]
	local fwd = last.n
	local base = V(last.c.x + fwd.x * 260, last.c.y + fwd.y * 260, 0)
	local climb = nil
	local hBase, zT = atan2(fwd.x, fwd.y), last.c.z
	for a = -70, 70, 10 do
		local hh = hBase + a * pi / 180
		local D = 2600
		local q = V(base.x + sin(hh) * D, base.y + cos(hh) * D, 0)
		local top = g(q.x, q.y)
		for k = 1, 8 do top = max(top, g(base.x + (q.x - base.x) * k / 8, base.y + (q.y - base.y) * k / 8)) end
		local z = top + 170
		local slope = (z - zT) / D
		local score = (slope > 0.84 and 1000 + slope * 100 or 0) - top + abs(a) * 0.8
		if not climb or score < climb.score then climb = { score = score, q = q, z = z, hh = hh } end
	end
	rings[#rings + 1] = { c = V(climb.q.x, climb.q.y, climb.z), n = norm(V(sin(climb.hh), cos(climb.hh), 0.2)) }
	return rings
end
function Canyon:reset()
	Race.reset(self)
	self.penalty, self.exposure, self.hit, self.warnT = 0, 0, false, 0
	self.targetVisible = true
end
function Canyon:paint()
	Race.paint(self)
	local t = self.rings[self.targetIdx + 1]
	if t and self.next <= self.targetIdx then
		t.color = self.next == self.targetIdx and 0xff3b2a or 0xb0463a
		t.opacity = self.next == self.targetIdx and 0.95 or 0.5
	end
	local c = self.rings[#self.rings]
	if c and self.next == #self.rings - 1 then c.color, c.opacity = 0x62d9ff, 0.95 end
end
-- "ring" | "target" | "finish" | "miss" | "radar" | nil
function Canyon:update(dt, ac, prev)
	local ev = Race.update(self, dt, ac, prev)
	if self.finished then
		if ev ~= "finish" then return nil end
		self.time = self.time + self.penalty                          -- the radar penalties count
		self.success = self.time <= self.limit
		self.record = self.success and ((not self.best) or self.time < self.best)
		if self.record then
			self.best = self.time
			if self.canyonOnRecord then self.canyonOnRecord(self.time) end
		end
		return "finish"
	end
	-- above 350 m the enemy radar sees you (not on the final climb)
	if self.running and self.next <= self.targetIdx then
		local agl = ac.pos.z - self.terrain:height(ac.pos.x, ac.pos.y)
		if agl > 350 then self.exposure = self.exposure + dt else self.exposure = max(0, self.exposure - dt) end
		if self.exposure > 4 then
			self.exposure = 0
			self.penalty = self.penalty + 5
			return "radar"
		end
	end
	if ev == "ring" and self.next - 1 == self.targetIdx then
		self.hit = true
		self.targetVisible = false
		return "target"
	end
	return ev
end

-- ------------------------------------------------------------------ the tunnel run
local Tube = setmetatable({}, { __index = Race })
Tube.__index = function(t, k)
	local m = Tube[k]
	if m ~= nil then return m end
	if k == "total" then return t.laps * t.count end
	if k == "lap" then return min(t.laps, math.floor(t.next / t.count) + 1) end
	if k == "target" then
		if t.finished then return nil end
		return t.rings[t.next % t.count + 1]
	end
	if k == "clock" then return t.time + t.penalty end
	return nil
end
R.Tube = Tube
R.TUBE_GATES, R.TUBE_LAPS, R.TUBE_R = 28, 3, 95
local SAMPLES, SHAPE_R = 360, 1500

-- centre: the middle of the circuit (x, y); opts.best / opts.bestLap / opts.onRecord(best, lap)
function Tube.new(terrain, centre, opts)
	opts = opts or {}
	local self = setmetatable({}, Tube)
	self.laps, self.limit = R.TUBE_LAPS, nil
	self.centre = centre
	self.bestLap = opts.bestLap
	self.tubeOnRecord = opts.onRecord
	Race.init(self, terrain, centre, 0, { rings = R.TUBE_GATES, R = 80, record = false, best = opts.best })
	self:reset()
	return self
end
function Tube:layout(centre)
	local t = self.terrain
	local N = SAMPLES
	local function shape(u) return SHAPE_R * (1 + 0.18 * sin(2 * u + 0.6) + 0.1 * sin(3 * u + 1.9)) end
	local flat = {}
	local top = 0
	for i = 0, N - 1 do
		local u = i / N * pi * 2
		local r = shape(u)
		local x, y = centre.x + sin(u) * r, centre.y - cos(u) * r
		flat[#flat + 1] = { x, y, u }
		for a = 0, 5 do
			top = max(top, t:height(x + cos(a * 1.047) * 120, y + sin(a * 1.047) * 120))
		end
	end
	local base = top + 240
	self.samples = {}
	for i, f in ipairs(flat) do self.samples[i] = V(f[1], f[2], base + 70 * sin(2 * f[3] + 1)) end
	self.lapLength = 0
	for i = 0, N - 1 do
		self.lapLength = self.lapLength + len(sub(self.samples[(i + 1) % N + 1], self.samples[i + 1]))
	end
	local out = {}
	for k = 0, self.count - 1 do
		local i = math.floor(k * N / self.count)
		local a, b = self.samples[(i + N - 1) % N + 1], self.samples[(i + 1) % N + 1]
		out[#out + 1] = { c = M.copy(self.samples[i + 1]), n = norm(sub(b, a)) }
	end
	return out
end
-- where the player starts: a little before the start gate, on the middle line, flying along it
function Tube:startPose(back)
	back = back or 550
	local N = SAMPLES
	local step = self.lapLength / N
	local i = (N - math.floor(back / step + 0.5)) % N
	local a, b = self.samples[i + 1], self.samples[(i + 3) % N + 1]
	local d = norm(sub(b, a))
	return { pos = M.copy(a), heading = atan2(d.x, d.y) / (pi / 180), dir = d }
end
function Tube:reset()
	Race.reset(self)
	self.next, self.penalty, self.outside, self.warnT = 0, 0, false, 0
	self.lapStart, self.lapTimes, self.lastLap, self.finalTime, self.success = 0, {}, nil, nil, true
	self:paint()
end
function Tube:paint()
	local P = #self.rings
	local cur = self.next % P
	for i, r in ipairs(self.rings) do
		local k = i - 1
		r.visible = true
		r.color = k == cur and 0xffc840 or k == (cur + 1) % P and 0x6bff85 or k == 0 and 0xfff2b0 or 0x9fb0bf
		r.opacity = k == cur and 0.95 or k == (cur + 1) % P and 0.7 or k == 0 and 0.6 or 0.3
	end
end
-- distance of a point from the middle line of the tube
function Tube:offAxis(p)
	local best = 1e18
	for _, s in ipairs(self.samples) do
		local d = (s.x - p.x) ^ 2 + (s.y - p.y) ^ 2 + (s.z - p.z) ^ 2
		if d < best then best = d end
	end
	return sqrt(best)
end
-- "ring" | "lap" | "finish" | "out" | nil
function Tube:update(dt, ac, prev)
	if self.finished then return nil end
	local ev = nil
	if self.running then self.time = self.time + dt end
	local P = self.count
	local r = self.rings[self.next % P + 1]
	local s0, s1 = dot(sub(prev, r.c), r.n), dot(sub(ac.pos, r.c), r.n)
	if s0 < 0 and s1 >= 0 then
		local hit = add(prev, mul(sub(ac.pos, prev), s0 / (s0 - s1)))
		if len(sub(hit, r.c)) <= self.R then
			self.next = self.next + 1
			self.running = true
			ev = "ring"
			if self.next % P == 0 then
				local t = self.clock
				self.lastLap = t - self.lapStart
				self.lapStart = t
				self.lapTimes[#self.lapTimes + 1] = self.lastLap
				if not self.bestLap or self.lastLap < self.bestLap then self.bestLap = self.lastLap end
				ev = "lap"
				if self.next >= self.total then
					self.finished = true
					self.finalTime = t
					self.record = (not self.best) or t < self.best
					if self.record then self.best = t end
					if self.tubeOnRecord then self.tubeOnRecord(self.best, self.bestLap) end
					self:paint()
					return "finish"
				end
			end
			self:paint()
		end
	end
	if self.running then
		local out = self:offAxis(ac.pos) > R.TUBE_R
		if out then
			self.penalty = self.penalty + dt
			self.warnT = self.warnT - dt
		end
		if out and not self.outside and self.warnT <= 0 then
			self.outside = true
			self.warnT = 3
			if not ev then ev = "out" end
		end
		if not out then self.outside = false end
	end
	return ev
end

return R
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX46"><Properties><string name="Name">Radio</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The radio: the port of web/js/radio.js (the calls and what the other side answers).  You talk to the tower, your wingman and
-- the AWACS with the real brevity words ("FOX TWO", "SPLASH", "BINGO" ...): type them, or pick one from the numbered list.  The
-- other side answers in the radio log (subtitles; Roblox cannot synthesise speech).  There is no speech recognition either.
-- The unidentified-intruder calls (interrogate, follow me ...) belong to the air-policing missions of the browser career and are left out.
-- Written in the common subset of Lua 5.4 and Luau, so it is tested outside of Roblox (roblox/tests).
local M = require(script.Parent.Parent.sim.SimMath)
local V, sub, len, norm, dot, DEG = M.V, M.sub, M.len, M.norm, M.dot, M.DEG
local atan2 = M.atan2

local Radio = {}
Radio.__index = Radio

-- id, what to say, other ways to say it, who to, the lesson that teaches it, what it means (Hungarian)
local CALLS = {
	-- tower
	{ id = "radio_check", say = "RADIO CHECK", alt = { "HOW DO YOU READ", "COMM CHECK" }, to = "tower", lesson = "radio1", hu = "rádiópróba – hallanak-e" },
	{ id = "request_taxi", say = "REQUEST TAXI", alt = { "READY TO TAXI", "TAXI" }, to = "tower", lesson = "radio1", hu = "gurulási engedélyt kérsz" },
	{ id = "ready_takeoff", say = "READY FOR TAKEOFF", alt = { "REQUEST TAKEOFF", "READY FOR DEPARTURE", "HOLDING SHORT", "READY" }, to = "tower", lesson = "radio1", hu = "felszállásra kész vagy, engedélyt kérsz" },
	{ id = "airborne", say = "AIRBORNE", alt = { "DEPARTING", "WHEELS UP" }, to = "tower", lesson = "radio1", hu = "a levegőben vagy" },
	{ id = "inbound", say = "INBOUND FOR LANDING", alt = { "REQUEST LANDING", "INBOUND", "RETURNING FOR LANDING", "FULL STOP" }, to = "tower", lesson = "radio2", hu = "leszállni jössz" },
	{ id = "gear_down", say = "GEAR DOWN", alt = { "THREE GREEN", "GEAR DOWN AND LOCKED" }, to = "tower", lesson = "radio2", hu = "a futómű kint és bezárva" },
	{ id = "clear_runway", say = "CLEAR OF RUNWAY", alt = { "RUNWAY VACATED", "CLEAR OF THE RUNWAY" }, to = "tower", lesson = "radio2", hu = "leszálltál, elhagytad a kifutót" },
	{ id = "emergency", say = "MAYDAY", alt = { "EMERGENCY", "PAN PAN" }, to = "tower", lesson = "radio2", hu = "vészhelyzet" },
	-- flight (between the lead and the wingman)
	{ id = "ack", say = "COPY", alt = { "TWO", "ROGER", "WILCO", "ACKNOWLEDGED", "AFFIRMATIVE" }, to = "flight", lesson = "radio3", hu = "vettem (a 2-es így nyugtáz: „TWO”)" },
	{ id = "visual", say = "VISUAL", alt = { "VISUAL ON LEAD", "I HAVE YOU" }, to = "flight", lesson = "radio3", hu = "látom a saját gépet (vezért / kísérőt)" },
	{ id = "blind", say = "BLIND", alt = { "NO VISUAL", "LOST YOU" }, to = "flight", lesson = "radio3", hu = "nem látom a saját gépet" },
	{ id = "tally", say = "TALLY", alt = { "TALLY HO", "TALLY BANDIT" }, to = "flight", lesson = "radio4", hu = "látom az ellenséget" },
	{ id = "no_joy", say = "NO JOY", alt = { "NO TALLY" }, to = "flight", lesson = "radio4", hu = "nem látom az ellenséget" },
	{ id = "fox2", say = "FOX TWO", alt = { "FOX 2" }, to = "flight", lesson = "radio4", hu = "hőkövető rakétát indítottam" },
	{ id = "fox3", say = "FOX THREE", alt = { "FOX 3" }, to = "flight", lesson = "radio4", hu = "aktív radaros rakétát indítottam" },
	{ id = "guns", say = "GUNS GUNS", alt = { "GUNS" }, to = "flight", lesson = "radio4", hu = "gépágyúval lövök" },
	{ id = "splash", say = "SPLASH ONE", alt = { "SPLASH", "KILL", "BANDIT DOWN" }, to = "flight", lesson = "radio4", hu = "lelőttem" },
	{ id = "defending", say = "DEFENDING", alt = { "DEFENSIVE", "MISSILE INBOUND", "SPIKED", "NOTCHING" }, to = "flight", lesson = "radio4", hu = "rakéta jön rám, védekezem" },
	{ id = "bingo", say = "BINGO", alt = { "BINGO FUEL", "JOKER" }, to = "flight", lesson = "radio5", hu = "kevés az üzemanyag – haza kell indulni" },
	{ id = "winchester", say = "WINCHESTER", alt = { "OUT OF MISSILES", "NO WEAPONS" }, to = "flight", lesson = "radio5", hu = "elfogyott a fegyver" },
	{ id = "rtb", say = "RTB", alt = { "RETURNING TO BASE", "RETURN TO BASE", "HEADING HOME" }, to = "flight", lesson = "radio5", hu = "visszatérek a bázisra" },
	-- orders to the wingman
	{ id = "engage", say = "ENGAGE", alt = { "CLEARED HOT", "ATTACK", "TWO ENGAGE", "ENGAGE BANDIT", "CLEARED TO ENGAGE" }, to = "wing", lesson = "radio6", hu = "parancs a kísérőnek: támadj" },
	{ id = "cover", say = "COVER ME", alt = { "COVER", "CHECK SIX", "CHECK MY SIX" }, to = "wing", lesson = "radio6", hu = "parancs: védd a hátamat" },
	{ id = "rejoin", say = "REJOIN", alt = { "FORM UP", "JOIN UP", "RETURN TO FORMATION" }, to = "wing", lesson = "radio6", hu = "parancs: gyere vissza alakzatba" },
	{ id = "break", say = "BREAK LEFT", alt = { "BREAK RIGHT", "BREAK" }, to = "wing", lesson = "radio6", hu = "figyelmeztetés: rakéta / ellenség – kitörés" },
	-- AWACS (the airborne radar: who is where)
	{ id = "picture", say = "PICTURE", alt = { "REQUEST PICTURE", "BOGEY DOPE", "DECLARE", "BRAA" }, to = "awacs", lesson = "radio5", hu = "hol vannak az ellenséges gépek? (irány, táv, magasság)" },
	{ id = "checking_in", say = "CHECKING IN", alt = { "ON STATION", "CHECK IN" }, to = "awacs", lesson = "radio5", hu = "bejelentkezel az AWACS-hoz" },
}
Radio.CALLS = CALLS

local NUM = { [0] = "ZERO", "ONE", "TWO", "THREE", "FOUR", "FIVE", "SIX", "SEVEN", "EIGHT", "NINE" }
local FIX = { FOCKS = "FOX", FOCUS = "FOX", FOXTROT = "FOX", TOO = "TWO", TO = "TWO", FOR = "FOUR", TALLEY = "TALLY", TELLY = "TALLY", TALLIES = "TALLY",
	SPLASHED = "SPLASH", BINGE = "BINGO", RTV = "RTB", ARE = "R", TEA = "T", BEE = "B", VISUALS = "VISUAL", PICTURES = "PICTURE",
	WINCHESTERS = "WINCHESTER", ENGAGED = "ENGAGE", ENGAGING = "ENGAGE", DEFENSIVE = "DEFENDING", GUN = "GUNS", TAXIING = "TAXI" }

-- "Fox 2!" -> "FOX TWO"
function Radio.normalise(text)
	local t = string.upper(tostring(text))
	t = string.gsub(t, "TAKE[%- ]?OFF", "TAKEOFF")
	t = string.gsub(t, "[^A-Z0-9 ]", " ")
	t = string.gsub(t, "%d", function(d) return " " .. NUM[tonumber(d)] .. " " end)
	local words = {}
	for w in string.gmatch(t, "%S+") do words[#words + 1] = FIX[w] or w end
	return table.concat(words, " ")
end
local normalise = Radio.normalise

-- does the phrase occur in the words (in order, other words allowed in between: callsigns, "tower", ...)?
local function occurs(words, phrase)
	local p = {}
	for w in string.gmatch(phrase, "%S+") do p[#p + 1] = w end
	local i = 1
	for _, w in ipairs(words) do
		if w == p[i] then
			i = i + 1
			if i > #p then return true end
		end
	end
	return false
end

-- -> the best matching call (the longest phrase wins: "FOX TWO" over "TWO"), or nil
function Radio.recognise(text, allowed)
	allowed = allowed or CALLS
	local words = {}
	for w in string.gmatch(normalise(text), "%S+") do words[#words + 1] = w end
	local best, bestLen = nil, 0
	for _, c in ipairs(allowed) do
		local phrases = { c.say }
		for _, a in ipairs(c.alt) do phrases[#phrases + 1] = a end
		for _, ph in ipairs(phrases) do
			local n = normalise(ph)
			if occurs(words, n) and #n > bestLen then best, bestLen = c, #n end
		end
	end
	return best
end

Radio.NAMES = { tower = "TORONY", awacs = "AWACS „MAGIC”", wing = "KÍSÉRŐ", lead = "VEZÉR", instructor = "OKTATÓ", you = "TE" }

local MAX_LOG = 5

-- g: the match (player, wingman, world, terrain, hud)
function Radio.new(g)
	local self = setmetatable({}, Radio)
	self.g = g
	self.log = {}                                       -- { who, text, t } newest last
	self.version = 0                                    -- grows whenever the log changes
	self.listeners = {}
	self.callsign = (g.opts and g.opts.callsign) or "VIPER 1-1"
	self.unlocked = nil                                 -- nil: everything (free play); else a set of lesson ids
	self.cleared = { taxi = false, takeoff = false, land = false }
	self.time, self.pending = 0, {}
	return self
end

function Radio:reset()
	self.cleared = { taxi = false, takeoff = false, land = false }
end

function Radio:onCall(fn)
	table.insert(self.listeners, fn)
	return function()
		for i, f in ipairs(self.listeners) do
			if f == fn then table.remove(self.listeners, i) break end
		end
	end
end

-- the calls that make sense right now
function Radio:available()
	local g, p = self.g, self.g.player
	local out = {}
	for _, c in ipairs(CALLS) do
		local ok = true
		if self.unlocked and not self.unlocked[c.lesson] then ok = false end
		if c.to == "wing" then ok = ok and g.wingman ~= nil and g.wingman.alive end
		if c.to == "awacs" then ok = ok and (p == nil or not p.onGround) end
		if ok then out[#out + 1] = c end
	end
	return out
end

-- a line in the radio log; delay: seconds until it appears
function Radio:say(who, text, delay)
	if delay and delay > 0 then
		self.pending[#self.pending + 1] = { t = self.time + delay, who = who, text = text }
		return
	end
	self.log[#self.log + 1] = { who = who, text = text, t = self.time }
	while #self.log > MAX_LOG do table.remove(self.log, 1) end
	self.version = self.version + 1
end

function Radio:update(dt)
	self.time = self.time + dt
	local i = 1
	while i <= #self.pending do
		local l = self.pending[i]
		if l.t <= self.time then
			table.remove(self.pending, i)
			self:say(l.who, l.text)
		else
			i = i + 1
		end
	end
end

local PREFIX = { tower = "TOWER, ", awacs = "MAGIC, ", wing = "TWO, ", flight = "" }

-- text: what the player typed / picked.  -> true if understood
function Radio:transmit(text, how)
	if not text or string.match(text, "^%s*$") then return false end
	local call = Radio.recognise(text, self:available())
	local hud = self.g.hud
	if not call then
		local locked = self.unlocked and Radio.recognise(text, CALLS)
		self:say("you", string.upper(text))
		hud:message(locked and ("Ezt még nem tanultad: " .. locked.say .. " (" .. locked.hu .. ")") or "Ezt nem értik a rádión – nézd meg a listát (I)", "warn", 3, "mic")
		return false
	end
	self:say("you", (PREFIX[call.to] or "") .. self.callsign .. ", " .. call.say)
	self:respond(call)
	for _, fn in ipairs(self.listeners) do fn(call, how) end
	return true
end

local function rdelay() return 0.9 + math.random() * 0.7 end

function Radio:homeBearing()
	local p, f = self.g.player, self.g.terrain.airfield
	if not p then return "000" end
	return string.format("%03d", math.floor(((atan2(f.x - p.pos.x, f.y - p.pos.y) / DEG) + 360) % 360 + 0.5) % 360)
end

-- BRAA: bearing, range (nautical miles), altitude (angels = thousands of feet) and aspect of the nearest group
function Radio:picture(short)
	local g, p, cs = self.g, self.g.player, self.callsign
	if not p then return cs .. ", Magic, picture clean." end
	local foes = {}
	for _, a in ipairs(g.world.aircraft) do
		if a.alive and a.team ~= p.team then foes[#foes + 1] = a end
	end
	if #foes == 0 then return cs .. ", Magic, picture clean." end
	local nearest = foes[1]
	for _, a in ipairs(foes) do
		if len(sub(a.pos, p.pos)) < len(sub(nearest.pos, p.pos)) then nearest = a end
	end
	local group = 0
	for _, a in ipairs(foes) do
		if len(sub(a.pos, nearest.pos)) < 8000 then group = group + 1 end
	end
	local rel = sub(nearest.pos, p.pos)
	local brg = math.floor(((atan2(rel.x, rel.y) / DEG) + 360) % 360 + 0.5) % 360
	local nm = math.max(1, math.floor(len(rel) / 1852 + 0.5))
	local angels = math.max(1, math.floor(nearest.pos.z * 3.281 / 1000 + 0.5))
	local asp = dot(norm(nearest.vel), norm(sub(p.pos, nearest.pos)))
	local aspect = asp > 0.7 and "hot" or (asp < -0.5 and "cold" or "flanking")
	local count = ""
	if group > 1 then count = (group == 2 and "two contacts" or (group .. " contacts")) .. ", " end
	local more = ""
	if #foes > group and not short then more = " " .. (#foes - group) .. " more further out." end
	return string.format("%s, Magic, %s BRAA %03d, %d miles, angels %d, %s, %shostile.%s", cs, #foes > group and "lead group" or "single group", brg, nm, angels, aspect, count, more)
end

-- what the other side answers
function Radio:respond(call)
	local g, p, cs = self.g, self.g.player, self.callsign
	local rwy = "36"
	local function R(who, text) self:say(who, text, rdelay()) end
	local id = call.id
	if id == "radio_check" then R("tower", cs .. ", Tower, loud and clear.")
	elseif id == "request_taxi" then
		self.cleared.taxi = true
		R("tower", cs .. ", taxi to runway " .. rwy .. ", hold short.")
	elseif id == "ready_takeoff" then
		-- in training the order matters: taxi clearance first
		if self.unlocked and not self.cleared.taxi and p and p.onGround then R("tower", cs .. ", request taxi first.")
		else
			self.cleared.takeoff = true
			R("tower", cs .. ", wind calm, runway " .. rwy .. ", cleared for takeoff.")
		end
	elseif id == "airborne" then R("tower", cs .. ", radar contact, climb and maintain angels one five. Contact Magic.")
	elseif id == "inbound" then R("tower", cs .. ", runway " .. rwy .. ", report gear down.")
	elseif id == "gear_down" then
		if p and p.fm.gearPos > 0.9 then
			self.cleared.land = true
			R("tower", cs .. ", check gear down, wind calm, runway " .. rwy .. ", cleared to land.")
		else R("tower", cs .. ", negative, your gear is not down! Go around.") end
	elseif id == "clear_runway" then R("tower", cs .. ", taxi to parking. Welcome home.")
	elseif id == "emergency" then R("tower", cs .. ", roger your mayday, runway " .. rwy .. " is yours, crash crews standing by.")
	elseif id == "picture" then R("awacs", self:picture(false))
	elseif id == "checking_in" then R("awacs", cs .. ", Magic, radar contact. " .. self:picture(true))
	elseif id == "engage" or id == "cover" or id == "rejoin" or id == "break" then
		local w = g.wingman
		if not w or not w.alive then R("awacs", cs .. ", your wingman is not on frequency.")
		else
			if w.pilot and w.pilot.order ~= nil then w.pilot.order = id == "break" and "engage" or id end
			R("wing", ({ engage = "Two, engaging.", cover = "Two, in your six.", rejoin = "Two, rejoining.", ["break"] = "Two, breaking, defending!" })[id])
		end
	elseif id == "bingo" then
		if g.wingman and g.wingman.alive then R("wing", "Two, copy bingo, RTB.")
		else R("awacs", cs .. ", Magic, copy, vector " .. self:homeBearing() .. " for home.") end
	elseif id == "rtb" then R("awacs", cs .. ", Magic copies, home plate bearing " .. self:homeBearing() .. ".")
	elseif id == "defending" then
		if g.wingman and g.wingman.alive then
			R("wing", "Two, coming to help!")
			if g.wingman.pilot then g.wingman.pilot.order = "engage" end
		end
	elseif id == "splash" then
		if g.wingman and g.wingman.alive then R("wing", "Two, good kill!")
		else R("awacs", cs .. ", Magic, copy splash.") end
	end
end

-- the game's own events (missile launched, kill ...): an automatic call from the wingman
function Radio:event(kind)
	local w = self.g.wingman
	if not (w and w.alive) then return end
	if kind == "wing_fox" then self:say("wing", "Two, fox three!", 0.3)
	elseif kind == "wing_splash" then self:say("wing", "Two, splash one!", 0.3)
	elseif kind == "wing_defending" then self:say("wing", "Two, defending, missile inbound!", 0.2) end
end

return Radio
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX47"><Properties><string name="Name">Tutorial</string><ProtectedString name="Source"><![CDATA[--!nonstrict
-- The tutorial (Oktatás): the port of web/js/tutorial.js.  An optional guided flight: every lesson explains what a system does, how to use
-- it and when it is worth it, then gives one small task that the game checks by itself.  Target drones do not shoot back, and the player's
-- jet cannot be hurt by weapons here.  The texts are Roblox rich text (<b>, <font>).  Common subset of Lua 5.4 and Luau.
local M = require(script.Parent.Parent.sim.SimMath)
local Sim = require(script.Parent.Parent.sim.Sim)
local AI = require(script.Parent.Parent.sim.AI)
local Specs = require(script.Parent.Parent.sim.Specs)
local Weapons = require(script.Parent.Parent.sim.Weapons)
local V, add, sub, mul, norm, len, clamp, copy, DEG = M.V, M.add, M.sub, M.mul, M.norm, M.len, M.clamp, M.copy, M.DEG
local atan2, sin, cos, abs, max, min = M.atan2, math.sin, math.cos, math.abs, math.max, math.min

local T = {}

local function k(key) return '<font color="#ffc840"><b>[' .. key .. ']</b></font>' end

-- a target that just flies: straight, or weaving gently; radar off so the RWR stays quiet
local Drone = {}
Drone.__index = Drone
local function newDrone(ac, heading, weave, throttle)
	local self = setmetatable({}, Drone)
	self.ac, self.heading, self.weave, self.throttle, self.t, self.alt = ac, heading, weave or 0, throttle or 0.9, 0, ac.pos.z
	if ac.radar.on then ac.radar:togglePower() end
	ac.pilot = self
	return self
end
function Drone:think() end
function Drone:fly(dt)
	local ac = self.ac
	self.t = self.t + dt
	local h = self.heading + sin(self.t * 0.3) * self.weave
	local climb = clamp((self.alt - ac.pos.z) / 1500, -0.25, 0.25)
	AI.steerTowards(ac.fm, norm(V(sin(h), cos(h), climb)), ac.controls, 0.45, 0.8)
	ac.controls.throttle = self.throttle
end

local function fixs(x, n) return string.format("%." .. (n or 1) .. "f", x) end

-- the lessons: { title, read, paras (list of rich text lines), task, setup(t), check(t, dt), status(t) }
local function lessons(spec)
	local f16, gun = spec.id == "f16", spec.gun
	local L = {}
	local function add_(l) L[#L + 1] = l end
	add_({ title = "Üdvözlünk a pilótafülkében!", read = true, paras = {
		"Ez az oktatás lépésről lépésre végigvezet a játékon. Minden lépésnél leírjuk, <b>mit</b> csinál egy funkció, <b>hogyan</b> használod és <b>mikor</b> érdemes, utána jön egy kis feladat – a játék magától észreveszi, ha megcsináltad.",
		"A gép közben magától repül. Gyakorlás alatt a lövések nem sebeznek meg, csak a földbe csapódás veszélyes.",
		"<b>A képernyő</b>",
		"• <b>Bal oldalt:</b> IAS = sebesség (km/h), M = Mach, G = terhelés, AoA = állásszög, THR = gázkar, MOT = hajtómű.",
		"• <b>Jobb oldalt:</b> ALT = magasság, AGL = föld feletti magasság, VS = emelkedés, HDG = irány, FUEL = üzemanyag, HP = épség.",
		"• <b>Középen:</b> a zöld kereszt a gép orra, a szárnyas zöld kör a valódi repülési irány, a fehér kör az, ahová célzol.",
		"• <b>Bal lent</b> az RWR (ki figyel rád radarral), <b>jobb lent</b> a radar.",
	}, task = "Nyomd meg az " .. k("Enter") .. "-t, ha elolvastad." })
	add_({ title = "Repülés az egérrel", paras = {
		"<b>Mit:</b> külső nézetben az egér a fehér kört mozgatja, a gép pedig az orrát oda fordítja. A bedöntést és a húzást egy robotpilóta (instruktor) intézi helyetted.",
		"<b>Hogyan:</b> mozgasd az egeret. Kicsi elmozdulás = finom korrekció, nagy = éles forduló. Kézzel is repülhetsz: " .. k("S") .. " orr fel, " .. k("W") .. " orr le, " .. k("A") .. " / " .. k("D") .. " orsózás, " .. k("Q") .. " / " .. k("E") .. " oldalkormány – amíg nyomod, az instruktor elengedi a gépet.",
		"<b>Mikor:</b> célzáshoz és üldözéshez az egér a legjobb; kézzel akkor, ha egy manővert pontosan akarsz.",
	}, task = "Fordulj legalább 90°-ot (bármelyik irányba).",
		setup = function(t) t.flags.turned, t.flags.lastHdg = 0, nil end,
		check = function(t)
			local f = t.player.forward
			local h = atan2(f.x, f.y)
			if t.flags.lastHdg ~= nil then
				local d = h - t.flags.lastHdg
				d = atan2(sin(d), cos(d))
				t.flags.turned = t.flags.turned + d
			end
			t.flags.lastHdg = h
			return abs(t.flags.turned) >= 90 * DEG
		end,
		status = function(t) return "Eddig: " .. math.floor(abs(t.flags.turned) / DEG + 0.5) .. "°" end })
	add_({ title = "Gáz és utánégető", paras = {
		"<b>Mit:</b> " .. k("Shift") .. " növeli, " .. k("Z") .. " (vagy " .. k("Ctrl") .. ") csökkenti a gázt. 100% a katonai teljesítmény (MIL). E fölött jön az utánégető (AB): sokkal több tolóerő, de 4–5-ször annyi üzemanyag.",
		"<b>Hogyan:</b> tartsd nyomva a " .. k("Shift") .. "-et – 100%-nál megáll. Engedd el, és nyomd meg még egyszer: ez az AB. Lefelé az első " .. k("Z") .. " kikapcsolja az AB-t. A HUD-on a THR a kar állása, a MOT a hajtómű, ami pár másodperc alatt pörög fel.",
		"<b>Mikor:</b> AB-t felszálláskor, ha lelassultál, és éles forduló közben. Utazáshoz MIL vagy kevesebb, így tovább bírja az üzemanyag. Hőkövető rakéta ellen kapcsold ki az AB-t.",
	}, task = "Kapcsold be az utánégetőt, aztán vedd vissza 100%-ra.",
		setup = function(t) t.flags.ab = false end,
		check = function(t)
			local thr = t.player.controls.throttle
			if thr > 1.001 then t.flags.ab = true end
			return t.flags.ab and thr <= 1.001
		end,
		status = function(t) return t.flags.ab and "Utánégető megvolt – most vissza 100%-ra (Z)" or ("Gáz most: " .. math.floor(min(t.player.controls.throttle, 1) * 100 + 0.5) .. "%") end })
	add_({ title = "Forduló, G és energia", paras = {
		"<b>Mit:</b> a G a terhelés: vízszintes repülésben 1 G, a gép határa " .. spec.gMax .. " G. Minél nagyobb a G, annál élesebben fordulsz – de annál gyorsabban fogy a sebességed. A sebesség az „energiád”: ha elfogy, nem tudsz fordulni, és könnyű célpont leszel.",
		"<b>Hogyan:</b> vidd az egeret messze oldalra és felfelé, vagy nyomd az " .. k("S") .. "-t. Közben figyeld a bal oldali G és IAS értéket.",
		"<b>Mikor:</b> a legélesebb forduló kb. 650–850 km/h-n megy (ez a sarok-sebesség). Ha elfogyott a sebesség: AB és enyhe süllyedés. 8 G fölött tartósan elszürkül a kép.",
	}, task = "Húzz legalább 6 G-t.",
		setup = function(t) t.flags.g = 1 end,
		check = function(t) t.flags.g = max(t.flags.g, t.player.fm.gLoad); return t.flags.g >= 6 end,
		status = function(t) return "Legnagyobb eddig: " .. fixs(t.flags.g) .. " G" end })
	add_({ title = "Kabin és kijelzők", paras = {
		"<b>Mit:</b> a " .. k("V") .. " a kabinnézet. Itt az egér maga a botkormány: előre tolva orr le, magad felé húzva orr fel, oldalra orsózás. A bot ott marad, ahová teszed – középre te viszed vissza (a bal oldali kis kijelzőn a zöld pont jelzi a semleges állást).",
		"<b>Hogyan:</b> " .. k("N") .. " = nagyobb kijelzők, újra " .. k("N") .. " = vissza. " .. k("J") .. " / " .. k("K") .. " / " .. k("L") .. " = a bal / jobb / középső kijelző lapozása.",
		"• <b>RDR</b> – radar: a célok, a lockolt cél adatai, hatótáv-csík  • <b>SA</b> – térkép: ellenség, rakéták, harci zóna, bázis  • <b>SMS</b> – fegyverzet, lőszer  • <b>ENG</b> – hajtómű, üzemanyag, mennyi kell hazáig (BINGO)  • <b>RWR</b> – ki figyel rád",
		"<b>Mikor:</b> a kabinnézet akkor jó, ha a cél előtted van. A kijelzőkre utazás közben vagy lock előtt nézz – csak röviden.",
	}, task = "Válts kabinnézetbe (" .. k("V") .. "), nagyítsd fel a kijelzőket (" .. k("N") .. "), majd " .. k("N") .. "-nel vissza.",
		setup = function(t) t.flags.panel = false end,
		check = function(t)
			local c = t.cam
			if c.cockpit and c.panelLook then t.flags.panel = true end
			return t.flags.panel and c.cockpit and not c.panelLook
		end,
		status = function(t) return t.flags.panel and "Most N-nel vissza" or (t.cam.cockpit and "Most nyomd meg az N-t" or "Nyomd meg a V-t") end })
	add_({ title = "Radar lock és AIM-120 – távoli cél", paras = {
		"Egy céldrón repül feléd kb. 22 km-ről (nem lő vissza). A piros háromszög jelöli, alatta a távolság km-ben.",
		"<b>Mit:</b> az AIM-120A AMRAAM radarvezérlésű rakéta („Fox 3”), 5–35 km-ről lőhető. Kilövés után a te radarod vezeti, majd kb. 11–16 km-re a céltól bekapcsolja a saját radarját (PITBULL) – onnan magától megy.",
		"<b>Hogyan:</b>  1. Nyomd meg a " .. k("2") .. "-t: kiválasztod az AIM-120A-t.  2. Fordulj a cél felé, és nyomd meg a " .. k("T") .. "-t: fél másodperc alatt lockol, a célon zöld négyzet jelenik meg.  3. A jobb oldali DLZ-csík mutatja, elér-e a rakéta. Ha a négyzet piros lesz és villog a <b>LŐHETSZ!</b>, nyomd meg a " .. k("Space") .. "-t.  4. Tartsd az orrod a cél felé, amíg meg nem jelenik a PITBULL üzenet.",
		"<b>Mikor:</b> szemből messzebbről is elér; hátulról csak közelebbről. Ha a lock elvész (a cél 90°-ra fordul – ez a notch), nyomd meg újra a " .. k("T") .. "-t.",
	}, task = "Lődd le a drónt AIM-120-szal.",
		setup = function(t) t:drone({ dist = 22000, heading = "toward" }) end,
		check = function(t) return t:killed() end, status = function(t) return t:droneStatus() end })
	add_({ title = "AIM-9 – hőkövető rakéta közelről", paras = {
		"Egy drón repül előtted kb. 3 km-re, teljes gázzal – jó meleg cél.",
		"<b>Mit:</b> az AIM-9M Sidewinder a gép hőjét követi („Fox 2”). Nem kell hozzá radar, de rövid a hatótávja: hátulról 1–8 km, szemből csak 3–4 km.",
		"<b>Hogyan:</b>  1. Nyomd meg az " .. k("1") .. "-et. Megjelenik egy nagy kör – a rakéta keresője.  2. Vidd a célt a körbe: ha hőt lát, magától lockol. Az " .. k("F") .. " azonnal lockol bármelyik ellenségre az orrod előtt ±30°-on belül.  3. " .. k("Space") .. " = indítás.",
		"<b>Mikor:</b> a cél mögül, főleg ha utánégetővel repül. Ha a cél flare-t szór, várj egy pillanatot és lockolj újra. 400 m-en belül már túl közel van – oda az ágyú való.",
	}, task = "Lődd le a drónt AIM-9-cel.",
		setup = function(t) t:drone({ dist = 3000, heading = "away", throttle = 0.85, speed = 190, maxDist = 10000 }) end,
		check = function(t) return t:killed() end, status = function(t) return t:droneStatus() end })
	add_({ title = "Gépágyú", paras = {
		"Most egy lassabb, kicsit kanyargó drón van előtted kb. 900 m-re.",
		"<b>Mit:</b> a " .. gun.name .. " gépágyú 1 km-en belül hatásos, " .. gun.ammo .. " lőszerrel (kb. " .. math.floor(gun.ammo / 100 + 0.5) .. " másodpercnyi tűz).",
		"<b>Hogyan:</b>  1. Lockold a célt radarral (" .. k("T") .. "). Megjelenik az előretartás-jelző: fehér kör ponttal – ide érnek a golyók.  2. Tedd a fehér célzókört erre a jelre, és tüzelj a <b>bal egérgombbal</b>, rövid sorozatokkal.",
		"<b>Mikor:</b> ha a cél közel van és előtted, vagy ha elfogytak a rakéták. 1,5 km-nél messzebbről ne lőj.",
	}, task = "Lődd le a drónt.",
		setup = function(t) t:drone({ dist = 900, heading = "away", speed = 170, throttle = 0.7, weave = 0.2, maxDist = 6000, hp = 40 }) end,
		check = function(t) return t:killed() end, status = function(t) return t:droneStatus() end })
	add_({ title = "Védekezés: rád lőttek!", paras = {
		"Pár másodperc múlva egy ellenség rakétát indít rád kb. 9 km-ről, oldalról. A gyakorlásban nem sebez, de jelezzük, ha eltalált volna.",
		"<b>Mit jelez a gép:</b> az RWR-en (bal lent) piros villogó jel, gyorsuló sípolás, középen <b>MISSILE!</b>, a rakétán piros rombusz a távolsággal és a becsapódásig hátralévő idővel.",
		"<b>Hogyan védekezz:</b>  1. Fordulj úgy, hogy a rakéta oldalt (3 vagy 9 órában) legyen – ez a <b>notch</b>: a radar nem lát jól.  2. Közben tartsd nyomva az " .. k("X") .. "-et: chaff (radar ellen) és flare (hőkövető ellen).  3. Az utolsó 2–3 másodpercben húzz egy éles fordulót – a rakéta nem tud ilyen élesen fordulni.  4. Hőkövető ellen vedd vissza az utánégetőt.",
		"<b>Mikor:</b> azonnal, amint megjelenik a MISSILE!. Egyenesen előre ne menekülj – a rakéta gyorsabb.",
	}, task = "Éld túl a rakétát (ne találjon el).",
		setup = function(t) t.flags.fireIn, t.flags.missile, t.flags.hit, t.flags.tries = 3, nil, false, 0 end,
		check = function(t, dt) return t:missileDrill(dt) end, status = function(t) return t:missileStatus() end })
	if spec.id == "f22" then
		add_({ title = "A Raptor: lopakodás és belső fegyvertér", paras = {
			"<b>Lopakodó:</b> az F-22 radarkeresztmetszete apró, ezért az ellenség radarja csak kb. 10–15 km-ről lát meg (téged akár 100 km-ről is). Az APG-77 radarod „csendes” (LPI).",
			"<b>Belső fegyvertér:</b> 6 AIM-120 a hasban, 1–1 AIM-9 az oldalsó terekben. " .. k("Space") .. "-re előbb kinyílik az ajtó, a kar kitolja a rakétát, aztán minden visszacsukódik – kb. 0,7 s késéssel indul a rakéta. Amíg az ajtó nyitva van, a géped jól látszik a radaron.",
			"<b>Tolóerő-vektorálás:</b> mindig be van kapcsolva (nem kell Tab), a gép max 8 G-t húz.",
		}, task = "Indíts egy rakétát (" .. k("Space") .. "), és nézd meg, ahogy kinyílik a fegyvertér.",
			setup = function(t) t.flags.launched = false end,
			check = function(t)
				for _, st in ipairs(t.player.stations) do if st.launch and st.launch.t > 1.0 then return true end end
				return t.flags.launched
			end,
			status = function(t) return t.player.bayOpenAny > 0.05 and "Fegyvertér nyitva!" or ("Fegyver: " .. (t.player.selected or "-")) end })
	elseif spec.id == "f15" then
		add_({ title = "Az Eagle erőssége: tolóerő és 9 G", paras = {
			"<b>Mit:</b> az F-15EX-ben két F110 hajtómű van, és nagy szárnya: nagy tolóerővel és 9 G-vel fordul. Akár 12 rakétát is vihet (a menüben).",
			"<b>Hogyan:</b> tartsd az utánégetőt és a 650–850 km/h-s sebességet, és húzz élesen. A nagy tolóerő miatt sokáig bírja a nagy G-t – ez az energiaharc.",
			"<b>Mikor:</b> hosszú fordulós harcban a gyengébb ellenfeleket is kifordítod. A nagy légfék (" .. k("B") .. ") gyorsan lelassít, ha túlrepülnéd a célt.",
		}, task = "Húzz legalább 8 G-t.",
			setup = function(t) t.flags.g = 1 end,
			check = function(t) t.flags.g = max(t.flags.g, t.player.fm.gLoad); return t.flags.g >= 8 end,
			status = function(t) return "Legnagyobb eddig: " .. fixs(t.flags.g) .. " G · " .. math.floor(t.player.fm.ias * 3.6 + 0.5) .. " km/h" end })
	elseif f16 then
		add_({ title = "Extrém mód: tolóerő-vektorálás és Cobra (F-16)", paras = {
			"Csak az F-16-on van (mint a kísérleti F-16 MATV-n): a fúvócső ±20°-ot fordul.",
			"<b>Mit ad:</b> 9 G-s fordulók, 32°-os állásszög, gyorsabb orsózás, kis sebességen is irányítható. Cserébe többet fogyaszt.",
			"<b>Cobra:</b> teljes húzásra a gép felágaskodik (80° állásszögig), és egy pillanat alatt rengeteg sebességet veszít. Ha egy rakéta <b>3–4 másodpercen belül</b> van tőled, amikor ezt csinálod, nagy eséllyel elveszít és elrepül melletted.",
			"<b>Hogyan:</b> " .. k("Tab") .. " = extrém mód be / ki. Cobra: 600 km/h alatt tartsd nyomva az " .. k("S") .. "-t (kabinban: bot teljesen hátra) kb. 1 másodpercig, engedd el, adj AB-t, és engedd le az orrot.",
		}, task = "Kapcsold be az extrém módot (" .. k("Tab") .. "), és csinálj egy Cobrát (állásszög 50° fölött).",
			check = function(t) return t.player.extreme and t.player.fm.alpha > 50 * DEG end,
			status = function(t) return t.player.extreme and ("Extrém mód BE · " .. math.floor(t.player.fm.ias * 3.6 + 0.5) .. " km/h · AoA " .. math.floor(t.player.fm.alpha / DEG + 0.5) .. "°") or "Nyomd meg a Tab-ot" end })
	else
		add_({ title = "A Super Hornet erőssége: nagy állásszög", paras = {
			"<b>Mit:</b> a Hornet nagy szárnya és a törzs melletti LEX miatt 40°-os állásszögig is irányítható: lassan is oda tudja fordítani az orrát, ahová kell.",
			"<b>Hogyan:</b> lassíts 450 km/h alá, aztán húzz teljes erővel (" .. k("S") .. " vagy egér messze felfelé).",
			"<b>Mikor:</b> csak röviden! Nagy állásszögben gyorsan fogy a sebesség.",
		}, task = "Érj el 30° fölötti állásszöget.",
			check = function(t) return t.player.fm.alpha > 30 * DEG end,
			status = function(t) return math.floor(t.player.fm.ias * 3.6 + 0.5) .. " km/h · AoA " .. math.floor(t.player.fm.alpha / DEG + 0.5) .. "°" end })
	end
	add_({ title = "Harci zóna, bázis, leszállás", read = true, paras = {
		"A játékban a harc a térkép túloldalán, a <b>harci zónában</b> van: a HUD-on borostyán rombusz mutatja az irányt és a távolságot. A bázis körüli 14 km-es körben senki nem támad – ott nyugodtan fel- és leszállhatsz.",
		"<b>Hullámok:</b> felszállás után kb. 25 másodperccel jön az első hullám a zónába, minden hullám eggyel több ellenséget hoz. Az ellenség csak közelről lő, te sokkal messzebbről lockolhatsz és lőhetsz.",
		"<b>Leszállás:</b> futómű ki (" .. k("G") .. "), kb. 270 km/h, lassú süllyedés (4 m/s alatt), vízszintes szárnyak; a földön " .. k("B") .. " fékez. A bázis betonján lelassulva újratölt, tankol és javít. Arkád módban a rakéták 10 másodperc alatt maguktól visszatöltődnek.",
		"<b>Tipp:</b> messziről AIM-120 (" .. k("T") .. " + " .. k("Space") .. "), közelről AIM-9 vagy ágyú, és mindig figyeld az RWR-t. Jó repülést!",
	}, task = k("Enter") .. " = az oktatás vége, vissza a főmenübe." })
	return L
end

local Tut = {}
Tut.__index = Tut
-- match: the Match (player, world, terrain, hud, opts); cam: a table with .cockpit and .panelLook that the game keeps up to date
function T.new(match, cam)
	local self = setmetatable({}, Tut)
	self.match, self.cam = match, cam or { cockpit = false, panelLook = false }
	self.spawned, self.deadTime, self.renderTime = {}, 0, 0
	self.steps = lessons(match.player.spec)
	self.statusText = ""
	self.version = 0                  -- changes whenever the card must be redrawn
	self:start(1)
	return self
end
function Tut:playerNow() return self.match.player end
-- (the lessons read t.player)
setmetatable(Tut, { __index = nil })
Tut.__index = function(t, key)
	if key == "player" then return t.match.player end
	if key == "step" then return t.steps[t.i] end
	return Tut[key]
end

function Tut:start(i)
	local w = self.match.world
	local keep = {}
	for _, a in ipairs(w.aircraft) do
		local drop = false
		for _, s in ipairs(self.spawned) do if s == a then drop = true end end
		if not drop then keep[#keep + 1] = a end
	end
	w.aircraft = keep
	local mk = {}
	for _, m in ipairs(w.missiles) do
		local drop = false
		for _, s in ipairs(self.spawned) do if s == m.shooter then drop = true end end
		if not drop then mk[#mk + 1] = m end
	end
	w.missiles = mk
	self.spawned = {}
	self.i, self.done, self.doneTime, self.flags = i, false, 0, {}
	local p = self.player
	p.invulnerable = true
	-- the lessons need both missile types on the jet
	local has9, has120 = false, false
	for _, s in ipairs(p.stations) do
		if s.key == "AIM-9M" then has9 = true end
		if s.key == "AIM-120A" then has120 = true end
	end
	if not has9 or not has120 then
		p.loadout = "default"
		p:rearm()
	end
	local st = self.steps[i]
	if st.setup then st.setup(self) end
	self.version = self.version + 1
end
function Tut:next()
	if self.i < #self.steps then self:start(self.i + 1) else self:finish() end
end
function Tut:enter() self:next() end
function Tut:finish()
	local w = self.match.world
	local keep = {}
	for _, a in ipairs(w.aircraft) do
		local drop = false
		for _, s in ipairs(self.spawned) do if s == a then drop = true end end
		if not drop then keep[#keep + 1] = a end
	end
	w.aircraft = keep
	self.player.invulnerable = false
	self.finished = true
	self.match.tutorial = nil
	if self.match.env.onTutorialEnd then self.match.env.onTutorialEnd() end
end

-- ------------------------------------------------------------------ helpers
function Tut:drone(o)
	local dist, heading, speed, throttle, weave, side, maxDist, hp = o.dist, o.heading or "away", o.speed or 220, o.throttle or 0.9, o.weave or 0, o.side or 0, o.maxDist or 45000, o.hp
	local p, m = self.player, self.match
	local fwd = norm(V(p.forward.x, p.forward.y, 0), V(0, 1, 0))
	local right = V(fwd.y, -fwd.x, 0)
	local pos = add(add(p.pos, mul(fwd, dist)), mul(right, side))
	pos.z = max(p.pos.z, m.terrain:height(pos.x, pos.y) + 1200)
	local hdgP = atan2(fwd.x, fwd.y)
	local h = heading == "toward" and hdgP + math.pi or hdgP
	local spec = Specs.BANDITS[(m.opts.enemyType == "fa18") and "fa18" or "f16"]
	local ac = Sim.newAircraft(spec, "Céldrón", "red", pos, h / DEG, speed, { missiles = Specs.BANDIT_MISSILES, rnd = M.rng(7) })
	for _, s in ipairs(ac.stations) do s.loaded = false end
	ac:updateStores()
	if hp then ac.hp = hp end
	newDrone(ac, h, weave, throttle)
	m.world:addAircraft(ac)
	self.spawned[#self.spawned + 1] = ac
	self.flags.drone, self.flags.maxDist = ac, maxDist
	return ac
end
function Tut:killed()
	local d = self.flags.drone
	if d and not d.alive and d.lastAttacker == self.player then self.flags.kill = true end
	if self.flags.kill then return true end
	-- flew away, or went down without your shot (a hill): a new one
	if d and (len(sub(d.pos, self.player.pos)) > self.flags.maxDist or not d.alive) then
		local keep = {}
		for _, a in ipairs(self.match.world.aircraft) do if a ~= d then keep[#keep + 1] = a end end
		self.match.world.aircraft = keep
		self.match.hud:message("A drón elment – itt egy új előtted", "info", 3)
		self.steps[self.i].setup(self)
	end
	return false
end
function Tut:droneStatus()
	local d = self.flags.drone
	if not d or not d.alive then return "Találat!" end
	local dist = len(sub(d.pos, self.player.pos)) / 1000
	local locked = self.player.radar.locked == d
	return "Drón: " .. fixs(dist) .. " km · " .. (locked and "radar lock OK" or "nincs radar lock") .. " · fegyver: " .. (self.player.selected or "-")
end
function Tut:missileDrill(dt)
	local f, p, m = self.flags, self.player, self.match
	if not f.missile then
		f.fireIn = f.fireIn - dt
		if f.fireIn > 0 then return false end
		-- a bandit appears 7 km out behind on the right and fires one (weak) AIM-120 at once, aimed ahead of you
		local ac = self:drone({ dist = -5000, side = 5000, heading = "away", speed = 260 })
		local rel = sub(p.pos, ac.pos)
		local mis = Weapons.newMissile(Specs.BANDIT_MISSILES["AIM-120A"], ac, ac.pos, ac.vel, norm(rel), ac.rnd, p)
		mis.estVel = copy(p.vel)
		m.world:addMissile(mis)
		f.missile, f.hit = mis, false
		f.tries = f.tries + 1
		return false
	end
	local mis = f.missile
	if mis.alive then
		-- gone past you and flying away, or lost you: that counts as beaten
		local rel = sub(p.pos, mis.pos)
		local closing = (mis.vel.x * rel.x + mis.vel.y * rel.y + mis.vel.z * rel.z) / max(len(rel), 1)
		if (closing < 0 and len(rel) > 1500) or mis.defeated then mis.alive = false else return false end
	end
	if f.hit then                                   -- it would have hit: one more try
		m.hud:message("ELTALÁLT VOLNA – próbáld újra: fordulj oldalra, X, és az utolsó pillanatban éles forduló", "warn", 5)
		f.missile, f.fireIn = nil, 4
		return false
	end
	return true
end
function Tut:missileStatus()
	local f = self.flags
	if not f.missile then return f.tries > 0 and "Új rakéta jön..." or ("Rakéta indul " .. max(0, math.ceil(f.fireIn)) .. " s múlva") end
	local d = len(sub(f.missile.pos, self.player.pos)) / 1000
	return "RAKÉTA: " .. fixs(d) .. " km · " .. tostring(f.missile.status)
end

-- ------------------------------------------------------------------ frame
function Tut:update(dt)
	local p = self.player
	if not p.alive then                              -- crashed: back in the air, same lesson again
		self.deadTime = self.deadTime + dt
		if self.deadTime > 2 then
			self.deadTime = 0
			self.match.state.banner, self.match.state.subBanner = "", ""
			self.match:spawnPlayer()
			self:start(self.i)
		end
		return
	end
	local s = self.steps[self.i]
	if not self.done and s.check and s.check(self, dt) then
		self.done = true
		self.version = self.version + 1
	end
	if self.done then
		self.doneTime = self.doneTime + dt
		if self.doneTime > 2.5 then self:next(); return end
	end
	self.renderTime = self.renderTime + dt
	if self.renderTime > 0.25 then
		self.renderTime = 0
		local ok, txt = pcall(function() return (not self.done and s.status) and s.status(self) or "" end)
		self.statusText = ok and txt or ""
	end
end
function Tut:onEvent(kind, d)
	if kind == "shielded" and d.target == self.player then self.flags.hit = true end
	if kind == "kill" and d.killer == self.player and d.victim == self.flags.drone then self.flags.kill = d.weapon end
end

-- what the card shows
function Tut:view()
	local s = self.steps[self.i]
	return { i = self.i, n = #self.steps, title = s.title, body = table.concat(s.paras, "\n\n"), task = s.task, done = self.done, status = self.statusText,
		read = s.read == true, version = self.version }
end

return T
]]></ProtectedString></Properties></Item>
