--!nonstrict
-- Reads the game's island (the height grid and the ground materials, Island*.luau, generated by tools/roblox_island.py) into
-- the table the simulation's terrain (sim/SimTerrain.luau) is made from: { size, res, heights (1-based, metres), airfield }.
local Island = require(script.Parent.Island)

local IslandData = {}

local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local lookup = {}
for i = 1, #alphabet do lookup[string.byte(alphabet, i)] = i - 1 end

-- base64 -> int16 values (little endian), appended to out
local function decodeInt16(s, out, scale)
	local n = #out
	local acc, bits = 0, 0
	local lo = nil
	for i = 1, #s do
		local v = lookup[string.byte(s, i)]
		if v then
			acc = acc * 64 + v
			bits = bits + 6
			if bits >= 8 then
				bits = bits - 8
				local div = 2 ^ bits
				local byte = math.floor(acc / div)
				acc = acc - byte * div
				if lo == nil then
					lo = byte
				else
					local val = lo + byte * 256
					if val >= 32768 then val = val - 65536 end
					n = n + 1
					out[n] = val * scale
					lo = nil
				end
			end
		end
	end
end

local cache = nil
-- the data for SimTerrain.new, plus .mats (the material digits, one string per module)
function IslandData.load()
	if cache then return cache end
	local heights = {}
	for _, name in ipairs(Island.HeightModules) do
		decodeInt16(require(script.Parent[name]), heights, Island.scale)
	end
	local mats = {}
	for _, name in ipairs(Island.MatModules) do mats[#mats + 1] = require(script.Parent[name]) end
	cache = { size = Island.size, res = Island.res, heights = heights, airfield = Island.airfield, mats = mats }
	return cache
end

-- the ground material digit (1 grass, 2 leafy grass, 3 ground, 4 rock, 5 sand, 6 snow) at grid point (i, j), 0-based
function IslandData.material(data, i, j)
	local n = data.res + 1
	local row = j
	local per = Island.MatRows
	local m = math.floor(row / per) + 1
	local off = (row - (m - 1) * per) * n + i + 1
	return string.byte(data.mats[m], off) - 48
end

return IslandData
